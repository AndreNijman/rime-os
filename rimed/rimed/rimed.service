[Unit]
Description=Rime OS power daemon (rimed)
Documentation=https://github.com/AndreNijman/rime-os
After=dbus.service polkit.service
Wants=polkit.service

[Service]
Type=dbus
BusName=org.rimeos.Rimed1
ExecStart=/usr/bin/rimed
# Fan safety net: this runs after the main process stops for *any* reason,
# including a crash or a SIGKILL, where no in-process restore could have run.
# It re-discovers the fans and hands every one of them back to firmware control
# without needing the daemon or the bus. See docs/m6-notes.md.
ExecStopPost=-/usr/bin/rime fan restore --local
Restart=on-failure
RestartSec=2
# rimed needs raw sysfs writes (cpufreq, platform_profile, charge thresholds,
# hwmon pwm), to exec ryzenadj (L16) and nvidia-smi (Katana), and to write
# /proc/irq/*/smp_affinity_list — so it runs as root and is only lightly
# sandboxed. Set RIMED_DRY_RUN=1 here to make it plan without writing.
Environment=RUST_BACKTRACE=1
# /var/lib/rimed/mode: the mode the user chose (Settings → Gaming), put back at
# every start. See rimed/rimed/src/hold.rs.
StateDirectory=rimed
ProtectHome=yes
# NOT ProtectControlGroups: M6 game mode creates a cgroup-v2 cpuset
# (/sys/fs/cgroup/rime-game) and moves the game's PIDs into it, which needs
# /sys/fs/cgroup writable. Hardening this back on silently disables P/E pinning.
ProtectControlGroups=no
RestrictRealtime=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
