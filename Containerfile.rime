# ─────────────────────────────────────────────────────────────────────────
# Rime OS — the image. One image, every laptop.
#
#   FROM rime-base → stamp the edition, set the boot splash, rebuild the
#   initramfs that ships. That is all this tier does.
#
# ═══ WHY THERE IS ONLY ONE OF THESE NOW ═══
#
# Rime used to publish three: `daily`, `gaming-mesa`, `gaming-nvidia`. They were
# the same operating system with different payloads bolted on, and the split
# forced a decision at INSTALL time that nobody has the information to make.
# Someone with a gaming laptop who plays occasionally had to pick, and picking
# Daily locked them out of the GPU driver their machine came with — recoverable
# only by a rebase, which is not a thing a normal person does. Three images also
# meant three CI legs, three sets of verification, and two of them idle on any
# given machine forever.
#
# The replacement rule is not "put everything in one image and hope". It is a
# hard technical line:
#
#     A kernel module cannot be installed at runtime under Secure Boot.
#     Userspace can.
#
# Signing a module the kernel will accept needs the Rime MOK private key, which
# is a CI secret and must never reach a user's machine — `rime-pkg` refuses
# kernels, kernel modules and akmods for exactly this reason. So:
#
#   ships in the image, built and signed in CI  |  installs on demand
#   ------------------------------------------- | ---------------------------
#   NVIDIA akmod + userspace driver             |  Steam, Proton
#   xone / xpadneo controller akmods            |  gamescope, MangoHud
#                                               |  Sunshine, OBS
#
#     sudo rime install steam gamescope mangohud gamemode
#
# and none of that touches the deployment — `rime install` builds a systemd
# system extension, so `bootc upgrade` keeps working (see docs/packages.md).
#
# Verified against the repositories this image actually enables, rather than
# assumed: steam resolves from RPMFusion nonfree; gamescope, mangohud, gamemode,
# obs-studio, steam-devices and protontricks from Fedora. Proton itself ships
# inside Steam. SUNSHINE IS THE EXCEPTION and is named as one — it is in no
# enabled repository, so it needs `rime repo enable-copr` or a downloaded .rpm
# (which `rime install` also takes). One command for the rest, two for Sunshine.
#
# Everything in the left-hand column lives in Containerfile.core, NOT here and
# NOT in the base. That is a download decision, and it is the reason a single
# image is affordable at all: the base consumes core as `FROM …@sha256:…`, so
# those layer descriptors are reused verbatim and bootc downloads none of them
# on a normal update. The NVIDIA driver is fetched once, by digest, forever.
#
# WHAT THIS TIER STILL EXISTS FOR: the Plymouth theme has to be set, and setting
# it requires the LAST initramfs regeneration of the build — after core's NVIDIA
# dracut configuration and after the base's content. That ordering is the tier.
# ─────────────────────────────────────────────────────────────────────────
ARG BASE=localhost/rime-base:latest
FROM ${BASE}

# ── Edition stamp ──────────────────────────────────────────────────────────
# There is one edition now, so it is named after the product rather than after
# one of the three things it replaced. VARIANT_ID=rime, not `daily`: keeping
# `daily` would have been a free ride through the greeter's existing branding
# switch, and it would also be a lie told by every machine's /etc/os-release —
# this image is what `:gaming-nvidia` resolves to as well.
#
# /etc/os-release is a symlink into /usr/lib/os-release, so append there. (The
# base deliberately leaves this unset.) rime-greet maps `rime` to the chartreuse
# accent; /etc/rime-greet/edition still overrides it per machine.
RUN set -eux; \
    printf 'VARIANT="Rime"\nVARIANT_ID=rime\n' >> /usr/lib/os-release; \
    grep -q '^VARIANT_ID=rime$' /usr/lib/os-release

# ── Gaming Mode: the session, without the payload ──────────────────────────
# gamescope and Steam are on-demand packages now, so this session cannot be
# offered unconditionally — a greeter entry that bounces the user straight back
# to the greeter is worse than no entry. `TryExec=/usr/bin/gamescope` is the
# desktop-entry spec's own mechanism for exactly this, and rime-greet's
# enumeration now honours it: the entry is INVISIBLE until `rime install
# gamescope steam` puts the binary in place, and appears by itself afterwards.
# That is why the session's own files ship here regardless — they are shell
# scripts and a sudoers rule, they cost nothing, and provisioning them at
# install time would mean writing to a read-only /usr.
#
# What the session gives, once its packages are present: gamescope presenting
# directly to KMS with no Hyprland, no bar and nothing composited over the game;
# `rime game start` on entry, which is what finally makes the CachyOS kernel's
# sched-ext support do something (scx_lavd) alongside the cpuset, IRQ steering,
# GPU clock locks and performance tier.
#
# scx_loader is NOT enabled here, and that is deliberate rather than an
# oversight: its unit is `Type=dbus` with `BusName=org.scx.Loader`, and
# /usr/share/dbus-1/system-services/org.scx.Loader.service names
# `SystemdService=scx_loader.service`. It is D-Bus activated, so the first
# scxctl call from rimed starts it. Enabling it would add a daemon to every
# boot on every laptop to save an activation that systemd already performs.
#
# REALTIME: this drop-in raises RLIMIT_RTPRIO through pam_limits, which greetd's
# PAM stack does run, and that part works — katana 2026-09-19 measured the soft
# limit at 20 in a real Gaming Mode session.
#
# It is NOT enough for gamescope's `--rt`, and the comment that used to sit here
# said it was. gamescope gates realtime on CAP_SYS_NICE, not on the rlimit, so
# with the drop-in installed and the flag passed it still logged "No CAP_SYS_NICE,
# falling back to regular-priority compute and threads" on every attempt. The
# session script now checks the capability and passes `--rt` only when it is
# actually reachable — see its own header for why nothing here grants it
# (setcap cannot write a read-only composefs /usr, and pam_cap would break
# Steam's bwrap).
COPY --chmod=0755 files/system/libexec/rime-gaming-session \
     /usr/libexec/rime-gaming-session
COPY --chmod=0755 files/system/libexec/rime-gamescope-steam \
     /usr/libexec/rime-gamescope-steam
COPY --chmod=0755 files/system/libexec/rime-session-select \
     /usr/libexec/rime-session-select
# Gaming Mode is a toggle: greetd's ExecStartPre (rime-greetd) spends the
# one-shot autologin rime-session-select leaves for a desktop <-> Gaming Mode
# switch; greetd itself is still exec'd directly (see both files' headers).
COPY --chmod=0755 files/system/libexec/rime-greetd /usr/libexec/rime-greetd
# What Steam's Gaming Mode Power menu runs (-steamos3): "Switch to Desktop" and
# the System > Software Updates check. See each file.
COPY --chmod=0755 files/system/bin/steamos-session-select /usr/bin/steamos-session-select
COPY --chmod=0755 files/system/bin/steamos-update /usr/bin/steamos-update
COPY files/system/units/50-rime-greetd-switch.conf \
     /usr/lib/systemd/system/greetd.service.d/50-rime-greetd-switch.conf
COPY files/system/sudoers/rime-session-select \
     /etc/sudoers.d/040-rime-session-select
COPY files/system/limits/30-rime-gaming-rtprio.conf \
     /etc/security/limits.d/30-rime-gaming-rtprio.conf
COPY files/desktop/wayland-sessions/rime-gaming.desktop \
     /usr/share/wayland-sessions/rime-gaming.desktop
RUN set -eux; \
    # sudoers is parsed by a setuid binary: a syntax error or wrong mode is
    # refused at RUNTIME, i.e. a password prompt no compositor can answer.
    chown root:root /etc/sudoers.d/040-rime-session-select; \
    chmod 0440 /etc/sudoers.d/040-rime-session-select; \
    visudo -cf /etc/sudoers.d/040-rime-session-select; \
    bash -n /usr/libexec/rime-gaming-session; \
    bash -n /usr/libexec/rime-gamescope-steam; \
    command -v xprop >/dev/null || { echo "FATAL: rime-gamescope-steam needs xprop (Gaming Mode would scan out garbage on NVIDIA)"; exit 1; }; \
    bash -n /usr/libexec/rime-session-select; \
    bash -n /usr/libexec/rime-greetd; \
    bash -n /usr/bin/steamos-session-select; bash -n /usr/bin/steamos-update; \
    grep -q '^ExecStart=/usr/bin/greetd \$RIME_GREETD_ARGS$' /usr/lib/systemd/system/greetd.service.d/50-rime-greetd-switch.conf; \
    test -x /usr/bin/greetd || { echo "FATAL: the greetd drop-in execs /usr/bin/greetd, which is missing"; exit 1; }; \
    # The gate that keeps the entry hidden until its packages exist. Without
    # this line the session is offered on every machine and fails on almost all
    # of them, which is the regression this whole arrangement exists to avoid.
    grep -q '^TryExec=/usr/bin/gamescope$' \
        /usr/share/wayland-sessions/rime-gaming.desktop \
        || { echo "FATAL: rime-gaming.desktop has no TryExec gate; it would be offered without gamescope"; exit 1; }; \
    # ...and the greeter must actually honour TryExec, or the gate is decorative.
    grep -q 'TryExec=' /usr/share/rime-greet/GreetContext.qml \
        || { echo "FATAL: rime-greet does not filter on TryExec"; exit 1; }; \
    # Prove it against the shipped artifact rather than trusting the two greps:
    # run the greeter's OWN enumeration and require rime-gaming to be absent
    # while gamescope is not installed.
    ! command -v gamescope >/dev/null \
        || { echo "FATAL: gamescope is baked in; it is meant to be on-demand"; exit 1; }; \
    ! command -v steam >/dev/null \
        || { echo "FATAL: steam is baked in; it is meant to be on-demand"; exit 1; }; \
    ENUM='for f in /usr/share/wayland-sessions/*.desktop; do [ -r "$f" ] || continue; id=$(basename "$f" .desktop); tryexec=$(sed -n "s/^TryExec=//p" "$f" | head -n1); if [ -n "$tryexec" ] && ! command -v "$tryexec" >/dev/null 2>&1; then continue; fi; exec=$(sed -n "s/^Exec=//p" "$f" | head -n1); [ -n "$exec" ] || continue; printf "%s\n" "$id"; done'; \
    got="$(sh -c "${ENUM}" | tr '\n' ' ')"; \
    echo "greeter would offer: ${got}"; \
    case "${got}" in *rime-gaming*) echo "FATAL: rime-gaming offered without gamescope"; exit 1 ;; esac; \
    case "${got}" in *hyprland*) ;; *) echo "FATAL: hyprland session missing"; exit 1 ;; esac; \
    case "${got}" in *niri*) ;; *) echo "FATAL: niri session missing"; exit 1 ;; esac; \
    # THE LOCKOUT GUARD, kept verbatim from the retired Containerfile.gaming.
    # Sessions are enumerated by a sorted glob and the greeter's index defaults
    # to 0, so `rime-gaming.desktop` sorts BEFORE hyprland/niri and would become
    # the default session the moment a user installs gamescope. That is precisely
    # how hyprland-uwsm.desktop locked users out (see Containerfile.base). The
    # greeter picks its default BY NAME, and this asserts that it still does.
    grep -q 'defaultSession: "hyprland"' /usr/share/rime-greet/GreetContext.qml \
        || { echo "FATAL: greeter no longer names its default session; rime-gaming would sort first and become the default"; exit 1; }; \
    grep -q 'ctx.defaultSession' /usr/share/rime-greet/GreetContext.qml; \
    # ── The picker's WORDING, swept over the complete set ──────────────────
    # Every session entry exists by now: niri and hyprland from Containerfile
    # .base, rime-labwc from the labwc stage, rime-gaming from the COPY above.
    # BASE-013's third criterion is that compositor names stay implementation
    # details for normal users, and `Name=` is the only line of these files a
    # user ever reads — the greeter renders it verbatim at every login. A
    # regression here is silent: the session still works, it just tells every
    # user which compositor project Rime vendored. The sweep is over the whole
    # directory rather than the files this repo owns, so the next package that
    # drops a session entry in is caught by the build instead of by a user.
    # `swept` is not decoration. A sweep over a directory that turned out to be
    # empty — a moved path, a COPY that landed a tier later — would print
    # nothing and exit 0, and this gate would be a build step that cannot fail.
    # The count is asserted afterwards, and the whole block is what
    # tests/test-rime-greet-sessions.sh lifts out and runs.
    swept=0; \
    for f in /usr/share/wayland-sessions/*.desktop; do \
        n="$(sed -n 's/^Name=//p' "$f" | head -n1 | tr 'A-Z' 'a-z')"; \
        [ -n "$n" ] || { echo "FATAL: $f has no Name="; exit 1; }; \
        case "$n" in \
            *labwc*|*hyprland*|*niri*|*sway*|*wlroots*|*openbox*|*gamescope*|*wayfire*|*river*) \
                echo "FATAL: $f shows users the compositor's name: ${n}"; exit 1 ;; \
        esac; \
        echo "session wording: $(basename "$f" .desktop) -> $(sed -n 's/^Name=//p' "$f" | head -n1)"; \
        swept=$((swept + 1)); \
    done; \
    [ "$swept" -ge 4 ] || { echo "FATAL: the wording sweep saw $swept session entries; it expected at least 4 (niri, hyprland, rime-labwc, rime-gaming)"; exit 1; }; \
    echo "session picker: $swept entries checked, none names a compositor"; \
    echo "gaming session: shipped, TryExec-gated, hidden until its packages are installed"

# ── The image carries its GPU drivers; assert it, here, at the end ─────────
# These are built in Containerfile.core, four tiers down and possibly weeks ago
# in a digest-pinned parent. A base rebuilt on the WRONG core is the exact
# failure this catches, and it is not hypothetical — a stale local core is how a
# validation build in this project reported green against an image that did not
# contain the change under test.
RUN set -eux; \
    KVER="$(cat /usr/lib/rime-kver)"; \
    MODDIR="/usr/lib/modules/${KVER}"; \
    OOT=""; for d in extra updates; do [ -d "${MODDIR}/${d}" ] && OOT="${OOT} ${MODDIR}/${d}"; done; \
    test -n "${OOT}" || { echo "FATAL: no out-of-tree modules in this image at all"; exit 1; }; \
    for pat in nvidia xone xpadneo; do \
        test "$(find ${OOT} -type f -name "*${pat}*.ko*" | wc -l)" -gt 0 \
            || { echo "FATAL: ${pat} module missing — this image was built on a core without it"; exit 1; }; \
    done; \
    test -e /usr/lib64/libGLX_nvidia.so.0; \
    test -e /usr/lib64/libGLX_mesa.so.0; \
    test -s /usr/lib/modprobe.d/50-rime-nvidia.conf; \
    echo "gpu: nvidia + controller modules present, mesa intact"

# ── NTSYNC: Windows synchronisation primitives in the kernel, for Proton ──
# Proton 11 (and Wine 11) use /dev/ntsync whenever it exists and fall back to
# fsync when it does not. The kernel builds the driver as a module, and
# nothing loads it on demand: it registers a dynamic misc minor, so no udev or
# open() autoload ever fires. Before this file, every Rime machine ran every
# Windows game on the fallback. SteamOS, Bazzite and CachyOS ship the same
# one-line modules-load.d entry. The device is created 0666 by the driver
# (`.mode = 0666`), so no udev rule is needed; Proton opens it read-only.
#
# Measured on katana (i7-12700H, RTX 3070 Laptop, Proton Experimental 11.0,
# 2026-10-08), Cyberpunk 2077's built-in benchmark in a CPU-bound
# configuration: 51.4 -> 59.3 fps average, 1 % low 24.5 -> 28.0.
RUN set -eux; \
    KVER="$(cat /usr/lib/rime-kver)"; \
    test -n "$(find "/usr/lib/modules/${KVER}" -name 'ntsync.ko*' | head -n1)" \
        || { echo "FATAL: kernel ${KVER} has no ntsync module; /dev/ntsync would never exist"; exit 1; }; \
    mkdir -p /usr/lib/modules-load.d; \
    printf '%s\n' '# Proton/Wine NT synchronisation driver (/dev/ntsync). Rime OS.' 'ntsync' \
        > /usr/lib/modules-load.d/rime-ntsync.conf; \
    echo "ntsync: loaded at boot for Proton"

# ═══════════════════════════════════════════════════════════════════════════
# M2 — branding (Plymouth). The shared M2 concerns (Rime Shell first-boot
# provisioner, greeter session curation) + M3 (rimed) all live in the BASE.
# ═══════════════════════════════════════════════════════════════════════════

# ── Plymouth boot splash: rime-os-chartreuse ───────────────────────────────
# One image, one splash. Chartreuse is the general-purpose identity and the one
# that matches the greeter accent above; the gold theme was the Gaming edition's
# and has no edition left to belong to.
#
# Copy the theme, set it as the Plymouth default, then rebuild the CachyOS
# initramfs so the theme is actually present in the initrd bootc boots from
# (/usr/lib/modules/<kver>/initramfs.img). `plymouth-set-default-theme` WITHOUT
# -R only sets the default; we run dracut ourselves (mirroring core's Stage-1
# flags) because on bootc the initramfs is regenerated in-image, not by the
# tool's -R host path. The theme uses `ModuleName=script`, so the script plugin
# (plymouth-plugin-script) is required, and so is a label plugin
# (plymouth-plugin-label): without one every Image.Text() — the passphrase
# prompt included — silently draws nothing. Both are installed in
# Containerfile.core; the loop below asserts the label plugin and its font
# reached the initramfs.
#
# THIS IS THE LAST INITRAMFS REGENERATION IN THE BUILD, which is why core's
# 99-nvidia-dracut.conf has to be in place before it. That file used to be what
# put nvidia/nvidia_modeset/nvidia_drm/nvidia_uvm INTO this initramfs; since
# 2026-09-21 it is what keeps EVERY KMS driver out of it, along with the
# network stack. MEASURED on the first build that ran this stanza end to end
# (run 35624291221, kernel 7.2.6-cachyos1.rime1): vmlinuz 16,906,312 B +
# initramfs 88,935,408 B = 100.9 MiB per deployment, so rime-boot-migrate needs
# 3 x 100.9 + 48 = 351 MiB against 1173 MiB before. Confirmed on katana, which
# boots this image: its three deployment directories are 101M (this build)
# against 376M and 376M (the two before it), and the engine itself now answers
# `OK esp-space: 503 MiB free, 350 MiB needed` / "This machine can migrate" —
# the first Rime machine that passes. (503 not 512: that is the FAT filesystem's
# free space, which is what the engine measures.) Either way the claim is
# asserted below against the produced image, not assumed from the config file.
#
# Keeping the theme switch in this tier rather than core is a download
# optimisation: every dnf transaction rewrites the ~200 MB sqlite rpmdb into its
# layer, so installing plymouth here would cost an rpmdb-sized layer on every
# build. With the engine in core, all this layer holds is a theme plus a
# --reproducible dracut run.
#
# WHAT THAT DOES AND DOES NOT BUY, because the earlier version of this comment
# claimed too much. Two `podman build --no-cache` runs from the same parent give
# a BYTE-IDENTICAL initramfs (sha256 4569c3b0…, 88,934,458 B, `cmp` clean), so
# bootc's find_vmlinuz_initrd_duplicate — which digests content — can dedupe a
# deployment. The LAYER digest still moves: the tar records initramfs.img's
# mtime, and --reproducible normalises timestamps inside the cpio, not the file
# dracut writes. Measured across all 14 published rime-<sha> tags: 14 distinct
# final layers. `podman build --timestamp 0` makes the layer and the image id
# stable (verified twice) but rewrites every mtime in the tier, so it is not
# taken here without a real image build behind it.
# See ROADMAP/evidence/initramfs-slim2-20260922.md.
COPY files/branding/plymouth/rime-os-chartreuse \
     /usr/share/plymouth/themes/rime-os-chartreuse
# The 24 accent themes (make-accent-themes.sh) and the dracut module that starts
# the splash in the owner's one before plymouthd does, from an ESP credential
# (files/dracut/rime-plymouth-accent). Copied whole and moved in the RUN below:
# a COPY glob over several directories would flatten them into one.
COPY files/branding/plymouth /tmp/rime-plymouth-src
COPY --chmod=0755 files/dracut/rime-plymouth-accent \
     /usr/lib/dracut/modules.d/50rime-plymouth-accent
COPY --chmod=0755 files/scripts/check-initramfs-budget.sh \
     /tmp/check-initramfs-budget.sh
RUN set -eux; \
    command -v plymouth-set-default-theme >/dev/null \
        || { echo "FATAL: plymouth engine missing from core"; exit 1; }; \
    for t in /tmp/rime-plymouth-src/rime-os-accent-*; do \
        cp -a "$t" /usr/share/plymouth/themes/; \
    done; \
    rm -rf /tmp/rime-plymouth-src; \
    test "$(ls -d /usr/share/plymouth/themes/rime-os-accent-* | wc -l)" -eq 24 \
        || { echo "FATAL: expected 24 accent themes"; exit 1; }; \
    plymouth-set-default-theme rime-os-chartreuse; \
    KVER="$(cat /usr/lib/rime-kver)"; \
    dracut --force --no-hostonly --reproducible --zstd \
        --add "plymouth rime-plymouth-accent" --kver "${KVER}" \
        "/usr/lib/modules/${KVER}/initramfs.img"; \
    test -s "/usr/lib/modules/${KVER}/initramfs.img"; \
    # The splash can only start in the owner's accent if the chooser and every
    # theme it can choose are in the initramfs: dracut's plymouth module carries
    # only the default theme.
    _ls="$(lsinitrd "/usr/lib/modules/${KVER}/initramfs.img")"; \
    for want in usr/bin/rime-plymouth-theme \
                sysinit.target.wants/rime-plymouth-theme.service \
                themes/rime-os-accent-00/rime-os-accent-00.plymouth \
                themes/rime-os-accent-01/spark.png \
                themes/rime-os-accent-23/rime-os.script \
                usr/lib64/plymouth/label-freetype.so \
                usr/share/fonts/Plymouth.ttf \
                fs/fat/vfat.ko; do \
        printf '%s\n' "$_ls" | grep -qF "$want" \
            || { echo "FATAL: $want is not in the initramfs"; exit 1; }; \
    done; \
    # ── the gates ──────────────────────────────────────────────────────────
    # These used to be ~140 lines of inline `grep` right here, which makes them
    # the one kind of test that cannot be run by running the test suite: they
    # exist only inside a build, so nobody ever watches one go red. That is not
    # hypothetical. The version this replaces asserted
    #
    #     ! grep -qE 'kernel/drivers/net/ethernet/'
    #
    # as "the initramfs has no network", and the slim initramfs this build
    # produces CONTAINS eleven files under kernel/drivers/net — FCoE offload,
    # a Chelsio crypto accelerator and SDIO wireless, all dependencies of
    # modules present for storage reasons. It would have FATALed every build on
    # the artifact it was written to pass.
    #
    # So the predicate lives in files/scripts/check-initramfs-budget.sh and
    # tests/test-rime-initramfs-budget.sh runs it against captured listings of
    # a fat and a slim initramfs, asserting every gate's verdict by name in
    # BOTH directions. When one of these fails your build, that suite can tell
    # you whether the gate or the image is wrong, in two seconds, without a
    # 40-minute rebuild.
    #
    # It prints the per-deployment size and the ESP requirement whether it
    # passes or fails, so the number migrate-preconditions consumes is in every
    # build log and a slow drift is visible long before it is fatal.
    /tmp/check-initramfs-budget.sh \
        --initrd  "/usr/lib/modules/${KVER}/initramfs.img" \
        --vmlinuz "/usr/lib/modules/${KVER}/vmlinuz" \
        --kconfig "/usr/lib/modules/${KVER}/config"; \
    rm -f /tmp/check-initramfs-budget.sh

# Kernel args for the graphical splash. `quiet splash` per the theme's own
# README (files/branding/plymouth/README.md). NOTE: `quiet` raises the console
# loglevel, so it trims the verbose serial output core's 10-rime-serial.toml
# enables for CI/QEMU observability (warnings/errors still print). Drop `quiet`
# here if noisier boot logs are wanted. bootc merges all kargs.d files.
RUN set -eux; \
    mkdir -p /usr/lib/bootc/kargs.d; \
    printf 'kargs = ["quiet", "splash"]\n' \
        > /usr/lib/bootc/kargs.d/20-rime-plymouth.toml

# ── The APEX-OS names, kept working for a release or two ─────────────────── (rime-rename: keep)
# Andre: "keep `apex` working for a release or two". Existing machines name the
# old spellings where no update rewrites them: units a person enabled
# (`systemctl --user enable apex-agentd`), labwc/Hyprland/niri configs seeded
# into home directories, an edited /etc/greetd/config.toml, MCP entries in
# ~/.claude.json that launch `apex mcp run`. So:
#   * /usr/bin/apex runs rime, with one line on stderr and nothing on stdout
#     (stdio MCP servers speak on stdout);
#   * every unit, /usr/libexec helper and /usr/share tree the old image
#     shipped keeps its old name as a relative link to the new one
#     (files/scripts/install-rename-compat has the lists and the reasons).
# Here, at the very end, because the gaming-session helpers above are among
# the targets and a link to a file that is not there yet fails the build.
# tests/test-rime-rename-compat.sh runs the installer on a fixture root.
COPY --chmod=0755 files/system/compat/apex /usr/bin/apex
COPY --chmod=0755 files/scripts/install-rename-compat /tmp/install-rename-compat
RUN set -eux; \
    bash /tmp/install-rename-compat /; \
    rm -f /tmp/install-rename-compat; \
    : 'rime-rename: keep: the lines below check the old names on purpose'; \
    test "$(/usr/bin/apex --help 2>/dev/null)" = "$(/usr/bin/rime --help)" \
        || { echo "FATAL: /usr/bin/apex does not print exactly what rime prints"; exit 1; }; \
    test "$(/usr/bin/apex --help 2>&1 >/dev/null)" = 'apex: this command is now `rime`' \
        || { echo "FATAL: /usr/bin/apex must say one line on stderr"; exit 1; }; \
    test "$(readlink /usr/lib/systemd/user/apex-agentd.service)" = rime-agentd.service; \
    test "$(readlink /usr/lib/systemd/system/apexd.service)" = rimed.service; \
    test -x /usr/libexec/apex-greet-session; \
    test -x /usr/libexec/apex-shell-autostart; \
    test -f /usr/share/apex-shell/shell.qml; \
    test -f /usr/share/apex-greet/sway-greet.conf; \
    # systemd must read each one as an alias of a real unit. A link it took for
    # a unit of its own would be a second copy with the old name's state.
    for scope in "" --global; do \
        n="$(systemctl $scope list-unit-files --no-legend --no-pager 'apex*' | wc -l)"; \
        test "$n" -gt 0; \
        if systemctl $scope list-unit-files --no-legend --no-pager 'apex*' | awk '$2 != "alias"' | grep -q .; then \
            echo "FATAL: an old-name unit is not an alias:"; \
            systemctl $scope list-unit-files --no-legend --no-pager 'apex*'; exit 1; \
        fi; \
    done

# Informational lint.
RUN bootc container lint || true

# ── The release this image IS (rimeos.com master spec §7.6) ────────────────
# /usr/share/rime/release.json: Rime Shell's ReleaseService reads it on the
# first desktop session after an update and opens
# https://rimeos.com/updates/<id> once (§7.2). The ID is computed by the
# workflow from what the channel tags serve now (files/scripts/next-release-id)
# and passed in; a build without one (local, branch test) is "dev", which has
# no notes URL and opens nothing. Last, so a new ID invalidates one tiny layer.
ARG RIME_REVISION=dev
ARG RIME_RELEASE_ID=dev
COPY --chmod=0755 files/scripts/stamp-release /tmp/stamp-release
RUN set -eux; \
    bash /tmp/stamp-release "${RIME_RELEASE_ID}" "${RIME_REVISION}" /; \
    rm -f /tmp/stamp-release; \
    cat /usr/share/rime/release.json; \
    python3 -c 'import json; d = json.load(open("/usr/share/rime/release.json")); assert d["schema"] == 1 and d["id"], d'

LABEL org.opencontainers.image.title="Rime OS" \
      org.opencontainers.image.description="Rime OS — one image for every laptop: NVIDIA + controller drivers built and signed in, gaming userspace on demand" \
      org.opencontainers.image.source="https://github.com/AndreNijman/rime-os" \
      org.opencontainers.image.revision="${RIME_REVISION}" \
      org.opencontainers.image.version="rime" \
      org.opencontainers.image.vendor="Rime OS" \
      org.rimeos.release.id="${RIME_RELEASE_ID}"
