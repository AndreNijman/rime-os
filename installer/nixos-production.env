# The production defaults of a NixOS installer ISO (build-live-iso.sh, NIXOS_SYSTEM=… without NIXOS_CACHE_DIR).
# The same caches and keys an installed system's `rime update` uses (nix/modules/update.nix rime.update.*):
# checks.installer-production-defaults fails when the two disagree. Lab and VM builds override every one.
NIXOS_DEFAULT_CACHE_URL=https://cache.rimeos.com
NIXOS_DEFAULT_CACHE_KEY=rime-cache-1:LXocssi9/mdVEgEUlO+thxyiumct4b+HfqW2nIFmX1k=
NIXOS_DEFAULT_UPSTREAM_URL=https://cache.nixos.org
NIXOS_DEFAULT_UPSTREAM_KEY=cache.nixos.org-1:6NCHdD59X431o0gWypbMrAURkbJ16ZPMQFGspcDShjY=
NIXOS_DEFAULT_RELEASE_REPO=ghcr.io/andrenijman/rime-os
