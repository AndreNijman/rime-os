# Rime OS installer live-environment rootfs.
#
# A small Fedora rootfs (NOT the Rime image) that boots as a live ISO and runs
# the GTK installer over the rime-install engine. The netinstall build downloads
# the Rime image (a digest pinned at ISO build time) during the install; the
# offline build embeds it in this env's container storage and installs from it.
#
# NOTE: the Rime image is NOT embedded here. `skopeo copy … containers-storage:`
# cannot run inside a podman build (the build container's fs is overlayfs and
# containers/storage refuses overlay-on-overlay). build-live-iso.sh injects the
# store into the exported rootfs on the HOST instead (step 3 there).
#
# Plain fedora base (not fedora-bootc) so the rootfs is a simple mutable tree.
# Built into a live ISO by build-live-iso.sh.
FROM registry.fedoraproject.org/fedora:43

# ── Firmware: its OWN transaction, with weak deps ENABLED on purpose ─────────
# The live env shipped with /lib/firmware absent entirely, so i915/amdgpu could
# not initialise, KMS failed, and the installer black-screened on an Acer Aspire
# that only booted with nomodeset (rime-logs 48).
#
# The first fix — adding `linux-firmware` to the big install below — did NOT
# work, and the failure was silent: `linux-firmware` is a METAPACKAGE whose GPU
# and wifi content lives in subpackages (amd-gpu-firmware, intel-gpu-firmware,
# nvidia-gpu-firmware, atheros-, brcmfmac-, mt7xxx-, realtek-, …) that it pulls
# as RECOMMENDS. install_weak_deps=False strips all thirteen, leaving 649 files
# and zero i915. Measured, not assumed.
#
# So firmware gets its own transaction with weak deps left ON. Naming the
# subpackages individually would work today and rot the first time Fedora adds
# one; this keeps working.
# EVERY firmware package Fedora ships, not a hand-picked list. This ISO has to
# boot and connect on hardware nobody working on it owns, so enumerating the
# adapters we happen to have is the wrong shape: it silently excludes everyone
# else, and it rots the moment Fedora adds a package.
#
# linux-firmware alone is not enough twice over. Its GPU and wifi content lives
# in subpackages it only RECOMMENDS (see above), and Intel wifi, legacy Intel
# wifi, Marvell, Atmel, ZyDAS, Qualcomm and the Intel camera controller are
# packaged entirely separately and recommended by nothing at all.
#
# Excluded: gnome-firmware (a GUI updater) and python3-virt-firmware (a library)
# — neither ships hardware blobs.
#
# The assertions are the point. Every previous attempt at this failed SILENTLY
# and shipped a black screen; a build that cannot prove it has GPU and wifi
# firmware must not produce an ISO.
RUN set -eux; \
    pkgs="$(dnf -q repoquery --qf '%{name}\n' '*-firmware' 2>/dev/null \
            | grep -vE '^(gnome-firmware|python3-virt-firmware)$' \
            | sort -u | tr '\n' ' ')"; \
    echo "installing firmware packages: $pkgs"; \
    dnf -y install --skip-unavailable $pkgs; \
    dnf clean all; \
    n=$(find /lib/firmware -type f | wc -l); \
    echo "firmware files: $n"; \
    [ "$n" -gt 2500 ] || { echo "FATAL: only $n firmware files"; exit 1; }; \
    for d in i915 amdgpu nvidia; do \
        c=$(find /lib/firmware -path "*/$d/*" -type f | wc -l); \
        [ "$c" -gt 0 ] || { echo "FATAL: no $d firmware"; exit 1; }; \
        echo "  $d: $c files"; \
    done; \
    [ "$(find /lib/firmware -iname 'iwlwifi*' | wc -l)" -gt 0 ] \
        || { echo "FATAL: no Intel wifi firmware"; exit 1; }

# Live-env + installer toolchain. kernel + dracut(+live) make it bootable as a
# squashfs live image; bootc/skopeo run the install; btrfs-progs/
# dosfstools/util-linux for the target disk; shadow-utils for useradd/chpasswd
# into the installed tree; device-mapper for the dmsquash-live snapshot root;
# grub2-tools-extra/-efi-x64-modules so build-live-iso.sh can produce the ISO's
# UEFI grub binary with this same container (host may lack grub2-mkstandalone);
# grub2-pc-modules for the same reason on the LEGACY-BIOS side: it provides
# /usr/lib/grub/i386-pc (the module set grub2-mkimage -O i386-pc-eltorito needs
# to build the ISO's BIOS boot image) plus boot_hybrid.img, the isohybrid MBR
# code that makes a dd'd USB stick boot on pre-UEFI machines. grub2-mkimage
# itself is already here via grub2-tools;
# NetworkManager-wifi / wpa_supplicant / wireless-regdb / iw are listed
# EXPLICITLY for the same reason linux-firmware is: they are WEAK dependencies of
# NetworkManager and install_weak_deps=False silently drops them. Without
# NetworkManager-wifi, NM has no wifi device support whatsoever — `nmcli device`
# shows no wlan at all — so the installer could never offer to join a network.
# (Third instance of this trap in one day: linux-firmware, hyprland-qtutils, and
# now this. Anything only pulled in as a Recommends must be named here.)
# The wifi firmware itself comes from linux-firmware, added above.
# linux-firmware is listed EXPLICITLY because install_weak_deps=False is set
# below: firmware is only a *weak* dependency of the kernel, so it was silently
# excluded and the live environment shipped with /lib/firmware absent entirely
# (0 files). Without GPU firmware i915/amdgpu cannot initialise, KMS fails, and
# the installer black-screens on real hardware — reproduced on an Acer Aspire,
# which only booted with nomodeset. QEMU never caught it because its virtio/bochs
# GPU needs no firmware, and the ThinkPad install was done from a running system
# rather than this ISO, so this path was never exercised on metal.
# It costs ~1 GB of ISO, which is the correct trade for an installer that has to
# boot on unknown hardware. The INSTALLED image already has firmware; this gap
# was only ever in the live environment.
#
# newt (whiptail) is REMOVED on purpose: the whiptail text installer is being
# deleted from rime-install in this same change. It existed as a fallback, and
# on real hardware it is where users got STRANDED — the GUI failed to start
# silently (missing typelib + no seat, both fixed here) and the launcher
# dropped them into a text UI they were never meant to see. The GUI is now the
# ONLY front end; if it cannot start, the assertions below fail the build
# instead of an ISO shipping a dead-end fallback. ncurses stays — the engine
# still uses `clear`.
#
# gobject-introspection is listed EXPLICITLY — the FIFTH weak-deps casualty in
# this file (linux-firmware, its firmware subpackages, hyprland-qtutils,
# NetworkManager-wifi, now this). python3-gobject only *recommends* it, so
# install_weak_deps=False silently dropped it and the built image had no
# /usr/lib64/girepository-1.0/cairo-1.0.typelib. Result, measured in
# localhost/rime-installer:latest: EVERY `import gi` fails with
#   ImportError: Typelib file for namespace 'cairo', version '1.0' not found
# so rime-installer-gui died before it could draw a window and the installer
# fell back to the text UI on real hardware. `dnf repoquery --whatprovides`
# names gobject-introspection as the owner of that typelib.
#
# seatd is required because Fedora 43's libseat ships NO builtin backend.
# Measured in the built image:
#   grep -aoE '\b(seatd|logind|builtin)\b' /usr/lib64/libseat.so.1*
# yields only `logind` and `seatd`. The installer runs as a systemd service
# with TTYPath=/dev/tty1, which has no logind session, so the logind backend
# can never grant a seat — and with no builtin backend to fall back on,
# wlroots/cage cannot acquire a seat, cannot become DRM master, and the
# compositor dies at startup. We standardise on the seatd daemon (enabled
# below, so it is running before the installer service starts).
#
# xorg-x11-server-Xwayland: without it cage logs `Cannot find Xwayland binary
# "/usr/bin/Xwayland"` / `Cannot create XWayland server` at every startup. It
# survived that in testing, but it is console noise and an avoidable failure
# mode, so the binary is installed.
#
# xkeyboard-config and libinput arrive transitively TODAY, but are named
# EXPLICITLY for the same weak-deps reason as everything above: keyboard input
# in the GUI depends on both, and a dependency that is only present by
# accident is one packaging change away from vanishing silently. (dbus-daemon
# is NOT needed and deliberately not listed — dbus-broker is already present.)
#
# bootc is the installer itself now: rime-install runs THIS environment's
# `bootc install to-filesystem --source-imgref …` rather than starting bootc
# inside a container of the image, which is what removed the tens of GB a
# network install used to stage (see "Where the OS comes from" in
# rime-install). skopeo stays: bootc fetches through `skopeo
# experimental-image-proxy`, and the engine's reachability check calls it. The
# things bootc reads from the machine it runs on — the SELinux policy,
# prepare-root.conf — are the IMAGE's, copied in by build-live-iso.sh, which
# also checks this bootc is not older than the image's own.
#
# tpm2-tools, because /usr/libexec/rime-luks-enroll (also copied out of the
# image by build-live-iso.sh) runs here now and calls tpm2_getcap,
# tpm2_pcrreset and tpm2_pcrextend; systemd-cryptenroll's TPM2 support needs
# the tpm2-tss libraries that come with it.
#
# policycoreutils, for setfiles. rime-install labels what it writes into the
# installed system after bootc — the timezone, the keyboard layout, the
# carried-over network connections — with `setfiles -r <deployment>` and the
# IMAGE's file_contexts, guarded by `have setfiles`. This environment never
# had setfiles, so every one of those was silently skipped and left
# unlabeled_t. MEASURED 2026-10-04 on a VM install from this ISO: 444 AVC
# denials in the first minute, Rime Shell refused /etc/localtime.
RUN dnf -y install --setopt=install_weak_deps=False \
        kernel systemd systemd-udev dracut dracut-live device-mapper \
        bootc podman skopeo tpm2-tools policycoreutils \
        ncurses util-linux coreutils bash shadow-utils \
        btrfs-progs dosfstools e2fsprogs xfsprogs gdisk parted \
        lvm2 cryptsetup mdadm \
        NetworkManager NetworkManager-wifi wpa_supplicant wireless-regdb iw \
        iproute iputils \
        plymouth kbd \
        cage gtk4 libadwaita python3-gobject gobject-introspection \
        seatd xorg-x11-server-Xwayland xkeyboard-config libinput \
        mesa-dri-drivers mesa-vulkan-drivers \
        adwaita-icon-theme jetbrains-mono-fonts google-noto-sans-fonts \
        abattis-cantarell-fonts \
        grub2-tools-extra grub2-efi-x64-modules grub2-pc-modules \
        shim-x64 grub2-efi-x64 mokutil efibootmgr xorriso \
    && dnf clean all

# The installer TUI.
# The install ENGINE (also the text-mode UI), the graphical front end, and the
# launcher that picks between them. One engine, two front ends: rime-installer-gui
# collects answers and drives `rime-install --headless`, so every disk guard and
# safety check lives in exactly one place.
COPY rime-install         /usr/bin/rime-install
COPY rime-installer-gui   /usr/bin/rime-installer-gui
COPY rime-installer-launch /usr/bin/rime-installer-launch
# The session script owns the cage loop so the keyboard page can restart the
# compositor (a wlroots keymap is compiled once, at startup, from
# XKB_DEFAULT_LAYOUT). rime-installer-launch EXECS this path, so an image
# missing it has no installer at all.
COPY rime-installer-session /usr/bin/rime-installer-session
RUN chmod 0755 /usr/bin/rime-install /usr/bin/rime-installer-gui \
                /usr/bin/rime-installer-launch \
                /usr/bin/rime-installer-session

# ── Build-time assertions: the GUI stack must provably work ──────────────────
# Every previous instance of this class of bug shipped SILENTLY: the missing
# firmware black-screened an Acer, the missing cairo typelib killed every
# `import gi`, the missing seat backend left cage unable to become DRM master —
# and in each case the build succeeded and the failure only surfaced on real
# hardware. A build that cannot prove the GUI can import its toolkit, find its
# compositor, resolve its libraries, and parse its own code must not produce
# an ISO. Each check echoes its evidence so the build log shows what passed.
RUN set -eu; \
    python3 -c 'import gi; gi.require_version("Gtk","4.0"); gi.require_version("Adw","1"); from gi.repository import Gtk, Adw, Gdk, GLib, Gio, Pango' \
        || { echo "FATAL: GTK4/libadwaita GI import failed — the GUI cannot start (weak-deps casualty again?)"; exit 1; }; \
    echo "OK: python3 imports Gtk 4.0, Adw 1, Gdk, GLib, Gio, Pango via gi"; \
    [ -f /usr/lib64/girepository-1.0/cairo-1.0.typelib ] \
        || { echo "FATAL: cairo-1.0.typelib missing — gobject-introspection got dropped again"; exit 1; }; \
    echo "OK: /usr/lib64/girepository-1.0/cairo-1.0.typelib present"; \
    command -v cage >/dev/null \
        || { echo "FATAL: cage not installed — no compositor, no GUI"; exit 1; }; \
    echo "OK: cage at $(command -v cage)"; \
    command -v seatd >/dev/null \
        || { echo "FATAL: seatd not installed — cage cannot acquire a seat on tty1"; exit 1; }; \
    echo "OK: seatd at $(command -v seatd)"; \
    command -v Xwayland >/dev/null \
        || { echo "FATAL: Xwayland not installed — cage cannot create its XWayland server"; exit 1; }; \
    echo "OK: Xwayland at $(command -v Xwayland)"; \
    if ldd /usr/bin/cage | grep 'not found'; then \
        echo "FATAL: cage has unresolved shared libraries (above)"; exit 1; fi; \
    echo "OK: every shared library cage links against resolves"; \
    python3 -m py_compile /usr/bin/rime-installer-gui \
        || { echo "FATAL: rime-installer-gui has a Python syntax error"; exit 1; }; \
    rm -rf /usr/bin/__pycache__; \
    echo "OK: rime-installer-gui compiles"; \
    bash -n /usr/bin/rime-install \
        || { echo "FATAL: rime-install has a bash syntax error"; exit 1; }; \
    echo "OK: rime-install parses"; \
    command -v bootc >/dev/null \
        || { echo "FATAL: bootc is missing — rime-install installs with this environment's own bootc"; exit 1; }; \
    command -v setfiles >/dev/null \
        || { echo "FATAL: setfiles is missing — the files rime-install writes after bootc would ship unlabeled"; exit 1; }; \
    echo "OK: bootc and setfiles present"; \
    bash -n /usr/bin/rime-installer-launch \
        || { echo "FATAL: rime-installer-launch has a bash syntax error"; exit 1; }; \
    echo "OK: rime-installer-launch parses"; \
    bash -n /usr/bin/rime-installer-session \
        || { echo "FATAL: rime-installer-session has a bash syntax error"; exit 1; }; \
    echo "OK: rime-installer-session parses"; \
    _t=$(grep -oE '^GUI_CMD=\(([^ )]+)' /usr/bin/rime-installer-launch | cut -d'(' -f2); \
    [ -x "$_t" ] \
        || { echo "FATAL: rime-installer-launch execs '$_t', which is not an executable in this image"; exit 1; }; \
    echo "OK: rime-installer-launch's exec target $_t is present and executable"; \
    [ -r /usr/share/X11/xkb/rules/base.lst ] \
        || { echo "FATAL: xkb base.lst missing — the keyboard page would list no layouts"; exit 1; }; \
    echo "OK: xkb layout database present"; \
    [ -f /usr/lib/systemd/system/seatd.service ] \
        || { echo "FATAL: seatd.service unit file missing"; exit 1; }; \
    echo "OK: seatd.service unit present"

# Unattended-install marker. rime-install only honours `rime.unattended` when
# this file exists — baked ONLY for test/CI builds (ALLOW_UNATTENDED=1). The
# PRODUCTION build (default 0) omits it, so the flashed USB has no unattended
# path at all. build-live-iso.sh also drops the unattended boot-menu entry in
# production.
ARG ALLOW_UNATTENDED=0
RUN if [ "$ALLOW_UNATTENDED" = 1 ]; then \
        install -Dm644 /dev/null /usr/share/rime-installer/allow-unattended; \
        echo "installer image: UNATTENDED TEST MODE ENABLED"; \
    else echo "installer image: production build (no unattended)"; fi

# Auto-launch the installer on tty1; boot to multi-user (the GUI is not a
# graphical.target session — cage is started directly by the installer unit).
# seatd is enabled so the seat daemon is up BEFORE the installer starts: the
# installer's tty1 has no logind session and Fedora 43's libseat has no builtin
# backend (see the package-list comment), so a running seatd is the only way
# cage can acquire a seat and become DRM master.
#
# NetworkManager-wait-online is masked. NetworkManager itself stays (the Wi-Fi
# page and the carry-the-network-over step need it), but waiting for a route is
# pointless in an installer that works fully offline, and it blocks the boot
# transaction for up to 90s on any machine with an unplugged Ethernet port.
# rime-installer.service is Type=idle, so systemd caps that delay at 5s rather
# than 90 — but 5 extra seconds of blank console before the GUI paints is still
# 5 seconds in which a user with no feedback concludes the installer has hung.
# Observed in the QEMU boot test: "Starting NetworkManager Wait Online" sat on
# the console with nothing after it.
COPY rime-installer.service /usr/lib/systemd/system/rime-installer.service
RUN systemctl set-default multi-user.target \
    && systemctl enable rime-installer.service \
    && systemctl enable NetworkManager.service \
    && systemctl enable seatd.service \
    && systemctl mask getty@tty1.service \
    && systemctl mask serial-getty@ttyS0.service \
    && systemctl mask NetworkManager-wait-online.service

# Live-env-only root login (tty2 / serial) for rescue & debugging. This is the
# throwaway live session, not the installed system.
RUN echo 'root:rime' | chpasswd

# A friendly hostname in the live env.
RUN echo rime-installer > /etc/hostname
