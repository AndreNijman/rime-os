            r.set_margin_top(SP * 3); r.set_margin_bottom(SP * 3)
            r.set_margin_start(SP * 4); r.set_margin_end(SP * 4)
            top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=SP * 3)
            top.append(lbl(d["dev"], "apex-mono apex-accent", wrap=False))
            top.append(lbl(d["size"], "apex-mono", wrap=False))
            m = lbl(d["model"], "apex-dim", wrap=False)
            m.set_hexpand(True); m.set_xalign(1.0)
            top.append(m)
            r.append(top)
            bits = []
            if d["tran"]:
                bits.append(d["tran"])
            if d["removable"]:
                bits.append("removable")
            if d["serial"]:
                bits.append(f"sn {d['serial']}")
            bits.append(f"{d['nparts']} partition(s)" if d["nparts"] else "empty")
            if d["labels"]:
                bits.append(", ".join(d["labels"]))
            r.append(lbl("   ".join(bits), "apex-dim apex-mono", wrap=False))
            self.disk_list.append(r)
        self.disk_list.select_row(self.disk_list.get_row_at_index(0))
        sc = Gtk.ScrolledWindow(vexpand=True)
        sc.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        sc.set_child(self.disk_list)
        body.append(sc)
        body.append(lbl("The disk you booted from is not listed.", "apex-dim"))

        def nxt(_b):
            row = self.disk_list.get_selected_row()
            if row is None:
                return
            self.disk = self._disks[row.get_index()]["dev"]
            self.go("mode")

        return self.frame("STEP 4 OF 7", "Select a disk",
                          "Where should APEX-OS go?", body,
                          [(self.btn("Back", "apex-ghost", lambda *_: self.go("wifi")), False),
                           (self.btn("Continue", "apex-go", nxt), True)])

    # ── 4. whole disk or one partition ───────────────────────────────────────
    def p_mode(self):
        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=SP * 3)
        parts = list_partitions(self.disk)

        def choose(mode):
            def _cb(_b):
                self.answers["mode"] = mode
                self.go("part" if mode == "partition" else "account")
            return _cb

        for mode, title, desc, danger in (
            ("disk", "Use the entire disk",
             f"Erases every partition on {self.disk}. Simplest option on a machine "
             f"you are dedicating to APEX-OS.", True),
            ("partition", "Install into one partition",
             "Keeps the other partitions and installs alongside your existing OS "
             "(dual-boot). You choose which partition on the next screen.", False),
        ):
            b = Gtk.Button()
            b.add_css_class("apex-row")
            inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=SP)
            t = lbl(title, "apex-danger" if danger else "apex-accent")
            inner.append(t)
            inner.append(lbl(desc, "apex-dim"))
            b.set_child(inner)
            b.connect("clicked", choose(mode))
            body.append(b)

        if parts:
            body.append(lbl(f"{self.disk} currently holds {len(parts)} partition(s).",
                            "apex-dim apex-mono"))
        else:
            body.append(lbl(f"{self.disk} has no partitions — it looks empty.",
                            "apex-dim apex-mono"))

        return self.frame("STEP 5 OF 7", "How should this disk be used?",
                          self.disk, body,
                          [(self.btn("Back", "apex-ghost", lambda *_: self.go("disk")), False)])

    # ── 4b. pick the partition ───────────────────────────────────────────────
    def p_part(self):
        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=SP * 3)
        parts = list_partitions(self.disk)
        self.esp = find_esp(self.disk)
        self._parts = [p for p in parts if p["dev"] != self.esp]

        if not self.esp:
            w = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            w.add_css_class("apex-warn")
            i = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=SP * 2)
            i.set_margin_top(SP * 5); i.set_margin_bottom(SP * 5)
            i.set_margin_start(SP * 5); i.set_margin_end(SP * 5)
            i.append(lbl("No EFI System Partition found on this disk.", "apex-danger"))
            i.append(lbl("Dual-boot needs an existing ESP to add a boot entry to. "
                         "Use the whole disk instead, or create an ESP first.",
                         "apex-dim"))
            w.append(i)
            body.append(w)
            return self.frame("STEP 5 OF 7", "Choose a partition", self.disk, body,
                              [(self.btn("Back", "apex-ghost", lambda *_: self.go("mode")), False)])

        if not self._parts:
            w = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            w.add_css_class("apex-warn")
            i = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=SP * 2)
            i.set_margin_top(SP * 5); i.set_margin_bottom(SP * 5)
            i.set_margin_start(SP * 5); i.set_margin_end(SP * 5)
            i.append(lbl("No partition to install into.", "apex-danger"))
            i.append(lbl(f"The only partition on this disk is the EFI System "
                         f"Partition ({self.esp}), which is shared and never "
                         f"formatted. Go back and use the whole disk, or create "
                         f"a partition with another tool first.", "apex-dim"))
            w.append(i)
            body.append(w)
            return self.frame("STEP 5 OF 7", "Choose a partition", self.disk, body,
                              [(self.btn("Back", "apex-ghost", lambda *_: self.go("mode")), False)])

        self.part_list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.SINGLE)
        self.part_list.add_css_class("apex-card")
        for p in self._parts:
            r = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=SP * 3)
            r.set_margin_top(SP * 3); r.set_margin_bottom(SP * 3)
            r.set_margin_start(SP * 4); r.set_margin_end(SP * 4)
            blocked = p["fstype"] in CONTAINER_FS
            r.append(lbl(p["dev"], "apex-mono" + ("" if blocked else " apex-accent"), wrap=False))
            r.append(lbl(p["size"], "apex-mono", wrap=False))
            desc = p["fstype"] or "unformatted"
            if p["label"]:
                desc += f"  {p['label']}"
            if blocked:
                desc += "   — cannot be used (container member)"
            d = lbl(desc, "apex-danger" if blocked else "apex-dim", wrap=False)
            d.set_hexpand(True); d.set_xalign(1.0)
            r.append(d)
            self.part_list.append(r)
        sc = Gtk.ScrolledWindow(vexpand=True)
        sc.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        sc.set_child(self.part_list)
        body.append(sc)
        body.append(lbl(f"EFI System Partition: {self.esp} — shared, not erased.",
                        "apex-dim apex-mono"))
        self.part_err = lbl("", "apex-danger")
        body.append(self.part_err)

        def nxt(_b):
            row = self.part_list.get_selected_row()
            if row is None:
                self.part_err.set_text("Select a partition to install into.")
                return
            p = self._parts[row.get_index()]
            if p["fstype"] in CONTAINER_FS:
                self.part_err.set_text(
                    f"{p['dev']} is a {p['fstype']} member. Formatting it would "
                    f"destroy everything inside it. Pick another partition.")
                return
            self.target = p["dev"]
            self.go("account")

        return self.frame("STEP 5 OF 7", "Choose a partition",
                          f"This partition will be erased. Everything else on "
                          f"{self.disk} is kept.", body,
                          [(self.btn("Back", "apex-ghost", lambda *_: self.go("mode")), False),
                           (self.btn("Continue", "apex-go", nxt), True)])

    # ── 5. account ───────────────────────────────────────────────────────────
    def p_account(self):
        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=SP * 3)
        grid = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=SP * 3)

        self.e_user = Gtk.Entry(text=self.answers.get("username", "andre"))
        self.e_host = Gtk.Entry(text=self.answers.get("hostname", "apex"))
        self.e_pw1 = Gtk.PasswordEntry(show_peek_icon=True)
        self.e_pw2 = Gtk.PasswordEntry(show_peek_icon=True)
        self.e_pw1.set_property("placeholder-text", "Password")
        self.e_pw2.set_property("placeholder-text", "Repeat password")

        for caption, widget in (("Username", self.e_user),
                                ("Password", self.e_pw1),
                                ("Repeat password", self.e_pw2),
                                ("Computer name", self.e_host)):
            grid.append(lbl(caption, "apex-dim"))
            # The caption is what a sighted user reads; these two lines are what
            # everyone else gets. Both derive from the same string, so they
            # cannot drift apart.
            a11y(widget, caption)
            grid.append(widget)
        body.append(grid)
        self.acct_err = lbl("", "apex-danger")
        body.append(self.acct_err)
        body.append(lbl("This account is created during installation and is an "
                        "administrator. There is no locked-out first boot.",
                        "apex-dim"))

        RESERVED = {"root", "bin", "daemon", "adm", "nobody", "greetd"}

        def nxt(_b):
            u = self.e_user.get_text().strip()
            h = self.e_host.get_text().strip()
            p1, p2 = self.e_pw1.get_text(), self.e_pw2.get_text()
            if not re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", u):
                self.acct_err.set_text(
                    "Username must be lowercase letters, digits, - or _, start with "
                    "a letter or _, and be at most 32 characters.")
                return
            if u in RESERVED or u.startswith("systemd-"):
                self.acct_err.set_text(f"'{u}' is a reserved system account.")
                return
            if not p1:
                self.acct_err.set_text("Password cannot be empty.")
                return
            if p1 != p2:
                self.acct_err.set_text("The two passwords do not match.")
                return
            if not re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9-]{0,62}", h):
                self.acct_err.set_text(
                    "Computer name must be letters, digits and hyphens only.")
                return
            self.answers.update(username=u, hostname=h, password=p1)
            # Encryption is offered only in whole-disk mode, and the engine
            # refuses the combination outright rather than inventing a place to
            # put an unencrypted /boot inside somebody else's partition. Saying
            # "no" here rather than leaving the key at its default is what stops
            # the user meeting that refusal after the confirm page.
            if self.answers["mode"] == "disk":
                self.go("encrypt")
            else:
                self.answers["encrypt"] = "no"
                self.go("secureboot" if self.sb_offer() else "confirm")

        back = "part" if self.answers["mode"] == "partition" else "mode"
        return self.frame("STEP 6 OF 7", "Create your account", None,
                          self.scrolled(body),
                          [(self.btn("Back", "apex-ghost", lambda *_: self.go(back)), False),
                           (self.btn("Continue", "apex-go", nxt), True)])

    # ── 5a. disk encryption — on by default, and refusable ───────────────────
    def p_encrypt(self):
        """The one page that decides whether this machine can be stolen.

        Two things on it are not decoration and must not be "simplified" away:

        * The passphrase field can SHOW ITS CHARACTERS (show_peek_icon). The
          passphrase is typed again at a boot prompt that has one keyboard
          layout, no input method and no way back. Letting the user see what
          their keyboard actually produced, here, while a mistake still costs
          nothing, is the cheapest anti-lockout measure that exists.
        * The layout they chose is named on the page. `y`/`z` swap between US
          and German keyboards, and a passphrase is exactly the place where
          that matters and is invisible.

        Declining is a first-class answer. An encrypted machine the owner
        cannot open is worse than an unencrypted one, so "No" is a plain button
        and not a hidden link.
        """
        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=SP * 3)

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        card.add_css_class("apex-card")
        i = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=SP * 2)
        i.set_margin_top(SP * 4); i.set_margin_bottom(SP * 4)
        i.set_margin_start(SP * 4); i.set_margin_end(SP * 4)
        i.append(lbl("Everything on this disk is encrypted. Someone who takes the "
                     "laptop, or the drive out of it, cannot read a thing without "
                     "the passphrase.", "apex-dim"))
        i.append(lbl("You will type this passphrase every time the machine starts, "
                     "before anything else appears. It is NOT your login password.",
                     "apex-dim"))
        i.append(lbl("A recovery key is also made for you, and shown on the last "
                     "screen. It opens the disk when the passphrase will not — "
                     "including when the keyboard is typing the wrong characters. "
                     "Write it down somewhere that is not this laptop.", "apex-dim"))
        card.append(i)
        body.append(card)

        self.cb_encrypt = Gtk.CheckButton(
            label="Encrypt this disk  (recommended)")
        self.cb_encrypt.set_active(self.answers.get("encrypt", "yes") == "yes")
        a11y(self.cb_encrypt, "Encrypt this disk",
             "When on, the whole disk is encrypted and a passphrase is required "
             "at every start.")
        body.append(self.cb_encrypt)

        self.e_luks1 = Gtk.PasswordEntry(show_peek_icon=True)
        self.e_luks2 = Gtk.PasswordEntry(show_peek_icon=True)
        self.e_luks1.set_property("placeholder-text", "Disk passphrase")
        self.e_luks2.set_property("placeholder-text", "Repeat passphrase")
        a11y(self.e_luks1, "Disk passphrase",
             "Typed at every start, before the system loads. At least 8 "
             "characters, ordinary letters, digits and punctuation only.")
        a11y(self.e_luks2, "Repeat the disk passphrase")
        body.append(self.e_luks1)
        body.append(self.e_luks2)

        layout = self.answers.get("keymap") or active_layout()[0] or "us"
        variant = self.answers.get("keyvariant") or ""
        body.append(lbl(f"Keyboard in use: {layout}{('  ' + variant) if variant else ''}"
                        "   ·   use the eye icon to check what you actually typed",
                        "apex-mono apex-dim"))

        self.luks_err = lbl("", "apex-danger")
        body.append(self.luks_err)

        def toggled(_c):
            on = self.cb_encrypt.get_active()
            self.e_luks1.set_sensitive(on)
            self.e_luks2.set_sensitive(on)
            if not on:
                self.luks_err.set_text("")
        self.cb_encrypt.connect("toggled", toggled)
        toggled(None)

        def nxt(_b):
            nxt_page = "secureboot" if self.sb_offer() else "confirm"
            if not self.cb_encrypt.get_active():
                self.answers["encrypt"] = "no"
                self.answers.pop("lukspass", None)
                self.go(nxt_page)
                return
            p1, p2 = self.e_luks1.get_text(), self.e_luks2.get_text()
            if not p1:
                self.luks_err.set_text("Choose a passphrase, or turn encryption off.")
                return
            if len(p1) < 8:
                self.luks_err.set_text("The disk passphrase must be at least 8 characters.")
                return
            # The engine refuses non-ASCII for a reason it explains at length;
            # refusing it HERE means the user finds out while they can still
            # change it, instead of after the confirm page.
            if any(ord(c) < 0x20 or ord(c) > 0x7e for c in p1):
                self.luks_err.set_text(
                    "The screen that asks for this passphrase runs before the system "
                    "starts: it has no accents, no emoji and no input method. Please "
                    "use ordinary letters, digits and punctuation. (Your login "
                    "password is not restricted this way.)")
                return
            if p1 != p2:
                self.luks_err.set_text("The two passphrases do not match.")
                return
            # Ask the engine, right now, whether the layout in use can even
            # TYPE this passphrase at the unlock prompt — the same check the
            # real install runs during validation, asked for directly instead
            # of finding out on the PROGRESS page, after the confirm step,
            # when changing course means starting this page over. See
            # apex-install's own --check-passphrase and its header comment:
            # one line on stdout, always exit 0 — this is advice for a form
            # field, never a gate, so a check that could not run (missing
            # engine, timeout, unexpected output) must fail OPEN and let the
            # install proceed rather than block it over a check that did not
            # complete.
            #
            # Memoised on (layout, variant, passphrase): once shown for this
            # exact combination, a second Continue click proceeds — the
            # recovery key exists and the install is not unsafe, only
            # inconvenient at one screen, so this is a warning to act on, not
            # an error blocking every click the way the four checks above it
            # are.
            key = (layout, variant, p1)
            if key != self._luks_typeable_warned_for:
                try:
                    r = subprocess.run(
                        [ENGINE, "--check-passphrase", layout, variant],
                        input=p1, capture_output=True, text=True, timeout=5)
                    out = r.stdout.strip()
                except (subprocess.SubprocessError, OSError, ValueError):
                    out = ""
                if out.startswith("typeable: no "):
                    chars = ""
                    for tok in out.split():
                        if tok.startswith("chars="):
                            chars = tok[len("chars="):]
                    self._luks_typeable_warned_for = key
                    self.luks_err.set_text(
                        f"Your keyboard layout ({layout}) has no key for: {chars} "
                        "— at the disk-unlock screen only, before anything else "
                        "has loaded. That ONE prompt will use the US layout "
                        "instead, so every character you just typed has a key "
                        "there; your login screen and desktop keep your own "
                        "layout. Click Continue again to proceed, or change the "
                        "passphrase.")
                    return
            self.answers["encrypt"] = "yes"
            self.answers["lukspass"] = p1
            self.go(nxt_page)

        return self.frame("STEP 6 OF 7", "Encrypt this disk",
                          "On by default. You can turn it off — but a stolen "
                          "laptop with an unencrypted disk is an open book.",
                          self.scrolled(body),
                          [(self.btn("Back", "apex-ghost", lambda *_: self.go("account")), False),
                           (self.btn("Continue", "apex-go", nxt), True)])

    # ── 5b. secure boot — shown only when the firmware has it enabled ────────
    def sb_enabled(self):
        """True when the firmware reports Secure Boot enabled RIGHT NOW.

        Only used to choose the wording on the Secure Boot page, never to decide
        whether to show it — see sb_offer()."""
        if not hasattr(self, "_sb_state"):
            rc, txt = run(["mokutil", "--sb-state"], timeout=10)
            self._sb_state = "enabled" in txt.lower()
        return self._sb_state

    def sb_offer(self):
        """True when this install should offer to enrol the APEX key.

        Deliberately NOT gated on Secure Boot being on already. It used to be,
        and that was wrong: with Secure Boot off — the state most machines ship
        in, and the state of both machines this was developed on — the page
        never appeared, so nothing was enrolled, so turning Secure Boot on later
        meant installing, booting, running mokutil by hand and rebooting again.
        That is a ridiculous amount of ceremony to impose on someone who just
        wanted the option later.

        Enrolling from here works because `mokutil --import` writes MokNew and
        MokAuth to UEFI NVRAM. That is firmware state, not filesystem state: it
        belongs to the machine, not to the OS on the disk, and it survives the
        install. shim picks it up on the next boot and runs MokManager. The
        request also persists until it is processed, so queueing it while
        Secure Boot is off is safe — if the firmware does not present
        MokManager until Secure Boot is switched on, the pending request is
        still there waiting when it is.

        Three things must hold:
          * we booted UEFI — no efivars means no Secure Boot and no NVRAM to
            write to (a legacy-BIOS boot lands here);
          * mokutil exists;
          * the image actually ships a kernel signed with the APEX key, which
            build-live-iso.sh stamps into the live environment because the
            marker inside the image cannot be read before it is installed.
        """
        if not hasattr(self, "_sb_offer"):
            ok = os.path.isdir("/sys/firmware/efi/efivars")
            if ok:
                rc, _ = run(["mokutil", "--sb-state"], timeout=10)
                ok = rc == 0
            if ok:
                # Offer unless we KNOW the kernel is unsigned.
                #
                # "signed"   — fat ISO, the embedded image is signed. Offer.
                # "unknown"  — netinstall: the kernel belongs to whatever the
                #              registry serves, which is not knowable here. Offer
                #              anyway. Refusing would mean Secure Boot silently
                #              never works for anyone who installs over the
                #              network, which is most people, and a build-time
                #              guess would go stale the moment CI republishes.
                #              The engine re-checks the DEPLOYED image and skips
                #              enrolment with an explanation if it turns out
                #              unsigned, so the worst case is a password that
                #              goes unused and a clear message saying so.
                # "unsigned" — definitively no. Do not ask for a password that
                #              cannot possibly be used.
                try:
                    with open("/usr/lib/apex-installer/kernel-signed") as f:
                        self._sb_state_stamp = f.read().strip()
                except OSError:
                    self._sb_state_stamp = "unknown"
                ok = self._sb_state_stamp != "unsigned"
            self._sb_offer = ok
        return self._sb_offer

    def p_secureboot(self):
        # Shown whenever the image ships an APEX-signed kernel and we booted
        # UEFI — NOT only when Secure Boot is already on. See sb_offer() for
        # why. The two situations need different words, though: with Secure
        # Boot ON this is mandatory (skip it and the machine will not boot),
        # and with it OFF this is an offer (do it now so switching Secure Boot
        # on later is a firmware toggle instead of a second install-and-reboot
        # dance). Saying "Secure Boot is enabled on this machine" to someone
        # whose firmware has it off would be a plain lie, and this installer
        # does not get to lie on the page immediately before it erases a disk.
        on = self.sb_enabled()
        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=SP * 3)

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        card.add_css_class("apex-card")
        i = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=SP * 2)
        i.set_margin_top(SP * 5); i.set_margin_bottom(SP * 5)
        i.set_margin_start(SP * 5); i.set_margin_end(SP * 5)
        i.append(lbl("Secure Boot is ON in this machine's firmware." if on
                     else "Secure Boot is currently OFF in this machine's firmware.",
                     "apex-mono"))
        if on:
            i.append(lbl("APEX-OS ships its own kernel. Microsoft does not sign it — "
                         "it is signed with the APEX key. Until your firmware is told "
                         "to trust that key, it will refuse to boot the installed "
                         "system.", "apex-dim"))
        else:
            i.append(lbl("APEX-OS installs and boots fine as things stand — you do "
                         "not have to do anything here. But APEX ships its own "
                         "kernel, which Microsoft does not sign, so if you ever turn "
                         "Secure Boot on it will refuse to boot unless its key was "
                         "enrolled first. Enrolling now costs one password and takes "
                         "effect on the next boot; doing it later means booting the "
                         "installed system, running mokutil by hand and rebooting "
                         "again.", "apex-dim"))
        i.append(lbl("Enrolling the key happens once. Choose a password now. On "
                     "the next boot a blue \"MOK management\" screen appears — "
                     "choose \"Enroll MOK\" and type this password. That screen "
                     "is the firmware checking a person is physically present. "
                     "After that the password is never needed again.", "apex-dim"))
        if getattr(self, "_sb_state_stamp", "") == "unknown":
            i.append(lbl("This installer downloads APEX-OS, so whether the kernel "
                         "it fetches carries the APEX signature is confirmed during "
                         "the install. If it turns out unsigned, this step is "
                         "skipped and you will be told — nothing breaks either way.",
                         "apex-dim"))
        card.append(i)
        body.append(card)

        # Placeholder-only entries (the wifi page's pattern) — with the
        # explanation card above, captioned rows push the action row off a
        # 720-pixel-tall screen.
        self.e_mok1 = Gtk.PasswordEntry(show_peek_icon=True)
        self.e_mok2 = Gtk.PasswordEntry(show_peek_icon=True)
        self.e_mok1.set_property("placeholder-text", "One-time enrolment password")
        self.e_mok2.set_property("placeholder-text", "Repeat password")
        # These two have no visible caption at all -- the page is too short for
        # captioned rows -- so the accessible name is the ONLY label they have.
        a11y(self.e_mok1, "One-time enrolment password",
             "Used once at the next boot to enrol the Secure Boot key.")
        a11y(self.e_mok2, "Repeat the enrolment password")
        body.append(self.e_mok1)
        body.append(self.e_mok2)
        self.mok_err = lbl("", "apex-danger")
        body.append(self.mok_err)
        body.append(lbl(
            "If you skip, the installed system will not boot until you turn "
            "Secure Boot off in firmware setup." if on else
            "If you skip, nothing changes — the system installs and boots "
            "normally. You would only need this if you later switch Secure "
            "Boot on.", "apex-dim"))

        def nxt(_b):
            p1, p2 = self.e_mok1.get_text(), self.e_mok2.get_text()
            if not p1:
                self.mok_err.set_text(
                    "Choose a password, or skip if you will turn Secure Boot "
                    "off instead.")
                return
            if not 8 <= len(p1) <= 256:
                self.mok_err.set_text(
                    "The enrolment password must be 8 to 256 characters — the "
                    "firmware tooling rejects anything else.")
                return
            if p1 != p2:
                self.mok_err.set_text("The two passwords do not match.")
                return
            self.answers["mokpw"] = p1
            self.go("confirm")

        def skip(_b):
            self.answers["mokpw"] = ""
            self.go("confirm")

        # Subtitle and skip label BOTH have to follow the firmware state. With
        # Secure Boot off, "this machine will not boot APEX-OS" is simply untrue,
        # and offering to "turn Secure Boot off instead" offers to turn off
        # something already off. Small strings, but this is the screen before the
        # one that erases a disk and it does not get to say false things.
        sub = ("This machine will not boot APEX-OS until the APEX signing key "
               "is enrolled." if on else
               "Optional. Enrol now and you can switch Secure Boot on later "
               "without reinstalling.")
        skip_label = ("Skip — I'll turn Secure Boot off instead" if on
                      else "Skip — I don't use Secure Boot")
        sb_back = "encrypt" if self.answers["mode"] == "disk" else "account"
        return self.frame("STEP 6 OF 7", "Secure Boot", sub, self.scrolled(body),
                          [(self.btn("Back", "apex-ghost", lambda *_: self.go(sb_back)), False),
                           (self.btn(skip_label, "apex-ghost", skip), True),
                           (self.btn("Enrol and continue", "apex-go", nxt), False)])

    # ── 6. confirm — the screen this whole rewrite exists for ────────────────
    def p_confirm(self):
        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=SP * 3)
        mode = self.answers["mode"]
        target = self.target if mode == "partition" else self.disk

        # The warning comes FIRST and is never truncated. whiptail clipped this
        # silently once a disk had five partitions — hiding the destruction
        # notice exactly when there was most to lose.
        warn = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        warn.add_css_class("apex-warn")
        wi = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=SP * 2)
        wi.set_margin_top(SP * 4); wi.set_margin_bottom(SP * 4)
        wi.set_margin_start(SP * 4); wi.set_margin_end(SP * 4)
        if mode == "disk":
            wi.append(lbl(f"EVERYTHING ON {self.disk} WILL BE ERASED", "apex-danger"))
            wi.append(lbl("Every partition on this disk is destroyed, including any "
                          "other operating system on it. This cannot be undone.",
                          "apex-dim"))
        else:
            wi.append(lbl(f"{target} WILL BE ERASED", "apex-danger"))
            wi.append(lbl(f"Only this partition is formatted. The rest of "
                          f"{self.disk} is left alone.", "apex-dim"))
        warn.append(wi)
        body.append(warn)

        # A netinstall with no network will fail at the download step, AFTER the
        # user has typed ERASE. Say so here, while it still costs nothing.
        if netinstall():
            ok, why = online()
            if not ok:
                nb = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
                nb.add_css_class("apex-warn")
                ni = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=SP)
                ni.set_margin_top(SP * 3); ni.set_margin_bottom(SP * 3)
                ni.set_margin_start(SP * 4); ni.set_margin_end(SP * 4)
                ni.append(lbl(f"NO NETWORK — this installer downloads APEX-OS ({why}).",
                              "apex-danger"))
                ni.append(lbl("The install will stop at the download step and nothing "
                              "will be erased, but you will have to start again. Go "
                              "Back to the Network step and connect first.", "apex-dim"))
                nb.append(ni)
                body.append(nb)

        # Full inventory, scrollable — never clipped.
        inv = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=SP)
        inv.add_css_class("apex-card")
        ii = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=SP)
        ii.set_margin_top(SP * 3); ii.set_margin_bottom(SP * 3)
        ii.set_margin_start(SP * 4); ii.set_margin_end(SP * 4)
        parts = list_partitions(self.disk)
        for p in parts:
            dying = (mode == "disk") or (p["dev"] == target)
            keep_esp = (mode == "partition" and p["dev"] == self.esp)
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=SP * 3)
            if keep_esp:
                verdict, css = "SHARED", "apex-accent"
            elif dying:
                verdict, css = "ERASED", "apex-danger"
            else:
                verdict, css = "KEPT", "apex-dim"
            v = lbl(verdict, f"{css} apex-mono", wrap=False)
            v.set_size_request(80, -1)
            row.append(v)
            row.append(lbl(p["dev"], "apex-mono", wrap=False))
            row.append(lbl(p["size"], "apex-mono apex-dim", wrap=False))
            d = lbl(f"{p['fstype'] or 'unformatted'}  {p['label']}".strip(),
                    "apex-dim", wrap=False)
            d.set_hexpand(True); d.set_xalign(1.0)
            row.append(d)
            ii.append(row)
        if not parts:
            ii.append(lbl("No existing partitions — the disk is empty.", "apex-dim"))
        inv.append(ii)

        # ── What is fixed and what scrolls, and why ──────────────────────────
        # The warning above is FIXED: it is the one thing that must be on screen
        # no matter what, so it stays outside the scroller.
        #
        # Everything else — inventory, summary, the ERASE prompt — goes into ONE
        # scroller, and the inventory no longer has a scroller of its own. That
        # is the point of the change. A page's MINIMUM height is what GTK uses
        # when deciding what to squash, and this page's minimum was 611px: on a
        # 1024x600 panel GTK crushed the inventory to about two rows and the
        # ERASED row — the partition about to be destroyed — fell below the fold
        # behind a near-invisible overlay scrollbar. Exactly the sin this page
        # exists to stop whiptail committing, in a new costume.
        #
        # Two earlier attempts failed and are worth recording. Setting
        # min_content_height on the inventory made it WORSE (611 -> 693): it adds
        # to the minimum, which is the number that hurts. Detecting a short panel
        # at runtime and tightening margins did nothing either, because the
        # window is not yet at its final size when the page is measured. Neither
        # is a substitute for the page simply not DEMANDING more room than a
        # small screen has. With one scroller the minimum collapses to the fixed
        # chrome, while the natural size on a large screen is unchanged.
        rest = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=SP * 3)
        rest.append(inv)

        summary = (f"{self.answers['username']} @ {self.answers['hostname']}"
                   f"   ·   {self.ed}   ·   btrfs")
        rest.append(lbl(summary, "apex-mono apex-dim"))
        # The encryption decision belongs on the page where the disk is
        # confirmed, not only on the page where it was made. A user who ticked
        # or unticked the box four screens ago must be able to see, at the point
        # of no return, which way it went.
        if self.answers.get("encrypt") == "yes":
            rest.append(lbl("ENCRYPTED — a passphrase is required at every start, "
                            "and a recovery key is shown when the install finishes.",
                            "apex-mono apex-accent"))
        else:
            rest.append(lbl("NOT ENCRYPTED — anyone holding this disk can read it.",
                            "apex-mono apex-danger"))

        rest.append(lbl("Type ERASE to confirm:", "apex-dim"))
        self.e_erase = Gtk.Entry()
        self.e_erase.set_property("placeholder-text", "ERASE")
        # The last thing between the user and an irreversible erase. If any
        # field in this installer must be announceable, it is this one.
        a11y(self.e_erase, "Type ERASE to confirm",
             "The disk is erased only after this word is typed exactly.")
        rest.append(self.e_erase)

        sc = Gtk.ScrolledWindow(vexpand=True)
        sc.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        sc.set_propagate_natural_height(True)
        sc.set_child(rest)
        body.append(sc)

        go = self.btn("Erase and install", "apex-destroy", lambda *_: self.begin(), False)
        self.e_erase.connect("changed",
                             lambda e: go.set_sensitive(e.get_text().strip() == "ERASE"))
        self.e_erase.connect("activate",
                             lambda e: self.begin() if e.get_text().strip() == "ERASE" else None)

        if self.sb_offer():
            back = "secureboot"
        elif self.answers["mode"] == "disk":
            back = "encrypt"
        else:
            back = "account"
        return self.frame("STEP 7 OF 7", "Confirm",
                          "Nothing has been written yet. This is the last point at "
                          "which you can go back.", body,
                          [(self.btn("Back", "apex-ghost", lambda *_: self.go(back)), False),
                           (go, True)])

    # ── 7. run ───────────────────────────────────────────────────────────────
    def begin(self):
        self.go("run")

    def p_run(self):
        # A retry after failure re-enters here with the previous, dead process
        # still in self.proc — pulse() would see poll() != None and stop the
        # bar before the new engine even spawned. Reset first.
        self.proc = None
        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=SP * 3)
        self.bar = Gtk.ProgressBar(show_text=False)
        self.bar.set_pulse_step(0.06)
        body.append(self.bar)
        self.run_state = lbl("Preparing…", "apex-mono")
        body.append(self.run_state)

        self.logview = Gtk.TextView(editable=False, cursor_visible=False,
                                    monospace=True, wrap_mode=Gtk.WrapMode.WORD_CHAR)
        self.logbuf = self.logview.get_buffer()
        sc = Gtk.ScrolledWindow(vexpand=True)
        sc.add_css_class("apex-card")
        sc.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        sc.set_child(self.logview)
        self.logscroll = sc
        body.append(sc)
        body.append(lbl("Do not power off. Full log: /var/log/apex-install.log",
                        "apex-dim"))

        page = self.frame("INSTALLING", "Installing APEX-OS",
                          self.target if self.answers["mode"] == "partition" else self.disk,
                          body, [])
        GLib.idle_add(self.spawn_engine)
        GLib.timeout_add(120, self.pulse)
        return page

    def pulse(self):
        if self.stack.get_visible_child_name() != "run":
            return False  # left the run page (e.g. spawn failed) — stop the timer
        if self.proc is None or self.proc.poll() is None:
            self.bar.pulse()
            return True
        return False

    def append_log(self, text):
        end = self.logbuf.get_end_iter()
        self.logbuf.insert(end, text)
        mark = self.logbuf.create_mark(None, self.logbuf.get_end_iter(), False)
        self.logview.scroll_mark_onscreen(mark)
        self.logbuf.delete_mark(mark)

    def spawn_engine(self):
        """Hand the answers to the ONE install engine. The password goes via a
        0600 file, never argv — argv is world-readable in /proc."""
        a = dict(self.answers)
        a["disk"] = self.disk
        if a["mode"] == "partition":
            a["target"] = self.target
            a["esp"] = self.esp

        try:
            fd, path = tempfile.mkstemp(prefix="apex-answers-", dir="/run")
        except OSError as e:
            self.finish(False, f"Could not create the answers file in /run: {e}")
            return False
        self._answers_path = path  # set before writing so finish() cleans up
        try:
            os.fchmod(fd, 0o600)
            with os.fdopen(fd, "w") as f:
                # mokpw is empty (or absent) when the user skipped enrolment or
                # Secure Boot is off — the get() guard omits it and the engine
                # skips the MOK step with an explanation.
                # `encrypt` is ALWAYS written: the engine refuses an answers
                # file without it, deliberately, so that a decision can never go
                # missing between this front end and the disk. It is "yes" or
                # "no", both truthy, so the get() guard below cannot drop it.
                for k in ("mode", "disk", "target", "esp", "username", "password",
                          "hostname", "rootfs", "mokpw", "encrypt", "lukspass",
                          "keymap", "keyvariant", "timezone"):
                    if a.get(k):
                        f.write(f"{k}={a[k]}\n")
        except OSError as e:
            self.finish(False, f"Could not write the answers file: {e}")
            return False

        try:
            self.proc = subprocess.Popen(
                [ENGINE, "--headless", path],
                stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                text=True, bufsize=1)
        except OSError as e:
            self.finish(False, f"Could not start the install engine: {e}")
            return False

        GLib.io_add_watch(self.proc.stdout, GLib.IO_IN | GLib.IO_HUP, self.on_output)
        return False

    # The engine's protocol lines for the disk recovery key. They are prefixes
    # rather than a side channel because stdout is the only channel this front
    # end has, and a key that arrived by a route the front end did not know
    # about would simply be lost.
    RECOVERY_PREFIX = "APEX-INSTALL-RECOVERY-KEY: "
    RECOVERY_SAVED_PREFIX = "APEX-INSTALL-RECOVERY-SAVED: "
    RECOVERY_UNSAVED_PREFIX = "APEX-INSTALL-RECOVERY-UNSAVED: "

    def on_output(self, src, cond):
        line = src.readline()
        if line:
            s_ = line.strip()
            # Capture the key BEFORE anything is appended to the on-screen log.
            # It belongs on a page of its own where it is large, selectable and
            # acknowledged — not as one line of scrolling install chatter the
            # user watches go past.
            if s_.startswith(self.RECOVERY_PREFIX):
                self.recovery_key = s_[len(self.RECOVERY_PREFIX):]
                # Deliberately NOT `return True` here. Returning early skips the
                # HUP check below, so if this were ever the last line the engine
                # wrote, finish() would never run and the installer would sit on
                # the progress page for ever. Fall through with the raw line
                # replaced instead.
                line = ("Recovery key created — it is shown when the install "
                        "finishes.\n")
                s_ = "Recovery key created."
            elif s_.startswith(self.RECOVERY_SAVED_PREFIX):
                self.recovery_saved = s_[len(self.RECOVERY_SAVED_PREFIX):]
            elif s_.startswith(self.RECOVERY_UNSAVED_PREFIX):
                self.recovery_saved = ""
            self.append_log(line)
            s = s_
            if s and not s.startswith("+"):
                self.run_state.set_text(s[:110])
            if "APEX-INSTALL-FAILED" in s:
                self.finish(False, s.split("APEX-INSTALL-FAILED:", 1)[-1].strip())
                return False
        if cond & GLib.IO_HUP or (self.proc and self.proc.poll() is not None):
            rc = self.proc.wait() if self.proc else 1
            # Drain anything buffered after HUP so a failure reason is never lost.
            try:
                for rest in src:
                    self.append_log(rest)
            except (ValueError, OSError):
                pass
            self.finish(rc == 0, "" if rc == 0 else f"The installer exited with status {rc}.")
            return False
        return True

    def finish(self, ok, err):
        # If the engine is somehow still alive (failure banner printed but the
        # process hung), stop it — "Try again" must never race a dying engine.
        if self.proc is not None and self.proc.poll() is None:
            try:
                self.proc.terminate()
            except OSError:
                pass
        # The answers file carries the password — remove it whatever happened.
        p = getattr(self, "_answers_path", None)
        if p:
            try:
                os.unlink(p)
            except OSError:
                pass
            self._answers_path = None
        self.ok, self.err = ok, err
        self.go("done")

    def _log_tail(self, lines=40):
        """Last lines of the install log: the live buffer from the run page
        when it has content, else /var/log/apex-install.log. Never raises."""
        text = ""
        buf = getattr(self, "logbuf", None)
        if buf is not None:
            text = buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False)
        if not text.strip():
            try:
                with open("/var/log/apex-install.log", errors="replace") as f:
                    text = f.read()
            except OSError:
                return ""
        return "\n".join(text.splitlines()[-lines:])

    # ── 8. done ──────────────────────────────────────────────────────────────
    def p_done(self):
        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=SP * 3)
        ok = getattr(self, "ok", False)

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        card.add_css_class("apex-card" if ok else "apex-warn")
        i = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=SP * 2)
        i.set_margin_top(SP * 5); i.set_margin_bottom(SP * 5)
        i.set_margin_start(SP * 5); i.set_margin_end(SP * 5)

        if ok:
            i.append(lbl("APEX-OS is installed.", "apex-accent"))
            if self.answers["mode"] == "partition":
                i.append(lbl(f"Installed into {self.target}. The other partitions "
                             f"on {self.disk} were not touched.", "apex-dim"))
            else:
                i.append(lbl(f"Installed on {self.disk}.", "apex-dim"))
            i.append(lbl(f"Log in as  {self.answers['username']}   ·   "
                         f"hostname  {self.answers['hostname']}", "apex-mono"))
            try:
                n = len([f for f in os.listdir("/etc/NetworkManager/system-connections")
                         if f.endswith(".nmconnection")])
            except OSError:
                n = 0
            if n:
                i.append(lbl(f"{n} saved network(s) carried over — Wi-Fi should "
                             f"work on first boot.", "apex-dim"))
        else:
            i.append(lbl("Installation failed.", "apex-danger"))
            i.append(lbl(getattr(self, "err", "") or "See the log for details.",
                         "apex-dim", sel=True))
            i.append(lbl("Nothing further will be written. The full log is at "
                         "/var/log/apex-install.log — switch to a shell with "
                         "Ctrl+Alt+F2 (root / apex) to read it.", "apex-dim"))
        card.append(i)
        body.append(card)

        if not ok:
            # Put the evidence on screen — do not make a stranded user go
            # hunting for a shell just to learn why it failed.
            tail = self._log_tail()
            if tail:
                view = Gtk.TextView(editable=False, cursor_visible=False,
                                    monospace=True, wrap_mode=Gtk.WrapMode.WORD_CHAR)
                view.get_buffer().set_text(tail)
                sc = Gtk.ScrolledWindow(vexpand=True)
                sc.add_css_class("apex-card")
                sc.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
                sc.set_child(view)
                body.append(sc)

        # ── THE RECOVERY KEY ─────────────────────────────────────────────────
        # Shown whether the install succeeded or not. On success it is the way
        # back into the machine; on failure the disk still carries a LUKS2
        # header this key opens, and a user who wants to wipe or inspect it
        # needs the key to do so. Either way, an encrypted disk whose recovery
        # key was never shown to anybody is the stranding case this whole
        # feature exists to prevent.
        ack = None
        if getattr(self, "recovery_key", ""):
            rc_ = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            rc_.add_css_class("apex-warn")
            ri = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=SP * 2)
            ri.set_margin_top(SP * 4); ri.set_margin_bottom(SP * 4)
            ri.set_margin_start(SP * 4); ri.set_margin_end(SP * 4)
            ri.append(lbl("WRITE THIS DOWN — DISK RECOVERY KEY", "apex-danger"))
            # Selectable, because on a machine with a working session the user
            # may want to copy it, and monospace because it will be read back
            # character by character off a screen.
            ri.append(lbl(self.recovery_key, "apex-mono apex-accent", sel=True))
            ri.append(lbl("If APEX-OS ever refuses your disk passphrase — you "
                          "forgot it, the keyboard types the wrong characters, "
                          "or automatic unlocking stops working — type this at "
                          "the same prompt instead. It always works, and its "
                          "letters are in the same place on nearly every "
                          "keyboard layout.", "apex-dim"))
            if getattr(self, "recovery_saved", ""):
                ri.append(lbl(f"A copy is on the USB stick you booted from, as "
                              f"{self.recovery_saved}. That stick lives in the "
                              f"same bag as the laptop, so it protects nothing on "
                              f"its own — move the key somewhere else and delete "
                              f"that file.", "apex-dim"))
            else:
                ri.append(lbl("It could NOT be saved to the USB stick, so this "
                              "screen is the only copy. Write it down now.",
                              "apex-danger"))
            ack = Gtk.CheckButton(label="I have written down the recovery key")
            a11y(ack, "I have written down the recovery key",
                 "Rebooting is enabled once this is ticked.")
            ri.append(ack)
            rc_.append(ri)
            body.append(rc_)

        acts = []
        if ok:
            reboot_btn = self.btn("Reboot now", "apex-go",
                                  lambda *_: run(["systemctl", "reboot"], timeout=30))
            # A user who reboots past the recovery key never sees it again: the
            # installer's RAM disk goes with the reboot. So the button waits
            # for them to say they have it. "Stay in the installer" is always
            # available, so this cannot trap anyone.
            if ack is not None:
                reboot_btn.set_sensitive(False)
                ack.connect("toggled",
                            lambda c, b=reboot_btn: b.set_sensitive(c.get_active()))
            acts.append((reboot_btn, True))
            acts.insert(0, (self.btn("Stay in the installer", "apex-ghost",
                                     lambda *_: self.go("welcome")), False))
        else:
            acts.append((self.btn("Quit", "apex-ghost", lambda *_: self.quit()), False))
            acts.append((self.btn("Try again", "apex-go", lambda *_: self.go("welcome")), True))

        return self.frame("DONE" if ok else "FAILED",
                          "Installation complete" if ok else "Installation failed",
                          None, body, acts)


if __name__ == "__main__":
    app = Installer()
    rc = app.run(None)
    # A restart request travels as the EXIT STATUS, because that is the only
    # channel that survives cage: apex-installer-session reads it to decide
    # whether to relaunch the compositor with a new XKB_DEFAULT_LAYOUT. Measured
    # rather than assumed — `cage -- sh -c 'exit 75'` returns 75.
    sys.exit(app.exit_code if app.exit_code is not None else rc)
