def edition():
    try:
        with open(EDITION_FILE) as f:
            return f.read().strip() or "daily"
    except OSError:
        return "daily"


def run(cmd, timeout=15):
    """Run a command, never raise. Returns (rc, stdout)."""
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout
    except (subprocess.SubprocessError, OSError, ValueError):
        return 1, ""


# ── hardware enumeration ─────────────────────────────────────────────────────
# A front end presenting choices. The engine re-validates everything it is
# handed, including refusing the live USB via its "currently mounted" guard, so
# a bug here cannot wipe the boot stick.
def live_disks():
    """Disks backing the live session — excluded from the target list."""
    out = set()
    rc, txt = run(["lsblk", "-o", "NAME,MOUNTPOINT", "-rn"])
    for line in txt.splitlines():
        parts = line.split()
        if len(parts) < 2:
            continue
        if re.search(r"(^|/)(live|install|ISO)", parts[1]):
            rc2, parent = run(["lsblk", "-no", "PKNAME", f"/dev/{parts[0]}"])
            p = parent.strip().splitlines()
            out.add(p[0].strip() if p else parts[0])
    return out


def list_disks():
    """Eligible whole disks. One lsblk in pairs format — quote-safe with spaces
    in MODEL, which is what broke the TUI's positional parsing."""
    skip = live_disks()
    disks = []
    rc, txt = run(["lsblk", "-dn", "-P", "-e", "7,11",
                   "-o", "NAME,SIZE,TYPE,MODEL,TRAN,RM,SERIAL"])
    for line in txt.splitlines():
        d = dict(re.findall(r'(\w+)="([^"]*)"', line))
        if d.get("TYPE") != "disk":
            continue
        if d.get("SIZE") in ("0B", "0", ""):
            continue
        name = d.get("NAME")
        if not name or name in skip:
            continue
        dev = f"/dev/{name}"
        rc2, ptxt = run(["lsblk", "-rno", "TYPE,SIZE,FSTYPE,LABEL", dev])
        parts = [l for l in ptxt.splitlines() if l.split() and l.split()[0] == "part"]
        disks.append({
            "dev": dev,
            "size": d.get("SIZE", "?"),
            "model": (d.get("MODEL") or "disk").strip(),
            "tran": d.get("TRAN", ""),
            "removable": d.get("RM") == "1",
            "serial": (d.get("SERIAL") or "")[-8:],
            "nparts": len(parts),
            "labels": [x.split()[-1] for x in parts if len(x.split()) >= 4][:3],
        })
    return disks


def list_partitions(disk):
    rc, txt = run(["lsblk", "-rno", "NAME,TYPE,SIZE,FSTYPE,LABEL,PARTTYPE", disk])
    out = []
    for line in txt.splitlines():
        f = line.split()
        if len(f) < 3 or f[1] != "part":
            continue
        name, _t, size = f[0], f[1], f[2]
        fstype = f[3] if len(f) > 3 else ""
        rest = f[4:] if len(f) > 4 else []
        parttype = rest[-1] if rest and rest[-1].startswith("0x") or (rest and "-" in rest[-1]) else ""
        label = " ".join(rest[:-1]) if parttype else " ".join(rest)
        out.append({"dev": f"/dev/{name}", "size": size, "fstype": fstype,
                    "label": label, "parttype": parttype})
    return out


def find_esp(disk):
    """GPT ESP GUID or MBR 0xef only. A plain vfat partition is NOT assumed to
    be an ESP — doing that once adopted a FAT32 photo partition and truncated
    BOOTX64.EFI when it filled up."""
    GPT_ESP = "c12a7328-f81f-11d2-ba4b-00a0c93ec93b"
    for p in list_partitions(disk):
        pt = (p.get("parttype") or "").lower()
        if pt == GPT_ESP or pt == "0xef":
            return p["dev"]
    return ""


