def lbl(text, css=None, xalign=0.0, wrap=True, sel=False, pres=False):
    """A label. `pres=True` keeps it OUT of the accessibility tree.

    For text that is a picture: the Wi-Fi signal bars are drawn out of block
    characters, and a screen reader spells them out one glyph at a time in front
    of the network's name. The role is set at CONSTRUCTION rather than with
    set_property afterwards -- `accessible-role` is settable at runtime on GTK
    4.20 but has not always been, and a call that quietly does nothing on an
    older toolkit is the failure mode this file's a11y() docstring warns about.
    """
    if pres:
        w = Gtk.Label(label=text, xalign=xalign, wrap=wrap, selectable=sel,
                      accessible_role=Gtk.AccessibleRole.PRESENTATION)
    else:
        w = Gtk.Label(label=text, xalign=xalign, wrap=wrap, selectable=sel)
    w.set_wrap_mode(Pango.WrapMode.WORD_CHAR)
    if css:
        for c in css.split():
            w.add_css_class(c)
    return w


def a11y(widget, label, description=None):
    """Give a control the name a screen reader will announce.

    Every text field on every page of this installer carries a
    `placeholder-text`, and until this function existed that was the ONLY label
    several of them had. A placeholder is painted inside the box and vanishes as
    soon as the user types; GTK does not map it to the accessible name, so it is
    read by nobody.

    Measured page by page on the shipped GUI before this was added: TEN
    focusable `text box` nodes on the accessibility bus with an empty name AND
    an empty description -- the keyboard test field (1), the Wi-Fi password and
    the hidden-network name (2), all four account fields including both
    passwords (4), both Secure Boot enrolment passwords (2), and the "type
    ERASE to confirm" field (1). A blind user tabbing through the account page
    was told only "text box", four times in a row.

    The captions beside the account fields are real Gtk.Labels, but a label that
    merely sits next to a widget is not attached to it. The name is therefore
    set explicitly, from the same string the caption uses, so the two cannot
    drift apart.

    An AT-SPI LABELLED_BY relation was tried as well and removed again:
    PyGObject's update_relation() rejects the list-of-accessible shape and emits
    a GLib warning instead of raising, so the guarding try/except never fired and
    the call did nothing but print. A call that only produces a warning is worse
    than no call -- it reads like the problem is handled.

    Never allowed to be silently skipped: a caller that passes an empty label is
    a bug in this file, not a widget that happens to have no name.
    """
    if not label:
        raise ValueError("a11y() needs a non-empty label")
    props = [Gtk.AccessibleProperty.LABEL]
    vals = [label]
    if description:
        props.append(Gtk.AccessibleProperty.DESCRIPTION)
        vals.append(description)
    widget.update_property(props, vals)
    return widget



def xkb_layouts():
    """Every layout xkb knows, as (code, human description), sorted by description.

    Parsed out of xkeyboard-config's own base.lst rather than hardcoded, using
    the same awk-shaped rule apex-shell-firstrun and the engine already use: the
    `! layout` section runs until the next `!` heading, and each line is a code
    then a description. xkeyboard-config is installed explicitly by
    Containerfile.installer, so its absence is a build defect — but a missing
    file must not leave the user with NO keyboard page, so we degrade to a short
    built-in list instead of showing an empty one.
    """
    out = []
    try:
        with open(XKB_RULES, encoding="utf-8", errors="replace") as f:
            in_section = False
            for line in f:
                if line.startswith("! layout"):
                    in_section = True
                    continue
                if line.startswith("!"):
                    in_section = False
                    continue
                if not in_section:
                    continue
                parts = line.split(None, 1)
                if len(parts) == 2 and re.fullmatch(r"[a-z][a-z0-9_-]{0,31}", parts[0]):
                    out.append((parts[0], parts[1].strip()))
    except OSError:
        pass
    if not out:
        out = [("us", "English (US)"), ("gb", "English (UK)"), ("de", "German"),
               ("fr", "French"), ("es", "Spanish"), ("it", "Italian"),
               ("se", "Swedish"), ("no", "Norwegian"), ("dk", "Danish"),
               ("fi", "Finnish"), ("pt", "Portuguese"), ("br", "Portuguese (Brazil)"),
               ("ru", "Russian"), ("ua", "Ukrainian"), ("pl", "Polish"),
               ("cz", "Czech"), ("hu", "Hungarian"), ("tr", "Turkish"),
               ("gr", "Greek"), ("jp", "Japanese"), ("kr", "Korean")]
    out.sort(key=lambda p: p[1].lower())
    return out


def xkb_variants(layout):
    """Variants xkb offers for one layout, as (code, description). [] is normal.

    The `! variant` section's second column names the layout the variant belongs
    to, so a variant list is a filter over one file rather than a second lookup.
    """
    out = []
    try:
        with open(XKB_RULES, encoding="utf-8", errors="replace") as f:
            in_section = False
            for line in f:
                if line.startswith("! variant"):
                    in_section = True
                    continue
                if line.startswith("!"):
                    in_section = False
                    continue
                if not in_section:
                    continue
                parts = line.split(None, 2)
                # `nodeadkeys  de: German (no dead keys)`
                if len(parts) >= 2 and parts[1].rstrip(":") == layout:
                    desc = parts[2].strip() if len(parts) > 2 else parts[0]
                    out.append((parts[0], desc))
    except OSError:
        pass
    out.sort(key=lambda p: p[1].lower())
    return out


def timezones():
    """Every zone tzdata ships, as (name, human hint), sorted by name.

    Read from zone1970.tab — the file tzdata itself ships — rather than a
    hardcoded list, for the same reason the layouts are read from base.lst: a
    hardcoded list silently goes stale, and a zone the installed system does not
    have produces an /etc/localtime pointing at nothing. The engine checks the
    chosen zone exists in the DEPLOY root before linking it, so a zone that is
    on the ISO but not in the image degrades loudly there rather than here.
    """
    out, seen = [], set()
    try:
        with open(TZ_TAB, encoding="utf-8", errors="replace") as f:
            for line in f:
                if line.startswith("#"):
                    continue
                parts = line.split("\t")
                if len(parts) >= 3:
                    name = parts[2].strip()
                    if name and name not in seen:
                        seen.add(name)
                        hint = parts[3].strip() if len(parts) > 3 else ""
                        out.append((name, hint))
    except OSError:
        pass
    if not out:
        out = [(z, "") for z in (
            "Australia/Perth", "Australia/Sydney", "UTC", "Europe/London",
            "Europe/Berlin", "Europe/Paris", "Europe/Madrid", "Europe/Moscow",
            "America/New_York", "America/Chicago", "America/Los_Angeles",
            "America/Sao_Paulo", "Asia/Tokyo", "Asia/Shanghai", "Asia/Kolkata",
            "Asia/Dubai", "Africa/Cairo", "Africa/Lagos", "Pacific/Auckland")]
    out.sort(key=lambda p: p[0])
    return out


def session_state():
    """What the previous run of this process left for the one after the restart.

    The compositor restart starts a NEW apex-installer-gui, so self.answers is
    empty in it. The layout and variant come back through XKB_DEFAULT_*, because
    the session script exported them — but nothing carries anything else, and a
    value the user chose that does not survive is worse than one never offered:
    the resume page tells them to check the keyboard, so nobody looks at the
    time zone again, and the wrong one is written to the installed system.

    Parsed key=value, not sourced: the file is written by this same program on a
    tmpfs, and a crash mid-write must not be executed.
    """
    out = {}
    try:
        with open(SESSION_STATE) as f:
            for line in f:
                k, _, v = line.partition("=")
                k = k.strip()
                if k:
                    out[k] = v.strip()
    except OSError:
        pass
    return out


def active_timezone():
    """The zone this live environment resolved, as the sensible default.

    /etc/localtime is a symlink into zoneinfo on any systemd system. The ISO's
    kickstart hardcodes Australia/Perth, so that is what this normally returns —
    which is exactly the value the user is here to change, but it is the honest
    starting point rather than a guess.
    """
    try:
        tgt = os.readlink("/etc/localtime")
        if "/zoneinfo/" in tgt:
            return tgt.split("/zoneinfo/", 1)[1]
    except OSError:
        pass
    return "Australia/Perth"


def active_layout():
    """The layout the RUNNING compositor compiled its keymap from.

    Not `localectl`, and not the installed system's config: what a wlroots
    compositor hands its clients comes from XKB_DEFAULT_LAYOUT in its own
    environment, and libxkbcommon's compiled-in default when that is unset is
    `us`. Reading anything else here would report a layout the keyboard is not
    actually on.
    """
    return (os.environ.get("XKB_DEFAULT_LAYOUT", "") or "us",
            os.environ.get("XKB_DEFAULT_VARIANT", "") or "")


class Installer(Adw.Application):
    def __init__(self):
        super().__init__(application_id="org.apexos.Installer",
                         flags=Gio.ApplicationFlags.NON_UNIQUE)
        self.connect("activate", self.startup)
        self.ed = edition()
        self.accent = ACCENTS.get(self.ed, ACCENTS["daily"])
        # ── "LUKS2 by default" lives HERE ────────────────────────────────
        # The engine refuses to guess: it needs `encrypt=` spelled out in the
        # answers file. "By default" is therefore a property of the question
        # this front end asks — the box arrives ticked — and not of the
        # mechanism, which is the only place a default can be seen and changed
        # by the person it affects.
        self.answers = {"mode": "disk", "rootfs": "btrfs", "encrypt": "yes"}
        # Captured from the engine's stdout during the install. SECRET: it is
        # shown on the final page and written to the USB stick by the engine,
        # and it is never put in the answers file or any log.
        self.recovery_key = ""
        self.recovery_saved = ""
        self.disk = None
        self.target = None
        self.esp = ""
        self.proc = None
        # (layout, variant, passphrase) the encrypt page has already warned
        # about via apex-install --check-passphrase — see p_encrypt(). None
        # until the first check runs.
        self._luks_typeable_warned_for = None
        # None means "whatever GTK returns". Set to RESTART_RC by the keyboard
        # page to ask apex-installer-session for a new compositor; see there.
        self.exit_code = None

    # ── shell ────────────────────────────────────────────────────────────────
    def startup(self, _app):
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK)
        prov = Gtk.CssProvider()
        prov.load_from_data(CSS.format(bg=BG, surface=SURFACE, raised=RAISED,
                                       text=TEXT, accent=self.accent,
                                       danger=DANGER).encode())
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        # ── Text scale on high-density panels ────────────────────────────────
        # cage does no output scaling, so on a 13" 3840x2160 laptop panel every
        # control renders at a quarter of its intended size. That is not a
        # crash, so nothing else catches it, and the person in front of it
        # cannot read the installer well enough to use it.
        #
        # This has to happen HERE, in-process, and not via GDK_SCALE in the
        # launcher. Measured on the exact GTK this image ships (4.20.4):
        # GDK_SCALE is honoured on the X11 backend and IGNORED on Wayland,
        # where the scale comes from the compositor — and we run on Wayland
        # under cage. gtk-xft-dpi is a GtkSettings property, so it applies on
        # any backend; it scales text, which is the part that has to be
        # legible. The launcher measures the panel and passes the width; the
        # decision lives here so it can act on it.

        # ── Short panels ─────────────────────────────────────────────────────
        # 1024x600 netbooks and 800x600 firmware fallback modes are real, and on
        # them this installer's generous vertical rhythm stops being generous
        # and starts hiding things. Measured on the confirm page at 1024x600:
        # GTK could not fit its 611px minimum, so it squashed the partition
        # inventory to about two rows and the ERASED row — the partition being
        # destroyed — fell below the fold. That is the exact failure this page
        # was written to prevent whiptail from committing, reappearing in a
        # different form.
        #
        # So measure the panel and tighten the layout when it is short, rather
        # than letting GTK silently decide what to squash.
        try:
            pw = int(os.environ.get("APEX_PANEL_WIDTH", "0"))
        except ValueError:
            pw = 0
        if pw >= 2560:
            st = Gtk.Settings.get_default()
            if st is not None:
                # gtk-xft-dpi is in 1024ths of a point; 96*1024 is the default.
                st.set_property("gtk-xft-dpi", 96 * 1024 * 2)

        self.win = Adw.ApplicationWindow(application=self)
        self.win.set_title("APEX-OS Installer")
        self.win.set_default_size(1024, 700)
        self.win.fullscreen()
        self.win.add_css_class("apex-bg")

        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE,
                               transition_duration=200)
        self.win.set_content(self.stack)

        for name, build in (("welcome", self.p_welcome),
                            ("keyboard", self.p_keyboard), ("wifi", self.p_wifi),
                            ("disk", self.p_disk), ("mode", self.p_mode),
                            ("part", self.p_part), ("account", self.p_account),
                            ("encrypt", self.p_encrypt),
                            ("secureboot", self.p_secureboot),
                            ("confirm", self.p_confirm), ("run", self.p_run),
                            ("done", self.p_done)):
            self.stack.add_named(Gtk.Box(), name)
        self.builders = {"welcome": self.p_welcome,
                         "keyboard": self.p_keyboard, "wifi": self.p_wifi,
                         "disk": self.p_disk, "mode": self.p_mode,
                         "part": self.p_part, "account": self.p_account,
                         "encrypt": self.p_encrypt,
                         "secureboot": self.p_secureboot,
                         "confirm": self.p_confirm, "run": self.p_run,
                         "done": self.p_done}
        # Test affordance: jump straight to a page for screenshotting. Only
        # reachable by setting the env var explicitly; harmless in production.
        # A resumed session is one apex-installer-session restarted to apply a
        # keyboard layout. It comes back to the keyboard page rather than the
        # welcome page: the user's last action was choosing a layout, and the
        # page they land on is the one with the field to test it in.
        default_page = ("keyboard"
                        if os.environ.get("APEX_INSTALLER_RESUMED") == "1"
                        else "welcome")
        start = os.environ.get("APEX_GUI_PAGE", default_page)
        if start not in ("welcome", "keyboard"):
            self.disk = os.environ.get("APEX_GUI_DISK", "")
            self.target = os.environ.get("APEX_GUI_TARGET", "") or None
            self.esp = os.environ.get("APEX_GUI_ESP", "")
            self.answers.setdefault("username", "andre")
            self.answers.setdefault("hostname", "apex")
            self.answers["mode"] = os.environ.get("APEX_GUI_MODE", "disk")
            self.ok = os.environ.get("APEX_GUI_OK", "") == "1"
        self.go(start)
        self.win.present()

    def go(self, name):
        """Rebuild on entry — every page reflects state chosen on earlier pages."""
        page = self.builders[name]()
        old = self.stack.get_child_by_name(name)
        if old:
            self.stack.remove(old)
        self.stack.add_named(page, name)
        self.stack.set_visible_child_name(name)

    def is_compact(self):
        """True on a panel too short for the full vertical rhythm.

        Asked per page rather than once at startup: probing the monitor list in
        `activate` returned nothing under a headless compositor, so a
        startup-time flag silently stayed False and the tightening never
        happened. By the time a page is built the window is mapped and
        fullscreened, so its own allocated height is the reliable number, with
        the monitor geometry only as a fallback for the very first page.
        """
        try:
            h = self.win.get_height()
            if h > 0:
                return h < 700
        except Exception:
            pass
        try:
            mons = Gdk.Display.get_default().get_monitors()
            hs = [mons.get_item(i).get_geometry().height
                  for i in range(mons.get_n_items())]
            if hs:
                return min(hs) < 700
        except Exception:
            pass
        return False

    def scrolled(self, body):
        """Wrap a page body so it can never push the action row off-screen.

        The action row is the only way forward, so a page that overflows the
        panel is a stranded user — and there is no text installer to escape to
        any more. Pages with a list already bring their own scroller; this is
        for the FORM pages, whose fixed content is tall enough to overflow a
        1024x600 netbook or an 800x600 firmware fallback mode. Measured: the
        account page lands around 700px and the Secure Boot page (three
        paragraphs, two entries, a three-button row) was trimmed to fit exactly
        720px, so both clip below that.

        Do not wrap a body that already contains a ScrolledWindow — a scroller
        inside a scroller gets unbounded natural height and the inner list
        grows forever instead of scrolling.
        """
        sc = Gtk.ScrolledWindow(vexpand=True)
        sc.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        sc.set_propagate_natural_height(True)
        sc.set_child(body)
        return sc

    def frame(self, step, title, subtitle, body, actions):
        """Every page: step marker, title, subtitle, body, action row.
        Consistent structure is what makes an installer feel trustworthy."""
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        outer.add_css_class("apex-bg")
        clamp = Adw.Clamp(maximum_size=780, tightening_threshold=680)
        # Vertical chrome is the first thing to give on a short panel: the
        # generous top margin is presentation, the action row is function.
        _tight = self.is_compact()
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL,
                      spacing=SP * (2 if _tight else 4))
        col.set_margin_top(SP * (4 if _tight else 14))
        col.set_margin_bottom(SP * (3 if _tight else 8))
        col.set_margin_start(SP * 6); col.set_margin_end(SP * 6)
        col.set_valign(Gtk.Align.FILL)

        ed_name = {"daily": "DAILY", "gaming-nvidia": "GAMING",
                   "gaming-mesa": "GAMING"}.get(self.ed, self.ed.upper())
        col.append(lbl(f"APEX-OS  {ed_name}   ·   {step}", "apex-step"))
        col.append(lbl(title, "apex-title"))
        if subtitle:
            col.append(lbl(subtitle, "apex-sub"))

        body.set_vexpand(True)
        body.set_margin_top(SP * (1 if _tight else 3))
        col.append(body)

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=SP * 3)
        row.set_margin_top(SP * 4)
        row.set_halign(Gtk.Align.FILL)
        for w, end in actions:
            if end:
                w.set_hexpand(False)
                spacer = Gtk.Box(hexpand=True)
                if not any(getattr(c, "_spacer", False) for c in row):
                    spacer._spacer = True
                    row.append(spacer)
            row.append(w)
        col.append(row)
        clamp.set_child(col)
        outer.append(clamp)
        return outer

    def btn(self, label, css, cb, enabled=True):
        b = Gtk.Button(label=label)
        b.add_css_class(css)
        b.connect("clicked", cb)
        b.set_sensitive(enabled)
        return b

    # ── 1. welcome ───────────────────────────────────────────────────────────
    def p_welcome(self):
        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=SP * 3)
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=SP * 2)
        card.add_css_class("apex-card")
        card.set_margin_top(SP * 2)
        for w in (SP * 5, SP * 5):
            pass
        card.set_margin_start(0); card.set_margin_end(0)
        inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=SP * 3)
        inner.set_margin_top(SP * 5); inner.set_margin_bottom(SP * 5)
        inner.set_margin_start(SP * 5); inner.set_margin_end(SP * 5)
        for line in (
            "Choose your keyboard, so the password you set is the one you typed.",
            "Connect to Wi-Fi so the installed system has network on first boot.",
            "Choose a disk, or a single partition to install alongside another OS.",
            "Create your account — no locked-out first boot.",
            "Review exactly what will be erased, then confirm.",
        ):
            r = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=SP * 3)
            r.append(lbl("—", "apex-accent apex-mono", wrap=False))
            r.append(lbl(line, "apex-dim"))
            inner.append(r)
        card.append(inner)
        body.append(card)
        body.append(lbl("Nothing on any disk is touched until the confirmation step.",
                        "apex-dim"))
        return self.frame("STEP 1 OF 7", "Install APEX-OS",
                          "A guided install. You can go back at any point before confirming.",
                          body,
                          [(self.btn("Quit", "apex-ghost", lambda *_: self.quit()), False),
                           (self.btn("Begin", "apex-go", lambda *_: self.go("keyboard")), True)])

    # ── 2. keyboard ──────────────────────────────────────────────────────────
    # Placed here, second, for a reason that is not cosmetic: the criterion is
    # "keyboard layout before password creation", and the account page is where
    # the password is created. Putting the choice first also means the only
    # state that has to survive the compositor restart is the layout itself —
    # no Wi-Fi credentials, no disk selection, nothing to serialise.
    def p_keyboard(self):
        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=SP * 3)
        cur_l, cur_v = active_layout()

        layouts = xkb_layouts()
        codes = [c for c, _ in layouts]
        names = [f"{d}  ({c})" for c, d in layouts]

        model = Gtk.StringList.new(names)
        self.kb_drop = Gtk.DropDown(model=model)
        a11y(self.kb_drop, "Keyboard layout")
        self.kb_drop.set_enable_search(True)
        self.kb_drop.set_expression(Gtk.PropertyExpression.new(Gtk.StringObject, None, "string"))
        want = self.answers.get("keymap") or cur_l
        if want in codes:
            self.kb_drop.set_selected(codes.index(want))

        self.kb_var_drop = Gtk.DropDown(model=Gtk.StringList.new(["Default"]))
        a11y(self.kb_var_drop, "Keyboard variant")

        def refill_variants(*_a):
            sel = self.kb_drop.get_selected()
            code = codes[sel] if 0 <= sel < len(codes) else "us"
            vs = xkb_variants(code)
            self._kb_variants = [""] + [v for v, _ in vs]
            self.kb_var_drop.set_model(
                Gtk.StringList.new(["Default"] + [d for _, d in vs]))
            pick = self.answers.get("keyvariant") or (cur_v if code == cur_l else "")
            if pick in self._kb_variants:
                self.kb_var_drop.set_selected(self._kb_variants.index(pick))
            else:
                self.kb_var_drop.set_selected(0)

        self._kb_variants = [""]
        refill_variants()
        self.kb_drop.connect("notify::selected", refill_variants)

        # Time zone. On this page rather than a page of its own because it is
        # the other thing the live ISO hardcodes (bib-config.toml pins
        # Australia/Perth), it needs no restart to take effect on the installed
        # system, and a second near-empty step is a worse installer than one
        # honest one.
        tzs = timezones()
        tz_names = [z for z, _ in tzs]
        self._tz_names = tz_names
        self.tz_drop = Gtk.DropDown(model=Gtk.StringList.new(
            [f"{z}{('  — ' + h) if h else ''}" for z, h in tzs]))
        a11y(self.tz_drop, "Time zone")
        self.tz_drop.set_enable_search(True)
        self.tz_drop.set_expression(
            Gtk.PropertyExpression.new(Gtk.StringObject, None, "string"))
        # On a resume the answers dict is empty, so the choice has to come back
        # from the state file the pre-restart process wrote. Falling straight
        # through to active_timezone() here would silently reset the user's pick
        # to whatever the live ISO resolved.
        resumed = os.environ.get("APEX_INSTALLER_RESUMED") == "1"
        want_tz = (self.answers.get("timezone")
                   or (session_state().get("timezone") if resumed else "")
                   or active_timezone())
        if want_tz in tz_names:
            self.tz_drop.set_selected(tz_names.index(want_tz))

        grid = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=SP * 3)
        grid.append(lbl("Keyboard layout", "apex-dim"))
        grid.append(self.kb_drop)
        grid.append(lbl("Variant", "apex-dim"))
        grid.append(self.kb_var_drop)
        grid.append(lbl("Time zone", "apex-dim"))
        grid.append(self.tz_drop)
        body.append(grid)

        # The try-it field. This is the whole feature made visible: a layout that is
        # merely recorded changes nothing you can feel, and a user who cannot
        # verify the keyboard before typing a password into it is being asked to
        # trust a dropdown. After the restart, the keys under their hands really
        # are the ones they picked, and this is where they find that out.
        body.append(lbl("Test it here — type the characters you expect, "
                        "especially any in your password:", "apex-dim"))
        self.kb_test = Gtk.Entry()
        self.kb_test.set_property("placeholder-text",
                                  "Type here to check your keyboard")
        a11y(self.kb_test, "Keyboard test",
             "Type here to check the layout before you set a password.")
        body.append(self.kb_test)

        self.kb_note = lbl("", "apex-dim")
        body.append(self.kb_note)
        if resumed:
            self.kb_note.set_text(
                f"The keyboard is now {cur_l}{('-' + cur_v) if cur_v else ''}. "
                "Check it in the box above, then continue.")
        else:
            self.kb_note.set_text(
                f"The keyboard is currently {cur_l}"
                f"{('-' + cur_v) if cur_v else ''}. Choosing a different one "
                "restarts the installer's display so the new keys take effect "
                "straight away — nothing you have entered is lost, because "
                "nothing has been entered yet.")

        self.kb_err = lbl("", "apex-danger")
        body.append(self.kb_err)
        body.append(lbl("This layout is also written into the installed system, "
                        "so the login screen and desktop come up on it too.",
                        "apex-dim"))

        def nxt(_b):
            sel = self.kb_drop.get_selected()
            if not 0 <= sel < len(codes):
                self.kb_err.set_text("Pick a keyboard layout.")
                return
            code = codes[sel]
            vsel = self.kb_var_drop.get_selected()
            variant = (self._kb_variants[vsel]
                       if 0 <= vsel < len(self._kb_variants) else "")
            self.answers["keymap"] = code
            self.answers["keyvariant"] = variant
            tsel = self.tz_drop.get_selected()
            if 0 <= tsel < len(self._tz_names):
                self.answers["timezone"] = self._tz_names[tsel]

            # Already on it: nothing to restart for. This is also what makes the
            # restart terminate — after the relaunch the environment matches the
            # choice, so the second pass through this branch simply continues.
            if (code, variant) == (cur_l, cur_v):
                self.go("wifi")
                return

            try:
                os.makedirs(os.path.dirname(SESSION_STATE), exist_ok=True)
                with open(SESSION_STATE, "w") as f:
                    # The time zone rides along. The session script's parser
                    # ignores keys it does not know, so this costs it nothing,
                    # and it is the only way the choice survives the restart.
                    f.write(f"layout={code}\nvariant={variant}\n"
                            f"timezone={self.answers.get('timezone', '')}\n")
                os.chmod(SESSION_STATE, 0o600)
            except OSError as e:
                # Not fatal to the install. The layout still reaches the
                # INSTALLED system through the answers file; what is lost is
                # only the live session's keyboard, so say exactly that rather
                # than refusing to go on.
                self.kb_err.set_text(
                    f"Could not apply the layout to this session ({e}). "
                    f"{code} will still be set on the installed system — but "
                    "type carefully until then.")
                self.go("wifi")
                return

            self.exit_code = RESTART_RC
            self.quit()

        return self.frame("STEP 2 OF 7", "Keyboard and time zone",
                          "The password you create in a moment is typed on this "
                          "layout, so set it now.",
                          self.scrolled(body),
                          [(self.btn("Back", "apex-ghost", lambda *_: self.go("welcome")), False),
                           (self.btn("Continue", "apex-go", nxt), True)])

    # ── 3. wifi (skippable) ──────────────────────────────────────────────────
    def p_wifi(self):
        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=SP * 3)
        self.wifi_status = lbl("", "apex-dim")

        if not wifi_available():
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=SP * 2)
            box.add_css_class("apex-card")
            i = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=SP * 2)
            i.set_margin_top(SP * 5); i.set_margin_bottom(SP * 5)
            i.set_margin_start(SP * 5); i.set_margin_end(SP * 5)
            if wifi_blocked():
                i.append(lbl("Wi-Fi is switched off by a hardware switch.", "apex-mono"))
                i.append(lbl("Software cannot turn this back on. Look for a physical "
                             "Wi-Fi switch on the side of the laptop, an Fn key with a "
                             "radio symbol, or a Wireless setting in firmware setup.",
                             "apex-dim"))
            else:
                i.append(lbl("No Wi-Fi adapter detected.", "apex-mono"))
            # Do not just assume Ethernet is fine — say what it is doing. A cable
            # in a port with no DHCP server looks identical to a working
            # connection from here, and the netinstall download will fail later
            # for a reason the user was never given a chance to see.
            est, edev = eth_status()
            if est == "connected":
                i.append(lbl(f"Wired network is connected on {edev} — you already "
                             "have network and can continue.", "apex-dim"))
            elif est == "disconnected":
                i.append(lbl(f"A wired adapter ({edev}) is present but has no "
                             "connection. Plug in a cable, or check the other end — "
                             "if the network has no DHCP server this will not come up "
                             "on its own.", "apex-dim"))
            else:
                i.append(lbl("No wired adapter either. The system will come up "
                             "offline and you can connect after first boot.",
                             "apex-dim"))
            box.append(i)
            body.append(box)
            return self.frame("STEP 3 OF 7", "Network", None, body,
                              [(self.btn("Back", "apex-ghost", lambda *_: self.go("keyboard")), False),
                               (self.btn("Continue", "apex-go", lambda *_: self.go("disk")), True)])

        self.net_list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.SINGLE)
        self.net_list.add_css_class("apex-card")
        a11y(self.net_list, "Available Wi-Fi networks",
             "Pick one, then type its password below.")
        sc = Gtk.ScrolledWindow(vexpand=True)
        sc.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        sc.set_child(self.net_list)
        # GTK makes a ScrolledWindow focusable so it can be scrolled from the
        # keyboard, and it is the first focusable widget on this page -- so the
        # page opened with the focus on a nameless scroll container, and a
        # screen reader user was told nothing at all about where they were.
        # Measured: `role=generic | name= | states=focusable,focused`. The list
        # inside it takes Up/Down and scrolls itself, so nothing is lost by
        # letting the focus start on the named list instead.
        sc.set_focusable(False)
        # …and with the scroll container out of the way nothing at all had the
        # focus, which is worse: a keyboard user starts nowhere. So the page
        # says where the keyboard is, rather than leaving it to the toolkit.
        # idle_add because the widget is not realised while the page is being
        # built and grab_focus on an unrealised widget does nothing.
        GLib.idle_add(lambda: (self.net_list.grab_focus(), False)[1])
        body.append(sc)

        # Username, shown only for WPA-Enterprise. School, university and
        # workplace networks (eduroam and friends) authenticate with an identity
        # AND a password; a lone password field cannot express that, so before
        # this anyone on a managed network simply could not get online.
        self.wifi_user = Gtk.Entry()
        self.wifi_user.set_property("placeholder-text", "Username (enterprise networks)")
        a11y(self.wifi_user, "Network username",
             "Only needed on WPA-Enterprise networks such as eduroam.")
        self.wifi_user.set_visible(False)
        body.append(self.wifi_user)

        self.wifi_pw = Gtk.PasswordEntry(show_peek_icon=True)
        self.wifi_pw.set_property("placeholder-text", "Network password")
        a11y(self.wifi_pw, "Network password")
        body.append(self.wifi_pw)

        # A hidden network never appears in a scan, so without this there is no
        # way to type its name and the user is simply stuck.
        self.wifi_hidden = Gtk.Entry()
        self.wifi_hidden.set_property("placeholder-text",
                                      "Hidden network name (leave blank if it is in the list)")
        a11y(self.wifi_hidden, "Hidden network name",
             "Leave blank if the network is already in the list above.")
        body.append(self.wifi_hidden)
        body.append(self.wifi_status)

        self._wifi_nets = []
        # Scans and connects run on worker threads: nmcli can take 20–60s and
        # blocking the main loop that long looks like a dead installer. Skip
        # and Back stay live the whole time. Results come back via idle_add;
        # a captured-widget check discards them if the page was rebuilt.
        self._wifi_busy = False

        def refresh(*_):
            if self._wifi_busy:
                self.wifi_status.set_text("Wait for the current scan or "
                                          "connection to finish.")
                return
            self._wifi_busy = True
            self.wifi_status.set_text("Scanning…")
            netlist, status = self.net_list, self.wifi_status

            def worker():
                nets = wifi_scan()

                def apply():
                    if self.net_list is not netlist:
                        return False  # page rebuilt while scanning — stale
                    self._wifi_busy = False
                    child = netlist.get_first_child()
                    while child:
                        netlist.remove(child)
                        child = netlist.get_first_child()
                    self._wifi_nets = nets
                    for n in nets:
                        r = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=SP * 3)
                        r.set_margin_top(SP * 2); r.set_margin_bottom(SP * 2)
                        r.set_margin_start(SP * 4); r.set_margin_end(SP * 4)
                        bars = "▁▃▅▇"[:max(1, min(4, n["signal"] // 25 + 1))]
                        # The signal bars are a picture drawn out of block
                        # characters. A reader announces them one glyph at a time
                        # -- "lower one eighth block, lower three eighths
                        # block" -- in front of the network's name, so they are
                        # marked presentational and the strength is said in words
                        # in the row's description instead.
                        r.append(lbl(bars, "apex-accent apex-mono", wrap=False,
                                     pres=True))
                        r.append(lbl(n["ssid"], "apex-mono"))
                        lock = lbl("locked" if n["secure"] else "open", "apex-dim", wrap=False)
                        lock.set_hexpand(True); lock.set_xalign(1.0)
                        r.append(lock)
                        # An explicit row, because the accessible name has to go
                        # on the thing that takes the focus. A Gtk.Box handed
                        # straight to ListBox.append is wrapped in a
                        # GtkListBoxRow that GTK creates and this file never
                        # sees -- and THAT is the node the Tab ring lands on.
                        # Measured before this existed: seven `list item` nodes
                        # on the bus, every one of them focusable with an empty
                        # name and an empty description. A blind user tabbing
                        # through this page was told "list item" seven times and
                        # never heard a single network's name.
                        row = Gtk.ListBoxRow()
                        row.set_child(r)
                        a11y(row, n["ssid"],
                             "%s network, signal %d percent."
                             % ("Secured" if n["secure"] else "Open",
                                max(0, min(100, n["signal"]))))
                        netlist.append(row)
                    status.set_text(
                        f"{len(nets)} network(s) found."
                        if nets else "No networks found. Try scanning again, or "
                                     "Skip — Wi-Fi can be set up after first boot.")
                    return False
                GLib.idle_add(apply)

            threading.Thread(target=worker, daemon=True).start()

        def on_pick(_lb, _row):
            # Reveal the username field only when it is needed. Showing it
            # always would invite people to fill it in on a home network, where
            # supplying an identity switches nmcli to an 802.1X profile that
            # cannot possibly associate.
            try:
                r = self.net_list.get_selected_row()
                ent = (r is not None and 0 <= r.get_index() < len(self._wifi_nets)
                       and self._wifi_nets[r.get_index()].get("enterprise"))
                self.wifi_user.set_visible(bool(ent))
            except Exception:
                pass
        self.net_list.connect("row-selected", on_pick)

        def connect(_b):
            if self._wifi_busy:
                self.wifi_status.set_text("Wait for the current scan or "
                                          "connection to finish.")
                return
            # A typed hidden name wins over the list: if someone filled that in,
            # the network they want is by definition not in the list.
            hidden_name = self.wifi_hidden.get_text().strip()
            if hidden_name:
                n = {"ssid": hidden_name, "enterprise": bool(self.wifi_user.get_text().strip())}
                is_hidden = True
            else:
                row = self.net_list.get_selected_row()
                if row is None or not 0 <= row.get_index() < len(self._wifi_nets):
                    self.wifi_status.set_text(
                        "Pick a network first, or type a hidden network name.")
                    return
                n = self._wifi_nets[row.get_index()]
                is_hidden = False

            ident = self.wifi_user.get_text().strip()
            if n.get("enterprise") and not ident:
                self.wifi_status.set_text(
                    f"{n['ssid']} is an enterprise network — enter your username as "
                    "well as your password.")
                return

            self._wifi_busy = True
            self.wifi_status.set_text(f"Connecting to {n['ssid']}…")
            status, pw = self.wifi_status, self.wifi_pw.get_text()

            def worker():
                ok, err = wifi_connect(n["ssid"], pw, identity=ident, hidden=is_hidden)

                def apply():
                    if self.wifi_status is not status:
                        return False  # page rebuilt while connecting — stale
                    self._wifi_busy = False
                    if ok:
                        status.set_text(
                            f"Connected to {n['ssid']}. This will be copied to "
                            f"the installed system.")
                    else:
                        status.set_text(f"Could not connect: {err[:120]}")
                    return False
                GLib.idle_add(apply)

            threading.Thread(target=worker, daemon=True).start()

        refresh()
        acts = [(self.btn("Back", "apex-ghost", lambda *_: self.go("keyboard")), False),
                (self.btn("Rescan", "apex-ghost", refresh), False),
                (self.btn("Connect", "apex-ghost", connect), False),
                (self.btn("Skip", "apex-ghost", lambda *_: self.go("disk")), True),
                (self.btn("Continue", "apex-go", lambda *_: self.go("disk")), False)]
        return self.frame("STEP 3 OF 7", "Connect to Wi-Fi",
                          "Optional. If you connect, the network is carried into the "
                          "installed system so it has Wi-Fi on first boot.",
                          body, acts)

    # ── 3. disk ──────────────────────────────────────────────────────────────
    def p_disk(self):
        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=SP * 3)
        disks = list_disks()
        self._disks = disks

        if not disks:
            w = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            w.add_css_class("apex-warn")
