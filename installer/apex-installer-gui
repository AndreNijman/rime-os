# ── wifi ─────────────────────────────────────────────────────────────────────
def radio_on():
    """Unblock the Wi-Fi radio before doing anything else.

    A soft rfkill block is invisible in the UI and indistinguishable from "this
    laptop has no Wi-Fi": the device exists, the scan returns nothing, and the
    user is told there are no networks. Laptops ship blocked more often than you
    would think — a stray Fn-key press, a previous OS that left it off, or
    firmware that boots the radio down. Both switches have to be thrown:
    rfkill is the kernel-level block and `nmcli radio wifi` is NetworkManager's
    own, and either one alone leaves the card dark.

    A HARD block (physical switch) cannot be undone in software; wifi_blocked()
    detects that so the page can say so instead of pretending to scan.
    """
    run(["rfkill", "unblock", "wifi"], timeout=5)
    run(["rfkill", "unblock", "all"], timeout=5)
    run(["nmcli", "radio", "wifi", "on"], timeout=5)


def wifi_blocked():
    """True when a HARD rfkill block is active — a physical switch or BIOS
    setting that no amount of software can clear. Worth saying out loud rather
    than leaving someone staring at an empty network list."""
    rc, txt = run(["rfkill", "list", "wifi"], timeout=5)
    return "Hard blocked: yes" in txt


def eth_status():
    """('connected'|'disconnected'|'absent', device). Ethernet needs no
    configuration when a DHCP server answers, but when it does not, saying
    "cable in, no address" is the difference between a user waiting forever and
    a user plugging into a different port."""
    rc, txt = run(["nmcli", "-t", "-f", "DEVICE,TYPE,STATE", "device"])
    for line in txt.splitlines():
        f = line.split(":")
        if len(f) >= 3 and f[1] == "ethernet":
            return ("connected" if f[2] == "connected" else "disconnected"), f[0]
    return "absent", ""


def netinstall():
    """True when this ISO downloads the OS instead of carrying it."""
    return os.path.exists("/usr/lib/apex-installer/netinstall")


def online():
    """(ok, reason). Cheap layered check, same shape as the engine's.

    Exists because the first real install attempt reached the confirm screen,
    typed ERASE, and only THEN discovered there was no network — the download
    failed with a DNS error and the whole run was wasted. On an ISO that has to
    download 5 GB, telling someone that before they commit is the difference
    between a wasted minute and a wasted install.
    """
    rc, txt = run(["ip", "route", "show", "default"], timeout=5)
    if not txt.strip():
        return False, "not connected to any network"
    rc, _ = run(["getent", "hosts", "ghcr.io"], timeout=10)
    if rc != 0:
        return False, "connected, but DNS is not answering"
    return True, ""


def wifi_available():
    rc, txt = run(["nmcli", "-t", "-f", "TYPE", "device"])
    return any(l.strip() == "wifi" for l in txt.splitlines())


def wifi_scan():
    radio_on()
    run(["nmcli", "device", "wifi", "rescan"], timeout=20)
    rc, txt = run(["nmcli", "-t", "-f", "SSID,SIGNAL,SECURITY", "device", "wifi", "list"], timeout=20)
    seen, nets = set(), []
    for line in txt.splitlines():
        # nmcli -t escapes colons inside fields as \: — split on unescaped ones.
        f = re.split(r"(?<!\\):", line)
        if len(f) < 3:
            continue
        ssid = f[0].replace("\\:", ":").strip()
        if not ssid or ssid in seen:
            continue
        seen.add(ssid)
        try:
            sig = int(f[1])
        except ValueError:
            sig = 0
        sec = f[2].strip()
        # WPA-Enterprise needs a username as well as a password, and a totally
        # different nmcli invocation. Detect it here so the page can ask.
        ent = bool(re.search(r"802\.1X|EAP", sec, re.I))
        nets.append({"ssid": ssid, "signal": sig, "secure": bool(sec),
                     "security": sec, "enterprise": ent})
    nets.sort(key=lambda n: -n["signal"])
    return nets


def wifi_connect(ssid, password, identity="", hidden=False):
    """Join a network. Never raises — a hung or missing nmcli must degrade to an
    error message, not a stack trace with the status stuck on 'Connecting…'.

    Three cases, because `nmcli device wifi connect … password …` only covers
    the first one and silently cannot do the others:

      * PSK / open      — the simple form.
      * Hidden SSID     — same form plus `hidden yes`; without it nmcli will not
                          associate with a network that does not beacon, and the
                          user has no way to type a name that never appears in
                          a scan.
      * WPA-Enterprise  — needs a full connection profile with 802-1x settings.
                          PEAP/MSCHAPv2 is the near-universal school, university
                          and workplace configuration (eduroam included). Before
                          this, enterprise networks could not be joined at all:
                          the password field alone cannot express an identity,
                          so anyone on a managed network was simply locked out
                          of the network step.
    """
    try:
        if identity:
            name = f"apex-{ssid}"
            run(["nmcli", "connection", "delete", name], timeout=15)
            add = ["nmcli", "connection", "add", "type", "wifi",
                   "con-name", name, "ssid", ssid,
                   "wifi-sec.key-mgmt", "wpa-eap",
                   "802-1x.eap", "peap", "802-1x.phase2-auth", "mschapv2",
                   "802-1x.identity", identity, "802-1x.password", password]
            if hidden:
                add += ["wifi.hidden", "yes"]
            p = subprocess.run(add, capture_output=True, text=True, timeout=30)
            if p.returncode != 0:
                return False, (p.stderr or p.stdout).strip()
            p = subprocess.run(["nmcli", "connection", "up", name],
                               capture_output=True, text=True, timeout=90)
        else:
            cmd = ["nmcli", "device", "wifi", "connect", ssid]
            if password:
                cmd += ["password", password]
            if hidden:
                cmd += ["hidden", "yes"]
            p = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
        return p.returncode == 0, (p.stderr or p.stdout).strip()
    except subprocess.TimeoutExpired:
        return False, "timed out"
    except (subprocess.SubprocessError, OSError, ValueError) as e:
        return False, str(e)


