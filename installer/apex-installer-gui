            i.set_margin_top(SP * 5); i.set_margin_bottom(SP * 5)
            i.set_margin_start(SP * 5); i.set_margin_end(SP * 5)
            i.append(lbl("No eligible disks found.", "apex-danger"))
            i.append(lbl("The disk you booted from is excluded on purpose. If this "
                         "machine has an internal drive and it is not listed, it may "
                         "be in RAID/RST mode in firmware — switch it to AHCI and "
                         "try again.", "apex-dim"))
            w.append(i)
            body.append(w)
            return self.frame("STEP 4 OF 7", "Select a disk", None, body,
                              [(self.btn("Back", "apex-ghost", lambda *_: self.go("wifi")), False),
                               (self.btn("Rescan", "apex-ghost", lambda *_: self.go("disk")), True)])

