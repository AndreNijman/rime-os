# ─────────────────────────────────────────────────────────────────────────
# Rime OS — base image (thin, fast-moving tier)
#
#   FROM rime-os-core@<digest>
#     → rimed + rime CLI (compiled here)
#     → sysprofiles, D-Bus policy, polkit rules, systemd units
#     → every COPY out of files/**  (branding, dotfile templates, greeter,
#       provisioner, helpers, sudoers rules)
#     → the vendored Rime Shell + its read-only-/usr path rewrites
#
# ═══ WHY THE SPLIT: this tier is the one that changes ═══
#
# `rime update` used to re-download the entire OS on every push. The base job's
# path filter fires on files/**, rimed/** and config/** — almost every commit —
# and a cacheless rebuild gives every layer a new digest even when the content
# is identical, so bootc could reuse nothing. Measured on the author's L16 the
# published daily image was 155 layers / 5.07 GiB compressed, and essentially
# all of it moved every time.
#
# So the ~95% that does not change per commit now lives in Containerfile.core
# and is consumed here by DIGEST. A digest-pinned FROM reuses those layer
# descriptors verbatim: bootc already holds the blobs and fetches none of them.
# What is left in this file is the volatile remainder — a handful of COPY layers
# and two small binaries, tens of MiB rather than gigabytes.
#
# ── The rule for anything added here ──
# If it runs `dnf`, downloads, or compiles a third-party program, it belongs in
# Containerfile.core. This tier may only COPY repo content, compile rimed, and
# assert against those. A RUN that needs both must be split across the two
# files — see the zsh verification, the Windows-boot helper and the Hyprland
# template guards below, each of which is the base half of a pair.
#
# ── CORE must be pinned by digest ──
# CI passes --build-arg CORE=ghcr.io/andrenijman/rime-os-core@sha256:… . The
# `:latest` default exists only so a local `podman build -f Containerfile.base .`
# works; a tag would defeat the whole point in CI, because a tag that moves
# gives no reuse guarantee at all.
# ─────────────────────────────────────────────────────────────────────────
ARG CORE=ghcr.io/andrenijman/rime-os:core

# ═══ rimed builder ═══════════════════════════════════════════════════════
# Built FROM the core image rather than a bare fedora-bootc, so rimed links
# against exactly the libraries the image ships. rust and cargo are installed
# HERE, in a stage that is thrown away: the image no longer carries a Rust
# toolchain (2026-10-04, developer toolchains install on demand), and a `dnf`
# in a discarded stage costs the fleet nothing — the same reasoning as the
# translation stage below. gcc, which the `ring` crate's build script needs,
# is in core: its devstack names gcc and make for exactly this.
#
# rimed + rime are the workspace under rimed/; they embed config/sysprofiles/*.toml
# via include_str!, so config/ must sit at ../../../config relative to the crate —
# hence both rimed/ and config/ are copied under /build/.
FROM ${CORE} AS rime-builder
# /root is special in bootc images (symlink → /var/roothome), so cargo's default
# $HOME/.cargo fails ("File exists" on mkdir). Point CARGO_HOME at the build tree.
ENV CARGO_HOME=/build/.cargo
RUN dnf5 -y install --setopt=install_weak_deps=False rust cargo
COPY rimed/ /build/rimed/
COPY config/ /build/config/
RUN set -eux; cd /build/rimed; cargo build --release --locked; \
    install -Dm755 target/release/rimed       /out/usr/bin/rimed; \
    install -Dm755 target/release/rime        /out/usr/bin/rime; \
    install -Dm755 target/release/rime-agentd /out/usr/bin/rime-agentd; \
    install -Dm755 target/release/rime-remoted /out/usr/bin/rime-remoted; \
    install -Dm755 target/release/rime-secretd /out/usr/bin/rime-secretd; \
    install -Dm755 target/release/rime-aid    /out/usr/bin/rime-aid


# ═══ Rime.I18n builder: the catalogue AND the module ═════════════════════
# Compiles rime-shell's translations/*.ts into the .qm files QTranslator can
# actually load, and its tests/rime-i18n-plugin.cpp into the Rime.I18n QML
# module that installs them (Stage 5b2a below explains why that module exists).
# This is a DISCARDED stage and that is the entire point.
#
# The module was compiled in the base tier itself until 2026-10-04, off a C++
# compiler and Qt headers that core only carried because its own cleanup never
# ran (`dnf5 remove ... pkgconf ... || true`: kmod needs pkg-config, so dnf
# refused the whole transaction and `|| true` hid it). Core removes them now,
# so g++, moc, the Qt .pc files and the `qml` engine the proofs run in are
# installed HERE, and only the proved bytes are copied out. The proofs are as
# good here as in the image: this stage is FROM the same core, and base runs no
# dnf, so the Qt the module loads into below is the Qt it loads into there.
#
# lrelease is not in the image (qt6-linguist: 1 MiB download, 4 MiB installed,
# 3 packages — a sixth of the orca line in docs/update-cost.md). The package is
# cheap; a `dnf` in the base tier is not. Measured with podman history on this
# core image: install qt6-linguist, use lrelease, remove it, `dnf5 clean all`,
# all in ONE layer and net of zero shipped files, leaves a **113 MB** layer —
# the rewritten sqlite rpmdb docs/update-cost.md is about. Every machine, every
# update, for ever, to run one command once at build time. Here the whole stage
# is thrown away and only the .qm files are copied out.
#
# The other route considered and NOT taken: put qt6-linguist in
# Containerfile.core. It is 4 MiB and it would also give a booted machine
# lupdate/lrelease, which is what run-i18n-test.sh sections 2 and 3 need. It is
# rejected here because touching Containerfile.core triggers a core rebuild, and
# that is a multi-gigabyte update for every machine — a trade an agent should
# not make on its own. If anybody ever wants it, this stage is what it replaces.
#
# It clones rime-shell a SECOND time rather than restructuring the vendoring
# stanza into its own stage, deliberately: that stanza is the most load-bearing
# thing in this file and a `--depth 1` clone is two seconds. The two clones are
# then PROVED to agree — not assumed to — by carrying each .ts's sha256 out of
# this stage and comparing it against the vendored copy below. If the ref moved
# between the two clones, the build fails loudly instead of shipping a catalogue
# compiled from a source nobody shipped.
FROM ${CORE} AS rime-i18n-catalogue
ARG RIME_SHELL_REF=main
RUN set -eux; \
    dnf5 -y install qt6-linguist gcc-c++ pkgconf-pkg-config \
        qt6-qtbase-devel qt6-qtdeclarative-devel; \
    rm -rf /b; \
    # rime-rename: keep. The shell repository's old name resolves before the
    # GitHub rename and redirects after it; the new one resolves only after.
    if git clone --depth 1 --branch "${RIME_SHELL_REF}" \
         https://github.com/AndreNijman/apex-shell /b 2>/dev/null; then \
        echo "catalogue: cloned rime-shell at ${RIME_SHELL_REF}"; \
    else \
        rm -rf /b; \
        git clone https://github.com/AndreNijman/apex-shell /b; : 'rime-rename: keep (see above)'; \
        git -C /b checkout --detach "${RIME_SHELL_REF}"; \
    fi; \
    mkdir -p /out; \
    n=0; \
    for ts in /b/translations/*.ts; do \
        [ -e "$ts" ] || continue; \
        b="$(basename "$ts" .ts)"; \
        lrelease-qt6 -silent "$ts" -qm "/out/$b.qm"; \
        # lrelease exits 0 having written nothing for an unreadable .ts, so the
        # file is required to be non-empty rather than merely present.
        test -s "/out/$b.qm"; \
        sha256sum "$ts" | cut -d' ' -f1 > "/out/$b.ts.sha256"; \
        n=$((n + 1)); \
    done; \
    printf '%s\n' "$n" > /out/COUNT; \
    echo "catalogue: compiled $n catalogue(s) from rime-shell ${RIME_SHELL_REF}"; \
    # ── the module ──────────────────────────────────────────────────────────
    # /out/module always exists, so the COPY below never fails on a ref that
    # predates the module; the base tier decides what an empty one means.
    mkdir -p /out/module; \
    PLUG=/b/tests/rime-i18n-plugin.cpp; QMLD=/b/tests/rime-i18n-qmldir; \
    if [ -f "$PLUG" ] && [ -f "$QMLD" ]; then \
        MOC="$(qmake6 -query QT_HOST_LIBEXECS)/moc"; \
        test -x "$MOC"; \
        D=/usr/lib64/rime-shell/qml/Rime/I18n; \
        mkdir -p "$D" /tmp/rime-i18n-build; \
        "$MOC" $(pkg-config --cflags-only-I Qt6Qml Qt6Core) "$PLUG" \
            -o /tmp/rime-i18n-build/rime-i18n-plugin.moc; \
        g++ -std=c++17 -fPIC -shared -O2 -Wl,-z,relro,-z,now \
            -o "$D/librimei18n.so" "$PLUG" \
            -I/tmp/rime-i18n-build \
            $(pkg-config --cflags Qt6Qml Qt6Core) \
            $(pkg-config --libs Qt6Qml Qt6Core); \
        install -m0644 "$QMLD" "$D/qmldir"; \
        rm -rf /tmp/rime-i18n-build; \
        # An unresolved DT_NEEDED is a module that dlopens into nothing, and the
        # engine reports that as "module is not installed" — the same words as a
        # missing directory.
        if ldd "$D/librimei18n.so" | grep 'not found'; then \
            echo "FATAL: librimei18n.so has unresolved shared libraries (above)"; exit 1; \
        fi; \
        # THE LOAD PROOF, and it is not a file test. FOUND 35: a QML plugin can
        # be dlopened, have its qmldir read, and register NOTHING — everything
        # looks loaded and the import still fails. The only honest check is to
        # resolve the import in a real QML engine, so this does.
        #
        # `qml` and not `quickshell`, measured rather than assumed: the real
        # quickshell loads this module correctly and then does not exit, so it
        # returns 124 under any timeout and the assertion could never pass. It
        # is the trap check-containerfile-assertions.sh exists for.
        mkdir -p /tmp/rime-i18n-probe /tmp/rime-i18n-xdg; \
        chmod 700 /tmp/rime-i18n-xdg; \
        printf '%s\n' 'import QtQml' 'import Rime.I18n' \
            'QtObject { Component.onCompleted: Qt.exit(0) }' \
            > /tmp/rime-i18n-probe/probe.qml; \
        if ! QT_QPA_PLATFORM=offscreen QT_FORCE_STDERR_LOGGING=1 \
             XDG_RUNTIME_DIR=/tmp/rime-i18n-xdg \
             QML_IMPORT_PATH=/usr/lib64/rime-shell/qml \
             timeout 120 /usr/lib64/qt6/bin/qml -platform offscreen \
                /tmp/rime-i18n-probe/probe.qml > /tmp/rime-i18n-probe/out 2>&1; then \
            echo "FATAL: a QML engine could not import Rime.I18n from the built module:"; \
            sed 's/^/       /' /tmp/rime-i18n-probe/out; exit 1; \
        fi; \
        # The import resolving is not the same claim as the plugin having run.
        # This is the line the plugin itself prints from registerTypes().
        if ! grep -q 'RIMEI18N: registerTypes uri=Rime.I18n' /tmp/rime-i18n-probe/out; then \
            echo "FATAL: Rime.I18n imported without its plugin registering anything:"; \
            sed 's/^/       /' /tmp/rime-i18n-probe/out; exit 1; \
        fi; \
        # THE CATALOGUE IS PROVED TO LOAD, per language, through this module —
        # not stat-ed. A .qm that lrelease wrote and QTranslator declines is
        # indistinguishable from no .qm at all in everything except this line.
        # RIME_SHELL_TRANSLATIONS points the plugin at the files compiled above,
        # which are the files the base tier ships (it checks their bytes).
        for qm in /out/rime-shell_*.qm; do \
            [ -e "$qm" ] || continue; \
            lang="$(basename "$qm" .qm)"; lang="${lang#rime-shell_}"; \
            LANG="${lang}.UTF-8" LC_ALL="${lang}.UTF-8" \
            RIME_SHELL_TRANSLATIONS=/out \
            QT_QPA_PLATFORM=offscreen QT_FORCE_STDERR_LOGGING=1 \
            XDG_RUNTIME_DIR=/tmp/rime-i18n-xdg \
            QML_IMPORT_PATH=/usr/lib64/rime-shell/qml \
            timeout 120 /usr/lib64/qt6/bin/qml -platform offscreen \
                /tmp/rime-i18n-probe/probe.qml > /tmp/rime-i18n-probe/out 2>&1; \
            if ! grep -q "RIMEI18N: installed .*rime-shell_${lang}.qm" /tmp/rime-i18n-probe/out; then \
                echo "FATAL: rime-shell_${lang}.qm is not loaded by the module under LANG=${lang}:"; \
                sed 's/^/       /' /tmp/rime-i18n-probe/out; exit 1; \
            fi; \
            echo "catalogue: rime-shell_${lang}.qm loads under LANG=${lang}"; \
        done; \
        rm -rf /tmp/rime-i18n-probe /tmp/rime-i18n-xdg; \
        cp "$D/librimei18n.so" "$D/qmldir" /out/module/; \
        sha256sum "$PLUG" | cut -d' ' -f1 > /out/module/plugin.cpp.sha256; \
        sha256sum "$QMLD" | cut -d' ' -f1 > /out/module/qmldir.src.sha256; \
        echo "module: Rime.I18n built and proved to load: $(stat -c%s "$D/librimei18n.so") bytes"; \
    elif [ "$n" != 0 ]; then \
        echo "FATAL: rime-shell ${RIME_SHELL_REF} carries $n catalogue(s) and no Rime.I18n"; \
        echo "       module source to load them; nothing could ever install them."; \
        exit 1; \
    fi; \
    rm -rf /b

# ─────────────────────────────────────────────────────────────────────────
FROM ${CORE}

# OCI provenance. The git SHA is injected by CI (--build-arg RIME_REVISION=…)
# so every image is traceable back to the exact source commit — the plan's
# "image carries git SHA" rule (org.opencontainers.image.revision).
# ── rimed + rime CLI + rime-agentd: static payload only ─────────────────────
# The BINARIES are deliberately NOT copied here. They are the most volatile
# content in the image — every rimed commit changes them — and this is layer 1
# of roughly eighty, so copying them here made any `rimed/` change invalidate
# the entire base image.
#
# That is not theoretical: the build after the agent-runtime merge rebuilt and
# re-pushed every layer below this point and was killed at GitHub's six-hour job
# limit, having reached step 76 of 83. The previous successful build took 3h16m.
# `podman build --cache-to` pushes each intermediate layer to the registry
# separately, so a cache miss here costs ~80 rebuilds AND ~80 registry pushes.
#
# The binaries now land at the very END of this file, after everything static.
# An rimed-only change therefore rebuilds the last two layers instead of eighty.
# Everything below that needs them at build time was moved down with them.
#
# What stays here is the static payload: unit files, D-Bus policy, polkit rules
# and the sysprofiles. Those are repository files that change rarely, so they
# keep their cheap early position.
COPY config/sysprofiles/ /usr/share/rimeos/sysprofiles/
COPY rimed/rimed/rimed.service /usr/lib/systemd/system/rimed.service
COPY files/system/dbus-1/system-services/org.rimeos.Rimed1.service \
     /usr/share/dbus-1/system-services/org.rimeos.Rimed1.service
COPY files/system/dbus-1/system.d/org.rimeos.Rimed1.conf \
     /usr/share/dbus-1/system.d/org.rimeos.Rimed1.conf
COPY files/system/polkit-1/actions/org.rimeos.rimed.policy \
     /usr/share/polkit-1/actions/org.rimeos.rimed.policy
COPY files/system/polkit-1/actions/org.rimeos.agent.policy \
     /usr/share/polkit-1/actions/org.rimeos.agent.policy
COPY files/system/polkit-1/rules.d/49-rime-singbox.rules \
     /usr/share/polkit-1/rules.d/49-rime-singbox.rules
COPY files/system/units/sing-box.service /usr/lib/systemd/system/sing-box.service

# A polkit action file that is not well formed is not an error anybody sees.
# polkitd skips it, pkcheck then exits 127 for that action for the life of the
# image, and there is no other symptom — which is how P0-016 shipped an
# unregisterable action in rime-shell. The two things that make an action file
# unparseable are both checked here: the XML itself, and the fact that an XML
# comment may not contain two consecutive hyphens, which is what a quoted
# command line in a comment always produces.
RUN set -eux; \
    for f in /usr/share/polkit-1/actions/org.rimeos.*.policy; do \
        xmllint --noout --nonet "$f"; \
    done; \
    # The four action ids the runtime and the daemon actually name. A renamed
    # action registers cleanly and authorises nothing, which is the same
    # silence in a different place.
    grep -q 'id="org.rimeos.rimed.manage-power"' \
        /usr/share/polkit-1/actions/org.rimeos.rimed.policy; \
    grep -q 'id="org.rimeos.rimed.manage-battery"' \
        /usr/share/polkit-1/actions/org.rimeos.rimed.policy; \
    grep -q 'id="org.rimeos.agent.system-access"' \
        /usr/share/polkit-1/actions/org.rimeos.agent.policy; \
    grep -q 'id="org.rimeos.agent.break-glass"' \
        /usr/share/polkit-1/actions/org.rimeos.agent.policy; \
    # §3.3: root is delegated. Neither elevation action may be reachable
    # without a human, and neither may cache the answer — `_keep` is a window
    # in which the answer is yes and nobody was asked.
    #
    # Anchored to an <allow_*> element, and that is a bug fix rather than
    # tidying. The assertion used to be a bare `! grep -q '_keep'` over the
    # whole file, which the policy file's own comment matches: it has a
    # section headed "and never the _keep variants" explaining why
    # auth_admin_keep is forbidden. So the check failed on a correct file, and
    # `set -eux` made that a failed image build — for prose that agrees with
    # it. It could only ever have failed, never passed, which is the same
    # defect as an assertion that can only ever pass, with the sign flipped.
    if grep -qE '<allow_[a-z]+>[a-z_]*_keep' \
        /usr/share/polkit-1/actions/org.rimeos.agent.policy \
        ; then echo "FATAL: a _keep authorisation caches a yes nobody was asked for"; exit 1; fi; \
    if grep -q '<allow_any>yes' /usr/share/polkit-1/actions/org.rimeos.agent.policy \
        ; then echo "FATAL: <allow_any>yes hands the elevation action to any caller"; exit 1; fi; \
    ! grep -q '<allow_inactive>yes' /usr/share/polkit-1/actions/org.rimeos.agent.policy

# ── MT7925 Wi-Fi: survive a suspend ──────────────────────────────────────────
# The L16's mt7925e comes back from s2idle with its receive path wedged. The
# link looks healthy and is not: -45 dBm signal, tx negotiated at 156 Mbit/s,
# rx pinned to VHT-MCS 0 (7.2 Mbit/s), and two thirds of packets to the local
# gateway lost. TCP connects and then stalls, so it reads as "the internet is
# slow" rather than as a driver fault, and the standing workaround was to
# reboot.
#
# Measured on the machine, in order of increasing violence:
#   power save off      66% loss -> 50%
#   re-associate        50% loss -> 33%, rx still MCS 0
#   reload mt7925e      0% loss, rx 144 Mbit/s
#
# So both ship. The sleep hook is CONDITIONAL — it pings the gateway and only
# reloads when the link is actually failing — because an unconditional reload
# would add ~15 s of no network to every lid-open, and most of them are fine.
# It also refuses to act unless the driver really is mt7925e: these images run
# on more than one machine, and cycling the radio on hardware without this fault
# would be a regression invented by a fix for someone else's laptop.
COPY files/system/NetworkManager/20-rime-wifi-powersave.conf \
     /etc/NetworkManager/conf.d/20-rime-wifi-powersave.conf

# ── Captive portals, which were invisible ───────────────────────────────────
# NetworkManager's connectivity check was off, so NM had two states for a
# connection — up or down — and a hotel or campus network that has associated
# you, addressed you and will answer nothing until you accept its terms reads as
# up. The desktop then says the network is fine while nothing loads. The check
# adds the `portal` state, which is the one anything can act on. The file states
# what it costs; see it for why the endpoint is Fedora's.
COPY files/system/NetworkManager/21-rime-connectivity.conf \
     /etc/NetworkManager/conf.d/21-rime-connectivity.conf
COPY --chmod=0755 files/system/system-sleep/rime-wifi-resume \
     /usr/lib/systemd/system-sleep/rime-wifi-resume
RUN set -eux; \
    test -x /usr/lib/systemd/system-sleep/rime-wifi-resume; \
    bash -n /usr/lib/systemd/system-sleep/rime-wifi-resume; \
    # A hook that fires on the wrong phase, or on the wrong hardware, is worse
    # than no hook: it would cycle the radio of every Rime machine on every
    # resume. Both guards are asserted here rather than assumed.
    grep -qF '= "post" ]' /usr/lib/systemd/system-sleep/rime-wifi-resume; \
    grep -qF 'mt7925e' /usr/lib/systemd/system-sleep/rime-wifi-resume; \
    # The session stays frozen until every system-sleep hook returns, so the
    # slow part of this one must run detached. See the hook for the measured
    # 20-second freeze on every lid-open this prevents.
    grep -qF 'systemd-run --no-block' /usr/lib/systemd/system-sleep/rime-wifi-resume; \
    grep -qF 'wifi.powersave = 2' /etc/NetworkManager/conf.d/20-rime-wifi-powersave.conf; \
    # Both keys, because either one missing turns the check into a no-op that
    # still reads as configured: no uri and NM checks nothing, no response and
    # a portal returning 200 with its own login page counts as connectivity.
    grep -qE '^enabled=true' /etc/NetworkManager/conf.d/21-rime-connectivity.conf; \
    grep -qE '^uri=' /etc/NetworkManager/conf.d/21-rime-connectivity.conf; \
    grep -qE '^response=' /etc/NetworkManager/conf.d/21-rime-connectivity.conf
RUN systemctl enable rimed.service

# ── agent runtime (rime-agentd) ─────────────────────────────────────────────
# A USER unit, and deliberately NOT `systemctl --global enable`d: a per-user
# daemon holding PTYs should not start for people who never run an agent. The
# CLI prints the enable command when the socket is absent.
COPY files/system/units/rime-agentd.service /usr/lib/systemd/user/rime-agentd.service

# ── Rime Remote (rime-remoted, §46) ─────────────────────────────────────────
# A USER unit, ENABLED for every account (Andre, 2026-09-23): pairing a phone
# from Settings must work without a setup step first. It pulls in rime-agentd
# through Wants=, so the agent runtime runs for every account too. The unit's
# ConditionUser=!greetd keeps it off the login screen's own user manager.
#
# The firewall stays shut. Starting the service opens no port: 7717 is in the
# catalogue as `rime-remote` and needs `sudo rime firewall allow rime-remote`,
# and the relay path needs no inbound port at all.
COPY files/system/units/rime-remoted.service /usr/lib/systemd/user/rime-remoted.service
RUN systemctl --global enable rime-remoted.service

# ── protected secret service (rime-secretd, §11) ────────────────────────────
# A SYSTEM unit, and enabled — the opposite of rime-agentd, on purpose. It holds
# every brokered credential and has no verb that returns one, so a git
# credential helper, the CLI and the agent runtime all depend on it being
# reachable; a service somebody has to remember to start is a service each of
# those needs a fallback for. It is idle until asked.
#
# Root, because the store must be unreadable by the user's uid AND the git
# operation must run as the user. The unit file itself carries the argument.
COPY files/system/units/rime-secretd.service /usr/lib/systemd/system/rime-secretd.service
RUN systemctl enable rime-secretd.service

# P1-012, §13.4's tool half: `wrangler` and `terraform` run by the broker, so
# an agent's normal command works without the agent ever holding a credential.
#
# The shim is installed once and symlinked under each tool's own name. The
# names are what matter: it reads argv[0] to decide which tool it is standing
# in for, so a third tool is a third symlink and nothing else. The profile.d
# drop-in puts that directory on PATH inside an agent session and nowhere else
# — see the file for why the owner's own shell is left alone.
COPY --chmod=0755 files/system/libexec/rime-tool-broker /usr/libexec/rime-tool-broker
COPY files/system/profile.d/rime-tool-broker.sh /etc/profile.d/rime-tool-broker.sh
RUN set -eux; \
    mkdir -p /usr/libexec/rime/tools; \
    ln -sf /usr/libexec/rime-tool-broker /usr/libexec/rime/tools/wrangler; \
    ln -sf /usr/libexec/rime-tool-broker /usr/libexec/rime/tools/terraform; \
    bash -n /usr/libexec/rime-tool-broker; \
    bash -n /etc/profile.d/rime-tool-broker.sh; \
    # A shim that resolves to itself would loop until the process table gave
    # out, so the directory it is installed in must not be the one it searches.
    test "$(readlink -f /usr/libexec/rime/tools/wrangler)" = /usr/libexec/rime-tool-broker; \
    grep -q RIME_AGENT_SESSION /etc/profile.d/rime-tool-broker.sh

# ── local inference service (rime-aid, §14) ─────────────────────────────────
# A USER unit, and — exactly like rime-agentd — deliberately NOT
# `systemctl --global enable`d. A per-user daemon that will hold gigabytes of
# VRAM must not start for people who never ask for local inference; `rime ai`
# prints the enable command when the socket is absent.
#
# NO INFERENCE RUNTIME IS INSTALLED HERE, AND NONE MAY BE.
# llama.cpp with CUDA is gigabytes, and Fedora's own `llama-cpp` links hipblas
# and rocblas (checked: `dnf5 repoquery --requires llama-cpp` on f43 lists
# libamdhip64.so.6, libhipblas.so.2 and librocblas.so.4). Adding either to
# Containerfile.core — the only tier where a package transaction is allowed —
# would cost the whole fleet a multi-gigabyte update. P1 already built the two
# mechanisms that serve this properly and AGENTS.md forbids a third:
#   sudo rime install llama-cpp        a system extension overlaid on /usr
#   rime env create cuda               a capsule with the driver passed through
# `rime ai status` prints whichever of those applies. Nothing in rimed-core,
# rime or rime-aid downloads a runtime.
COPY files/system/units/rime-aid.service /usr/lib/systemd/user/rime-aid.service
COPY config/ai/catalogue.toml /usr/share/rimeos/ai/catalogue.toml
RUN set -eux; \
    test -s /usr/lib/systemd/user/rime-aid.service; \
    grep -q '^ExecStart=/usr/bin/rime-aid$' /usr/lib/systemd/user/rime-aid.service; \
    # Opt-in by design, asserted the same way the agent runtime's is.
    test ! -e /usr/lib/systemd/user/default.target.wants/rime-aid.service; \
    # The store must never be writable by the service or anything it starts.
    # The 0444 blobs are the first reason; this directive is the second, and a
    # unit that lost it would leave the inference process — which loads
    # untrusted weights and speaks HTTP — able to rewrite every user's models.
    grep -q '^ReadOnlyPaths=/var/lib/rime/ai$' /usr/lib/systemd/user/rime-aid.service; \
    # THE security invariant of §14, asserted on the shipped unit rather than
    # trusted: no polkit action, no system-bus name, no system unit. AGENTS.md
    # forbids all three, and a `WantedBy=multi-user.target` slipped in here is
    # exactly how a per-user daemon becomes a system one by accident.
    if grep -q 'multi-user.target' /usr/lib/systemd/user/rime-aid.service \
        ; then echo "FATAL: a multi-user.target want makes the per-user aid daemon a system one"; exit 1; fi; \
    test ! -e /usr/lib/systemd/system/rime-aid.service; \
    test ! -e /usr/share/polkit-1/actions/org.rimeos.rime-aid.policy; \
    test ! -e /usr/share/dbus-1/system.d/org.rimeos.RimeAid1.conf; \
    # The shared model store. Root-owned, world-readable, created on first boot
    # because /var is machine-local and empty in the image. Staging is 0700: a
    # partially written blob must not be readable by the account that will use
    # it, and it is where `rime ai pull` verifies a digest before the atomic
    # rename into blobs/.
    printf '%s\n' \
        'd /var/lib/rime 0755 root root -' \
        'd /var/lib/rime/ai 0755 root root -' \
        'd /var/lib/rime/ai/models 0755 root root -' \
        'd /var/lib/rime/ai/models/blobs 0755 root root -' \
        'd /var/lib/rime/ai/models/manifests 0755 root root -' \
        'd /var/lib/rime/ai/staging 0700 root root -' \
        > /usr/lib/tmpfiles.d/rime-ai.conf; \
    # systemd-tmpfiles applies the policy's default context for each path, and
    # on a real Rime host that is `var_lib_t` for all of these — checked with
    # `matchpathcon /var/lib/rime/ai/models/blobs` on the katana with SELinux
    # enforcing. So no new type and no policy module: the store is ordinary
    # var_lib_t content read by an unconfined user process. Assert the rules
    # parse, because a malformed line is skipped silently at boot and the
    # symptom is a store that does not exist.
    systemd-tmpfiles --dry-run --create /usr/lib/tmpfiles.d/rime-ai.conf; \
    # The catalogue is the ONLY place a model name becomes a digest, and it is
    # image content precisely so that its integrity is the image's. A build that
    # shipped an unparseable one would leave `rime ai pull <name>` refusing
    # every model on every machine.
    test -s /usr/share/rimeos/ai/catalogue.toml; \
    python3 -c 'import sys,tomllib; tomllib.load(open(sys.argv[1],"rb"))' \
        /usr/share/rimeos/ai/catalogue.toml; \
    echo "rime-aid: user unit present and opt-in, store rules valid, no system surface"

# bubblewrap is the agent sandbox. It is already in the image as a flatpak
# dependency, so it is NOT added to Containerfile.core: a package transaction
# there rebuilds core and costs the whole fleet a multi-gigabyte update to
# install something that is already present.
#
# What that trades away is an explicit dependency, so this asserts the result
# instead. If flatpak ever stops pulling bubblewrap in, the build fails here
# rather than shipping an image where every confined `rime agent run` refuses
# to start. Same reasoning as the kernel/akmod postconditions above: tolerate
# the indirect source, then hard-gate on the artifact.
# Everything here is independent of the rimed binaries, so it keeps its cheap
# early position. The binary-dependent half of these assertions moved to the end
# of the file, next to the COPY that provides them.
RUN set -eux; \
    test -x /usr/bin/bwrap; \
    rpm -q bubblewrap; \
    # --version, not a real sandbox. Executing bwrap needs to create a mount
    # namespace, and an image build runs under --isolation=chroot where that is
    # legitimately denied ("Can't mount tmpfs on /newroot/dev"). So the build
    # asserts what a build can actually know — the binary is present, owned by
    # the expected package, and runs far enough to report itself, which is what
    # catches a broken dynamic link against core.
    #
    # Whether confinement genuinely WORKS is a runtime property and is checked
    # where it can be: sandbox::preflight() refuses to start a confined session
    # if bwrap is unusable, and the rime-agent-core tests assert the argv and
    # the measured properties on a real kernel.
    /usr/bin/bwrap --version; \
    test -s /usr/lib/systemd/user/rime-agentd.service; \
    grep -q '^ExecStart=/usr/bin/rime-agentd$' /usr/lib/systemd/user/rime-agentd.service; \
    # A TUI with no TERM emits no colour, and systemd starts a user unit with
    # almost no environment. Without these the agents render in one colour and
    # the cause is invisible, because a daemon started by hand from a shell
    # inherits TERM and looks correct.
    grep -q '^Environment=TERM=' /usr/lib/systemd/user/rime-agentd.service; \
    grep -q '^Environment=COLORTERM=' /usr/lib/systemd/user/rime-agentd.service; \
    # The daemon starts before the login adds ~/.local/bin to the manager, so
    # without its own PATH an agent installed there (npm's `codex`) is "not
    # installed". The user directories must come FIRST, as a login shell has
    # them, and the system ones must still be there.
    grep -qx 'Environment=PATH=%h/.local/bin:%h/bin:%h/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/bin' /usr/lib/systemd/user/rime-agentd.service; \
    # Opt-in by design: a per-user daemon holding PTYs must not be enabled for
    # users who never run an agent. Assert it is NOT wired into any target.
    test ! -e /usr/lib/systemd/user/default.target.wants/rime-agentd.service; \
    # Rime Remote: enabled for every account, and never for the greeter.
    test -s /usr/lib/systemd/user/rime-remoted.service; \
    grep -qx 'ExecStart=/usr/bin/rime-remoted --relay wss://apex-relay.andrenijman.com' /usr/lib/systemd/user/rime-remoted.service; : 'rime-rename: keep (the deployed relay host)'; \
    test -L /etc/systemd/user/default.target.wants/rime-remoted.service; \
    grep -qx 'ConditionUser=!@system' /usr/lib/systemd/user/rime-remoted.service; \
    # getifaddrs() needs a netlink socket; without it every pairing code has
    # no LAN address and a phone has nowhere to connect.
    grep -qE '^RestrictAddressFamilies=.*\bAF_NETLINK\b' /usr/lib/systemd/user/rime-remoted.service; \
    # The secret service is the other way round: a SYSTEM unit, and enabled,
    # because everything that brokers a credential depends on it answering.
    test -s /usr/lib/systemd/system/rime-secretd.service; \
    grep -q '^ExecStart=/usr/bin/rime-secretd$' /usr/lib/systemd/system/rime-secretd.service; \
    # /etc, not /usr/lib: `systemctl enable` puts the wants symlink under
    # /etc/systemd/system, which on a bootc image is the shipped default that
    # ostree three-way merges on upgrade. It has never put one in /usr/lib, so
    # this assertion used to be one that could only ever fail — the same defect
    # 706489ec fixed one RUN block away, and the reason `podman build -f
    # Containerfile.base` still could not succeed after that commit. The four
    # sibling checks in this file (rime-boot-notice, rime-storage-notice,
    # rime-sysext-rebuild, rime-firewall) all name /etc; this one did not.
    # Verified against the real thing rather than reasoned about: `systemctl
    # enable rime-secretd.service` inside ghcr.io/andrenijman/rime-os:core says
    # "Created symlink '/etc/systemd/system/multi-user.target.wants/
    # rime-secretd.service'" and leaves /usr/lib untouched.
    test -L /etc/systemd/system/multi-user.target.wants/rime-secretd.service; \
    test ! -e /usr/lib/systemd/system/multi-user.target.wants/rime-secretd.service; \
    # The two lines that make the store a boundary rather than a directory. A
    # StateDirectoryMode that drifted to 0755 would leave every credential
    # readable by the account it belongs to, which is the whole of P0-002's
    # first criterion, and nothing at runtime would complain.
    # The directory keeps its APEX name (see the unit): a rollback to an APEX
    # image starts apex-secretd, which refuses a symlinked state directory.
    # rime-rename: keep
    grep -q '^StateDirectory=apex-secretd:rime-secretd$' /usr/lib/systemd/system/rime-secretd.service; \
    grep -q '^StateDirectoryMode=0700$' /usr/lib/systemd/system/rime-secretd.service; \
    # And it must NOT have been given a User=: dropping to the owner for the
    # git child needs CAP_SETUID, which a non-root unit does not have, and the
    # daemon would refuse every operation with an error nobody would connect to
    # this line.
    if grep -q '^User=' /usr/lib/systemd/system/rime-secretd.service \
        ; then echo "FATAL: a User= leaves secretd without CAP_SETUID and it refuses every operation"; exit 1; fi; \
    echo "agent sandbox: bwrap functional; agentd opt-in; secretd enabled with a 0700 store"

# Default browser (system-wide XDG): Firefox is the only baked browser, but set
# the http/https/html handlers explicitly so any "open link" honours it without
# a per-user round-trip. /etc/xdg/mimeapps.list is the system default layer.
COPY files/desktop/xdg/mimeapps.list /etc/xdg/mimeapps.list
# mpv config (HW decode via VA-API; safe fallback on any GPU vendor).
COPY files/desktop/mpv/mpv.conf /etc/mpv/mpv.conf

# ── System config drop-ins: dark mode, default terminal, fastfetch, Firefox ──
# Dark mode (rime-logs 28): GTK3/4 prefer-dark, qt6ct dark palette, and the dconf
# default color-scheme=prefer-dark that the freedesktop appearance portal reads
# (so Flatpaks/GTK4 follow). Default terminal = Alacritty (rime-logs 31).
# fastfetch greeting config + logo (rime-logs 33). Firefox dark defaults.
COPY files/system/gtk/gtk-3.0-settings.ini /etc/gtk-3.0/settings.ini
COPY files/system/gtk/gtk-4.0-settings.ini /etc/gtk-4.0/settings.ini
COPY files/system/qt6ct/qt6ct.conf /etc/xdg/qt6ct/qt6ct.conf
COPY files/system/dconf/00-rime-dark /etc/dconf/db/local.d/00-rime-dark
COPY files/system/dconf/profile-user /etc/dconf/profile/user
COPY files/system/firefox/policies.json /etc/firefox/policies/policies.json
# Firefox default prefs, overriding Fedora's. `zz-` is load-bearing: files in
# browser/defaults/preferences are read in SORTED order and later ones win, and
# Fedora's is firefox-redhat-default-prefs.js. See the file's own header for what
# it fixes (every new profile opened on a literal
# `data:text/plain,browser.startup.homepage=https://start.fedoraproject.org/`).
COPY files/system/firefox/rime-default-prefs.js \
     /usr/lib64/firefox/browser/defaults/preferences/zz-rime-default-prefs.js
COPY files/system/xdg/xdg-terminals.list /etc/xdg/xdg-terminals.list
# ── The terminal choice, and the program that reads it ──────────────────────
# That list is xdg-terminal-exec's config file: the one place a desktop says
# which terminal a `Terminal=true` entry should open in, so every launcher does
# not carry its own list. It has shipped since rime-logs 31 — and until
# Containerfile.core started installing xdg-terminal-exec, nothing on the
# machine read it. The config was on every Rime install and the reader was not,
# so /usr/share/applications/nvim.desktop (Terminal=true, from the neovim rpm,
# unremovable by rime-pkg because the image already provides it) could be
# clicked and nothing happened. Andre reported it as "nvim works on mine but not
# others"; it worked from a shell everywhere and from the desktop nowhere.
#
# All three parts are asserted against each other, because any one of them alone
# is the same silent half-failure: a reader with no config falls back to
# scanning for any terminal emulator it can find, and a config naming an entry
# that is not installed selects nothing.
RUN set -eux; \
    test -x /usr/bin/xdg-terminal-exec \
        || { echo "FATAL: /etc/xdg/xdg-terminals.list ships but xdg-terminal-exec does not; nothing reads it and Terminal=true entries stay unlaunchable"; exit 1; }; \
    # `|| true` on the grep only: under `set -e` a command substitution that
    # exits non-zero kills the RUN before the next line can say why, and the
    # next line is the whole point of writing the check. ERE, not the GNU-only
    # `\|` alternation. Skips comments, `-` exclusions and `/` directives, which
    # is every kind of line in the file that is not a terminal.
    xte_entry="$(grep -m1 -E -v '^[[:space:]]*([#/-]|$)' /etc/xdg/xdg-terminals.list || true)"; \
    test -n "$xte_entry" \
        || { echo "FATAL: /etc/xdg/xdg-terminals.list names no terminal; the fallback scan would pick one at random"; exit 1; }; \
    test -s "/usr/share/applications/$xte_entry" \
        || { echo "FATAL: xdg-terminals.list names $xte_entry, which is not installed in /usr/share/applications"; exit 1; }; \
    # And it has to be the SAME terminal $TERMINAL names, or the desktop opens
    # one and every script that honours $TERMINAL opens another.
    xte_bin="$(sed -n 's/^TryExec=//p;s/^Exec=\([^ ]*\).*/\1/p' "/usr/share/applications/$xte_entry" | head -n1)"; \
    env_bin="$(sed -n 's/^TERMINAL=//p' /etc/environment | head -n1)"; \
    test "${xte_bin##*/}" = "${env_bin##*/}" \
        || { echo "FATAL: xdg-terminals.list opens ${xte_bin##*/} but /etc/environment sets TERMINAL=${env_bin##*/}"; exit 1; }; \
    echo "xdg-terminal-exec: $xte_entry (${xte_bin##*/}), agrees with TERMINAL"
# XKB defaults generator: exports XKB_DEFAULT_LAYOUT/VARIANT/MODEL/OPTIONS from
# the system keymap into the systemd manager environment, so greetd — and the
# sway/labwc greeter host it spawns — use the layout the machine is actually
# configured for instead of a hardcoded `us`. See the file's own header; it is
# a no-op when no keymap has been set.
COPY --chmod=0755 files/system/systemd/rime-keymap-env \
     /usr/lib/systemd/system-environment-generators/50-rime-keymap
COPY files/system/fastfetch/config.jsonc /etc/fastfetch/config.jsonc
COPY files/system/fastfetch/rime-logo.txt /etc/fastfetch/rime-logo.txt

# Distro logo icon for os-release LOGO=rime-os-logo (replaces fedora-logo-icon).
# Anything that resolves LOGO through the icon theme (GNOME About, Bazaar,
# fastfetch's icon lookups) then gets the Rime spark instead of the Fedora F.
COPY files/branding/logos/chartreuse/rime-spark-chartreuse-16.png  /usr/share/icons/hicolor/16x16/apps/rime-os-logo.png
COPY files/branding/logos/chartreuse/rime-spark-chartreuse-32.png  /usr/share/icons/hicolor/32x32/apps/rime-os-logo.png
COPY files/branding/logos/chartreuse/rime-spark-chartreuse-64.png  /usr/share/icons/hicolor/64x64/apps/rime-os-logo.png
COPY files/branding/logos/chartreuse/rime-spark-chartreuse-128.png /usr/share/icons/hicolor/128x128/apps/rime-os-logo.png
COPY files/branding/logos/chartreuse/rime-spark-chartreuse-256.png /usr/share/icons/hicolor/256x256/apps/rime-os-logo.png
COPY files/branding/logos/chartreuse/rime-spark-chartreuse-512.png /usr/share/icons/hicolor/512x512/apps/rime-os-logo.png
COPY files/branding/logos/chartreuse/rime-spark-chartreuse.svg     /usr/share/icons/hicolor/scalable/apps/rime-os-logo.svg

# Rebuild the caches that the two COPY blocks above seeded. Both HAVE to run
# after the copies, which is why they are not in core's hardening layer:
#   - gtk-update-icon-cache: os-release says LOGO=rime-os-logo, and that name
#     only resolves once the spark PNGs/SVG are in the hicolor theme.
#   - dconf update: compiles /etc/dconf/db/local.d/00-rime-dark (prefer-dark)
#     into the local database the freedesktop appearance portal reads.
RUN set -eux; \
    gtk-update-icon-cache -qf /usr/share/icons/hicolor 2>/dev/null || true; \
    dconf update; \
    # ── Firefox: prove the Fedora homepage override is actually overridden ────
    # This is asserted rather than assumed because the whole fix rests on load
    # ORDER, and a rename on either side silently restores the bug — a browser
    # that opens on `data:text/plain,browser.startup.homepage=...` on a distro
    # that is not Fedora.
    D=/usr/lib64/firefox/browser/defaults/preferences; \
    test -f "$D/zz-rime-default-prefs.js"; \
    # Ours must sort LAST in that directory, which is what makes it win.
    last="$(ls -1 "$D" | LC_ALL=C sort | tail -n1)"; \
    [ "$last" = "zz-rime-default-prefs.js" ] \
        || { echo "FATAL: $last sorts after zz-rime-default-prefs.js; the Fedora homepage would win"; exit 1; }; \
    # And it must actually set the pref it exists to set.
    grep -q '^pref("browser.startup.homepage", "about:home");' \
        "$D/zz-rime-default-prefs.js"; \
    # If Fedora ever stops shipping the bad pref, this override becomes dead
    # weight — warn rather than fail, so a fixed upstream does not break builds.
    grep -q 'start.fedoraproject.org' "$D/firefox-redhat-default-prefs.js" \
        || echo "NOTE: Fedora no longer sets a start.fedoraproject.org homepage — zz-rime-default-prefs.js may be redundant"; \
    # policies.json is parsed by Firefox at startup; invalid JSON is ignored
    # SILENTLY, taking the dark-theme defaults down with it.
    python3 -c "import json,sys; json.load(open('/etc/firefox/policies/policies.json'))"; \
    python3 -c "import json; p=json.load(open('/etc/firefox/policies/policies.json'))['policies']['Preferences']; assert p['browser.startup.homepage']['Value']=='about:home', p"; \
    # And its SHAPE, which is a different question from its validity and a much
    # more expensive one to get wrong. The agent sandbox binds / read-only, so
    # THIS file is read inside every browser capsule as well as by the user's
    # own Firefox -- measured, in docs/browser-capsule-auth.md, which is where
    # the per-capsule CA bind comes from. A Certificates.Install added here
    # would be a certificate authority every capsule on the machine trusts; a
    # Proxy would decide where every capsule connects; a preference at
    # Status 'locked' would be one no user can undo. None of the three is
    # visible at runtime and none of them is an error.
    #
    # So the assertion is positive rather than a list of the three forbidden
    # keys: `policies` carries Preferences and nothing else, and every
    # preference is a dict at Status 'default'. A policy nobody has thought of
    # yet then also has to be a deliberate edit to this line, and a bare value
    # -- the newer schema's spelling of 'locked' -- fails on the subscript
    # rather than passing as a preference with no Status at all.
    python3 -c "import json; d=json.load(open('/etc/firefox/policies/policies.json'))['policies']; assert set(d)=={'Preferences'}, sorted(d); assert all(isinstance(v,dict) and v['Status']=='default' for v in d['Preferences'].values()), d['Preferences']"; \
    echo "firefox: Rime prefs sort last; homepage override verified; policy carries preferences only, all user-changeable"

# Templates seeded per-user by the provisioner (NOT /etc/skel: the provisioner
# has to substitute the edition accent, and skel cannot).
COPY files/desktop/zsh/zshrc            /usr/share/rime/zsh/zshrc
COPY files/desktop/starship/starship.toml /usr/share/rime/starship/starship.toml

# starship in bash too (rime-logs 14). zsh is the default login shell and gets its
# prompt from the seeded ~/.zshrc, but bash was left with the stock prompt, so any
# bash — root, a TTY, a nested shell, `podman exec` — looked nothing like the rest
# of the OS. A profile.d drop-in is image-managed, so unlike a dotfile it keeps
# working and keeps improving across updates.
COPY files/desktop/bash/rime-starship.sh /etc/profile.d/rime-starship.sh

# zsh-syntax-highlighting in the wallpaper accent instead of its built-in green.
# Fedora's /etc/zshrc sources /etc/profile.d/*.sh before ~/.zshrc, and the plugin
# only fills styles that are unset, so this reaches existing accounts without
# touching their ~/.zshrc.
COPY files/desktop/zsh/rime-zsh-highlight.sh /etc/profile.d/rime-zsh-highlight.sh

# The fastfetch greeting, sourced by /etc/bashrc AND by the seeded ~/.zshrc, so the
# two can never drift. Image-managed for the same reason as the prompt above.
COPY files/desktop/shell/rime-greeting.sh /usr/share/rime/shell/greeting.sh

# The agent shortcuts (`a`, `aa`, `al`, `ad`, `aw`, `ap`) and completion, shared
# between bash and zsh the same way the greeting is. The zsh side is sourced
# from the seeded ~/.zshrc; the bash side is appended to /etc/bashrc here rather
# than in core, because a core edit rebuilds the whole image tier.
COPY files/desktop/shell/agent.sh /usr/share/rime/shell/agent.sh

# The same shortcuts, completion and prompt indicator for fish. A SEPARATE file
# and not a second copy of the same one: fish is not a POSIX shell, so agent.sh
# cannot be sourced there at all — a `. agent.sh` in a fish config is a syntax
# error, not a degraded experience.
#
# These paths are fish's own, not Rime's: `fish -c 'echo $__fish_vendor_confdirs'`
# lists /usr/share/fish/vendor_conf.d, and $__fish_vendor_completionsdirs lists
# vendor_completions.d. Dropping files there is how a distribution package adds
# fish support without editing anybody's dotfile, which is why there is no
# fish equivalent of the /etc/bashrc append below. The completions are autoloaded
# by command NAME, so rime.fish, a.fish, aa.fish, ad.fish and ap.fish cost
# nothing until somebody presses tab.
COPY files/desktop/fish/rime-agent.fish /usr/share/fish/vendor_conf.d/rime-agent.fish
COPY files/desktop/fish/completions/ /usr/share/fish/vendor_completions.d/

# And the same again for nushell, which is a third dialect: `def` and `extern`
# are parse-time declarations, so nushell cannot even express the runtime
# `command -v rime` guard the other three use.
#
# /usr/share/nushell/vendor/autoload is nushell's own — it is the first entry of
# `nu -c '$nu.vendor-autoload-dirs'` — and the directory does not exist in the
# image until this COPY makes it. Files there are read for every interactive
# session, and ONLY for interactive sessions: `nu -c` and `nu script.nu` do not
# read them, which is why the assertions below source the file by hand and check
# the directory separately.
COPY files/desktop/nushell/rime.nu /usr/share/nushell/vendor/autoload/rime.nu

# One shared file, sourced system-wide from BOTH shell rc files so `a` exists for
# every user in every interactive shell, root included -- not just those with a
# seeded ~/.zshrc. bash reaches /etc/bashrc via a ~/.bashrc that sources it; zsh
# sources /etc/zshrc itself for every interactive shell, which is why the zsh
# hook must live there and not only in the seeded dotfile (the gap that kept `a`
# undefined for root and for any pre-existing ~/.zshrc). A single source line in
# each, not a block: /etc/zshrc is package-owned, so the smaller the appended
# text the less there is to drift when the package updates. agent.sh guards
# against the resulting double-source from a seeded ~/.zshrc.
RUN set -eux; \
    printf '\n# Rime OS agent shortcuts. One file shared with zsh (see /etc/zshrc),\n# so bash and zsh can never drift. Guarded so a partial image cannot\n# break bash, and skippable with RIME_NO_AGENT_ALIASES=1.\n[ -r /usr/share/rime/shell/agent.sh ] && . /usr/share/rime/shell/agent.sh\n' >> /etc/bashrc; \
    printf '\n# Rime OS agent shortcuts, shared with bash (see /etc/bashrc). zsh sources\n# /etc/zshrc for every interactive shell, so this reaches root and any user\n# whose ~/.zshrc predates the OS seed. Guarded against a double source.\n[ -r /usr/share/rime/shell/agent.sh ] && . /usr/share/rime/shell/agent.sh\n' >> /etc/zshrc

# Verify everything the three COPYs above just seeded, plus the pieces of the
# shell story that core is responsible for. zsh being the default login shell,
# and the starship binary itself, are set in Containerfile.core — this is the
# half of that pair which can only run once the templates exist, and it
# re-asserts core's side so a bad core can never reach a user unnoticed.
RUN set -eux; \
    grep -q '^SHELL=/bin/zsh' /etc/default/useradd; \
    grep -q '^/bin/zsh$' /etc/shells; \
    test -x /usr/bin/starship; \
    # The rest of the terminal-developer row, re-asserted here for the same
    # reason zsh is: core installs it, and a bad core must not reach a user
    # unnoticed. Binaries first — `nu` is nushell's, and zellij comes from a
    # pinned upstream tarball rather than a package, so `test -x` is the only
    # check that covers both sources.
    test -x /usr/bin/fish; \
    test -x /usr/bin/nu; \
    test -x /usr/bin/tmux; \
    test -x /usr/bin/zellij; \
    # ...then the half that decides whether a user can actually adopt one:
    # chsh rejects a shell missing from /etc/shells.
    grep -qx /usr/bin/fish /etc/shells; \
    grep -qx /usr/bin/nu /etc/shells; \
    test -s /usr/share/rime/zsh/zshrc; \
    test -s /usr/share/rime/starship/starship.toml; \
    zsh -n /usr/share/rime/zsh/zshrc; \
    bash -n /etc/profile.d/rime-starship.sh; \
    test -s /etc/profile.d/rime-starship.sh; \
    grep -q 'starship init bash' /etc/profile.d/rime-starship.sh; \
    grep -q 'BASH_VERSION' /etc/profile.d/rime-starship.sh; \
    grep -q 'starship init zsh' /usr/share/rime/zsh/zshrc; \
    grep -q '@ACCENT@' /usr/share/rime/starship/starship.toml; \
    grep -q 'zmodload zsh/complist' /usr/share/rime/zsh/zshrc; \
    grep -q 'bindkey -M menuselect' /usr/share/rime/zsh/zshrc; \
    zsh -fc 'zmodload zsh/complist && bindkey -M menuselect >/dev/null'; \
    test -s /usr/share/rime/shell/greeting.sh; \
    sh -n   /usr/share/rime/shell/greeting.sh; \
    bash -n /usr/share/rime/shell/greeting.sh; \
    zsh -n  /usr/share/rime/shell/greeting.sh; \
    # agent.sh is sourced by EVERY login shell, so a syntax error in it is a
    # broken shell for every user. It carries both a bash and a zsh completion
    # block, each guarded at runtime, so all three parsers must accept the whole
    # file — not just the one whose block is live.
    test -s /usr/share/rime/shell/agent.sh; \
    sh -n   /usr/share/rime/shell/agent.sh; \
    bash -n /usr/share/rime/shell/agent.sh; \
    zsh -n  /usr/share/rime/shell/agent.sh; \
    grep -q 'agent.sh' /etc/bashrc; \
    grep -q 'agent.sh' /etc/zshrc; \
    grep -q 'agent.sh' /usr/share/rime/zsh/zshrc; \
    grep -q 'RIME_NO_AGENT_ALIASES' /usr/share/rime/shell/agent.sh; \
    # The fish half. Two things have to hold and they fail in different ways: a
    # syntax error breaks every fish shell on the image, and a file in the wrong
    # directory breaks nothing visibly — it is simply never read, and the feature
    # silently does not exist. So the parser is asked about the files, and fish
    # itself is asked whether the directory they were installed into is one it
    # reads. Hardcoding "/usr/share/fish/vendor_conf.d looks right" is the check
    # that would pass on the day fish changes it.
    test -s /usr/share/fish/vendor_conf.d/rime-agent.fish; \
    fish -n  /usr/share/fish/vendor_conf.d/rime-agent.fish; \
    for f in /usr/share/fish/vendor_completions.d/rime.fish \
             /usr/share/fish/vendor_completions.d/a.fish \
             /usr/share/fish/vendor_completions.d/aa.fish \
             /usr/share/fish/vendor_completions.d/ad.fish \
             /usr/share/fish/vendor_completions.d/ap.fish; do \
        test -s "$f"; fish -n "$f"; \
    done; \
    fish -c 'contains /usr/share/fish/vendor_conf.d $__fish_vendor_confdirs'; \
    fish -c 'contains /usr/share/fish/vendor_completions.d $__fish_vendor_completionsdirs'; \
    grep -q 'RIME_NO_AGENT_ALIASES' /usr/share/fish/vendor_conf.d/rime-agent.fish; \
    grep -q 'rime_agent_prompt' /usr/share/fish/vendor_conf.d/rime-agent.fish; \
    # The nushell half. `source` is the real parser AND the real loader, so a
    # file that declares a bad signature fails here rather than at somebody's
    # first prompt — and the directory is again asked of the shell, because a
    # file installed one level off is never read and nothing says so.
    test -s /usr/share/nushell/vendor/autoload/rime.nu; \
    nu -n -c 'source /usr/share/nushell/vendor/autoload/rime.nu'; \
    nu -n -c 'if ($nu.vendor-autoload-dirs | any {|d| $d == "/usr/share/nushell/vendor/autoload" }) { exit 0 } else { exit 1 }'; \
    grep -q 'rime-agent-prompt' /usr/share/nushell/vendor/autoload/rime.nu; \
    grep -q 'nu-complete rime sessions' /usr/share/nushell/vendor/autoload/rime.nu; \
    # Sourcing it and asserting `a` is defined happens in the rimed stage at the
    # end of this file, NOT here: agent.sh opens with
    # `command -v rime >/dev/null || return 0`, so with the binaries not yet
    # copied in it correctly defines nothing and the check would fail for the
    # wrong reason.

    ! grep -q '\[\[' /usr/share/rime/shell/greeting.sh; \
    grep -q 'greeting.sh' /etc/bashrc; \
    grep -q 'greeting.sh' /usr/share/rime/zsh/zshrc; \
    grep -q 'fastfetch' /usr/share/rime/shell/greeting.sh; \
    # LIVE lines only. This guard's job is "no fastfetch INVOCATION survives in
    # /etc/bashrc" — the inline block must be gone and only the shared file
    # sourced. Grepping the whole file failed the build on the first attempt,
    # because the replacement comment explaining the change says the word
    # "fastfetch" itself. Third instance of a guard tripping over a legitimate
    # mention in a comment (see also the (unset) postcondition and this file's
    # bash-only-test-syntax check), hence comment-stripping here too.
    ! grep -vE '^[[:space:]]*#' /etc/bashrc | grep -q 'fastfetch'

# ── Stage 5b2: Rime Shell, VENDORED INTO THE IMAGE ──────────────────────────
# Rime Shell now ships INSIDE the image at /usr/share/rime-shell instead of being
# cloned into every user's $HOME on first login.
#
# WHY THE CHANGE (rime-logs 56)
# The old model gave Rime OS *two independent update channels* with no version
# coupling: the OS moved via `rime update` (bootc), and the shell moved via its own
# in-app `git pull` of ~/.local/src/rime-shell behind a login-time popup. A machine
# could sit on a new OS with an old shell or the reverse, and nothing detected the
# mismatch. It also meant the shell — the entire user interface — was fetched over
# the network at first login, unsigned, outside the image's atomic/rollback story.
#
# Vendoring it here fixes all of that AND kills a whole bug class structurally:
#   * ONE update channel. `rime update` moves the OS and the UI together, atomically,
#     with `rime rollback` covering both.
#   * The clone race (rime-logs 51) becomes IMPOSSIBLE, not merely mitigated. The
#     shell is present before the compositor is ever exec'd, so the autostart
#     cannot fire against a directory that does not exist yet.
#   * No network needed at first login. Provisioning is now pure local file seeding.
#   * The shell is covered by the image's cosign signature and by ostree integrity.
#   * One copy on disk instead of one per user.
#
# The cost: users can no longer `git pull` the shell in place. That is the point —
# it is the second channel we are deliberately removing. Local hacking is still
# possible by pointing the autostart at your own checkout.
#
# RIME_SHELL_REF pins what gets vendored (default: main). CI can pass a tag/SHA for
# a reproducible release build. The resolved SHA is written to
# /usr/share/rime-shell/.rime-shell-commit and stamped as an OCI label so
# `rime changelog` / `skopeo inspect` can report exactly which shell shipped.
ARG RIME_SHELL_REF=main
ARG RIME_SHELL_STRICT=0
RUN set -eux; \
    rm -rf /usr/share/rime-shell; \
    # `--branch` accepts a branch or tag but NOT a bare SHA, so try it first and
    # fall back to clone-then-fetch for a pinned commit. The rm -rf between the two
    # matters: a failed clone can leave a partial directory behind, and the second
    # clone would then fail on "destination path already exists" — turning a
    # recoverable case into a hard build failure.
    # rime-rename: keep. The shell repository's old name resolves before the
    # GitHub rename and redirects after it; the new one resolves only after.
    if git clone --depth 1 --branch "${RIME_SHELL_REF}" \
         https://github.com/AndreNijman/apex-shell /usr/share/rime-shell 2>/dev/null; then \
        echo "cloned rime-shell at ref ${RIME_SHELL_REF}"; \
    else \
        rm -rf /usr/share/rime-shell; \
        git clone https://github.com/AndreNijman/apex-shell /usr/share/rime-shell; : 'rime-rename: keep (see above)'; \
        git -C /usr/share/rime-shell checkout --detach "${RIME_SHELL_REF}"; \
        echo "cloned rime-shell and checked out ${RIME_SHELL_REF}"; \
    fi; \
    SHA="$(git -C /usr/share/rime-shell rev-parse HEAD)"; \
    printf '%s\n' "${SHA}" > /usr/share/rime-shell/.rime-shell-commit; \
    # HARD-VERIFY the entrypoint exists before we throw away the git metadata —
    # a silently-empty /usr/share/rime-shell would mean no UI on every machine.
    test -s /usr/share/rime-shell/shell.qml; \
    test -d /usr/share/rime-shell/src/services; \
    # ── THE CROSS-REPO MERGE ORDER, ASSERTED HERE AND NOT 60 LAYERS LATER ────
    # `rime plugin` gets every verdict from this file — it deliberately
    # reimplements none of the plugin rules — so a rime-shell ref without the
    # §16 platform produces an image whose plugin CLI cannot answer anything.
    # The rime-plugin layer near the bottom of this file checks the same
    # condition, but that is ~60 layers and several hours in, and this
    # repository has already lost a six-hour build at step 76 of 83. Same
    # assertion, minutes in, and it reads as the merge-order rule it is:
    # rime-shell lands before or with the OS.
    test -f /usr/share/rime-shell/src/services/plugins/manifest.js \
        || { echo "FATAL: rime-shell ref ${RIME_SHELL_REF} has no src/services/plugins/manifest.js."; \
             echo "The §16 plugin platform is not in this ref, so \`rime plugin\` would ship unable"; \
             echo "to give any verdict. rime-shell must land before or with the OS — check that"; \
             echo "PR #9 (branch p1/plugin-platform) is merged to rime-shell main."; \
             exit 1; }; \
    # Drop .git: this is no longer a live checkout, and its presence would invite
    # the in-app updater to try to fetch into a read-only /usr.
    rm -rf /usr/share/rime-shell/.git; \
    echo "vendored rime-shell ${SHA}"
LABEL org.rimeos.rime-shell.ref="${RIME_SHELL_REF}"

# ── The shell's own polkit action ────────────────────────────────────────────
# rime-shell ships org.rimeos.shell.agent.policy in dots-extra/polkit/, and its
# "Always unrestricted agents" setting authenticates with
# `pkcheck --action-id org.rimeos.shell.agent.set-always-unrestricted`. polkitd
# only reads /usr/share/polkit-1/actions/, and the image installs its own two
# policies at the top of this file — long before the shell is vendored above —
# so this one was never copied anywhere. The setting therefore told every user
# "This machine has no polkit action for the setting" and could not be turned
# on. Installed from the vendored tree rather than duplicated into this repo,
# so the file the shell ships is the file polkit reads.
RUN set -eux; \
    src=/usr/share/rime-shell/dots-extra/polkit/org.rimeos.shell.agent.policy; \
    test -s "$src" \
        || { echo "FATAL: rime-shell ${RIME_SHELL_REF} ships no $src; the agent-sandbox setting would have no action to authenticate against"; exit 1; }; \
    install -D -m 0644 "$src" /usr/share/polkit-1/actions/org.rimeos.shell.agent.policy; \
    xmllint --noout --nonet /usr/share/polkit-1/actions/org.rimeos.shell.agent.policy; \
    grep -q 'id="org.rimeos.shell.agent.set-always-unrestricted"' \
        /usr/share/polkit-1/actions/org.rimeos.shell.agent.policy \
        || { echo "FATAL: the shell's policy no longer declares the action AgentPolicyService.qml names"; exit 1; }; \
    # The same rule the image holds its own elevation actions to: a human at the
    # active session, never an inactive or remote one, never a cached yes.
    if grep -qE '<allow_(any|inactive)>(yes|auth_self_keep|auth_admin_keep)' \
         /usr/share/polkit-1/actions/org.rimeos.shell.agent.policy; then \
        echo "FATAL: the shell's policy grants an inactive or remote session"; exit 1; fi; \
    echo "rime-shell polkit action installed: org.rimeos.shell.agent.set-always-unrestricted"

# ── Stage 5b2a: the Rime.I18n QML module — the shell's translations ─────────
# Rime Shell marks 186 strings with qsTr(). qsTr() walks the list of installed
# QTranslators, and quickshell constructs a bare QQmlEngine and installs none,
# so every one of those strings comes back in English however good the
# catalogue is. That was read for thirty roadmap rounds as a change somebody
# else had to accept upstream. It is not: a bare QQmlEngine still loads QML
# modules off QML_IMPORT_PATH, a QML module may carry a compiled plugin, and a
# plugin runs C++ inside the shell's own process before a single binding is
# evaluated. rime-shell's tests/run-i18n-host-test.sh measures the whole route
# inside the real /usr/bin/quickshell.
#
# ── WHAT THIS COSTS, because that question gated the work ──────────────────
# ~37 kB: a 29,776-byte .so and a qmldir. It is compiled and proved to load in
# the discarded rime-i18n-catalogue stage at the top of this file, which is
# where the compiler and the Qt headers live; this stanza checks that the bytes
# it was handed were built from the source vendored here, and installs them.
#
# There is deliberately no `dnf` here, and that is the expensive part of the
# decision rather than a tidiness preference. Measured with podman history on
# this image: `dnf5 install qt6-linguist` + use it + `dnf5 remove` +
# `dnf5 clean all`, all in ONE layer and net of zero shipped files, leaves a
# **113 MB** layer — the rewritten sqlite rpmdb docs/update-cost.md describes.
# That is 3,000x this artefact, on every machine, on every update, for ever.
# Which is why neither the module nor the .qm catalogue is compiled here: both
# come out of the discarded builder stage. A shell with no catalogue for the
# session's language says so through qInfo() — which on Fedora goes to the
# journal, so: journalctl --user -b | grep RIMEI18N.
#
# ── THE SOURCE IS THE SUITE'S SOURCE, one file, no copy ────────────────────
# tests/rime-i18n-plugin.cpp of the rime-shell ref is compiled as it stands,
# and its sha256 must equal the vendored copy's (the builder clones the ref a
# second time, exactly as it does for the catalogue). A path under tests/ is a
# strange place to build a shipped artefact from, and the alternative is worse: a second copy in this repository that
# drifts from the one rime-shell's suite builds and measures, silently, with
# nothing comparing them. One file, proved by that suite on two distributions,
# is the honest arrangement.
#
# ── THE MERGE ORDER, ASSERTED HERE ─────────────────────────────────────────
# Both halves live in rime-shell and both are checked, in both directions. A
# ref that predates the module is rebuilt cleanly — the module is skipped and
# so is the shell's import of it. A ref that imports a module whose source it
# does not carry is a broken shell tree and fails the build loudly, because
# that combination ships a desktop that can never be translated and says
# nothing about why.
COPY --from=rime-i18n-catalogue /out/module/ /tmp/rime-i18n-mod/
RUN set -eux; \
    S=/usr/share/rime-shell; \
    PLUG="$S/tests/rime-i18n-plugin.cpp"; \
    QMLD="$S/tests/rime-i18n-qmldir"; \
    BOOT="$S/src/i18n/I18nBootstrap.qml"; \
    M=/tmp/rime-i18n-mod; \
    if [ ! -f "$PLUG" ] || [ ! -f "$QMLD" ]; then \
        if [ -f "$BOOT" ]; then \
            echo "FATAL: rime-shell ref ${RIME_SHELL_REF} loads src/i18n/I18nBootstrap.qml"; \
            echo "       but carries no tests/rime-i18n-plugin.cpp to build Rime.I18n from."; \
            echo "       That ships a shell that imports a module nothing can provide."; \
            exit 1; \
        fi; \
        if [ -e "$M/librimei18n.so" ]; then \
            echo "FATAL: the builder stage built Rime.I18n from a rime-shell that has it,"; \
            echo "       and the vendored tree does not — ${RIME_SHELL_REF} moved between the clones."; \
            exit 1; \
        fi; \
        echo "rime-shell ref ${RIME_SHELL_REF} predates the Rime.I18n module; skipping it"; \
    else \
        test -s "$M/librimei18n.so" \
            || { echo "FATAL: the vendored shell has the Rime.I18n source and the builder produced no module"; exit 1; }; \
        # THE TWO CLONES MUST AGREE: the module shipped here was compiled from
        # the source shipped here, not from a ref that moved under the build.
        for pair in "$PLUG:plugin.cpp.sha256" "$QMLD:qmldir.src.sha256"; do \
            f="${pair%%:*}"; want="$(cat "$M/${pair#*:}")"; \
            got="$(sha256sum "$f" | cut -d' ' -f1)"; \
            if [ "$want" != "$got" ]; then \
                echo "FATAL: Rime.I18n was built from a different $(basename "$f") than the one vendored."; \
                echo "       builder saw $want, this tree has $got — the rime-shell ref"; \
                echo "       ${RIME_SHELL_REF} moved between the two clones. Re-run the build,"; \
                echo "       or pass RIME_SHELL_REF as a commit SHA to make it reproducible."; \
                exit 1; \
            fi; \
        done; \
        D=/usr/lib64/rime-shell/qml/Rime/I18n; \
        mkdir -p "$D"; \
        install -m0755 "$M/librimei18n.so" "$D/librimei18n.so"; \
        install -m0644 "$M/qmldir" "$D/qmldir"; \
        # The load itself was proved in the builder (same core, same Qt). What
        # can still differ here is the link: an unresolved DT_NEEDED is a module
        # that dlopens into nothing.
        if ldd "$D/librimei18n.so" | grep 'not found'; then \
            echo "FATAL: librimei18n.so has unresolved shared libraries (above)"; exit 1; \
        fi; \
        # The shell half. A module nothing imports translates nothing, and it
        # would be invisible: the image would be correct and the desktop still
        # English.
        if [ ! -f "$BOOT" ]; then \
            echo "FATAL: rime-shell ref ${RIME_SHELL_REF} carries the Rime.I18n"; \
            echo "       plugin source but no src/i18n/I18nBootstrap.qml, so nothing"; \
            echo "       in the shell imports the module and no string is translated."; \
            exit 1; \
        fi; \
        grep -q '^import Rime.I18n' "$BOOT"; \
        grep -q 'src/i18n/I18nBootstrap.qml' "$S/shell.qml"; \
        echo "Rime.I18n installed, built and proved in the builder: $(stat -c%s "$D/librimei18n.so") bytes"; \
    fi; \
    rm -rf "$M"; \
    # The launcher half of this — that something puts the module on the engine's
    # import path — is asserted where the launcher EXISTS, ~500 layers below.
    # It was written here first, and tests/test-containerfile-order.sh caught it
    # reading a file the build has not copied yet: an assertion that could never
    # have passed, which is the exact class that gate was built for.
    echo "Rime.I18n stage complete"

# ── Stage 5b2b: the catalogue the module loads ──────────────────────────────
# The module built above is a route, not a translation. QTranslator::load()
# finding nothing is a successful, silent no-op, so a shell with the plugin and
# no .qm renders exactly like a shell with neither — which is the shape of
# defect this repository keeps meeting. The .qm files come out of the discarded
# rime-i18n-catalogue stage, already proved to load there; nothing that built or
# proved them is in this image.
COPY --from=rime-i18n-catalogue /out/ /tmp/rime-i18n-cat/
RUN set -eux; \
    D=/usr/share/rime-shell/translations; \
    n="$(cat /tmp/rime-i18n-cat/COUNT)"; \
    if [ "$n" = 0 ]; then \
        echo "rime-shell ref ${RIME_SHELL_REF} carries no translations/*.ts; no catalogue to ship"; \
    else \
        test -d "$D"; \
        for sf in /tmp/rime-i18n-cat/*.ts.sha256; do \
            b="$(basename "$sf" .ts.sha256)"; \
            # THE TWO CLONES MUST AGREE. The catalogue stage cloned rime-shell
            # separately, so this is the assertion that the .qm shipped here was
            # compiled from the .ts shipped here and not from a ref that moved
            # underneath the build.
            want="$(cat "$sf")"; \
            got="$(sha256sum "$D/$b.ts" | cut -d" " -f1)"; \
            if [ "$want" != "$got" ]; then \
                echo "FATAL: $b.qm was compiled from a different $b.ts than the one vendored."; \
                echo "       catalogue stage saw $want, this tree has $got — the rime-shell"; \
                echo "       ref ${RIME_SHELL_REF} moved between the two clones. Re-run the build,"; \
                echo "       or pass RIME_SHELL_REF as a commit SHA to make it reproducible."; \
                exit 1; \
            fi; \
            install -m0644 "/tmp/rime-i18n-cat/$b.qm" "$D/$b.qm"; \
        done; \
        # Each of these .qm files was proved to load through the Rime.I18n
        # module, per language, in a real QML engine, in the builder stage that
        # compiled it — the `qml` engine is a devel package and is not in this
        # image. Copied byte for byte from there, so the proof carries.
    fi; \
    rm -rf /tmp/rime-i18n-cat

# ── Stage 5b3: the two paths that assumed a WRITABLE shell tree ─────────────
# /usr is a read-only ostree/composefs mount, so anything the shell writes inside
# its own tree must be redirected into $HOME. An audit of the whole checkout found
# exactly ONE such write, plus one stale reader:
#
#  1. src/config/matugen.toml.in wrote its hyprlock palette to
#     '@SRCDIR@/src/config/colors.conf' — i.e. back into the source tree. On a
#     read-only tree matugen would fail that one output. The call site guards with
#     `|| true`, so it would fail SILENTLY, which is worse than loudly.
#  2. src/config/hyprlock.conf sourced that file by a HARDCODED
#     ~/.local/src/rime-shell path (not even @SRCDIR@-substituted), so it was
#     already broken for any non-default install location.
#
# Both are redirected to ~/.config/hypr/rime-shell-hyprlock-colors.conf. Note that
# hyprlock is currently DEAD CODE upstream — src/windows/Lockscreen.qml is a native
# Wayland session lock that "replaces hyprlock", and the hyprlock invocation in
# src/scripts/PowerControl.sh is commented out as an emergency fallback. These are
# fixed anyway so the fallback works if it is ever re-enabled, and so nothing in
# the image attempts a doomed write.
#
# THESE PATCHES BELONG UPSTREAM in rime-shell; doing them here is drift. Tracked in
# rime-logs 56. The matugen one is hard-verified because it is the only functional
# change — if upstream reworks that file, this build must fail loudly rather than
# quietly ship a shell that cannot theme the lock screen.
RUN set -eux; \
    S=/usr/share/rime-shell; \
    # (a) matugen's in-tree write -> $HOME. The ONLY genuine write into the tree.
    sed -i "s|output_path = '@SRCDIR@/src/config/colors.conf'|output_path = '@HOME@/.config/hypr/rime-shell-hyprlock-colors.conf'|" \
        "$S/src/config/matugen.toml.in"; \
    grep -q "output_path = '@HOME@/.config/hypr/rime-shell-hyprlock-colors.conf'" \
        "$S/src/config/matugen.toml.in"; \
    if grep -q "output_path = '@SRCDIR@" "$S/src/config/matugen.toml.in" \
        ; then echo "FATAL: matugen still writes into the source tree"; exit 1; fi; \
    # (b) hyprlock's reader of that file -> the same $HOME path. Must run BEFORE
    #     the generic rewrite in (c), or (c) would turn it into a /usr path that
    #     can never be written to.
    sed -i 's|^source = ~/.local/src/rime-shell/src/config/colors.conf|source = ~/.config/hypr/rime-shell-hyprlock-colors.conf|' \
        "$S/src/config/hyprlock.conf"; \
    # (c) EVERY remaining hardcoded ~/.local/src/rime-shell -> the image path.
    #     These are not cosmetic. src/config/hypridle.conf alone carries FOUR
    #     functional ones, and all four fail silently once the shell moves:
    #       lock_cmd         = qs -c ~/.local/src/rime-shell ipc call lockscreen lock
    #       after_sleep_cmd  = ~/.local/src/rime-shell/src/scripts/DpmsControl.sh on
    #       on-timeout       = ~/.local/src/rime-shell/src/scripts/DpmsControl.sh off
    #       on-resume        = ~/.local/src/rime-shell/src/scripts/DpmsControl.sh on
    #     lock_cmd is the idle LOCK SCREEN. A broken lock_cmd means the machine
    #     stops locking on idle and nothing says so — a security regression, not a
    #     cosmetic one. Rewritten generically rather than line-by-line so a future
    #     upstream addition of another such path is caught by the guard below.
    grep -rl '~/\.local/src/rime-shell' "$S" 2>/dev/null | while read -r f; do \
        sed -i 's|~/\.local/src/rime-shell|/usr/share/rime-shell|g' "$f"; \
    done; \
    # (d) HARD GUARD: nothing may still point at the old per-user clone path, and
    #     nothing may still target an unwritable in-tree output. If upstream adds
    #     one, this build fails loudly instead of shipping a silent regression.
    if grep -rn '~/\.local/src/rime-shell' "$S" 2>/dev/null; then \
        echo "FATAL: stale per-user clone path survived the rewrite (above)"; exit 1; \
    fi; \
    grep -q '^lock_cmd\|lock_cmd = qs -c /usr/share/rime-shell' "$S/src/config/hypridle.conf"; \
    grep -q 'lock_cmd = qs -c /usr/share/rime-shell ipc call lockscreen lock' \
        "$S/src/config/hypridle.conf"; \
    echo "shell paths rewritten to /usr/share/rime-shell; lock_cmd + DPMS verified"

# ── Stage 5b3: make the power menu's "Boot into Windows" button work ─────────
# It never has, on any machine. PowerControl.sh called
# /usr/local/bin/caelestia-boot-windows — a path inherited from the project
# rime-shell was forked from, which Rime OS has never shipped and CANNOT ship:
# /usr is read-only on bootc, so /usr/local is redirected to ../var/usrlocal
# (writable per-machine state) earlier in this file. No image can put a file
# there. The button logged "no Windows boot helper installed" to a log nobody
# reads. Its comment also claimed a dedicated NOPASSWD sudoers rule existed;
# none was ever shipped either. Both halves are fixed here (rime-logs 15).
#
# efibootmgr is an EXPLICIT dependency, installed in Containerfile.core (it is a
# dnf transaction, so it cannot live in this tier). It was only ever present
# transitively via the shim/grub2-efi chain, and the button is useless without
# it, so its presence is re-asserted here — where the feature actually lives —
# rather than trusted.
# ── §22 boot v2: the health gate, the recovery notice, and NOTHING ELSE ────
#
# What ships here is the OS-side half of §22's migration step 4 — the
# definition of "this boot worked", plus the notice a rollback leaves behind.
#
# What does NOT ship, deliberately:
#
#   * No bootloader installation. Nothing in this image runs `bootctl install`,
#     `bootctl update`, `bootupctl` or `efibootmgr -c` — AGENTS.md boot-path
#     rule 5. Andre decided on 2026-09-20 that Rime moves to systemd-boot on
#     every machine, and that does not change this line: an ESP a script
#     overwrote has no rollback, the machine that boots systemd-boot is a
#     machine bootc INSTALLED that way (the composefs backend; the ostree
#     backend refuses `--bootloader systemd` outright), and an already-installed
#     machine cannot be converted in place. Enrolment stays the documented,
#     user-initiated procedure in docs/boot-v2.md.
#   * No systemd-boot binary and no ukify HERE. Both are dnf transactions and
#     therefore belong in Containerfile.core, which is where the pivot put
#     them — `systemd-boot-unsigned` has to be in the shipped image because
#     `bootc install --bootloader systemd` copies the loader OUT of the image
#     being installed, and without it bootc exits 0 leaving an unbootable ESP.
#     `rime boot status` reads `bootctl list`, which ships in systemd-udev —
#     asserted below rather than assumed.
#
# What the pivot ADDED here, and why each piece is a precondition rather than a
# default change:
#
#   * The boot blessing had to be repaired before a counter could be written at
#     all. On the composefs path the ESP is mounted at /boot, so the loader
#     entries are dosfs_t, and PID 1 running /usr/lib/systemd/systemd-bless-boot
#     (init_exec_t) stays in init_t, which Fedora 43's policy allows no rename
#     on dosfs_t. Measured on the Rime image with the AVC in
#     ROADMAP/evidence/sdboot-image-20260920-decision.md. Unrepaired, every
#     deployment would roll itself back on its fourth boot — the exact outcome
#     rule 5 exists to prevent.
#   * rime-boot-count writes the counter bootc does not. It renames the STAGED
#     entry, which `bootc-finalize-staged` is about to install, because a
#     rename in the live directory is discarded by the next upgrade.
#
# The health and notice units carry ConditionPathExists on systemd-boot's
# LoaderBootCountPath EFI variable, which is the same switch
# systemd-bless-boot-generator uses. On a GRUB machine that variable does not
# exist, so neither unit starts, and a failed condition counts as a skip rather
# than a failure — enabling them here cannot affect a GRUB boot.
# tests/test-boot-v2.sh asserts that every unit this block enables carries a
# condition that is false on a GRUB machine, because an enabled unit without
# one would be the exact way "opt-in" silently becomes "default".
#
# rime-boot-count is conditioned on /boot/loader/entries.srel instead, and the
# difference is not a lapse. LoaderBootCountPath exists only when systemd-boot
# booted the machine with a counter ALREADY in effect; this unit is what writes
# the first one, so that variable is absent exactly when it is needed. Worse,
# it does its work in ExecStop, and a unit whose condition failed at start is
# never stopped — the ExecStop would simply never run. entries.srel is the Boot
# Loader Specification's own marker for a Type #1 entry directory: bootc writes
# it on the ESP on the systemd-boot path, and on a GRUB/ostree machine it does
# not exist (checked on the L16, whose /boot/loader is a symlink to loader.0
# holding nothing but entries/).
COPY files/system/libexec/rime-boot-health /usr/libexec/rime-boot-health
COPY files/system/libexec/rime-boot-count /usr/libexec/rime-boot-count
COPY files/system/units/rime-boot-health.service \
     /usr/lib/systemd/system/rime-boot-health.service
COPY files/system/units/rime-boot-notice.service \
     /usr/lib/systemd/system/rime-boot-notice.service
COPY files/system/units/rime-boot-count.service \
     /usr/lib/systemd/system/rime-boot-count.service
COPY files/system/units/10-rime-bless-boot-esp.conf \
     /usr/lib/systemd/system/systemd-bless-boot.service.d/10-rime-bless-boot-esp.conf
COPY docs/boot-v2.md /usr/share/doc/rime/boot-v2.md
RUN set -eux; \
    chmod 0755 /usr/libexec/rime-boot-health /usr/libexec/rime-boot-count; \
    bash -n /usr/libexec/rime-boot-health; \
    bash -n /usr/libexec/rime-boot-count; \
    \
    : '── the blessing must be able to write a FAT ESP, or nothing else here'; \
    : '── matters: an unblessed entry keeps its +N-M counter and the machine'; \
    : '── rolls itself back on the fourth boot.'; \
    : 'Measured on the Rime image, SELinux enforcing, composefs + sd-boot:'; \
    : '  systemd-bless-boot: Failed to rename ...+2-1.conf -> ...conf: EACCES'; \
    : '  avc: denied { rename } scontext=init_t tcontext=dosfs_t tclass=file'; \
    : 'The drop-in sends it into bootupd_t, the domain Fedora built for'; \
    : 'writing bootloader state onto a FAT ESP, and the policy module grants'; \
    : 'the one permission that transition was missing.'; \
    test -s /usr/lib/systemd/system/systemd-bless-boot.service.d/10-rime-bless-boot-esp.conf; \
    grep -q '^SELinuxContext=-system_u:system_r:bootupd_t:s0$' \
        /usr/lib/systemd/system/systemd-bless-boot.service.d/10-rime-bless-boot-esp.conf; \
    : 'The leading dash makes a FAILURE TO SET the context non-fatal, which'; \
    : 'covers SELinux disabled or a policy without bootupd_t. It does NOT'; \
    : 'cover this module going missing on an enforcing machine: setexeccon'; \
    : 'then succeeds and the kernel denies the execve. That case is what the'; \
    : 'cross-tier semodule assertion below is for.'; \
    \
    : 'The drop-in is only half the repair: the transition it asks for needs'; \
    : 'the rime_sdboot policy module, which is COMPILED IN Containerfile.core'; \
    : '(compiling belongs in the slow tier, and `semodule -i` rewrites the'; \
    : 'binary policy -- measured at 3.8 MB for policy.35 in the daily image --'; \
    : 'which would land in every thin-tier update if it were done here).'; \
    : 'Asserted across the tier boundary, cheaply, so a core change that drops'; \
    : 'it fails here rather than on somebody machine four boots later.'; \
    semodule -l | grep -qx rime_sdboot; \
    \
    : '── the upstream mechanism must actually be in this image ──'; \
    : 'systemd-bless-boot is what strips the +N-M suffix. Without it the'; \
    : 'health gate would gate nothing and a deployment would never be'; \
    : 'blessed, so every systemd-boot boot would eventually roll back.'; \
    test -f /usr/lib/systemd/system/systemd-bless-boot.service; \
    test -f /usr/lib/systemd/system/boot-complete.target; \
    test -x /usr/lib/systemd/systemd-bless-boot; \
    test -x /usr/lib/systemd/system-generators/systemd-bless-boot-generator; \
    : 'rime boot status shells out to bootctl for the entry tally.'; \
    test -x /usr/bin/bootctl; \
    \
    : '── /var/lib/rime/boot is machine-local state, so tmpfiles owns it ──'; \
    : '/var is not part of the ostree deployment; a directory created at'; \
    : 'build time would not exist on an installed machine.'; \
    printf 'd /var/lib/rime/boot 0755 root root -\n' \
        > /usr/lib/tmpfiles.d/rime-boot.conf; \
    systemd-tmpfiles --dry-run --create /usr/lib/tmpfiles.d/rime-boot.conf; \
    \
    systemctl enable rime-boot-health.service; \
    systemctl enable rime-boot-notice.service; \
    systemctl enable rime-boot-count.service; \
    \
    : '── postconditions on the enablement, not just on the enable command ──'; \
    : 'RequiredBy vs WantedBy is the difference between "a failed health'; \
    : 'check blocks the blessing" and "a failed health check is a warning",'; \
    : 'so the symlink systemctl actually created is what gets checked.'; \
    test -L /etc/systemd/system/boot-complete.target.requires/rime-boot-health.service; \
    test -L /etc/systemd/system/boot-complete.target.wants/rime-boot-notice.service; \
    test -L /etc/systemd/system/multi-user.target.wants/rime-boot-count.service; \
    : 'And each enabled unit must be inert without systemd-boot counting.'; \
    for u in rime-boot-health rime-boot-notice; do \
        grep -q '^ConditionPathExists=/sys/firmware/efi/efivars/LoaderBootCountPath-' \
            "/usr/lib/systemd/system/$u.service"; \
    done; \
    : 'rime-boot-count cannot use that variable — it is what writes the first'; \
    : 'counter, and it works in ExecStop, which never runs for a unit whose'; \
    : 'start condition failed. entries.srel is absent on a GRUB machine.'; \
    grep -q '^ConditionPathExists=/boot/loader/entries.srel$' \
        /usr/lib/systemd/system/rime-boot-count.service; \
    : 'and the ordering that makes the ExecStop land before bootc swaps the'; \
    : 'directory in: systemd stops units in reverse start order.'; \
    grep -q '^After=bootc-finalize-staged.service$' \
        /usr/lib/systemd/system/rime-boot-count.service; \
    : 'And it must NOT carry a SELinuxContext=. /usr/libexec is bin_t, which'; \
    : 'systemd transitions to unconfined_service_t; forcing bootupd_t there'; \
    : 'confines a process that was already unconfined into a domain that'; \
    : 'cannot read /proc/cmdline. Measured in a guest, then reverted.'; \
    : 'Written as an if, not as `! grep`: errexit does not apply to an'; \
    : 'inverted command, so `! grep ...` in the middle of a chain fails'; \
    : 'nothing. tests/check-containerfile-assertions.sh caught this one.'; \
    if grep -q '^SELinuxContext=' /usr/lib/systemd/system/rime-boot-count.service; then \
        echo "FATAL: rime-boot-count.service sets SELinuxContext; bootupd_t cannot read /proc/cmdline" >&2; \
        exit 1; \
    fi; \
    : 'Nothing in the shipped payload may touch a real boot path. Matched on'; \
    : 'the executable lines only: a comment naming the command it refuses to'; \
    : 'run must not fail this, and the units and helper both contain such'; \
    : 'comments on purpose.'; \
    ! grep -nE '^[^#]*\b(bootctl[[:space:]]+(install|update)|bootupctl|grub2-install|efibootmgr[[:space:]]+-[cBo])' \
        /usr/libexec/rime-boot-health \
        /usr/libexec/rime-boot-count \
        /usr/lib/systemd/system/rime-boot-health.service \
        /usr/lib/systemd/system/rime-boot-notice.service \
        /usr/lib/systemd/system/rime-boot-count.service \
        /usr/lib/systemd/system/systemd-bless-boot.service.d/10-rime-bless-boot-esp.conf

# ── §22: the in-place move to systemd-boot ──────────────────────────────────
#
# rime-boot-migrate is what `rime update` runs on a GRUB machine. It converts
# the machine in place — `bootc install to-existing-root --composefs-backend
# --bootloader systemd`, with a throwaway FAT filesystem bound over
# /target/boot so bootc's wipe of "the bootloader state" cannot reach the real
# one — and commits with a single BootNext write. Everything it does before
# that write is discardable; a power cut anywhere in it leaves a machine that
# boots exactly what it booted before. Measured, with the power actually cut:
# ROADMAP/evidence/sdboot-migrate-20260921-lab.md.
#
# The confirm unit is the other half. BootNext is a one-shot, so a migration
# that is committed and never confirmed reverts to GRUB by itself; the unit
# writes BootOrder on a boot that worked, and records a FAILURE on a boot that
# came back to GRUB, which is what stops `rime update` re-arming a loader that
# has already failed once.
#
# Its dependencies are in the image, not assumed: the install runs as a
# container of the booted image (podman), the staging filesystem is FAT
# (mkfs.vfat), and /etc is carried across with rsync. precheck refuses without
# them rather than failing halfway, but a refusal on every machine would make
# the feature dead, so the packages are asserted here.
# rsync is NOT in fedora-bootc, and the assertion below is what found that out
# — the hard way, in `base`, after core had already spent 66 minutes. podman,
# mkfs.vfat, efibootmgr and unshare all come from the base image; rsync does
# not, and nothing here installed it, so the assertion was one that could never
# pass. That is the family this repository has lost five days of builds to.
#
# It is a real dependency rather than a convenience: the migration carries /etc
# with `rsync -aAXH --delete`, and every one of those letters is load-bearing —
# A for ACLs, X for xattrs (which is where the SELinux contexts live), H for
# hardlinks, --delete so a stale file from the old /etc does not survive into
# the new deployment. `cp -a` cannot do --delete and `tar` would need the whole
# tree staged twice.
#
# Cost, stated rather than buried: 913 KB installed, in `base`, so every tier
# above it carries it. Cheap against a migration that refuses on every machine.
RUN dnf5 -y install rsync && dnf5 clean all && rm -rf /var/cache/libdnf5

COPY --chmod=0755 files/system/libexec/rime-boot-migrate \
     /usr/libexec/rime-boot-migrate
COPY files/system/units/rime-boot-migrate-confirm.service \
     /usr/lib/systemd/system/rime-boot-migrate-confirm.service
RUN set -eux; \
    test -x /usr/libexec/rime-boot-migrate; \
    bash -n /usr/libexec/rime-boot-migrate; \
    \
    : '── what the migration needs at runtime, in the image ──'; \
    command -v podman; \
    command -v mkfs.vfat; \
    command -v rsync; \
    command -v efibootmgr; \
    command -v unshare; \
    \
    systemctl enable rime-boot-migrate-confirm.service; \
    test -L /etc/systemd/system/multi-user.target.wants/rime-boot-migrate-confirm.service; \
    \
    : '── the confirm unit must not be able to run on a machine that never'; \
    : '── started a migration: its condition is the state file the stage'; \
    : '── writes, and nothing else creates it.'; \
    grep -q '^ConditionPathExists=/var/lib/rime/boot-migrate/phase$' \
        /usr/lib/systemd/system/rime-boot-migrate-confirm.service; \
    \
    : '── Wants=, not Requires=, on boot-complete.target. On the first boot'; \
    : '── of a migrated machine the entry carries no boot counter, so'; \
    : '── systemd-bless-boot is condition-skipped and nothing else pulls that'; \
    : '── target in. Requires= would mean the confirm never runs and the'; \
    : '── machine silently reverts to GRUB on the next boot.'; \
    grep -q '^Wants=boot-complete.target$' \
        /usr/lib/systemd/system/rime-boot-migrate-confirm.service; \
    if grep -q '^Requires=boot-complete.target' \
        /usr/lib/systemd/system/rime-boot-migrate-confirm.service; then \
        echo "FATAL: confirm requires a target that a migrated machine may never reach" >&2; \
        exit 1; \
    fi; \
    \
    : '── the commit point is BootNext and nothing else. An efibootmgr that'; \
    : '── wrote BootOrder during the stage would change what the machine'; \
    : '── boots before anything had been verified. Matched on executable'; \
    : '── lines only; the file explains both commands in comments.'; \
    if grep -nE '^[^#]*efibootmgr[^|]*--bootorder' /usr/libexec/rime-boot-migrate | \
       grep -q 'cmd_stage'; then \
        echo "FATAL: the stage writes BootOrder" >&2; exit 1; \
    fi; \
    grep -q 'efibootmgr --bootnext' /usr/libexec/rime-boot-migrate; \
    grep -q 'create-only' /usr/libexec/rime-boot-migrate

# ── L-003: the disk-encryption key slots ────────────────────────────────────
#
# The installer calls this to put key slots on an encrypted volume:
#
#     /usr/libexec/rime-luks-enroll --device <dev> --recovery-out <path>
#
# A recovery key ALWAYS, and a TPM2 slot only where the machine can actually
# enforce one — which today means Secure Boot enabled, and never with the bare
# `--tpm2-device=auto` form that binds to no PCRs at all while exiting 0.
#
# It is NOT enabled by anything here and no unit runs it. There is no timer, no
# generator and no first-boot hook: it does something irreversible to a disk, so
# the only thing that may call it is a caller that already decided to.
COPY --chmod=0755 files/system/libexec/rime-luks-enroll \
     /usr/libexec/rime-luks-enroll
RUN set -eux; \
    test -x /usr/libexec/rime-luks-enroll; \
    bash -n /usr/libexec/rime-luks-enroll; \
    \
    : '── the three programs it names by absolute path must be here ──'; \
    : 'It hardcodes them deliberately: it runs as root from the installer,'; \
    : 'and a program name that came from the environment would be a hole.'; \
    : 'So the paths it hardcodes have to be the paths this image has.'; \
    test -x /usr/sbin/cryptsetup; \
    test -x /usr/bin/systemd-cryptenroll; \
    test -x /usr/bin/python3; \
    : 'systemd-cryptenroll cannot unseal a TPM2 token without the LUKS2'; \
    : 'token handler, and that ships in a different package from the'; \
    : 'binary. Without it a TPM-bound volume asks for a passphrase at every'; \
    : 'boot and the enrolment looks like it silently did nothing.'; \
    test -f /usr/lib64/cryptsetup/libcryptsetup-token-systemd-tpm2.so; \
    : '--with-pin reads this parts lockout counters off the chip rather'; \
    : 'than quoting numbers from documentation, and needs tpm2-tools to.'; \
    : 'MEASURED 2026-09-20: tpm2-tools reaches this image only as a'; \
    : 'dependency of clevis (rpm -q --whatrequires tpm2-tools -> clevis) and'; \
    : 'is pinned by no line in Containerfile.core. If this assertion is what'; \
    : 'failed your build, clevis stopped pulling it in: add tpm2-tools to'; \
    : 'core explicitly rather than deleting this line, or --with-pin goes'; \
    : 'back to telling users their lockout numbers are unknown.'; \
    test -x /usr/bin/tpm2_getcap; \
    \
    : '── it must never bind a PCR this program has ruled out ──'; \
    : 'PCR 0 moves on a firmware update and would strand a user on a BIOS'; \
    : 'update. The match is on EXECUTABLE lines only: the file explains at'; \
    : 'length why PCR 0 is not used, and a tripwire a comment can trip is a'; \
    : 'tripwire nobody can keep green.'; \
    if grep -nE "^[^#]*--tpm2-(public-key-)?pcrs=[^ ]*\\b0\\b" \
        /usr/libexec/rime-luks-enroll; then \
        echo "FATAL: rime-luks-enroll binds PCR 0" >&2; exit 1; \
    fi; \
    : '── and it must never enrol without naming its PCRs ──'; \
    : 'The bare form exits 0 and seals to the storage key and nothing else.'; \
    : 'MEASURED on systemd 258.10: tpm2-pcrs [], policy hash 32 zero bytes.'; \
    if grep -nE "^[^#]*--tpm2-device=" /usr/libexec/rime-luks-enroll \
        | grep -vE "POLICY_ARGS|tpm2-pcrs|--tpm2-device=PATH|unlock-tpm2-device"; then \
        echo "FATAL: an enrolment names a TPM2 device with no PCR selection beside it" >&2; \
        exit 1; \
    fi; \
    \
    : '── nothing shipped may touch a real boot path ──'; \
    if grep -nE "^[^#]*\\b(bootctl[[:space:]]+(install|update)|bootupctl|grub2-install|efibootmgr[[:space:]]+-[cBo])" \
        /usr/libexec/rime-luks-enroll; then \
        echo "FATAL: rime-luks-enroll runs a boot-path command" >&2; exit 1; \
    fi

# ── §48: the disk-health warning ────────────────────────────────────────────
# A USER timer, because notify-send needs a session bus and root has none. It
# is ENABLED by default, unlike rime-agentd and rime-aid: those start a daemon
# that holds resources, this runs one read-only pass a day and says nothing
# unless a disk has something to report. A warning mechanism nobody switched on
# is a warning mechanism that does not exist.
COPY files/system/libexec/rime-storage-notice /usr/libexec/rime-storage-notice
COPY files/system/units/rime-storage-notice.service \
     /usr/lib/systemd/user/rime-storage-notice.service
COPY files/system/units/rime-storage-notice.timer \
     /usr/lib/systemd/user/rime-storage-notice.timer
RUN set -eux; \
    chmod 0755 /usr/libexec/rime-storage-notice; \
    bash -n /usr/libexec/rime-storage-notice; \
    : '── the tool it depends on has to be in this image ──'; \
    : 'rime storage reads sysfs for everything but the SMART log, and'; \
    : 'smartctl is what reads that. Without it every wear row is'; \
    : 'unavailable, which is honest and useless.'; \
    test -x /usr/sbin/smartctl; \
    : 'The notice is a desktop notification and nothing else can send one.'; \
    command -v notify-send; \
    systemctl --global enable rime-storage-notice.timer; \
    test -L /etc/systemd/user/timers.target.wants/rime-storage-notice.timer; \
    : '── and it must NOT be a system unit ──'; \
    : 'A system unit reaching for a session bus either fails or finds the'; \
    : 'wrong user, and the warning goes to somebody who cannot act on it.'; \
    test ! -e /usr/lib/systemd/system/rime-storage-notice.service; \
    echo "rime-storage-notice enabled as a user timer"

# ── shared-machine recipes: guest disposability and kiosk (P2-016) ──────────
#
# Everything here ships INERT. No guest account is created, no kiosk config is
# installed over the login path, and the wipe unit has no WantedBy. That is the
# third criterion as a build fact rather than a promise: "kiosk/shared-device
# policy is possible without weakening ordinary desktop use" is a claim about
# the ORDINARY path, so the ordinary path is untouched and the assertions below
# say so.
#
# The engine exists because a tmpfs home is not disposability on Rime. P0-002
# moved credentials out of the home into /var/lib/rime-secretd/users/<uid>/,
# root-owned and unreadable by the account, and that directory survives a home
# wipe — so the next guest inherits the previous one's credentials and grants.
# See files/system/shared-machine/README.md.
COPY files/system/libexec/rime-guest-wipe /usr/libexec/rime-guest-wipe
COPY files/system/units/rime-guest-wipe@.service \
     /usr/lib/systemd/system/rime-guest-wipe@.service
COPY files/system/units/rime-guest-session@.service \
     /usr/lib/systemd/system/rime-guest-session@.service
COPY files/system/shared-machine/guest-accounts /etc/rime/guest-accounts
COPY files/system/shared-machine/greetd-kiosk.toml \
     /usr/share/rime/shared-machine/greetd-kiosk.toml
COPY files/system/shared-machine/sway-kiosk.conf \
     /usr/share/rime/shared-machine/sway-kiosk.conf
COPY files/system/shared-machine/README.md \
     /usr/share/rime/shared-machine/README.md
RUN set -eux; \
    chmod 0755 /usr/libexec/rime-guest-wipe; \
    bash -n /usr/libexec/rime-guest-wipe; \
    : '── the allowlist ships empty, and that is the whole fence ──'; \
    : 'The engine refuses every account not named here. A Rime with no'; \
    : 'guest configured cannot be talked into wiping anything, whatever'; \
    : 'it is handed, so a stray name in this file is a shipped hazard.'; \
    test -f /etc/rime/guest-accounts; \
    if grep -qE '^[[:space:]]*[^#[:space:]]' /etc/rime/guest-accounts \
        ; then echo "FATAL: the guest allowlist ships non-empty, so a named account can be wiped"; exit 1; fi; \
    : '── the wipe unit is installed and NOT enabled ──'; \
    test -f /usr/lib/systemd/system/rime-guest-wipe@.service; \
    test ! -e /etc/systemd/system/multi-user.target.wants/rime-guest-wipe@.service; \
    grep -q '^SuccessExitStatus=0 2$' /usr/lib/systemd/system/rime-guest-wipe@.service; \
    : '── the session-end hook: installed, not enabled, and LOUD ──'; \
    : 'The two units differ in exactly one judgement and it is not cosmetic.'; \
    : 'The boot sweep above treats a refusal as success, because on a machine'; \
    : 'with no guest configured refusing IS the right answer. The hook below'; \
    : 'is only ever enabled for an account that is a configured guest, so a'; \
    : 'refusal there means the guest left credentials behind -- it must fail'; \
    : 'loudly, and a copied SuccessExitStatus would make it green instead.'; \
    test -f /usr/lib/systemd/system/rime-guest-session@.service; \
    if grep -q '^SuccessExitStatus' /usr/lib/systemd/system/rime-guest-session@.service \
        ; then echo "FATAL: a copied SuccessExitStatus would turn a guest-wipe refusal green"; exit 1; fi; \
    : 'And it must hang off the unit logind actually stops. Binding to the'; \
    : 'user slice never fires: logind does not stop user-<uid>.slice, and a'; \
    : 'unit that BindsTo it keeps it from being collected, so the trigger the'; \
    : 'hook is waiting for is the one the hook prevents. Measured on the L16.'; \
    grep -q '^BindsTo=user-runtime-dir@%i.service$' \
         /usr/lib/systemd/system/rime-guest-session@.service; \
    grep -q '^WantedBy=user-runtime-dir@%i.service$' \
         /usr/lib/systemd/system/rime-guest-session@.service; \
    if grep -qE '^(BindsTo|WantedBy)=user-%i\.slice$' \
         /usr/lib/systemd/system/rime-guest-session@.service \
        ; then echo "FATAL: the session hook binds to user-%i.slice, which logind never stops"; exit 1; fi; \
    test -z "$(find /etc/systemd/system -name 'rime-guest-session@*.service' -print -quit)"; \
    : '── the kiosk config is a recipe, and lands where recipes land ──'; \
    : 'greetd reads exactly one file, /etc/greetd/config.toml, and the'; \
    : 'assertion that it carries no auto-login is NOT made here: this stanza'; \
    : 'runs 1300 lines before the COPY that creates that file, so a grep'; \
    : 'against it would pass vacuously -- the exact defect'; \
    : 'check-containerfile-assertions.sh was written for after four of them'; \
    : 'shipped. It is made just after that COPY instead, where the file is'; \
    : 'real, and tests/test-rime-shared-machine.sh asserts it against the'; \
    : 'source file too and watches it go red.'; \
    test -f /usr/share/rime/shared-machine/greetd-kiosk.toml; \
    test -f /usr/share/rime/shared-machine/sway-kiosk.conf; \
    : 'The recipe must at least be a kiosk: a default_session greetd will'; \
    : 'restart, not an initial_session that fires once per boot.'; \
    grep -qE '^[[:space:]]*\[default_session\]' /usr/share/rime/shared-machine/greetd-kiosk.toml; \
    if grep -qE '^[[:space:]]*\[initial_session\]' /usr/share/rime/shared-machine/greetd-kiosk.toml \
        ; then echo "FATAL: the kiosk recipe fires once per boot instead of restarting"; exit 1; fi; \
    echo "shared-machine recipes installed, inert"

# ── rime user: the surface that can create a STANDARD account (P2-016) ───────
#
# The standard/administrator distinction was enforced on Rime long before it
# could be reached: installer/rime-install puts the one account it creates in
# `wheel` unconditionally and the GUI offers no choice, so every account Rime
# had ever made was an administrator. This is the engine behind `rime user`.
COPY --chmod=0755 files/system/libexec/rime-user /usr/libexec/rime-user
RUN set -eux; \
    bash -n /usr/libexec/rime-user; \
    : '── the default is STANDARD, and that is one line ──'; \
    : 'Each grep is anchored to an EXECUTABLE line (^[^#]*), because this'; \
    : 'file discusses every one of these decisions at length in its own'; \
    : 'comments and a check its own prose can satisfy proves nothing — this'; \
    : 'repository has shipped five of those.'; \
    grep -qE '^[^#]*ADMIN_GROUP=wheel' /usr/libexec/rime-user; \
    : 'wheel is added only under the --admin branch. If this ever became'; \
    : 'unconditional, every account rime user makes could approve a root'; \
    : 'operation, and nothing would say so.'; \
    grep -qE '^[^#]*\[ "\$admin" = 1 \] && argv\+=\(-G "\$ADMIN_GROUP"\)' \
        /usr/libexec/rime-user; \
    test "$(grep -cE '^[^#]*-G "\$ADMIN_GROUP"' /usr/libexec/rime-user)" = 1; \
    : '── the refusal there is no recovery from ──'; \
    : 'polkit auth_admin and sudo both resolve to wheel, so a Rime with no'; \
    : 'member of it left cannot approve anything or become root again from'; \
    : 'inside the running system.'; \
    grep -qE '^[^#]*only administrator on this machine' /usr/libexec/rime-user; \
    : '── the test override is not a way into a privileged run ──'; \
    grep -qE '^[^#]*RIME_USER_TOOLS is set and this is running as root' \
        /usr/libexec/rime-user; \
    : '── it is not setuid; it is meant to be reached through sudo ──'; \
    test ! -u /usr/libexec/rime-user; \
    test ! -g /usr/libexec/rime-user; \
    echo "rime-user installed: add makes a standard account"

# ── fast user switching (P2-016 criterion 1) ─────────────────────────────────
#
# Two rounds of P2-016 measured per-account isolation on a real second account.
# The SWITCHING half had no surface at all: greetd runs one session on one VT,
# and switching users meant logging out. These three files are that surface.
#
# rime-switch-user decides (activate an existing session, or open a login
# screen) and needs no privilege. rime-switch-greeter starts a SECOND greetd
# instance on a spare VT and does, so it is reached through one argument-free
# NOPASSWD sudoers rule. The unit is the instance greetd runs in.
#
# The thing this stanza is really guarding is greetd.service. It is
# display-manager.service and it is the machine's only way in; a switch greeter
# that could be enabled, pulled in by a target, or answer to
# display-manager.service would be a second thing racing for VT 1.
COPY --chmod=0755 files/system/libexec/rime-switch-user /usr/libexec/rime-switch-user
COPY --chmod=0755 files/system/libexec/rime-switch-greeter /usr/libexec/rime-switch-greeter
COPY files/system/units/rime-switch-greeter@.service \
     /usr/lib/systemd/system/rime-switch-greeter@.service
COPY files/system/sudoers/rime-switch-greeter /etc/sudoers.d/050-rime-switch-greeter
RUN set -eux; \
    bash -n /usr/libexec/rime-switch-user; \
    bash -n /usr/libexec/rime-switch-greeter; \
    : '── the unit cannot become the login path ──'; \
    if grep -qE '^\[Install\]' /usr/lib/systemd/system/rime-switch-greeter@.service \
        ; then echo "FATAL: the switch greeter can be enabled"; exit 1; fi; \
    if grep -qE '^Alias=' /usr/lib/systemd/system/rime-switch-greeter@.service \
        ; then echo "FATAL: the switch greeter aliases something"; exit 1; fi; \
    grep -qE '^ConditionPathExists=/run/rime-switch-greeter/%i\.toml$' \
        /usr/lib/systemd/system/rime-switch-greeter@.service; \
    grep -qE '^Conflicts=getty@tty%i\.service$' \
        /usr/lib/systemd/system/rime-switch-greeter@.service; \
    grep -qE '^Restart=no$' /usr/lib/systemd/system/rime-switch-greeter@.service; \
    : 'greetd is what the unit execs, and this is the image that has to have'; \
    : 'it. A unit pointing at an absent binary would fail at the one moment'; \
    : 'nobody can debug it: when somebody asked to switch user.'; \
    test -x /usr/bin/greetd; \
    : 'and it is enabled nowhere'; \
    test -z "$(ls -d /etc/systemd/system/*.wants/rime-switch-greeter@* \
                     /usr/lib/systemd/system/*.wants/rime-switch-greeter@* 2>/dev/null)"; \
    : '── the sudoers grant ──'; \
    chown root:root /etc/sudoers.d/050-rime-switch-greeter; \
    chmod 0440 /etc/sudoers.d/050-rime-switch-greeter; \
    visudo -cf /etc/sudoers.d/050-rime-switch-greeter; \
    : 'ALL, not %wheel: a STANDARD account being able to switch users is the'; \
    : 'criterion. A grant restricted to wheel would mean only administrators'; \
    : 'can share the machine.'; \
    grep -qE '^ALL ALL=\(root\) NOPASSWD: /usr/libexec/rime-switch-greeter ""$' \
        /etc/sudoers.d/050-rime-switch-greeter; \
    : 'the empty string is the whole grant: the helper takes no arguments'; \
    : 'because an argument is a thing the caller chooses.'; \
    if grep -qE '^[^#]*%wheel' /etc/sudoers.d/050-rime-switch-greeter \
        ; then echo "FATAL: only administrators could switch users"; exit 1; fi; \
    : '── the fences that make the grant safe ──'; \
    grep -qE '^[^#]*only the session currently at the keyboard may open a login screen' \
        /usr/libexec/rime-switch-greeter; \
    grep -qE '^[^#]*RIME_SWITCH_GREETER_TOOLS is set and this is running as root' \
        /usr/libexec/rime-switch-greeter; \
    grep -qE '^[^#]*RIME_SWITCH_TOOLS is set and this is running as root' \
        /usr/libexec/rime-switch-user; \
    : 'the lock is WAITED for. `loginctl lock-session` is a request; LockedHint'; \
    : 'is the answer, and this repository has a standing record of that hint'; \
    : 'answering no on a session that was locked. A switch that ran first'; \
    : 'would hand the next person an unlocked desktop.'; \
    grep -qE '^[^#]*hint="\$\(prop "\$\(session_blob "\$id"\)" LockedHint\)"' \
        /usr/libexec/rime-switch-user; \
    test ! -u /usr/libexec/rime-switch-user; \
    test ! -g /usr/libexec/rime-switch-greeter; \
    : '── the SHIPPED login config is not a kiosk, checked on the real image ──'; \
    : 'Both engines refuse to switch on a machine whose greetd runs a real'; \
    : "account's session instead of the greeter. That refusal is read off the"; \
    : 'live config, so it is only correct if the greeter user really is a'; \
    : 'system account here.'; \
    test "$(id -u greetd)" -lt 1000; \
    echo "fast user switching installed: engine, helper, unit, sudoers"

COPY files/system/libexec/rime-boot-windows /usr/libexec/rime-boot-windows
COPY files/system/sudoers/rime-boot-windows /etc/sudoers.d/020-rime-boot-windows
RUN set -eux; \
    test -x /usr/sbin/efibootmgr -o -x /usr/bin/efibootmgr; \
    chmod 0755 /usr/libexec/rime-boot-windows; \
    bash -n /usr/libexec/rime-boot-windows; \
    # sudoers files are parsed by a setuid binary: wrong mode or a syntax error is
    # refused at RUNTIME, which would mean a password prompt no compositor-spawned
    # script can answer. visudo -c turns that into a build failure instead.
    chown root:root /etc/sudoers.d/020-rime-boot-windows; \
    chmod 0440 /etc/sudoers.d/020-rime-boot-windows; \
    visudo -cf /etc/sudoers.d/020-rime-boot-windows; \
    # rime-shell main now calls /usr/libexec/rime-boot-windows itself (upstream
    # 412d5b2), so this sed is a BACKWARD-COMPAT SHIM, not the fix: it only does
    # anything when RIME_SHELL_REF pins a shell older than that commit. Kept so
    # pinning an old ref still produces a working button rather than a dead one.
    # LIVE lines only, for both the rewrite and the check — the fourth time this
    # pattern has bitten in this repo (see the (unset) postcondition, the
    # bash-only-test-syntax check and the fastfetch guard). Rewriting comments made
    # the sed edit upstream's own explanation of the bug into a false statement, and
    # checking them made a correctly-fixed upstream file fail the guard.
    P=/usr/share/rime-shell/src/scripts/PowerControl.sh; \
    # Record whether this is a PRE-probe shell before rewriting, so the guard below
    # can tell "someone pinned an old release" apart from "main regressed".
    PRE_PROBE=0; \
    if grep -vE '^[[:space:]]*#' "$P" | grep -q 'caelestia-boot-windows'; then PRE_PROBE=1; fi; \
    sed -i '/^[[:space:]]*#/!s|/usr/local/bin/caelestia-boot-windows|/usr/libexec/rime-boot-windows|g' "$P"; \
    if grep -vE '^[[:space:]]*#' "$P" | grep -q 'caelestia-boot-windows'; then \
        echo "FATAL: PowerControl.sh still calls the dead /usr/local helper path"; exit 1; \
    fi; \
    grep -q '/usr/libexec/rime-boot-windows' "$P"; \
    # The probe action PowerMenu uses to decide whether to show the Windows row. If
    # an upstream refactor drops it the probe fails, the row is hidden, and the
    # button silently disappears for everyone — indistinguishable from "you have no
    # Windows", which is the exact silent-regression class this file exists to catch.
    #
    # But a shell pinned from BEFORE the probe existed legitimately does not have it,
    # and RIME_SHELL_REF exists precisely so an old release can be rebuilt
    # reproducibly. Failing that build would be obstructive and wrong — the button
    # was already dead in those refs. So: hard failure only when this is a
    # post-fix shell that LOST the probe; a warning when an old ref was pinned.
    if ! grep -q 'windows-check' "$P"; then \
        if [ "$PRE_PROBE" = 1 ]; then \
            echo "WARN: pinned rime-shell predates the windows-check probe — the Windows row will stay hidden in this image"; \
        else \
            echo "FATAL: PowerControl.sh has no windows-check action — PowerMenu would hide the Windows row on every machine"; exit 1; \
        fi; \
    else \
        grep -q 'windows-check' /usr/share/rime-shell/src/services/PowerMenu.qml; \
    fi; \
    bash -n "$P"; \
    # ── the shell scripts' compositor adapter must arrive with them ─────────
    # PowerControl.sh and DpmsControl.sh SOURCE src/scripts/compositor.sh, and
    # every action in both runs through its rime_run(). A tree that carries the
    # source line without the file has a power menu where NOTHING works —
    # strictly worse than the three labwc no-ops the adapter was added to fix,
    # and invisible to every check above, which only ever named PowerControl.sh.
    #
    # Keyed on the source line, not on the words "compositor.sh": both scripts
    # discuss the adapter in comments, and a check a comment can satisfy is a
    # check this repo has already shipped five times.
    #
    # A ref pinned from before the adapter simply has no source line and is left
    # alone with a warning — RIME_SHELL_REF exists so an old release can be
    # rebuilt, and labwc's logout and idle screen-off were already dead there.
    if grep -qE '^[[:space:]]*\.[[:space:]].*compositor\.sh' "$P"; then \
        C="${P%/*}/compositor.sh"; \
        test -s "$C" \
            || { echo "FATAL: PowerControl.sh sources compositor.sh but the vendored tree has no such file"; exit 1; }; \
        bash -n "$C"; \
        grep -qE '^rime_run\(\)' "$C" \
            || { echo "FATAL: vendored compositor.sh defines no rime_run; every power-menu action would call an undefined function"; exit 1; }; \
        grep -qE '^[[:space:]]*\.[[:space:]].*compositor\.sh' "${P%/*}/DpmsControl.sh" \
            || { echo "FATAL: DpmsControl.sh does not use the compositor adapter; idle screen-off would be compositor-blind again"; exit 1; }; \
        echo "shell-script compositor adapter vendored and sourced by both consumers"; \
    else \
        echo "WARN: pinned rime-shell predates src/scripts/compositor.sh — the labwc session has no working Log Out and no idle screen-off in this image"; \
    fi; \
    echo "windows boot helper installed; PowerControl.sh + PowerMenu probe verified"

# The config UI shows the shell version via `git -C <shellDir> describe`, which
# returns nothing now that .git is gone (the field would read "…" forever). Fall
# back to the commit file written above. Cosmetic, so a non-matching upstream
# refactor warns instead of failing the build.
RUN set -eux; \
    F=/usr/share/rime-shell/src/services/config_tab/pages/MiscPage.qml; \
    if grep -q 'describe --tags --always 2>/dev/null' "$F"; then \
        sed -i 's|describe --tags --always 2>/dev/null|describe --tags --always 2>/dev/null \|\| cut -c1-12 $1/.rime-shell-commit 2>/dev/null|' "$F"; \
        # $1 is left UNQUOTED on purpose: the replacement is spliced into a QML
        # string literal, and adding quotes here would need QML-level escaping
        # (\") -- getting that wrong is a syntax error that takes out the whole
        # config page. shellDir is an image-controlled path with no spaces.
        # Verified by loading a patched read-only tree in quickshell.
        awk '/describe --tags/{n=gsub(/"/,"\""); exit (n%2)}' "$F"; \
        echo "MiscPage version falls back to .rime-shell-commit"; \
    else \
        echo "WARN: MiscPage version command changed upstream — version display may read '…'"; \
    fi

# ── Stage 5c: Rime Shell per-user provisioner ──────────────────────────────
# Seeds each user's config on login. No longer clones anything: the shell itself
# lives in /usr/share/rime-shell (Stage 5b2 above), so this is pure local file
# seeding — no network, no marker, no race. Enabled globally so it runs for every
# user.
COPY files/system/units/rime-shell-firstrun.service \
     /usr/lib/systemd/user/rime-shell-firstrun.service
COPY files/system/libexec/rime-shell-firstrun /usr/libexec/rime-shell-firstrun
# The one-time move of an APEX-era account to its Rime OS names (state, config,
# data, cache, Hyprland, the shell's own directories, user units). A user unit
# ordered before basic.target, so it runs before rime-remoted could mint a new
# identity key (which would unpair every phone) and before the compositor starts.
COPY --chmod=0755 files/system/libexec/rime-session-migrate /usr/libexec/rime-session-migrate
COPY files/system/units/rime-session-migrate.service /usr/lib/systemd/user/rime-session-migrate.service
# Idempotent launcher for hypridle + quickshell. Kept after vendoring because it
# still owns two things: preferring the user's own ~/.config/hypr/hypridle.conf
# over the image copy, and refusing to start a second instance (which is what lets
# the provisioner safely re-invoke it to repair a live session).
COPY --chmod=0755 files/system/libexec/rime-shell-autostart \
     /usr/libexec/rime-shell-autostart

# Desktop context-menu helpers. The menu itself is one QML surface shared by all
# three sessions; these three scripts are where the per-compositor differences
# live, so the QML never has to know which compositor it is running under.
#
#   rime-desktop-menu      right-click entry point; restarts a dead shell rather
#                          than leaving the user with no menu at all
#   rime-compositor-reload labwc --reconfigure / hyprctl reload / niri validate
#   rime-session-logout    loginctl first, compositor exit verb as the fallback
COPY --chmod=0755 files/system/libexec/rime-desktop-menu \
     /usr/libexec/rime-desktop-menu
COPY --chmod=0755 files/system/libexec/rime-compositor-reload \
     /usr/libexec/rime-compositor-reload
COPY --chmod=0755 files/system/libexec/rime-session-logout \
     /usr/libexec/rime-session-logout

# Settings generators. Each takes ONE Rime model and writes whatever the three
# compositors need, so a settings page never has to know which one is running.
#
#   rime-input-apply    -> Hyprland rime/input.lua + niri KDL + the <libinput>
#                          element inside labwc's rc.xml. labwc has no include
#                          mechanism, which is why its half is an in-place span
#                          replacement rather than a generated file.
#   rime-display-apply  -> Hyprland rime/monitors.lua + a kanshi profile, applied
#                          live through hyprctl or wlr-randr. Two actions on
#                          purpose: `save` writes persistence only, `apply`
#                          also reaches the RUNNING compositor. Only `apply`
#                          touches hardware.
#   rime-labwc-keybinds -> the <keybind> region of labwc's rc.xml, generated
#                          from the same model the shell writes Hyprland .conf
#                          and niri .kdl from. Before it, a labwc user could
#                          rebind a shortcut, watch the UI confirm it, and get
#                          nothing: the three files the shell writes are all
#                          read by compositors labwc is not.
COPY --chmod=0755 files/system/libexec/rime-input-apply \
     /usr/libexec/rime-input-apply
COPY --chmod=0755 files/system/libexec/rime-display-apply \
     /usr/libexec/rime-display-apply
COPY --chmod=0755 files/system/libexec/rime-labwc-keybinds \
     /usr/libexec/rime-labwc-keybinds
# Not a generator: the one-way move from the hyprlang config every earlier image
# seeded to the Lua module layout. Run by rime-shell-firstrun on every login and
# idempotent by construction, so it converts an upgraded machine once and is a
# no-op thereafter.
COPY --chmod=0755 files/system/libexec/rime-hypr-migrate \
     /usr/libexec/rime-hypr-migrate

# Agent Center helpers. Both exist so Rime Shell never has to know which
# compositor is running (§6's adapter-layer rule) and never has to decide
# anything about privilege (§4).
#
#   rime-agent-focus   session id -> the terminal attached to it, focused.
#                      Resolved through the process tree, because a session has
#                      no window: agentd owns the PTY and a terminal merely
#                      attaches. Opens one when there is none.
#   rime-agent-review  opens a terminal on one privilege request. Approving
#                      performs the operation with the reviewing human's own
#                      root, so it must happen where sudo can authenticate and
#                      the whole prompt is visible — never behind a button.
COPY --chmod=0755 files/system/libexec/rime-agent-focus \
     /usr/libexec/rime-agent-focus
COPY --chmod=0755 files/system/libexec/rime-agent-review \
     /usr/libexec/rime-agent-review

# Project window layouts (§6). The only compositor-specific input to
# `rime project layout`, which is why it is a separate program: replacing it is
# how the layout suite becomes deterministic and runnable with no compositor.
COPY --chmod=0755 files/system/libexec/rime-project-windows \
     /usr/libexec/rime-project-windows

# The multiplexer adapter, in the same shape and for the same reason as the
# compositor one above: `rime project layout open` builds an editor/agent/
# terminal layout, and tmux and zellij are the only per-backend part of that.
# Keeping them here means the CLI carries no tmux or zellij knowledge and the
# tests have one program to fake.
COPY --chmod=0755 files/system/libexec/rime-mux /usr/libexec/rime-mux
# Only what exists at this point in the build. The cross-checks against
# /usr/share/rime/labwc/rc.xml live in the labwc section that populates it —
# asserting a path before its COPY is a build failure, and this block did
# exactly that until it was caught by reading the layer order.
RUN set -eux; \
    for h in rime-desktop-menu rime-compositor-reload rime-session-logout; do \
        test -x "/usr/libexec/$h"; \
        bash -n "/usr/libexec/$h"; \
    done; \
    for g in rime-input-apply rime-display-apply rime-labwc-keybinds rime-hypr-migrate; do \
        test -x "/usr/libexec/$g"; \
        python3 -c 'import ast,sys; ast.parse(open(sys.argv[1]).read())' "/usr/libexec/$g"; \
    done; \
    # The hyprlang -> Lua migration, over a config with Rime defaults, user
    # rebinds, user settings and directives that cannot be converted. It asserts
    # both halves that matter: a Rime default is recognised and dropped rather
    # than duplicated, and an unconvertible line survives verbatim. A migration
    # that quietly loses a user's keybinds is the one failure here that cannot
    # be undone from the machine it happens on.
    /usr/libexec/rime-hypr-migrate --self-test; \
    # The input generator's self-test runs every installed compositor's own
    # validator over its output. Names are verified rather than remembered
    # because labwc ignores an unknown element in silence — which is how
    # <tapToClick> shipped doing nothing at all.
    /usr/libexec/rime-input-apply --self-test; \
    # The display generators are pure functions of the model, so this asserts
    # the emitted syntax without needing outputs. RIME_DISPLAY_NO_LIVE is
    # belt-and-braces: there is no compositor in a build container, but `apply`
    # must never be reachable from a build even by accident.
    RIME_DISPLAY_NO_LIVE=1 /usr/libexec/rime-display-apply --self-test; \
    # Every verb the helpers dispatch to has to exist in the image.
    command -v labwc >/dev/null; \
    command -v niri >/dev/null; \
    command -v loginctl >/dev/null; \
    # rime-display-apply dispatches to these for the two wlroots sessions.
    command -v wlr-randr >/dev/null; \
    command -v kanshi >/dev/null; \
    # Agent Center helpers.
    test -x /usr/libexec/rime-agent-focus; \
    python3 -c 'import ast,sys; ast.parse(open("/usr/libexec/rime-agent-focus").read())'; \
    test -x /usr/libexec/rime-agent-review; \
    bash -n /usr/libexec/rime-agent-review; \
    # Both refuse a bad argument rather than guessing, and the usage text is
    # what a caller sees when the shell passes something wrong.
    if /usr/libexec/rime-agent-focus 2>/dev/null \
        ; then echo "FATAL: rime-agent-focus accepted a missing argument instead of refusing"; exit 1; fi; \
    if /usr/libexec/rime-agent-review not-a-number 2>/dev/null \
        ; then echo "FATAL: rime-agent-review accepted a non-numeric argument"; exit 1; fi; \
    # `ps` is how rime-agent-focus maps a session to a process; without it the
    # helper silently never finds a terminal and always opens a new one.
    command -v ps >/dev/null; \
    # Project window layouts.
    test -x /usr/libexec/rime-project-windows; \
    python3 -c 'import ast,sys; ast.parse(open("/usr/libexec/rime-project-windows").read())'; \
    # `list` must emit valid JSON even where the compositor cannot be queried —
    # there is no compositor in a build container, which is exactly that case.
    # The caller parses stdout, so a bare error message there would be a parse
    # failure rather than an empty layout.
    /usr/libexec/rime-project-windows list 2>/dev/null | python3 -c \
        'import json,sys; assert json.load(sys.stdin) == [], "expected an empty list"'; \
    /usr/libexec/rime-project-windows compositor >/dev/null; \
    if /usr/libexec/rime-project-windows nonsense-action 2>/dev/null \
        ; then echo "FATAL: rime-project-windows accepted an unknown action"; exit 1; fi; \
    # The multiplexer adapter. It is /bin/sh and not python3, so the parser to
    # ask is `sh -n`; and both multiplexers it drives have to be in the image,
    # because a layout template that names a program nobody installed is the
    # same defect the terminal-developer row already had once.
    test -x /usr/libexec/rime-mux; \
    sh -n /usr/libexec/rime-mux; \
    test "$(/usr/libexec/rime-mux backends | sort | tr '\n' ' ')" = "tmux zellij "; \
    if /usr/libexec/rime-mux nonsense-verb 2>/dev/null \
        ; then echo "FATAL: rime-mux accepted an unknown verb"; exit 1; fi; \
    if /usr/libexec/rime-mux has screen x 2>/dev/null \
        ; then echo "FATAL: rime-mux claims a screen backend it does not have"; exit 1; fi; \
    # A generated zellij layout that zellij's own parser rejects is the one
    # failure mode this format has, and it would only show up at somebody's
    # first `layout open`. So both arrangements are generated here and handed
    # straight back to zellij.
    printf 'editor\t/tmp\tnano\nagent\t/tmp\trime\tagent\trun\nterminal\t/tmp\n' \
        > /tmp/rime-mux-check.tsv; \
    for arr in main-vertical tiled; do \
        /usr/libexec/rime-mux kdl "$arr" /tmp/rime-mux-check.tsv > /tmp/rime-mux-check.kdl; \
        grep -q 'tab name="rime"' /tmp/rime-mux-check.kdl; \
        # Every directory zellij writes to is redirected under /tmp and removed
        # below. Without that it registers a session record in the build user's
        # ~/.cache and ~/.local/share, and the image would ship two dead zellij
        # sessions nobody created.
        if ZELLIJ_SOCKET_DIR=/tmp/rime-zcheck/sock \
          XDG_CACHE_HOME=/tmp/rime-zcheck/cache \
          XDG_DATA_HOME=/tmp/rime-zcheck/data \
          XDG_CONFIG_HOME=/tmp/rime-zcheck/config \
            timeout 30 zellij --layout-string "$(cat /tmp/rime-mux-check.kdl)" 2>&1 \
            | grep -q 'Failed to parse' \
            ; then echo "FATAL: zellij could not parse the generated layout"; exit 1; fi; \
    done; \
    rm -rf /tmp/rime-mux-check.tsv /tmp/rime-mux-check.kdl /tmp/rime-zcheck; \
    test ! -e /root/.cache/zellij; \
    echo "context menu + settings generators + agent helpers: installed and self-tested"
RUN set -eux; \
    systemctl --global enable rime-shell-firstrun.service; \
    python3 -m py_compile /usr/libexec/rime-session-migrate; \
    systemctl --global enable rime-session-migrate.service; \
    test -L /etc/systemd/user/basic.target.wants/rime-session-migrate.service

# ── Stage 5d: user packages, WITHOUT breaking OS updates ────────────────────
# The supported way to add software to a bootc system used to be `rpm-ostree
# install`, and it has one property that makes it unusable as the answer for a
# daily driver: a single layered package puts the deployment into "local
# modifications" state, and from then on
#
#   bootc upgrade  ->  error: Deployment contains local rpm-ostree modifications
#
# i.e. installing one CLI tool silently stops the OS from ever updating again.
# Worse, `--apply-live` layers are transient: a reboot threw the package away and
# the user was left with neither the tool nor a working update path.
#
# `rime install` instead builds a systemd SYSTEM EXTENSION — a squashfs image (or
# plain tree) in /var/lib/extensions that systemd overlays onto /usr. The bootc
# deployment is never touched, so updates keep working, while binaries, .desktop
# files, icons, man pages, systemd units and udev rules all land at the real /usr
# paths the rest of the OS already searches. Fedora, RPM Fusion, and explicitly
# enabled COPRs are the repository sources, so there is no Rime registry to run,
# sign or keep online; a path to a local .rpm installs that file through the same
# pipeline, with its dependencies still resolved from the repositories.
#
# The extension records the OS version it was built for and systemd refuses to
# merge a mismatched one; rime-sysext-rebuild.service turns that refusal into an
# automatic rebuild after an OS upgrade instead of vanished packages.
# ── roadmap §27: what the machine needs to verify an image itself ───────────
#
# `rime update` refuses an image whose cosign signature does not verify, and it
# does the verification with skopeo and openssl — cosign is not packaged for
# Fedora at all, so a gate built on it would be dead code on every machine this
# project ships to.
#
# `fulcio-root.pem` is the Sigstore root the signing certificate must chain to.
# It is PINNED, and shipped rather than taken from the signature, because a
# cosign signature's `chain` annotation carries Fulcio's intermediate AND root:
# verifying a certificate against a root the certificate handed you proves
# nothing at all.
#
# This file is load-bearing in the dangerous direction. Under the shipped
# default (`signature=enforce`) a root that is missing or unreadable is
# `CouldNotRun`, which REFUSES — so a build that shipped the wrong bytes here
# would refuse every update on every machine. Hence the assertions below: the
# build fails rather than the fleet.
COPY files/system/trust/fulcio-root.pem  /usr/share/rime-os/trust/fulcio-root.pem
COPY files/system/trust/enforcement.conf /usr/share/rime-os/trust/enforcement.conf
RUN set -eux; \
    # It has to be a certificate at all, and openssl has to be here to say so —
    # the same openssl the verifier will use at runtime.
    command -v openssl >/dev/null || { echo "FATAL: the trust gate needs openssl"; exit 1; }; \
    command -v skopeo  >/dev/null || { echo "FATAL: the trust gate needs skopeo"; exit 1; }; \
    openssl x509 -noout -in /usr/share/rime-os/trust/fulcio-root.pem; \
    # And it has to be THE Sigstore root, by fingerprint. Checked here because
    # the failure mode of the wrong root is not a broken feature, it is a fleet
    # that will not update: every good signature would stop chaining.
    want=3B:A7:B6:CC:4E:95:46:9D:4D:33:4B:49:CB:25:7A:D8:53:70:76:FA:84:B0:CA:87:FF:4E:CF:E6:A5:46:80:C1; \
    got="$(openssl x509 -noout -fingerprint -sha256 \
             -in /usr/share/rime-os/trust/fulcio-root.pem | sed 's/.*=//')"; \
    test "$got" = "$want" || { echo "FATAL: pinned Fulcio root is $got, expected $want"; exit 1; }; \
    # A self-signed root, i.e. actually a root and not an intermediate that
    # would need one.
    test "$(openssl x509 -noout -subject -in /usr/share/rime-os/trust/fulcio-root.pem)" \
       = "$(openssl x509 -noout -issuer  -in /usr/share/rime-os/trust/fulcio-root.pem | sed 's/^issuer=/subject=/')"; \
    # The defaults have to parse as the runtime parses them, or a typo here
    # ships a machine whose enforcement is not what this file says.
    grep -qx 'signature=enforce'  /usr/share/rime-os/trust/enforcement.conf; \
    grep -qx 'provenance=warn'    /usr/share/rime-os/trust/enforcement.conf

# squashfs-tools, explicitly, for the AppImage route below.
#
# It is already in this image — as a WEAK dependency of dracut-squash, which is
# an accident rather than a decision, and the same accident the mksquashfs note
# in the next stanza has been recording since the engine was written. Naming it
# here marks it user-installed, so an autoremove or a change in dracut's weak
# dependencies cannot take unsquashfs away and turn `rime install ./x.AppImage`
# into a runtime refusal on the user's machine.
#
# Cost, stated rather than buried: nothing measurable. The package is already
# resolved into every Rime image today, ~1.2 MB installed, and this line changes
# only whether its presence is deliberate.
RUN dnf5 -y install squashfs-tools && dnf5 clean all && rm -rf /var/cache/libdnf5

COPY --chmod=0755 files/system/libexec/rime-pkg /usr/libexec/rime-pkg
COPY files/system/units/rime-sysext-rebuild.service \
     /usr/lib/systemd/system/rime-sysext-rebuild.service
RUN set -eux; \
    bash -n /usr/libexec/rime-pkg; \
    # Every external tool the engine drives. These are asserted rather than
    # trusted because a missing one turns `rime install` into a confusing
    # runtime failure on the user's machine instead of a failed build here.
    for t in rpm rpmkeys dnf5 curl jq setfiles systemd-sysext \
             systemd-sysusers systemd-tmpfiles ldconfig od readlink sha256sum; do \
        command -v "$t" >/dev/null || { echo "FATAL: rime-pkg needs $t"; exit 1; }; \
    done; \
    # unsquashfs is how `rime install ./Thing.AppImage` reads the payload out
    # of an AppImage, and the whole reason that route needs no FUSE: this image
    # has fusermount3 but NO libfuse.so.2, no fusermount and no squashfuse, so
    # the classic AppImage runtime cannot mount itself here at all. It is
    # asserted rather than assumed because squashfs-tools reaches this image
    # only as a WEAK dependency of dracut-squash — the same accident the
    # mksquashfs note below records, and one dnf5 could drop without warning.
    command -v unsquashfs >/dev/null \
        || { echo "FATAL: rime-pkg needs unsquashfs (squashfs-tools) to install an AppImage"; exit 1; }; \
    dnf5 copr --help >/dev/null; \
    # Installing a local .rpm resolves its dependencies by asking libdnf5 which
    # requirements the running image already satisfies. That subcommand is a hard
    # dependency of the local-file path, and losing it would break only that
    # path — silently, on the user's machine — so it is asserted here.
    dnf5 repoquery --help >/dev/null; \
    # mksquashfs is preferred but genuinely optional: it reaches this image only
    # as a weak dependency of dracut-squash, so the engine falls back to a
    # directory extension. Note it rather than failing the build, and note it
    # LOUDLY so the fallback is a decision and not a surprise.
    if command -v mksquashfs >/dev/null; then \
        echo "rime-pkg: squashfs extensions available"; \
    else \
        echo "NOTE: mksquashfs absent — rime-pkg will build uncompressed directory extensions"; \
    fi; \
    # /var is machine-local and empty in the image; the engine's state and the
    # directory systemd scans for extensions have to be created on first boot.
    printf '%s\n' \
        'd /var/lib/extensions 0755 root root -' \
        'd /var/lib/rime 0755 root root -' \
        'd /var/lib/rime/pkg 0700 root root -' \
        'd /var/lib/rime/pkg/local 0700 root root -' \
        'd /var/lib/rime/appimage 0755 root root -' \
        > /usr/lib/tmpfiles.d/rime-pkg.conf; \
    # systemd-sysext.service is what merges the extension at boot. It is enabled
    # by preset today, which is exactly the kind of upstream default that can
    # change under us and would silently un-install every user package.
    systemctl enable systemd-sysext.service; \
    systemctl enable rime-sysext-rebuild.service; \
    test -L /etc/systemd/system/multi-user.target.wants/rime-sysext-rebuild.service

# ── The store compactor ─────────────────────────────────────────────────────
# Keeps /sysroot/ostree/repo and /var/lib/flatpak/repo compressed after every
# update, and compresses the whole store once on a machine installed before
# the installer did it (2026-10-04). libostree preallocates what it writes and
# btrfs never compresses a preallocated extent, so nothing else would; the
# engine's header has the measurements.
COPY --chmod=0755 files/system/libexec/rime-store-compact /usr/libexec/rime-store-compact
COPY files/system/units/rime-store-compact.service \
     files/system/units/rime-store-compact.timer \
     /usr/lib/systemd/system/
RUN set -eux; \
    bash -n /usr/libexec/rime-store-compact; \
    for t in btrfs filefrag unshare findmnt flock split comm xargs sync df; do \
        command -v "$t" >/dev/null || { echo "FATAL: rime-store-compact needs $t"; exit 1; }; \
    done; \
    printf '%s\n' 'd /var/lib/rime/store-compact 0700 root root -' \
        > /usr/lib/tmpfiles.d/rime-store-compact.conf; \
    systemctl enable rime-store-compact.timer; \
    test -L /etc/systemd/system/timers.target.wants/rime-store-compact.timer

# ── Rime Capsules (§8) ──────────────────────────────────────────────────────
# The other half of "how does software get onto this machine". The extension
# engine above serves the system: one signed set of RPMs overlaid onto /usr,
# rolled back as a unit. It cannot serve a development ecosystem, because
# `pip install --user`, `npm -g`, `cargo install` and a vendor's ./install.sh
# all expect a mutable userspace that a bootc host deliberately does not have.
#
# rime-env gives each ecosystem its own rootless podman container through
# distrobox, with the user's home, terminal and devices — and Rime's own
# policy on top: named images, device profiles for CUDA/ROCm/hardware work,
# and a record of what each capsule was built from.
#
# NO STATE UNDER /var. Capsules belong to the user, so the records live under
# ${XDG_DATA_HOME}/rime/env and the container storage under ~/.local/share/
# containers, which is why this needs no tmpfiles.d entry and no unit.
COPY --chmod=0755 files/system/libexec/rime-env /usr/libexec/rime-env
RUN set -eux; \
    bash -n /usr/libexec/rime-env; \
    # Every external tool the engine drives, asserted here rather than trusted,
    # because a missing one turns `rime env create` into a confusing runtime
    # failure on the user's machine instead of a failed build.
    for t in podman distrobox distrobox-export jq find comm date grep sed; do \
        command -v "$t" >/dev/null || { echo "FATAL: rime-env needs $t"; exit 1; }; \
    done; \
    # §8's GUI export. `distrobox-export` runs INSIDE a capsule and reaches
    # back through /run/host to write the .desktop file, so `rime env export`
    # can only ever drive it through `distrobox enter`. All three flags are
    # what the three verbs ARE — losing one turns `rime env export` into a
    # runtime failure on the user's machine, which is the class of bug this
    # whole block exists to convert into a failed build.
    distrobox-export --help 2>&1 | grep -q -- '--app'; \
    distrobox-export --help 2>&1 | grep -q -- '--delete'; \
    distrobox-export --help 2>&1 | grep -q -- '--list-apps'; \
    # The two distrobox flags the device profiles are built out of. Both are
    # what the profiles ARE, so an upstream rename would silently produce
    # capsules with no GPU access — a bug that reads as a driver problem. The
    # help text is the only place a shipped distrobox states them.
    distrobox create --help 2>&1 | grep -q -- '--nvidia'; \
    distrobox create --help 2>&1 | grep -q -- '--additional-flags'; \
    # `enter --no-tty` is the same class of dependency: `rime env exec` and
    # `rime install --source capsule` both run through it, and both are meant
    # for scripts and agents with no terminal. Losing the flag would make them
    # allocate a TTY and hang instead of returning.
    distrobox enter --help 2>&1 | grep -q -- '--no-tty'; \
    # The alias table has to resolve on THIS release: the fedora and python
    # aliases derive their tag from /usr/lib/os-release, so a missing or
    # renamed VERSION_ID would produce `fedora-toolbox:` with nothing after it.
    /usr/libexec/rime-env images | grep -qE 'fedora-toolbox:[0-9]+'; \
    /usr/libexec/rime-env images | grep -q 'ubuntu:24.04'; \
    # `rime env` is unprivileged and must stay that way, so the helper is not
    # setuid, has no polkit action and gets no unit. Asserted because "capsules
    # are per-user" is a security claim, not a preference.
    test ! -u /usr/libexec/rime-env; \
    test ! -g /usr/libexec/rime-env; \
    # §9's resolver offers a capsule as a package source and execs this exact
    # path. The engine holds it as a constant rather than an overridable
    # variable — `rime install` runs as root, and a caller-controlled variable
    # naming a program a root process executes is a hole — so the two files
    # agree only by both being right. Checked here, where being wrong is a
    # failed build rather than an `rime install --source capsule` that reports
    # "no capsule engine" on a machine that has one.
    grep -q '^readonly ENV_ENGINE=/usr/libexec/rime-env$' /usr/libexec/rime-pkg; \
    /usr/libexec/rime-pkg --help | grep -q -- '--source rpm|flatpak|capsule'

# ── Disposable environments (§19) ───────────────────────────────────────────
# A MODE of the capsule engine above, not a second environment mechanism: every
# disposable environment is an ordinary capsule created through
# /usr/libexec/rime-env with a throwaway home, so `rime env list` and
# `podman ps` both see it and AGENTS.md's "do not create another package/
# environment mechanism" holds.
#
# The assertions below are the safety claims, checked here so that being wrong
# is a failed build rather than a recursive delete on a user's machine.
# ── The default incoming firewall ───────────────────────────────────────────
# Rime shipped without one. firewalld is not installed, nftables was present
# with an empty ruleset, and every port a program happened to bind was reachable
# from the network — seventeen of them on the author's own laptop, including a
# model server and a Steam remote-play socket.
COPY files/system/nftables/rime.nft /usr/share/rime/nftables/rime.nft
COPY files/system/firewall/services /usr/share/rime/firewall/services
COPY --chmod=0755 files/system/libexec/rime-firewall /usr/libexec/rime-firewall
COPY files/system/units/rime-firewall.service /usr/lib/systemd/system/rime-firewall.service
# A hotspot inverts who answers: the phone that joined broadcasts a DHCP
# DISCOVER at us and then asks us to resolve names, both inbound on ports the
# policy shuts. The exception is scoped to the shared link rather than to the
# port — a `dns` entry in the service catalogue would open a resolver on the
# cafÃ© Wi-Fi too — so NetworkManager has to say which link that is.
COPY --chmod=0755 files/system/NetworkManager/dispatcher.d/50-rime-hotspot-firewall \
     /usr/lib/NetworkManager/dispatcher.d/50-rime-hotspot-firewall
RUN set -eux; \
    bash -n /usr/libexec/rime-firewall; \
    # nft arrives as a dependency rather than a named package, so assert it: a
    # future dependency change that dropped it would leave the unit failing at
    # boot and the machine unfiltered, which is the one failure that must not be
    # quiet.
    test -x /usr/sbin/nft; \
    # The policy must parse, and "could not check it" is not "it is fine".
    # `nft -c` applies nothing, but libnftables still opens a netlink socket and
    # lists the live ruleset before it will look at a file, and that needs
    # CAP_NET_ADMIN over a real network namespace. A build container has none,
    # so the check died with
    #     netlink: Error: cache initialization failed: Operation not permitted
    # and the parser never ran — which is what blocked every image build from
    # this branch after this stanza landed. A private user+network namespace of
    # our own gives nft an empty ruleset it is allowed to read, and the parse
    # then happens for real; a syntax error still fails the build (proved by
    # mutation: `policy dropp;` is rejected at the right line and column).
    N=/usr/share/rime/nftables/rime.nft; \
    out="$(/usr/sbin/nft -c -f "$N" 2>&1)" && rc=0 || rc=$?; \
    if [ "$rc" != 0 ] && command -v unshare >/dev/null 2>&1; then \
        ns_out="$(unshare --user --map-root-user --net \
                    /usr/sbin/nft -c -f "$N" 2>&1)" && rc=0 || rc=$?; \
        # unshare can be refused in its own right (no CAP_SYS_ADMIN, a seccomp
        # filter, a uid_map the builder will not let us write). That is the
        # namespace failing, not nft speaking, so keep nft's own words — or the
        # next branch would print unshare's refusal as "nft rejected the
        # ruleset" and fail the build on a diagnosis that is false.
        case "$ns_out" in unshare:*) : ;; *) out="$ns_out" ;; esac; \
    fi; \
    if [ "$rc" = 0 ]; then \
        echo "firewall: the shipped ruleset parses"; \
    elif printf '%s' "$out" | grep -q 'cache initialization failed'; then \
        # Reached only if even a private namespace is unavailable. Say that the
        # ruleset was NOT parsed rather than letting silence read as a pass;
        # tests/test-rime-firewall.sh parses it on every run and is the gate.
        echo "NOTE: nft could not reach netlink in this builder, with or without"; \
        echo "      a private namespace, so the ruleset was NOT parsed here."; \
        echo "      tests/test-rime-firewall.sh parses it on every run."; \
    else \
        echo "FATAL: nft rejected the shipped ruleset:"; \
        printf '%s\n' "$out"; exit 1; \
    fi; \
    # Default drop is the whole point; an `accept` policy on input would pass
    # every other assertion here and protect nothing.
    grep -qE '^\s*type filter hook input priority filter; policy drop;$' \
        /usr/share/rime/nftables/rime.nft; \
    # ssh is load-bearing, not incidental: Rime remote agents, `rime host run`
    # and `rime build --on` are all ssh, so a policy without it strands the user
    # on the machine they were driving from.
    grep -qE '^\s*tcp dport 22 accept$' /usr/share/rime/nftables/rime.nft; \
    # Without established/related every reply to the machine's own request is
    # dropped, which reads as "the network is broken" rather than as a firewall.
    grep -qE '^\s*ct state established,related accept$' /usr/share/rime/nftables/rime.nft; \
    # ICMPv6 neighbour discovery is not optional; dropping it removes IPv6
    # entirely, and slowly enough that nobody blames the firewall.
    grep -q 'nd-neighbor-solicit' /usr/share/rime/nftables/rime.nft; \
    # Exceptions are applied into named sets, never by rewriting the policy.
    grep -q 'tcp dport @allowed_tcp accept' /usr/share/rime/nftables/rime.nft; \
    test -s /usr/share/rime/firewall/services; \
    # Rime Remote's port is in the catalogue and is NOT opened. A network
    # listener whose port the image opened would make `rime firewall` a record
    # of what shipped rather than of what the owner allowed — and the relay
    # path works with it shut, so opening it is a choice about speed and
    # privacy rather than a requirement.
    grep -q '^rime-remote  *tcp  *7717 ' /usr/share/rime/firewall/services; \
    if grep -q 'rime-remote' /usr/share/rime/nftables/rime.nft \
        ; then echo "FATAL: the image opened the rime-remote port; the owner must choose it"; exit 1; fi; \
    # ── the hotspot exception ───────────────────────────────────────────
    # Three separate things have to be true, and any one of them missing is a
    # hotspot that hands out no addresses with nothing saying why.
    #
    # The set, so the rules below have somewhere to look.
    grep -qE '^\s*set hotspot_ifaces \{$' /usr/share/rime/nftables/rime.nft; \
    # The rules. DHCP first: the policy's other DHCP line is `udp sport 67 udp
    # dport 68`, a reply arriving for a client we are, and it cannot match a
    # client's request to us.
    grep -qE '^\s*iifname @hotspot_ifaces udp dport \{ 53, 67 \} accept$' \
        /usr/share/rime/nftables/rime.nft; \
    grep -qE '^\s*iifname @hotspot_ifaces tcp dport 53 accept$' \
        /usr/share/rime/nftables/rime.nft; \
    # And the part that keeps this an exception rather than a hole: nothing may
    # accept 53 or 67 without naming the link. An unscoped version of either
    # rule passes every assertion above and turns each of these machines into
    # an open resolver on whatever network it joins.
    if grep -nE '^\s*(udp|tcp) dport \{? ?(53|67)\b' \
        /usr/share/rime/nftables/rime.nft; then \
        echo "FATAL: the policy accepts DNS or DHCP on every interface, not just a shared link"; \
        exit 1; \
    fi; \
    # The dispatcher, without which the set stays empty and the rules never
    # match anything.
    test -x /usr/lib/NetworkManager/dispatcher.d/50-rime-hotspot-firewall; \
    bash -n /usr/lib/NetworkManager/dispatcher.d/50-rime-hotspot-firewall; \
    grep -q 'hotspot remove' /usr/lib/NetworkManager/dispatcher.d/50-rime-hotspot-firewall; \
    grep -q 'hotspot add' /usr/lib/NetworkManager/dispatcher.d/50-rime-hotspot-firewall; \
    # The helper it reaches for is overridable so the suite can watch which verb
    # it calls. The shipped default must stay the real path: an override that
    # became the default would be a dispatcher that opens nothing, on every
    # machine, with NetworkManager discarding the error.
    grep -qF 'FW="${RIME_HOTSPOT_FW:-/usr/libexec/rime-firewall}"' \
        /usr/lib/NetworkManager/dispatcher.d/50-rime-hotspot-firewall; \
    # A dispatcher script NetworkManager never runs is a file. The service is
    # D-Bus activated rather than enabled, so its presence is what to assert.
    test -f /usr/lib/systemd/system/NetworkManager-dispatcher.service; \
    # Enabled by default. A firewall that ships disabled is documentation.
    systemctl enable rime-firewall.service; \
    test -L /etc/systemd/system/multi-user.target.wants/rime-firewall.service; \
    echo "firewall: default-drop policy present, parses, and is enabled"

# ── Lid-closed continuous operation ─────────────────────────────────────────
# "if i close my laptop lid without shutting down … all agents and whatever
# theyre using/doing can stay running, also staying with the vpn." Without this
# unit the policy and the driver exist in the binary and nothing ever runs
# them, so every acceptance criterion for P1-063 is unmet on a real machine no
# matter how green the suites are.
COPY files/system/units/rime-lid.service /usr/lib/systemd/system/rime-lid.service
RUN set -eux; \
    # The binary this unit names is copied in much later, at the very bottom of
    # this file, so that an rimed-only change invalidates one layer instead of
    # the whole image. `rime lid --help` is therefore asserted down there with
    # the rest of the CLI surface, not here.
    grep -q '^ExecStart=/usr/bin/rime lid watch$' \
        /usr/lib/systemd/system/rime-lid.service; \
    # ── every refusal below is an `if … exit 1`, never `! grep` ─────────────
    # bash does NOT apply errexit to a pipeline whose status is inverted with
    # `!` (bash(1), `set -e`): `set -e; ! grep -q x <<<x; echo REACHED` prints
    # REACHED. Four Containerfile assertions on this branch have already been
    # found that could never pass or never run, each costing a 50-minute build
    # to discover — a `! grep` guard is a fifth of the same species, and it
    # cannot fail a build no matter what it matches.
    U=/usr/lib/systemd/system/rime-lid.service; \
    # The primitive is an inhibitor, and the image must never acquire a static
    # logind lid policy behind its back: `HandleLidSwitch=ignore` applies to a
    # machine with nothing running as readily as to one mid-build, and turns
    # every laptop bag into an oven.
    if grep -rqs '^ *HandleLidSwitch *=' /usr/lib/systemd/logind.conf.d/ \
            /etc/systemd/logind.conf.d/ /usr/lib/systemd/logind.conf; then \
        echo "FATAL: a static HandleLidSwitch= shipped; the lid policy must be an inhibitor"; \
        exit 1; \
    fi; \
    # `Restart=always` on a driver that exits 0 on a desktop would restart it
    # for ever; the unit says on-failure and that is load bearing.
    grep -q '^Restart=on-failure$' "$U"; \
    # KillMode must stay at the default. `process` would leave the
    # `systemd-inhibit … sleep infinity` child alive with its keeper gone — a
    # lid lock nothing can drop.
    if grep -q '^KillMode=' "$U"; then \
        echo "FATAL: KillMode is set; the inhibitor child must die with the driver"; exit 1; fi; \
    # ProtectSystem=strict or ProtectKernelTunables=yes would remount /sys
    # read-only and silently break every power-down write the unit exists to
    # make: the backlight, the keyboard LED. Both are refused here because the
    # symptom — a keyboard backlight that never dims — looks like anything but
    # a unit file.
    if grep -q '^ProtectSystem=strict$' "$U"; then \
        echo "FATAL: ProtectSystem=strict makes /sys read-only; the power-down writes it"; exit 1; fi; \
    if grep -q '^ProtectKernelTunables=yes$' "$U"; then \
        echo "FATAL: ProtectKernelTunables=yes makes /sys read-only; the power-down writes it"; exit 1; fi; \
    # ProtectHome=yes makes /run/user inaccessible AND EMPTY, which is where
    # this driver finds every live session and every owner's home. Measured on
    # the L16: `ls /run/user` under ProtectHome=yes returns nothing. The driver
    # would then see zero sessions for ever, `pin = "auto"` would never
    # activate, and the owner's ~/.config/rime/lid.toml would never be read —
    # the silent-pin defect 2aa9ed45 fixed in the code, reintroduced by a unit.
    if grep -q '^ProtectHome=yes$' "$U"; then \
        echo "FATAL: ProtectHome=yes empties /run/user; the driver would see no sessions"; exit 1; fi; \
    grep -q '^ProtectHome=no$' "$U"; \
    # PrivateTmp=yes hides the /tmp and /var/tmp a project worktree may live
    # in, and the guards' checkpoint runs inside one.
    if grep -q '^PrivateTmp=yes$' "$U"; then \
        echo "FATAL: PrivateTmp=yes hides worktrees under /tmp; the checkpoint runs in one"; exit 1; fi; \
    # CAP_SYS_RESOURCE is what `runuser` needs — without it pam_limits refuses
    # the session and the checkpoint dies at the moment work was to be saved.
    # Found by bisection on the L16, not guessed: CAP_AUDIT_WRITE, CAP_CHOWN,
    # CAP_FOWNER and CAP_SYS_ADMIN each fail on their own.
    grep -q '^CapabilityBoundingSet=.*CAP_SYS_RESOURCE' "$U"; \
    grep -q '^CapabilityBoundingSet=.*CAP_NET_ADMIN' "$U"; \
    # rfkill and `iw` are what the power-down half spends CAP_NET_ADMIN on.
    # They arrive as dependencies rather than named packages, so assert them:
    # without them the bluetooth block and the Wi-Fi power-save line fail at
    # the moment the lid shuts, which is the moment nobody is watching.
    command -v rfkill >/dev/null; \
    command -v iw >/dev/null; \
    # runuser is how a guard checkpoints a live session as its owner instead of
    # leaving root-owned git objects in the user's repository.
    command -v runuser >/dev/null; \
    systemctl enable rime-lid.service; \
    test -L /etc/systemd/system/multi-user.target.wants/rime-lid.service; \
    echo "lid: rime-lid.service present, enabled, and no static logind lid policy"

# ── What is attached, what is not, and what could not be looked at ──────────
# The third answer is why this ships. A failed stat is falsy and an empty list
# is falsy, so a device reader that does not separate them tells a user with a
# scanner they have none — which this codebase has now fixed in fourteen places
# and would rather not add a fifteenth.
COPY --chmod=0755 files/system/libexec/rime-devices /usr/libexec/rime-devices
RUN set -eux; \
    bash -n /usr/libexec/rime-devices; \
    # Read-only and unprivileged. Anything setuid here would change what it
    # reports rather than reveal more: root walks through the 0000 directory
    # whose refusal is the interesting answer.
    test ! -u /usr/libexec/rime-devices; \
    test ! -g /usr/libexec/rime-devices; \
    # Every area `rime devices` can be asked for has to be an area this file
    # knows. The CLI and the helper are separate programs, so a word that only
    # one of them knows is not a compile error — it is `rime devices dock`
    # printing usage to stderr and exiting 2.
    for a in print scan share media network bluetooth dock all; do \
        /usr/libexec/rime-devices --help | grep -qE "^  $a  *[A-Za-z]" \
          || { echo "rime-devices: '$a' is missing from its own usage"; exit 1; }; \
    done; \
    # The promise the help text makes about prompts is the reason the desktop
    # can run this from a menu. Losing it silently would be worse than losing
    # the command.
    /usr/libexec/rime-devices --help | grep -q 'never raises an authentication prompt'; \
    # A shared printer that does not work because of a firewall nobody mentioned
    # is the worst outcome this command has available to it.
    grep -q 'THE FIREWALL IS WHY' /usr/libexec/rime-devices; \
    grep -q 'rime firewall allow' /usr/libexec/rime-devices; \
    # It must run against a machine that has none of what it looks for, and say
    # so, rather than fail. This build container is exactly that machine: no
    # systemd, no seat, no /sys worth reading.
    env RIME_DEVICES_SYSFS=/nonexistent-sys RIME_DEVICES_ETC=/nonexistent-etc \
        RIME_DEVICES_SPA=/nonexistent-spa RIME_DEVICES_NMVPN=/nonexistent-vpn \
        RIME_DEVICES_LIBEXEC=/nonexistent-libexec RIME_DEVICES_DEV=/nonexistent-dev \
        RIME_DEVICES_MEDIA=/nonexistent-media RIME_DEVICES_NMLIB=/nonexistent-nmlib \
        RIME_DEVICES_NMCONFD=/nonexistent-nmconfd \
        /usr/libexec/rime-devices all > /tmp/rime-devices-all.txt 2>&1; \
    for h in Printing Scanning "Network shares" "Removable media" Networking \
             Bluetooth Thunderbolt; do \
        grep -q "$h" /tmp/rime-devices-all.txt \
          || { echo "rime-devices: no '$h' section in the full report"; exit 1; }; \
    done; \
    # An absence must never come back worded as a refusal, and this run has
    # nothing to refuse it: every root it was given does not exist.
    if grep -q 'could not be read' /tmp/rime-devices-all.txt \
        ; then echo "FATAL: an absence was reported as a refusal"; exit 1; fi; \
    rm -f /tmp/rime-devices-all.txt; \
    echo "rime-devices: every area dispatches, and an absent world reads as absent"

COPY --chmod=0755 files/system/libexec/rime-disposable /usr/libexec/rime-disposable
RUN set -eux; \
    bash -n /usr/libexec/rime-disposable; \
    # It drives the capsule engine by an absolute path that must exist. A
    # disposable environment with no engine behind it is a verb that fails at
    # the moment the user needs it.
    grep -q '^ENV_ENGINE="${RIME_DISPOSABLE_ENV_ENGINE:-/usr/libexec/rime-env}"$' \
        /usr/libexec/rime-disposable; \
    test -x /usr/libexec/rime-env; \
    # Teardown is a recursive removal driven by a name, so the four fences that
    # make it safe are build-time facts. Each `grep` is anchored to an
    # EXECUTABLE line (`^[^#]*`), because this file's comments discuss every
    # one of these checks at length and a check its own comments can satisfy is
    # a check that proves nothing — this repository has shipped five of those.
    grep -qE '^[^#]*\[\[ "\$1" =~ \^disp-\[a-z0-9\]\{1,24\}\$ \]\]' /usr/libexec/rime-disposable; \
    grep -qE '^[^#]*\[ -L "\$dir" \]' /usr/libexec/rime-disposable; \
    grep -qE '^[^#]*realpath -e -- "\$dir"' /usr/libexec/rime-disposable; \
    grep -qE '^[^#]*\[ "\$real" = "\$\{root_real\}/\$\{name\}" \]' /usr/libexec/rime-disposable; \
    # --home is what makes an environment disposable. Without it a capsule
    # shares the user's real home and the teardown would be deleting that.
    grep -qE '^[^#]*--home=' /usr/libexec/rime-disposable; \
    # Unprivileged, like `rime env`, and asserted because "disposable
    # environments are per-user" is a security claim rather than a preference.
    test ! -u /usr/libexec/rime-disposable; \
    test ! -g /usr/libexec/rime-disposable; \
    # The CLI's own constant is checked in the `rime` binary block near the end
    # of this file, because the binary is not copied in until then.
    /usr/libexec/rime-disposable --help | grep -q 'not a security boundary'; \
    /usr/libexec/rime-disposable --help | grep -q -- '--copy-out'

# ── The virtualization engine (P2-008) ──────────────────────────────────────
# `rime vm`'s engine. It defines libvirt domains and removes disk images, so
# the checks below are about the two properties that make it safe to ship
# rather than about it working: it is rootless and session-scoped, and it never
# opens a window.
#
# The STACK it drives is deliberately absent from this image. qemu, libvirt,
# OVMF, swtpm and virtiofsd are userspace; AGENTS.md's line is that an
# out-of-tree kernel module must be baked in and userspace must not be, and KVM
# needs no out-of-tree module at all — kvm_intel/kvm_amd are in-tree in the
# signed kernel. So the engine ships, the stack arrives through `rime install`,
# and `rime vm doctor` is what tells the user which command to run. Asserted
# below, because "the engine is present and the stack is not" is a design
# decision and would otherwise read as a packaging mistake.
COPY --chmod=0755 files/system/libexec/rime-vm /usr/libexec/rime-vm
RUN set -eux; \
    bash -n /usr/libexec/rime-vm; \
    # Session mode, structurally. A default of qemu:///system would need a root
    # daemon and would bring libvirt's `default` network — a host bridge and a
    # dnsmasq that outlive the VM that asked for them — onto every Rime
    # machine that ever ran `rime vm create`.
    grep -qE '^VM_URI="\$\{RIME_VM_URI:-qemu:///session\}"$' /usr/libexec/rime-vm; \
    # Headless is a product rule, not a default. There is no code path to a
    # viewer, so there is no <graphics> element and no --graphics flag: a
    # single occurrence of either would be a window opening on somebody's
    # desktop from a command whose whole contract is that it does not.
    if grep -qE '^[^#]*<graphics' /usr/libexec/rime-vm \
        ; then echo "FATAL: rime-vm grew a <graphics> element and its contract is headless"; exit 1; fi; \
    if grep -qE '^[^#]*(spice|vnc|virt-viewer)' /usr/libexec/rime-vm \
        ; then echo "FATAL: rime-vm grew a viewer path and its contract is headless"; exit 1; fi; \
    # The three elements that look optional in the XML and are not. Each one,
    # dropped, produces a domain that DEFINES and then refuses to start — the
    # worst failure shape available, because the user gets a success and then
    # an error unrelated to what they typed. Anchored to EXECUTABLE lines
    # (`^[^#]*`), because this file's own comments discuss all three at length
    # and a check its comments can satisfy proves nothing.
    grep -qE "^[^#]*<smm state=" /usr/libexec/rime-vm; \
    grep -qE "^[^#]*<access mode='shared'/>" /usr/libexec/rime-vm; \
    grep -qE "^[^#]*model='qemu-xhci'" /usr/libexec/rime-vm; \
    # Removal is a recursive `rm -rf` driven by a name, so the four fences that
    # make it safe are build-time facts — the same four rime-disposable carries
    # and for the same reason.
    grep -qE '^[^#]*\[\[ "\$1" =~ \^\[a-z0-9\]\[a-z0-9-\]\{0,31\}\$ \]\]' /usr/libexec/rime-vm; \
    grep -qE '^[^#]*\[ -L "\$dir" \]' /usr/libexec/rime-vm; \
    grep -qE '^[^#]*realpath -e -- "\$dir"' /usr/libexec/rime-vm; \
    grep -qE '^[^#]*\[ "\$real" = "\$\{root_real\}/\$\{name\}" \]' /usr/libexec/rime-vm; \
    # Unprivileged, asserted because "every VM is a per-user domain" is a
    # security claim rather than a preference.
    test ! -u /usr/libexec/rime-vm; \
    test ! -g /usr/libexec/rime-vm; \
    # The stack is NOT here, and that is the decision. If a later change layers
    # qemu or libvirt into the image, this fails and whoever did it has to say
    # why in the diff rather than in a commit message nobody reads.
    if command -v qemu-system-x86_64 >/dev/null 2>&1 \
        ; then echo "FATAL: qemu was layered into the image; the stack is deliberately absent"; exit 1; fi; \
    if command -v virsh >/dev/null 2>&1 \
        ; then echo "FATAL: libvirt was layered into the image; the stack is deliberately absent"; exit 1; fi; \
    # And the engine says so, with the command that fixes it, instead of
    # failing halfway through defining a domain.
    if /usr/libexec/rime-vm doctor >/dev/null 2>&1 \
        ; then echo "FATAL: rime-vm doctor reported success with no stack installed"; exit 1; fi; \
    /usr/libexec/rime-vm doctor 2>&1 | grep -q 'sudo rime install'; \
    /usr/libexec/rime-vm doctor 2>&1 | grep -q 'MISSING'; \
    /usr/libexec/rime-vm --help | grep -q 'no viewer'; \
    echo "rime-vm: engine present, stack deliberately absent, doctor names it"

# ── P2-012's browser automation capsule ─────────────────────────────────────
# `rime browser` runs a browser that automates a site without going near the
# one the user browses with. Unlike `rime vm`, EVERYTHING it needs is already
# in this image: bubblewrap is asserted above, rime-agentd is the agent
# runtime, and Firefox is installed with Rime's own policies. So there is no
# "the stack arrives on demand" half here — the whole capsule works on a
# stock machine.
#
# The engine enforces nothing itself. It asks `rime agent` for a confined,
# allowlisted session, so the masked home and the egress proxy have ONE
# implementation. That is what most of the checks below are about: a dropped
# word in the session argv is not a compile error and is not visible in the
# output, it is a capsule whose home is not masked or whose network is not
# filtered, reported by the command as though it were neither.
COPY --chmod=0755 files/system/libexec/rime-browser /usr/libexec/rime-browser
RUN set -eux; \
    bash -n /usr/libexec/rime-browser; \
    # The confinement it asks for. Anchored to EXECUTABLE lines (`^[^#]*`),
    # because this file's own comments discuss all of it at length and a check
    # its comments can satisfy proves nothing.
    grep -qE "^[^#]*--sandbox project" /usr/libexec/rime-browser; \
    grep -qE "^[^#]*--network allowlist" /usr/libexec/rime-browser; \
    # And the ones it must never ask for. `project` is the confined policy
    # that keeps a network; `strict` is the same thing offline, which the CLI
    # refuses alongside an allowlist. Either of these two would be a capsule
    # with no boundary at all.
    if grep -qE "^[^#]*--network open" /usr/libexec/rime-browser \
        ; then echo "FATAL: rime-browser asks for an open network; a capsule is allowlisted"; exit 1; fi; \
    if grep -qE "^[^#]*--sandbox unrestricted" /usr/libexec/rime-browser \
        ; then echo "FATAL: rime-browser asks for an unconfined session; a capsule masks the home"; exit 1; fi; \
    # It must not grow a sandbox of its own. Two implementations of one
    # confinement drift, and the one that drifts is the one nobody tests.
    if grep -qE "^[^#]*bwrap" /usr/libexec/rime-browser \
        ; then echo "FATAL: rime-browser invokes bwrap; confinement belongs to rime agent, not to this engine"; exit 1; fi; \
    # Headless is a product rule. --no-remote is not cosmetic either: without
    # it a capsule's browser can find the user's RUNNING browser and open a
    # tab in their window, which is the exact thing this verb must never do.
    grep -qE "^[^#]*--headless" /usr/libexec/rime-browser; \
    grep -qE "^[^#]*--no-remote" /usr/libexec/rime-browser; \
    # The two arguments it refuses among the browser's own. Found by a test:
    # clap's trailing var-arg absorbs an unrecognised option into the
    # browser's arguments, and a second --profile WINS on a Firefox command
    # line — so the refusal has to live in the engine, after the separator.
    grep -qE "^[^#]*--profile\|-profile\|-P" /usr/libexec/rime-browser; \
    grep -qE "^[^#]*--display\|-display" /usr/libexec/rime-browser; \
    # {capsule} is not a convenience. Firefox's --screenshot writes nothing at
    # all when given a relative filename — the run exits 0 and produces no
    # file — and a caller cannot type the path of a capsule this engine names
    # for them, so without the substitution nothing the browser writes by path
    # can ever be nominated.
    grep -qE '^[^#]*\{capsule\}' /usr/libexec/rime-browser; \
    # The copy loop runs over the NOMINATIONS. Iterating the capsule and
    # copying what matched would let the page decide what leaves by choosing a
    # filename, which is the one property this verb exists to have.
    grep -qE '^[^#]*for n in "\$\{download\[@\]\}"' /usr/libexec/rime-browser; \
    if grep -qE '^[^#]*for n in \$\(' /usr/libexec/rime-browser \
        ; then echo "FATAL: rime-browser iterates a directory to decide what leaves"; exit 1; fi; \
    # The profile is the ONLY thing pointing Firefox at the egress bridge:
    # Firefox does not read \$HTTP_PROXY, and its default is to bypass a proxy
    # for loopback — which inside the namespace is where the bridge is.
    grep -qE '^[^#]*network\.proxy\.type", 1' /usr/libexec/rime-browser; \
    grep -qE '^[^#]*allow_hijacking_localhost", true' /usr/libexec/rime-browser; \
    # And the browser's own vendor traffic is turned off in the profile rather
    # than left for the allowlist to refuse. Measured by the live lab: without
    # these the daemon logged a capsule being denied Mozilla's settings,
    # update and geolocation services over and over, and the retries cost the
    # run most of its wall clock. An allowlist that does not describe what the
    # capsule talks to is an allowlist doing the profile's job.
    grep -qE '^[^#]*services\.settings\.server", ""' /usr/libexec/rime-browser; \
    grep -qE '^[^#]*geo\.enabled", false' /usr/libexec/rime-browser; \
    # Removal is a recursive `rm -rf` driven by a name, so the four fences are
    # build-time facts — the same four rime-vm and rime-disposable carry.
    grep -qE '^[^#]*\[\[ "\$1" =~ \^\[a-z0-9\]\[a-z0-9-\]\{0,47\}\$ \]\]' /usr/libexec/rime-browser; \
    grep -qE '^[^#]*\[ -L "\$dir" \]' /usr/libexec/rime-browser; \
    grep -qE '^[^#]*realpath -e -- "\$dir"' /usr/libexec/rime-browser; \
    grep -qE '^[^#]*\[ "\$real" = "\$\{root_real\}/\$\{name\}" \]' /usr/libexec/rime-browser; \
    # Unprivileged, asserted because "a capsule runs as you and nothing more"
    # is a security claim rather than a preference.
    test ! -u /usr/libexec/rime-browser; \
    test ! -g /usr/libexec/rime-browser; \
    # Three answers, not two. A capability that could not be looked up is a
    # different fact from one that is absent, and the difference decides
    # whether the fix is starting a service or storing a credential.
    grep -qE "^[^#]*return 3" /usr/libexec/rime-browser; \
    # There is no agent runtime answering inside a build, so doctor must FAIL
    # and must name what is missing. A doctor that reported success here would
    # be the "permission denied is not absence" defect with a green tick.
    if /usr/libexec/rime-browser doctor >/dev/null 2>&1 \
        ; then echo "FATAL: rime-browser doctor reported success with no agent runtime"; exit 1; fi; \
    /usr/libexec/rime-browser doctor 2>&1 | grep -q 'rime-agentd'; \
    # STDOUT. `rime vm --help` wrote to stderr once, and `--help | grep` then
    # read an empty stream and a build assertion passed against nothing.
    /usr/libexec/rime-browser --help | grep -q 'headless'; \
    echo "rime-browser: engine present, confinement delegated, doctor names what is missing"

# ── The plugin CLI (§16) ────────────────────────────────────────────────────
# rime-shell's plugin platform ships the manifest, the permission model and the
# loader; this is the OS-side CLI it deliberately left out.
#
# IT OWNS NO PLUGIN RULES. Every verdict comes from the shell's own
# src/services/plugins/manifest.js, `require`d by the node shim below — the
# same file the QML engine imports and the same file rime-shell's own tests
# load. Two implementations of a permission model drift, and the failure mode
# is a CLI that tells a user their plugin is fine while the shell refuses it.
#
# That makes three things build dependencies rather than runtime hopes, which
# is why they are asserted here: node, the vendored shell tree, and the exact
# functions the shim calls out of manifest.js. A missing one turns `rime
# plugin` into a confusing runtime failure on the user's machine instead of a
# failed build.
COPY --chmod=0755 files/system/libexec/rime-plugin /usr/libexec/rime-plugin
COPY --chmod=0755 files/system/libexec/rime-plugin-verdict.js /usr/libexec/rime-plugin-verdict.js
RUN set -eux; \
    bash -n /usr/libexec/rime-plugin; \
    for t in node jq find awk; do \
        command -v "$t" >/dev/null || { echo "FATAL: rime-plugin needs $t"; exit 1; }; \
    done; \
    node --check /usr/libexec/rime-plugin-verdict.js; \
    # The shell's validator has to BE there, at the path the CLI defaults to.
    MJS=/usr/share/rime-shell/src/services/plugins/manifest.js; \
    test -f "$MJS"; \
    # …and it has to still export what the shim calls. Checked by running the
    # SHIPPED shim rather than a copy of its export list here: the shim already
    # refuses with exit 2 if manifest.js has lost any of the four functions,
    # and an upstream rename would otherwise surface as "undefined is not a
    # function" halfway through a verdict — which reads as a broken CLI rather
    # than a broken coupling.
    /usr/libexec/rime-plugin-verdict.js validid "$MJS" rime-worldclock; \
    if /usr/libexec/rime-plugin-verdict.js validid "$MJS" ../escape \
        ; then echo "FATAL: rime-plugin-verdict.js accepted a path-traversal id"; exit 1; fi; \
    # End to end, in the image, against the shell's OWN example plugin. This is
    # the only place the coupling is exercised for real: CI vendors rime-shell
    # from remote main and cannot know what the finished image contains.
    P=/tmp/rime-plugin-verify; \
    mkdir -p "$P/.config/rime-shell/plugins"; \
    cp -r /usr/share/rime-shell/plugins/rime-worldclock \
          "$P/.config/rime-shell/plugins/rime-worldclock"; \
    HOME="$P" /usr/libexec/rime-plugin list 2>&1 | tee /tmp/rime-plugin-list.txt; \
    grep -q 'rime-worldclock' /tmp/rime-plugin-list.txt; \
    grep -qE 'rime-worldclock +enabled +yes' /tmp/rime-plugin-list.txt; \
    HOME="$P" /usr/libexec/rime-plugin info rime-worldclock | grep -q 'bar-widget'; \
    # The disable/enable round trip, on a throwaway HOME, asserting the file
    # count is preserved in both directions.
    HOME="$P" /usr/libexec/rime-plugin disable rime-worldclock; \
    test ! -e "$P/.config/rime-shell/plugins/rime-worldclock"; \
    test -d "$P/.config/rime-shell/plugins-disabled/rime-worldclock"; \
    HOME="$P" /usr/libexec/rime-plugin enable rime-worldclock; \
    test -d "$P/.config/rime-shell/plugins/rime-worldclock"; \
    test ! -e "$P/.config/rime-shell/plugins-disabled/rime-worldclock"; \
    rm -rf "$P" /tmp/rime-plugin-list.txt; \
    # Unprivileged, and it must stay that way: every path it touches is under
    # the invoking user's ~/.config/rime-shell, which is the directory the
    # shell itself reads. Asserted because "plugins are per-user" is a security
    # claim, not a preference.
    test ! -u /usr/libexec/rime-plugin; \
    test ! -g /usr/libexec/rime-plugin; \
    # The permission model must never read as stronger than it is. QML plugins
    # run in-process with the shell's full authority; rime-shell fails its own
    # CI if that paragraph is deleted, and so does this image.
    /usr/libexec/rime-plugin --help | grep -q 'neither one confines hostile code'; \
    echo "rime-plugin verified against the vendored shell validator"

# ── Console setup must not be able to report the machine as broken ──────────
# systemd-vconsole-setup runs loadkeys/setfont with whatever /etc/vconsole.conf
# names. If that keymap or font is not installed the tool exits non-zero, the
# unit FAILS, and systemd puts the machine into "degraded" state — which is what
# the user is then told about every time they open a terminal, over a virtual
# console setting that has no effect on their graphical session.
#
# /etc/vconsole.conf is machine-local, so it survives every image update: once a
# machine has a bad value it stays broken forever and no OS update can fix it.
# The guard repairs the file in place at boot instead (falling back to `us`,
# keeping the original beside it), which is the only layer that CAN fix it.
COPY --chmod=0755 files/system/libexec/rime-vconsole-guard \
     /usr/libexec/rime-vconsole-guard
COPY files/system/units/10-rime-vconsole-guard.conf \
     /usr/lib/systemd/system/systemd-vconsole-setup.service.d/10-rime-vconsole-guard.conf
# Same class of problem, different unit: rpm-ostree's weekly "Count Me"
# telemetry pings the Fedora mirrors, and if the machine is offline when that
# timer fires the unit fails and the system reads as degraded for up to a week.
# Anonymous statistics are allowed to fail; they are not allowed to report the
# machine as broken. See the drop-in for why ExecStart is reset and re-added.
COPY files/system/units/10-rime-countme-nonfatal.conf \
     /usr/lib/systemd/system/rpm-ostree-countme.service.d/10-rime-countme-nonfatal.conf
RUN set -eux; \
    bash -n /usr/libexec/rime-vconsole-guard; \
    # The fallback keymap the guard relies on has to exist in THIS image, or the
    # repair would swap one unloadable keymap for another.
    find /usr/lib/kbd/keymaps -name 'us.map.gz' -print -quit | grep -q .; \
    cp /etc/vconsole.conf /tmp/vconsole.orig; \
    # A bad keymap must be repaired and the original preserved...
    printf 'KEYMAP=definitely-not-a-keymap\nFONT=definitely-not-a-font\n' > /etc/vconsole.conf; \
    /usr/libexec/rime-vconsole-guard; \
    grep -qx 'KEYMAP=us' /etc/vconsole.conf; \
    if grep -q '^FONT=' /etc/vconsole.conf \
        ; then echo "FATAL: the vconsole guard kept the invalid FONT= instead of dropping it"; exit 1; fi; \
    test -s /etc/vconsole.conf.rime-invalid; \
    rm -f /etc/vconsole.conf.rime-invalid; \
    # ...and a good one must be left completely alone, because this runs on
    # every boot and must never churn a working machine's configuration.
    printf 'KEYMAP=us\n' > /etc/vconsole.conf; \
    /usr/libexec/rime-vconsole-guard; \
    grep -qx 'KEYMAP=us' /etc/vconsole.conf; \
    test ! -e /etc/vconsole.conf.rime-invalid; \
    cp /tmp/vconsole.orig /etc/vconsole.conf; \
    rm -f /tmp/vconsole.orig; \
    echo "vconsole guard verified (bad config repaired, good config untouched)"

# ── A crash loop must not be able to fill /var ─────────────────────────────
# MEASURED ON KATANA 2026-09-19 (evidence §3.4): one crashing process respawned
# at ~2 Hz left 15 376 core dumps in a single boot and 4.0 GB of stored dumps
# on a /var that was already 94% full. systemd's vacuum was working the whole
# time — `MaxUse=` defaults to 10% of the filesystem CAPPED AT 4 GiB, and 4.0 GB
# is exactly that cap. The default is simply the wrong size for an ostree
# machine, where /var is the only writable filesystem and also holds every
# container image, the system extension `rime-pkg` builds, and the user's home.
# See the drop-in itself for the full argument.
COPY files/system/coredump/50-rime-coredump-limits.conf \
     /usr/lib/systemd/coredump.conf.d/50-rime-coredump-limits.conf
RUN set -eux; \
    # The file landing somewhere is not the assertion. `systemd-analyze
    # cat-config` resolves the SAME search path systemd-coredump resolves at
    # runtime, so this fails if the drop-in is in a directory nothing reads —
    # which is the only interesting way to get this wrong. Verified both ways
    # against this image before it was written: with the drop-in these two
    # lines appear, and without it the base image prints NEITHER, because
    # Fedora ships every value commented out.
    systemd-analyze cat-config systemd/coredump.conf > /tmp/coredump.merged; \
    grep -qx 'MaxUse=256M' /tmp/coredump.merged; \
    grep -qx 'KeepFree=2G' /tmp/coredump.merged; \
    rm -f /tmp/coredump.merged; \
    echo "coredump storage bounded: MaxUse=256M KeepFree=2G (default was a 4 GiB cap)"

# One-shot de-branding migration for systems installed from a PRE-branding image.
# The BLS entry titles, the EFI NVRAM label and a hand-written /etc/os-release
# all live OUTSIDE the ostree deployment, so `bootc upgrade` never replaces them.
# Dry-run by default; needs --apply. See docs/branding.md.
COPY --chmod=0755 files/scripts/rime-debrand-runtime.sh \
     /usr/libexec/rime-debrand-runtime

# Default Rime Hyprland config, seeded per-user by the provisioner. Ships the
# Rime keybinds + alacritty/thunar etc. so a fresh login is the intended Rime
# session, not the stock hyprland example (which binds dolphin/wofi that aren't
# installed). rime-logs 16.
#
# Lua, not hyprlang, since P0-025: Hyprland 0.55 deprecated hyprlang with "1-2
# releases" of life left and this image ships 0.56.2. hyprland.lua is the user's
# entry point, seeded once; rime/*.lua are Rime-owned and refreshed every login.
COPY files/desktop/hypr/hyprland.lua /usr/share/rime/hypr/hyprland.lua
COPY files/desktop/hypr/rime/ /usr/share/rime/hypr/rime/

# Guards for the seeded Hyprland tree (rime-logs 14):
#   1. the autostart must be the libexec launcher. The retired
#      ~/.local/bin/rime-shell-autostart shim is deleted by the provisioner, so a
#      template still naming it seeds a dead autostart and the session comes up
#      with no bar at all.
#   2. the tree must NOT contain the value localectl prints for an unset keymap.
#      rime-shell-firstrun greps seeded configs for it, so shipping it — even
#      inside a comment — made a correct, brand-new install fail its own
#      provisioning check. The check strips comments now; this keeps the string
#      out of the files so neither half of the bug can return.
#   3. parse the seeded form with the Hyprland version in this image. Hyprland
#      regularly removes config directives, and a valid old template otherwise
#      turns an image update into a login-blocking compositor failure.
#   4. no hyprlang anywhere. That is the whole point of P0-025, and a `source =`
#      or an `exec-once =` surviving in this tree would be silently dead: 0.56.2
#      loads hyprland.lua and never looks at a .conf beside it.
RUN set -eux; \
    grep -q 'exec_cmd("/usr/libexec/rime-shell-autostart")' /usr/share/rime/hypr/rime/session.lua; \
    if grep -rq 'local/bin/rime-shell-autostart' /usr/share/rime/hypr/ \
        ; then echo "FATAL: a ~/.local/bin autostart path survives in the shipped hypr tree"; exit 1; fi; \
    if grep -rq '(unset)' /usr/share/rime/hypr/ \
        ; then echo "FATAL: an unsubstituted (unset) survives in the shipped hypr tree"; exit 1; fi; \
    # The keymap substitution moved out of hyprland.lua and into the module that
    # actually sets it. Asserted in BOTH directions so the two cannot drift: the
    # token must be where the provisioner substitutes it, and must NOT be left
    # behind in the entry point that no longer carries it.
    grep -q '@KB_LAYOUT@' /usr/share/rime/hypr/rime/input-defaults.lua; \
    grep -q '@KB_VARIANT@' /usr/share/rime/hypr/rime/input-defaults.lua; \
    if grep -q '@KB_LAYOUT@' /usr/share/rime/hypr/hyprland.lua \
        ; then echo "FATAL: the keymap token was left behind in the entry point"; exit 1; fi; \
    # @HOME@ is gone on purpose: `require` resolves against the config file's own
    # directory and rime/session.lua reads os.getenv("HOME"), so there is no
    # absolute path left to substitute. Asserting its ABSENCE is what stops one
    # creeping back in and seeding a config that only works for one home.
    # Executable Lua only: two comment lines in this tree explain that @HOME@ is
    # gone and name the token while doing it, so a plain `grep -r` matched the
    # explanation and this assertion could only ever fail. Same shape as the
    # `mouse = true` one two stanzas down, found by
    # tests/check-containerfile-assertions.sh rather than by a fifth 50-minute
    # build.
    if grep -rqE '^[[:space:]]*[^-[:space:]].*@HOME@' /usr/share/rime/hypr/ \
        ; then echo "FATAL: an @HOME@ token survives outside a comment in the hypr tree"; exit 1; fi; \
    # No hyprlang left anywhere in the tree.
    if grep -rqE '^[[:space:]]*(source|exec-once|bind[a-z]*|windowrule|monitor|env)[[:space:]]*=' \
        /usr/share/rime/hypr/ \
        ; then echo "FATAL: hyprlang syntax survives in a tree 0.56.2 loads as Lua"; exit 1; fi; \
    # Each generated module must actually be required — a generator whose output
    # nothing reads is worse than no generator, because the settings page appears
    # to work. These three are the write targets of rime-display-apply,
    # rime-input-apply and the shell's KeybindService.
    grep -q '^rime("monitors")' /usr/share/rime/hypr/hyprland.lua; \
    grep -q '^rime("input")' /usr/share/rime/hypr/hyprland.lua; \
    grep -q '^rime("shell-keybinds")' /usr/share/rime/hypr/hyprland.lua; \
    # ...and so must the module rime-hypr-migrate writes a user's converted
    # hyprlang into, or the migration silently loses every one of their edits.
    grep -q '^rime("user-overrides")' /usr/share/rime/hypr/hyprland.lua; \
    # Every static module named in the entry point has to exist, and every module
    # shipped has to be named. Both directions, so adding a file without wiring
    # it up fails here rather than doing nothing on a user's machine.
    for m in $(sed -n 's/^rime("\([a-z-]*\)").*/\1/p' /usr/share/rime/hypr/hyprland.lua); do \
        case "$m" in monitors|input|shell-keybinds|user-overrides) continue ;; esac; \
        test -f "/usr/share/rime/hypr/rime/${m}.lua"; \
    done; \
    for f in /usr/share/rime/hypr/rime/*.lua; do \
        m="$(basename "$f" .lua)"; \
        grep -q "^rime(\"${m}\")" /usr/share/rime/hypr/hyprland.lua; \
    done; \
    # Parse the seeded form with this image's Hyprland. The tree is copied into a
    # config directory first because `require("rime.x")` resolves against the
    # CONFIG FILE's own directory — verifying the template where it sits would
    # test a package.path that no user will ever have.
    #
    # The generated modules are deliberately NOT stubbed. hyprland.lua's loader
    # calls package.searchpath before requiring, so absent is a legal state, and
    # this run is what proves it: a regression that made a missing generated
    # module fatal again would fail here rather than on a user's first boot.
    runtime="$(mktemp -d)"; cfg="$(mktemp -d)"; \
    chmod 0700 "$runtime"; \
    mkdir -p "$cfg/rime"; \
    sed -e 's|@KB_LAYOUT@|us|g' -e 's|@KB_VARIANT@||g' \
        /usr/share/rime/hypr/hyprland.lua > "$cfg/hyprland.lua"; \
    for f in /usr/share/rime/hypr/rime/*.lua; do \
        sed -e 's|@KB_LAYOUT@|us|g' -e 's|@KB_VARIANT@||g' \
            "$f" > "$cfg/rime/$(basename "$f")"; \
    done; \
    if grep -rq '@KB_LAYOUT@' "$cfg" \
        ; then echo "FATAL: the provisioner left @KB_LAYOUT@ unsubstituted"; exit 1; fi; \
    XDG_RUNTIME_DIR="$runtime" Hyprland --i-am-really-stupid \
        --verify-config --config "$cfg/hyprland.lua" | grep -q 'config ok'; \
    rm -rf "$cfg" "$runtime"

# SUPER+drag move/resize, asserted because it is silent when wrong. This stanza
# used to REQUIRE `{ drag = true }` and forbid `{ mouse = true }`, and had it
# backwards: `drag = true` forces `release = true`, so the bind fires only on
# button-up and SUPER+drag moves nothing. `hyprctl binds -j` reports mouse=false
# for both forms, which is what was misread as "`mouse = true` does nothing".
# Measured 2026-09-27 in a nested 0.56.2 with a virtual pointer holding SUPER:
# `mouse = true` (upstream's own form) floats the window and follows the
# pointer, `drag = true` leaves it where it was.
RUN set -eux; \
    grep -qE '^bind\(mod, "mouse:272", hl\.dsp\.window\.drag\(\), +\{ mouse = true' \
        /usr/share/rime/hypr/rime/keybindings.lua; \
    grep -qE '^bind\(mod, "mouse:273", hl\.dsp\.window\.resize\(\), +\{ mouse = true' \
        /usr/share/rime/hypr/rime/keybindings.lua; \
    # Executable Lua only, never a comment: keybindings.lua explains the trap
    # and names `drag = true` while doing it, and a plain `grep -r` matching a
    # stanza's own explanation is how 43d98f10 stopped `base` at step 113 of
    # 151. A comment line is one whose first non-blank character is `-`.
    if grep -rqE '^[[:space:]]*[^-[:space:]].*mouse:27[23].*drag = true' /usr/share/rime/hypr/ \
        ; then echo "FATAL: a mouse drag bind uses { drag = true }, which fires only on button-up"; exit 1; fi

# The same guard for niri, which had none because it has no Rime template to
# grep: niri's config is seeded from niri's OWN default and the Rime additions
# are appended by the per-login provisioner, so that is where the include lines
# live and that is what gets checked here.
#
# This exists because the niri half was missing entirely. rime-input-apply wrote
# RimeShellInput.kdl and the shell wrote RimeShellKeybinds.kdl, and nothing ever
# read either one — the generator emitted a COMMENT telling the user to add the
# include by hand. A generated file nothing reads is worse than no generator,
# because the Settings page reports success and the setting does not apply.
RUN set -eux; \
    f=/usr/libexec/rime-shell-firstrun; \
    grep -q 'include "${CFG_DIR}/RimeShellInput.kdl"' "$f"; \
    grep -q 'include "${CFG_DIR}/RimeShellKeybinds.kdl"' "$f"; \
    # Both include targets must be pre-created before that append runs. niri
    # treats an include it cannot read as a fatal parse error and refuses the
    # WHOLE config, so a line without a matching pre-create costs a niri user
    # every binding and window rule on boot #1 — the same failure Hyprland's
    # `source=` had, one compositor along.
    grep -q '^\[ -f "${CFG_DIR}/RimeShellInput.kdl" \]' "$f"; \
    # ...and the Keybinds half of the same pre-create. This line used to read
    # `RimeShellKeybinds.${_variant}`, a draft spelling of a variable that
    # appears nowhere in rime-shell-firstrun, so the assertion could only ever
    # fail -- the fourth of that shape on this branch, and it is what stopped
    # `base` at step 116 of 151 once the keybindings one was fixed. What the
    # comment above actually describes is the pre-create at firstrun line 553,
    # so that is what is checked, in the same shape as the Input line above it.
    grep -q '^\[ -f "${CFG_DIR}/RimeShellKeybinds.kdl" \]' "$f"; \
    # `include` is a niri 25.11+ feature. Ask THIS image's niri rather than
    # trusting a version string: if the package is ever pinned back, the build
    # fails here instead of the desktop failing at login.
    d="$(mktemp -d)"; \
    printf 'input {\n    touchpad {\n        tap\n    }\n}\n' > "$d/inc.kdl"; \
    printf 'include "%s/inc.kdl"\n' "$d" > "$d/config.kdl"; \
    niri validate --config "$d/config.kdl"; \
    # And the pre-create is load-bearing, not defensive: with the target gone,
    # the identical config must be REFUSED. If a future niri downgrades this to
    # a warning this line fails — read the pre-create rationale in the
    # provisioner before deleting it, because `include optional=true` (26.04+)
    # is then the better shape.
    rm -f "$d/inc.kdl"; \
    if niri validate --config "$d/config.kdl" \
        ; then echo "FATAL: niri accepted a config whose include is missing"; exit 1; fi; \
    rm -rf "$d"

# Greeter session picker: offer Hyprland + niri only. sway/labwc are the greeter
# HOST compositor, not user sessions — strip their wayland-session files so they
# are never offered as logins. rime-greet enumerates /usr/share/wayland-sessions.
#
# Also remove hyprland-uwsm.desktop (hyprland pulls in hyprland-uwsm, whose session
# Exec is `uwsm start -- hyprland.desktop`).
#
# WHY, honestly stated (rime-logs 25/39, corrected in 43): a fresh install with this
# entry present bounce-looped at login on real hardware, and a diagnostic wrapper did
# record a bare `uwsm` (empty args, ppid `greetd --session-worker`) being executed.
# Those OBSERVATIONS stand. The mechanism previously recorded here — "the greeter
# launches only the FIRST Exec token" — is WRONG: GreetContext.qml::launch() runs the
# session as `["sh","-lc", cmd]`, i.e. the full Exec string through a shell. That form
# dates to 6d3060e (2026-07-21), two days BEFORE the wrapper evidence, git history
# shows no split-on-space version ever existed, and the greeter installed on the system
# that produced the evidence is cmp-identical to this tree. So where the bare `uwsm`
# came from is UNEXPLAINED — it was not the greeter dropping Exec tokens.
#
# The removal stays regardless, on a mechanism-independent ground: hyprland-uwsm.desktop
# sorts BEFORE hyprland.desktop, so it becomes the default session on every fresh
# install, and shipping an entry that empirically bounce-looped AS THE DEFAULT locks
# users out. Plain `hyprland.desktop` is known-good.
#
# uwsm the PACKAGE stays installed, so restoring the entry is a one-line experiment for
# whoever chases the real cause. Do not re-add it as the sort-first default without
# first reproducing a clean login on hardware.
COPY files/desktop/wayland-sessions/niri.desktop \
     /usr/share/wayland-sessions/niri.desktop
RUN set -eux; \
    rm -f /usr/share/wayland-sessions/sway.desktop \
          /usr/share/wayland-sessions/labwc.desktop \
          /usr/share/wayland-sessions/hyprland-uwsm.desktop; \
    [ -f /usr/share/wayland-sessions/hyprland.desktop ] || \
      printf '[Desktop Entry]\nName=Rime Tiling\nComment=Windows tile themselves and reflow as you open and close them (Hyprland)\nExec=Hyprland\nType=Application\nDesktopNames=Hyprland\n' \
        > /usr/share/wayland-sessions/hyprland.desktop; \
    # THE SESSION PICKER SHOWS `Name=`, AND THIS ENTRY COMES FROM THE HYPRLAND
    # PACKAGE, so it is the one session whose wording this repo cannot decide in
    # a file it owns. rime-labwc.desktop and niri.desktop carry product names of
    # their own (Rime Floating, Rime Scrolling); without this line the carousel
    # would read "Rime Floating / Rime Scrolling / Hyprland" and the odd one out
    # would be the DEFAULT session. Renaming is safe because everything that
    # depends on this entry depends on its ID or DesktopNames, never on Name:
    # rime-greet's defaultSession is the literal "hyprland" (the file stem),
    # /var/lib/rime-greet/last-session stores the stem, and rime-session-select
    # validates against the stem.
    sed -i 's/^Name=.*/Name=Rime Tiling/' /usr/share/wayland-sessions/hyprland.desktop; \
    # The directory-wide sweep that this rename exists to satisfy lives in
    # Containerfile.rime, at the one point in the build where every session
    # entry is present (rime-labwc lands below, rime-gaming a tier up).
    grep -q '^Name=Rime Tiling$' /usr/share/wayland-sessions/hyprland.desktop

# labwc as a THIRD user session, offered alongside Hyprland and niri.
#
# It is copied AFTER the rm above, and named rime-labwc.desktop rather than
# labwc.desktop, for two reasons that must not be collapsed: the stock
# labwc.desktop launches labwc bare (no Rime Shell, no config) and has to stay
# deleted, and labwc is simultaneously the greeter's fallback HOST compositor, so
# the stock entry existing at all is a login hazard.
#
# The config templates are installed read-only and seeded per-user by
# rime-shell-firstrun, matching how the Hyprland config is handled.
# Portal backends for the labwc session. See the file for why the packaged
# `default=wlr;*` is not good enough. /etc overrides /usr/share per
# portals.conf(5) without conflicting with the labwc package on upgrade.
COPY files/system/xdg-desktop-portal/labwc-portals.conf \
     /etc/xdg-desktop-portal/labwc-portals.conf
RUN set -eux; \
    test -s /etc/xdg-desktop-portal/labwc-portals.conf; \
    # The backends this config names must actually be installed, or the session
    # silently loses screen sharing and file dialogs. A portal that is merely
    # *configured* is not a portal that answers.
    test -f /usr/share/xdg-desktop-portal/portals/wlr.portal; \
    test -f /usr/share/xdg-desktop-portal/portals/gtk.portal; \
    test -x /usr/libexec/xdg-desktop-portal-wlr; \
    test -x /usr/libexec/xdg-desktop-portal-gtk; \
    # wlr genuinely implements the two capture interfaces we point at it.
    grep -q 'org.freedesktop.impl.portal.ScreenCast' /usr/share/xdg-desktop-portal/portals/wlr.portal; \
    grep -q 'org.freedesktop.impl.portal.Screenshot' /usr/share/xdg-desktop-portal/portals/wlr.portal; \
    # ...and gtk implements the one that the wildcard used to leave to chance.
    grep -q 'org.freedesktop.impl.portal.FileChooser' /usr/share/xdg-desktop-portal/portals/gtk.portal; \
    # No wildcard survives: that is the whole point of overriding the packaged
    # file, so a regression that reintroduces it must fail the build.
    if grep -qE '^\s*default=.*\*' /etc/xdg-desktop-portal/labwc-portals.conf \
        ; then echo "FATAL: a default=* wildcard survives in labwc-portals.conf"; exit 1; fi; \
    grep -qE '^default=gtk$' /etc/xdg-desktop-portal/labwc-portals.conf; \
    grep -qE '^org\.freedesktop\.impl\.portal\.ScreenCast=wlr$' /etc/xdg-desktop-portal/labwc-portals.conf; \
    echo "portals: labwc pinned to wlr capture + gtk desktop interfaces"

# Portal backends for the niri session. Same reason as labwc's, a different
# defect: the niri package DOES ship a config (so this is not the wildcard case),
# but its `default=gnome;gtk` hands FileChooser, AppChooser, Print and Settings
# to xdg-desktop-portal-gnome, so "Open File" is a GNOME dialog on niri and a GTK
# one on the other two sessions this image offers. §24 asks niri for parity with
# Hyprland, and a different file chooser is not parity. See the file.
#
# The filename is load-bearing: portals.conf(5) resolves
# xdg-desktop-portal/<desktop>-portals.conf for each name in XDG_CURRENT_DESKTOP,
# lower-cased. niri sets XDG_CURRENT_DESKTOP=niri in `--session` mode (and
# niri.desktop carries DesktopNames=niri), which is the same premise on which the
# niri package ships its own niri-portals.conf. /etc beats /usr/share by
# DIRECTORY precedence, so this file wins over the packaged one without
# conflicting with it on upgrade.
COPY files/system/xdg-desktop-portal/niri-portals.conf \
     /etc/xdg-desktop-portal/niri-portals.conf
RUN set -eux; \
    test -s /etc/xdg-desktop-portal/niri-portals.conf; \
    # The session this config is named for must exist, and must still announce
    # the desktop name the filename depends on. A rename on either side makes
    # this file silently inert — xdg-desktop-portal would fall back to the
    # packaged config and nothing would report it.
    test -f /usr/share/wayland-sessions/niri.desktop; \
    grep -q '^DesktopNames=niri$' /usr/share/wayland-sessions/niri.desktop; \
    # The backends this config names must actually be installed. gnome is not
    # optional here: niri implements the Mutter ScreenCast API, not
    # wlr-screencopy-backed portal capture, so without xdg-desktop-portal-gnome
    # a niri session has no screen sharing at all.
    test -f /usr/share/xdg-desktop-portal/portals/gnome.portal; \
    test -f /usr/share/xdg-desktop-portal/portals/gtk.portal; \
    test -f /usr/share/xdg-desktop-portal/portals/gnome-keyring.portal; \
    test -x /usr/libexec/xdg-desktop-portal-gnome; \
    test -x /usr/libexec/xdg-desktop-portal-gtk; \
    # ...and each named backend genuinely implements what it is pointed at.
    grep -q 'org.freedesktop.impl.portal.ScreenCast' /usr/share/xdg-desktop-portal/portals/gnome.portal; \
    grep -q 'org.freedesktop.impl.portal.Screenshot' /usr/share/xdg-desktop-portal/portals/gnome.portal; \
    grep -q 'org.freedesktop.impl.portal.FileChooser' /usr/share/xdg-desktop-portal/portals/gtk.portal; \
    grep -q 'org.freedesktop.impl.portal.Secret' /usr/share/xdg-desktop-portal/portals/gnome-keyring.portal; \
    # No wildcard, and gtk leads the default list — that ordering IS the fix, so
    # a regression back to `default=gnome;gtk` must fail the build.
    if grep -qE '^\s*default=.*\*' /etc/xdg-desktop-portal/niri-portals.conf \
        ; then echo "FATAL: a default=* wildcard survives in niri-portals.conf"; exit 1; fi; \
    grep -qE '^default=gtk;gnome$' /etc/xdg-desktop-portal/niri-portals.conf; \
    grep -qE '^org\.freedesktop\.impl\.portal\.ScreenCast=gnome$' /etc/xdg-desktop-portal/niri-portals.conf; \
    grep -qE '^org\.freedesktop\.impl\.portal\.Screenshot=gnome$' /etc/xdg-desktop-portal/niri-portals.conf; \
    grep -qE '^org\.freedesktop\.impl\.portal\.Secret=gnome-keyring$' /etc/xdg-desktop-portal/niri-portals.conf; \
    # ── Every desktop session this image offers, BY NAME ────────────────────
    # Enumerated, never counted: niri went three releases with no Rime portal
    # configuration at all while labwc's was build-verified, and no assertion
    # here could see it, because nothing asked "and what about the other
    # sessions". A `-ge 2` would pass with one of these missing.
    #
    # For each, the desktop name that portals.conf(5) will look up must resolve
    # to a config SOMEWHERE — /etc for the two Rime pins, /usr/share for
    # Hyprland, whose packaged `default=hyprland;gtk` already reaches gtk for the
    # desktop interfaces because hyprland.portal implements only capture and
    # shortcuts — and none of them may resolve through a wildcard.
    #
    # rime-gaming (DesktopNames=gamescope) is deliberately NOT in this list:
    # it is Steam Big Picture inside gamescope with no desktop session, no
    # Flatpak file dialogs and no portal story. Named as excluded rather than
    # silently absent, because "absent" is what this whole block exists to
    # catch. It is also a Gaming-flavor file and does not exist in base.
    for d in hyprland niri labwc; do \
        c=""; \
        for p in "/etc/xdg-desktop-portal/${d}-portals.conf" "/usr/share/xdg-desktop-portal/${d}-portals.conf"; do \
            if [ -s "$p" ]; then c="$p"; break; fi; \
        done; \
        [ -n "$c" ] || { echo "FATAL: no portals.conf resolves for XDG_CURRENT_DESKTOP=${d}"; exit 1; }; \
        if grep -qE '^\s*default=.*\*' "$c"; then \
            echo "FATAL: ${c} resolves backends through a wildcard"; exit 1; \
        fi; \
        echo "portals: ${d} -> ${c}"; \
    done; \
    echo "portals: niri pinned to gnome capture + gtk desktop interfaces"

# ── Hyprland: the same pins, plus the Secret portal this session did not have ─
# P1-061. The packaged hyprland-portals.conf (`default=hyprland;gtk`) is right
# about capture and about the desktop interfaces, and this file keeps both —
# a config in /etc REPLACES the one in /usr/share rather than merging with it,
# so `default` has to be restated or FileChooser would be stranded.
#
# What it adds is org.freedesktop.impl.portal.Secret. Neither hyprland.portal
# nor gtk.portal implements it, gnome-keyring.portal does and carries
# `UseIn=gnome`, and the only thing that reaches a backend whose UseIn does not
# match the session is naming it explicitly. Until this file existed, a Flatpak
# asking for the Secret portal on Rime's DEFAULT session got nothing while the
# same Flatpak on the niri session got gnome-keyring.
COPY files/system/xdg-desktop-portal/hyprland-portals.conf \
     /etc/xdg-desktop-portal/hyprland-portals.conf
RUN set -eux; \
    test -s /etc/xdg-desktop-portal/hyprland-portals.conf; \
    # The session this config is named for must exist and must still announce
    # the desktop name the filename depends on — portals.conf(5) resolves
    # <desktop>-portals.conf from XDG_CURRENT_DESKTOP, lower-cased. A rename on
    # either side makes this file silently inert.
    test -f /usr/share/wayland-sessions/hyprland.desktop; \
    grep -qi '^DesktopNames=Hyprland$' /usr/share/wayland-sessions/hyprland.desktop; \
    # The backends it names must be installed...
    test -f /usr/share/xdg-desktop-portal/portals/hyprland.portal; \
    test -f /usr/share/xdg-desktop-portal/portals/gtk.portal; \
    test -f /usr/share/xdg-desktop-portal/portals/gnome-keyring.portal; \
    test -x /usr/libexec/xdg-desktop-portal-hyprland; \
    test -x /usr/libexec/xdg-desktop-portal-gtk; \
    # ...and must genuinely implement what they are pointed at. The Secret line
    # is the whole point of the file, so gnome-keyring.portal declaring it is
    # not something to take on trust.
    grep -q 'org.freedesktop.impl.portal.ScreenCast' /usr/share/xdg-desktop-portal/portals/hyprland.portal; \
    grep -q 'org.freedesktop.impl.portal.Screenshot' /usr/share/xdg-desktop-portal/portals/hyprland.portal; \
    grep -q 'org.freedesktop.impl.portal.FileChooser' /usr/share/xdg-desktop-portal/portals/gtk.portal; \
    grep -q 'org.freedesktop.impl.portal.Secret' /usr/share/xdg-desktop-portal/portals/gnome-keyring.portal; \
    # Neither of the two backends in `default` implements Secret. If either ever
    # does, this pin becomes redundant rather than wrong — but the assertion
    # says WHY the pin is here, so a future reader is not left guessing.
    if grep -q 'org.freedesktop.impl.portal.Secret' /usr/share/xdg-desktop-portal/portals/hyprland.portal \
        ; then echo "FATAL: hyprland.portal now implements Secret; revisit the pin above"; exit 1; fi; \
    if grep -q 'org.freedesktop.impl.portal.Secret' /usr/share/xdg-desktop-portal/portals/gtk.portal \
        ; then echo "FATAL: gtk.portal now implements Secret; revisit the pin above"; exit 1; fi; \
    # No wildcard, and the three pins are present.
    if grep -qE '^\s*default=.*\*' /etc/xdg-desktop-portal/hyprland-portals.conf \
        ; then echo "FATAL: a default=* wildcard survives in hyprland-portals.conf"; exit 1; fi; \
    grep -qE '^default=hyprland;gtk$' /etc/xdg-desktop-portal/hyprland-portals.conf; \
    grep -qE '^org\.freedesktop\.impl\.portal\.ScreenCast=hyprland$' /etc/xdg-desktop-portal/hyprland-portals.conf; \
    grep -qE '^org\.freedesktop\.impl\.portal\.Screenshot=hyprland$' /etc/xdg-desktop-portal/hyprland-portals.conf; \
    grep -qE '^org\.freedesktop\.impl\.portal\.Secret=gnome-keyring$' /etc/xdg-desktop-portal/hyprland-portals.conf; \
    # All three desktop sessions now pin Secret, which is the parity this
    # closes. Enumerated rather than counted, for the reason the block above
    # gives: a count passes with one of them missing.
    for d in hyprland niri labwc; do \
        grep -qE '^org\.freedesktop\.impl\.portal\.Secret=gnome-keyring$' \
            "/etc/xdg-desktop-portal/${d}-portals.conf" \
            || { echo "FATAL: ${d} has no Secret portal backend"; exit 1; }; \
    done; \
    echo "portals: hyprland pinned to its own capture + gtk desktop interfaces + gnome-keyring secrets"

COPY files/desktop/wayland-sessions/rime-labwc.desktop \
     /usr/share/wayland-sessions/rime-labwc.desktop
COPY files/desktop/labwc/ /usr/share/rime/labwc/
RUN set -eux; \
    test -f /usr/share/wayland-sessions/rime-labwc.desktop; \
    test ! -f /usr/share/wayland-sessions/labwc.desktop; \
    command -v labwc >/dev/null; \
    # Idle screen-off. The shipped hypridle.conf's 6-minute listener calls
    # rime-shell's DpmsControl.sh, which resolves to `wlopm --off '*'` on labwc
    # — the only route there is, because labwc publishes no IPC socket and
    # zwlr-output-power-management-v1 is the protocol it implements for this.
    # Without the binary the listener fires, reports a missing program, and the
    # display stays lit; asserting it here is what keeps that from regressing to
    # the silent version it used to be.
    command -v wlopm >/dev/null; \
    for f in rc.xml menu.xml autostart environment themerc-override; do \
        test -s "/usr/share/rime/labwc/$f"; \
    done; \
    # labwc has no --verify-config, so the XML is validated structurally at build
    # time instead. A malformed rc.xml makes labwc fall back to defaults
    # SILENTLY: the session would still start, but with no keybinds and no Rime
    # Shell, which is a far worse failure than a build error.
    xmllint --noout /usr/share/rime/labwc/rc.xml; \
    xmllint --noout /usr/share/rime/labwc/menu.xml; \
    # The shell's compositor detection depends on this being set, and labwc
    # publishes no socket or signature variable of its own.
    grep -q '^XDG_CURRENT_DESKTOP=labwc' /usr/share/rime/labwc/environment; \
    # The session is worthless if the shell never starts.
    grep -q 'rime-shell-autostart' /usr/share/rime/labwc/autostart; \
    # The keybinds invoke `rime shell`. That the VERB exists is asserted at the
    # end of this file, where the binaries are copied in; here we only check the
    # configs reference it, which is all this layer can see.
    grep -q 'rime shell' /usr/share/rime/labwc/rc.xml; \
    grep -q 'rime shell' /usr/share/rime/labwc/menu.xml; \
    # Desktop right-click must reach the Rime menu, and menu.xml must survive as
    # the modifier-reachable emergency path. Checked here rather than beside the
    # helper COPYs, because rc.xml does not exist until this layer.
    grep -q '/usr/libexec/rime-desktop-menu' /usr/share/rime/labwc/rc.xml; \
    grep -q 'ShowMenu' /usr/share/rime/labwc/rc.xml; \
    test -s /usr/share/rime/labwc/menu.xml; \
    # `qs` is what `rime shell` actually calls; without it the wrapper is inert.
    command -v qs >/dev/null; \
    # ── Rime Floating window chrome ─────────────────────────────────────────
    # labwc IGNORES an unrecognised theme key in silence, so a typo does not
    # break a session, it just leaves that element on the built-in grey — the
    # Openbox-fallback look this theme exists to remove. Assert the shape here
    # and the key names in tests/test-rime-firstrun.sh, which has labwc-theme(5)
    # available.
    grep -q '@ACCENT@' /usr/share/rime/labwc/themerc-override; \
    grep -qE '^window\.titlebar\.padding\.height: 11$' /usr/share/rime/labwc/themerc-override; \
    grep -qE '^window\.button\.width: 30$' /usr/share/rime/labwc/themerc-override; \
    grep -qE '^border\.width: 1$' /usr/share/rime/labwc/themerc-override; \
    # Window chrome must use a PROPORTIONAL face, and the font it names must
    # actually be installed: fontconfig silently substitutes a missing family,
    # so naming a font the image does not ship is invisible until someone looks
    # at a titlebar. Noto Sans comes from google-noto-sans-fonts in core.
    grep -q '<name>Noto Sans</name>' /usr/share/rime/labwc/rc.xml; \
    if grep -qE '<name>[^<]*Mono[^<]*</name>' /usr/share/rime/labwc/rc.xml \
        ; then echo "FATAL: labwc rc.xml names a Mono family for titlebar text"; exit 1; fi; \
    fc-match --format='%{family}\n' 'Noto Sans' | grep -qi 'noto sans'; \
    grep -qE '<cornerRadius>1[0-2]</cornerRadius>' /usr/share/rime/labwc/rc.xml; \
    grep -q '<dropShadows>yes</dropShadows>' /usr/share/rime/labwc/rc.xml; \
    grep -q 'style="thumbnail"' /usr/share/rime/labwc/rc.xml; \
    echo "Rime Floating: chrome theme, proportional font and thumbnail switcher verified"

# ── Rime Safe Graphics: the recovery session (roadmap P2-018) ───────────────
# A second labwc session with a BAKED config directory. `labwc -C` is what
# makes it a recovery session rather than a second desktop: the compositor
# reads rc.xml, autostart, environment and menu.xml from /usr/share/rime/
# safe-graphics and never opens ~/.config/labwc — the file rime-input-apply
# splices into and rime-labwc-keybinds generates into, and therefore the file
# that can be the reason the ordinary session did not paint.
COPY --chmod=0755 files/system/libexec/rime-safe-graphics \
     /usr/libexec/rime-safe-graphics
COPY --chmod=0755 files/system/libexec/rime-safe-graphics-terminal \
     /usr/libexec/rime-safe-graphics-terminal
COPY files/desktop/safe-graphics/ /usr/share/rime/safe-graphics/
COPY files/desktop/wayland-sessions/rime-safe-graphics.desktop \
     /usr/share/wayland-sessions/rime-safe-graphics.desktop
RUN set -eux; \
    for f in rc.xml menu.xml autostart environment; do \
        if ! test -s "/usr/share/rime/safe-graphics/$f"; then \
            echo "FATAL: the safe-graphics config is missing $f"; exit 1; fi; \
    done; \
    xmllint --noout /usr/share/rime/safe-graphics/rc.xml; \
    xmllint --noout /usr/share/rime/safe-graphics/menu.xml; \
    # THE criterion, as a build refusal. Without `-C <dir>` this session reads
    # the user's own labwc configuration, which is the configuration it exists
    # to be independent of — and labwc falls back to its defaults SILENTLY on a
    # malformed one, so the regression would ship looking like it worked.
    if ! grep -q 'exec labwc -C "\$CONFIG_DIR"' /usr/libexec/rime-safe-graphics; then \
        echo "FATAL: rime-safe-graphics does not exec labwc with a config directory of its own"; \
        exit 1; fi; \
    # Software rendering, because "the GPU does not work" is the case this
    # session exists for.
    for v in WLR_RENDERER=pixman LIBGL_ALWAYS_SOFTWARE=1 WLR_NO_HARDWARE_CURSORS=1; do \
        if ! grep -q "$v" /usr/libexec/rime-safe-graphics; then \
            echo "FATAL: rime-safe-graphics does not force $v"; exit 1; fi; \
    done; \
    # WLR_BACKENDS pinned here would mean this session could only ever be
    # exercised by taking a display away from whoever is testing it, and on a
    # real machine `headless` would be a session with no screen.
    if grep -qE "^ *(export +)?WLR_BACKENDS=" /usr/libexec/rime-safe-graphics; then \
        echo "FATAL: rime-safe-graphics pins WLR_BACKENDS"; exit 1; fi; \
    # Rime Shell is one of the things that can be broken; a recovery session
    # that started it would fail the way the session the user just left failed.
    # Comments are stripped first, because the autostart SAYS it deliberately
    # does not do this and the sentence is the useful part.
    if grep -vE "^[[:space:]]*(#|<!--)" /usr/share/rime/safe-graphics/autostart \
        | grep -qE "rime-shell-autostart|qs -p"; then \
        echo "FATAL: the safe-graphics autostart starts Rime Shell"; exit 1; fi; \
    # The remedies P2-018's second criterion asks for, each named on the menu.
    for needle in "rime recover status" "rime doctor" "rime-safe-graphics diagnose" \
                  "rime rollback" "thunar" "nmtui"; do \
        if ! grep -qF "$needle" /usr/share/rime/safe-graphics/menu.xml; then \
            echo "FATAL: the safe-graphics menu offers no way to: $needle"; exit 1; fi; \
    done; \
    # NAMING A REMEDY ON THE MENU IS NOT SHIPPING IT. The loop above proves the
    # menu offers a way to reach files and the network, which is P2-018's second
    # criterion; it proves nothing about whether either binary is in the image,
    # and a menu entry for a command that is not there is a recovery session
    # that looks complete and does nothing when clicked — the K12/K13 defect,
    # where every source-reading assertion stays green while the artifact is
    # broken. Both are checked HERE, on the built artifact.
    #
    # Thunar comes from Containerfile.core (core is this file's FROM), so it is
    # named by Rime and a build that lost it says so. nmtui is DIFFERENT and
    # the difference is the point: NetworkManager-tui is named by no Rime dnf
    # list. It is inherited from quay.io/fedora/fedora-bootc:43, nothing in the
    # image requires it, and it is not even a weak dependency of NetworkManager
    # — it is simply in the base manifest today. This assertion is the only
    # thing standing between a base-image change and a recovery session whose
    # single network tool vanished silently. IF IT EVER FIRES, the fix is to add
    # NetworkManager-tui to the dnf list in Containerfile.core, not to drop the
    # entry from the menu.
    for _bin in thunar nmtui; do \
        if ! command -v "$_bin" >/dev/null 2>&1; then \
            echo "FATAL: the safe-graphics menu offers $_bin but the image has no such command"; \
            exit 1; fi; \
    done; \
    # The terminals the helper will look for, in its own order. foot and
    # alacritty both come from core; asserting it here is what keeps a session
    # whose only client is a terminal from shipping without one.
    command -v foot >/dev/null || command -v alacritty >/dev/null; \
    test -x /usr/libexec/rime-safe-graphics-terminal; \
    test -f /usr/share/wayland-sessions/rime-safe-graphics.desktop; \
    grep -qx "Exec=/usr/libexec/rime-safe-graphics" \
        /usr/share/wayland-sessions/rime-safe-graphics.desktop; \
    grep -qx "TryExec=/usr/libexec/rime-safe-graphics" \
        /usr/share/wayland-sessions/rime-safe-graphics.desktop; \
    echo "Rime Safe Graphics: baked config, software rendering, recovery menu verified"

# The labwc bindings are maintained by hand — the shell's keybind editor emits
# Hyprland .conf/.lua and niri .kdl, and labwc has neither an IPC to push
# bindings over nor an include mechanism to append a generated file to. So they
# can drift from what the other two sessions do, and drift is invisible until
# someone presses a key and nothing happens.
#
# They DID drift: the launcher shipped as SUPER+SPACE when every other session
# used ALT+SPACE, plus two more wrong combos and eleven missing bindings. This is
# the gate that would have caught it. Both trees exist at this point in the
# build, so the comparison is exact rather than assumed.
#
# They are GENERATED now — /usr/libexec/rime-labwc-keybinds owns the marked
# region of rc.xml — so this no longer compares two hand-written lists. It
# asserts the seeded file is byte-for-byte what the generator produces from the
# shell's defaults, which is a stronger statement and one that cannot be
# satisfied by editing the config alone.
COPY --chmod=0755 files/scripts/check-labwc-keybinds /tmp/check-labwc-keybinds
RUN /tmp/check-labwc-keybinds /usr/share/rime-shell /usr/share/rime/labwc/rc.xml \
    && rm -f /tmp/check-labwc-keybinds

# ── Stage 6: flathub remote (first-boot) + greeter payload + config ────────
# Flathub CANNOT reliably be added at build time on bootc: `flatpak remote-add
# --system` writes to /var/lib/flatpak, and bootc treats /var as machine-local
# state that is only seeded once and never updated — a build-time remote is
# fragile across upgrades. So ship an idempotent first-boot oneshot (the uBlue
# pattern) that adds Flathub on the running system. `flatpak remote-add
# --if-not-exists` makes it safe to run repeatedly; a stamp keeps it quiet after
# the first success. Flatseal is then installable from Flathub as a first-run
# app (documented in the flavor images / README) — it cannot be preinstalled
# because flatpak install needs a running system.
COPY files/system/flatpak/flathub.flatpakrepo /etc/flatpak/flathub.flatpakrepo
COPY files/system/units/rime-flathub-setup.service \
     /usr/lib/systemd/system/rime-flathub-setup.service

# ── Zen Browser, shipped but not imposed ────────────────────────────────────
# ONE browser ships: Firefox. Zen Browser used to be installed on first boot as
# a Flatpak, and with its runtimes that was ~2 GB on every new machine —
# measured 2026-10-04 on a VM install: 7.8 GB after the install, 9.9 GB after
# the first boot, which on a 12 GB disk is 91% full and the storage notice on
# day one. It is an app, and apps install on demand now:
# `sudo rime install app.zen_browser.zen`. Machines that already have it
# keep it, and `rime update` keeps updating it.
#
# FIREFOX IS THE DEFAULT BROWSER, and the assertions below hold that in place: a
# Flatpak's exported .desktop can win the http/https handler depending on XDG
# data directory ordering, so a second browser installed later must not become
# the default by accident.
# SUPER+W opens the DEFAULT browser, not a named one. `$browser = firefox` in
# hyprland.conf meant the keybind contradicted the user's own setting the moment
# a second browser existed. The helper resolves the http/https handler at press
# time, so it follows the user to any browser, including ones Rime has never
# heard of.
COPY --chmod=0755 files/system/libexec/rime-open-browser \
     /usr/libexec/rime-open-browser
RUN set -eux; \
    # No first-boot browser install. Its absence is asserted, not assumed: a
    # unit file that comes back is 2 GB back on every new machine.
    test ! -e /usr/lib/systemd/system/rime-flatpak-preinstall.service; \
    # FIREFOX owns the web handlers in the shipped defaults. If this ever
    # fails, an image has silently changed every user's default browser.
    grep -q '^x-scheme-handler/http=firefox.desktop$'  /etc/xdg/mimeapps.list; \
    grep -q '^x-scheme-handler/https=firefox.desktop$' /etc/xdg/mimeapps.list; \
    # And no second browser shipped as a system .desktop, which would put it in
    # the handler race at build time.
    test ! -e /usr/share/applications/app.zen_browser.zen.desktop; \
    # The browser keybind must name no browser. A regression here is invisible
    # until someone changes their default and wonders why SUPER+W ignores it.
    test -x /usr/libexec/rime-open-browser; \
    bash -n /usr/libexec/rime-open-browser; \
    grep -q 'local browser *= *"/usr/libexec/rime-open-browser"' \
        /usr/share/rime/hypr/rime/keybindings.lua; \
    if grep -qE 'local browser *= *"(firefox|zen)' /usr/share/rime/hypr/rime/keybindings.lua \
        ; then echo "FATAL: the keybinding hard-codes a browser instead of the wrapper"; exit 1; fi; \
    echo "browser: firefox ships and keeps the web handlers; SUPER+W follows the default"

# ── The window switcher's keybind side ───────────────────────────────────────
# ALT+Tab opens the Rime Shell switcher and releasing ALT commits it. The
# release is reported by the COMPOSITOR — Hyprland's `release = true` bind and
# labwc's `onRelease="yes"` keybind — rather than by a shell surface that took
# keyboard focus to watch for it, because taking keyboard focus is how a
# switcher steals focus from the window it is about to activate.
#
# Both of those fire on every Alt release for as long as the machine is on, so
# the helper's closed-state path is asserted here to be exactly that: a test and
# an exit, with no `rime` invocation. The stub below FAILS the build if the
# closed path calls it, which is the only way to check a cost rather than
# describe one.
COPY --chmod=0755 files/system/libexec/rime-switcher /usr/libexec/rime-switcher
RUN set -eux; \
    test -x /usr/libexec/rime-switcher; \
    sh -n /usr/libexec/rime-switcher; \
    : 'Hyprland: the four binds exist and the release ones are releases.'; \
    grep -q '"/usr/libexec/rime-switcher"' /usr/share/rime/hypr/rime/keybindings.lua; \
    for _k in 'switcher .. " next"' 'switcher .. " prev"' \
              'switcher .. " cancel"' 'switcher .. " commit"'; do \
        grep -qF "$_k" /usr/share/rime/hypr/rime/keybindings.lua; \
    done; \
    for _c in 'bind("ALT",       "Alt_L"' 'bind("ALT",       "Alt_R"' \
              'bind("ALT SHIFT", "Alt_L"' 'bind("ALT SHIFT", "Alt_R"'; do \
        grep -qF "$_c" /usr/share/rime/hypr/rime/keybindings.lua; \
    done; \
    if ! grep -q 'release  = { release = true, non_consuming = true' \
        /usr/share/rime/hypr/rime/keybindings.lua \
        ; then echo "FATAL: the switcher release binds are not release + non-consuming"; exit 1; fi; \
    : 'non_consuming, NOT transparent. `t` means "cannot be shadowed by'; \
    : 'another bind" and still eats the key; `n` is what passes it on. Three'; \
    : 'other plausible spellings are accepted by hl.bind and silently do'; \
    : 'nothing, so this is checked here and asserted against a running'; \
    : 'instance in tests/test-rime-hypr-focus.sh.'; \
    : 'ALT+Return is the commit that does not depend on release semantics.'; \
    grep -q 'bind("ALT",       "Return"' /usr/share/rime/hypr/rime/keybindings.lua; \
    if ! grep -q 'commit   = { non_consuming = true' \
        /usr/share/rime/hypr/rime/keybindings.lua \
        ; then echo "FATAL: ALT+Return would eat ALT+Return from every application"; exit 1; fi; \
    : 'labwc keeps its OWN switcher, because labwc-config(5) says onRelease is'; \
    : 'for a modifier used WITHOUT another key -- measured: it never fires'; \
    : 'after A-Tab. What it was missing is the cross-desktop attribute.'; \
    grep -q '<action name="NextWindow" workspace="all"/>'     /usr/share/rime/labwc/rc.xml; \
    grep -q '<action name="PreviousWindow" workspace="all"/>' /usr/share/rime/labwc/rc.xml; \
    if grep -q 'rime-switcher' /usr/share/rime/labwc/rc.xml \
        ; then echo "FATAL: labwc binds the shell switcher, which it cannot commit"; exit 1; fi; \
    : 'The closed-state path must not reach the shell. A stub rime that fails'; \
    : 'the build if it is called is the only honest way to assert that.'; \
    mkdir -p /tmp/switcher-probe/bin /tmp/switcher-probe/run; \
    printf '#!/bin/sh\nexit 97\n' > /tmp/switcher-probe/bin/rime; \
    chmod +x /tmp/switcher-probe/bin/rime; \
    PATH="/tmp/switcher-probe/bin:$PATH" XDG_RUNTIME_DIR=/tmp/switcher-probe/run \
        /usr/libexec/rime-switcher commit; \
    PATH="/tmp/switcher-probe/bin:$PATH" XDG_RUNTIME_DIR=/tmp/switcher-probe/run \
        /usr/libexec/rime-switcher cancel; \
    : 'and with the flag present it MUST reach the shell — 97 from the stub.'; \
    mkdir -p /tmp/switcher-probe/run/rime-shell; \
    touch /tmp/switcher-probe/run/rime-shell/switcher-open; \
    _rc=0; \
    PATH="/tmp/switcher-probe/bin:$PATH" XDG_RUNTIME_DIR=/tmp/switcher-probe/run \
        /usr/libexec/rime-switcher commit || _rc=$?; \
    if [ "$_rc" -ne 97 ]; then \
        echo "FATAL: rime-switcher commit did not reach the shell with the flag set (rc=$_rc)"; \
        exit 1; fi; \
    : 'next/prev must never consult the flag, so a stale one cannot wedge it.'; \
    rm -f /tmp/switcher-probe/run/rime-shell/switcher-open; \
    _rc=0; \
    PATH="/tmp/switcher-probe/bin:$PATH" XDG_RUNTIME_DIR=/tmp/switcher-probe/run \
        /usr/libexec/rime-switcher next || _rc=$?; \
    if [ "$_rc" -ne 97 ]; then \
        echo "FATAL: rime-switcher next did not reach the shell (rc=$_rc)"; exit 1; fi; \
    : 'and `next` must have WRITTEN the flag before reaching the shell. This is'; \
    : 'the single-tap race: a quick ALT+Tab lets go of ALT about 60ms after Tab'; \
    : 'goes down, and a flag written by the shell at the end of a'; \
    : 'spawn -> rime -> qs ipc -> Process chain does not exist yet when the'; \
    : 'release arrives. The commit is then dropped and the switcher is left'; \
    : 'open on the wrong entry.'; \
    if [ ! -e /tmp/switcher-probe/run/rime-shell/switcher-open ]; then \
        echo "FATAL: rime-switcher next did not write the flag before the IPC"; exit 1; fi; \
    rm -rf /tmp/switcher-probe; \
    echo "switcher: ALT+Tab opens it, the Alt release commits it, and a closed switcher costs one stat"

# The whole rime-greet tree lands at /usr/share/rime-greet so the QML's
# Qt.resolvedUrl("assets/…") resolves in place; the wallpaper is dropped where
# GreetSurface.qml expects it; greetd-config.toml becomes the live greetd
# config; sway-greet.conf is the layer-shell-capable host config it launches.
COPY files/desktop/rime-greet /usr/share/rime-greet
COPY files/branding/wallpapers/rime-wallpaper-default.jpg \
     /usr/share/backgrounds/rime/default.jpg
COPY files/desktop/rime-greet/greetd-config.toml /etc/greetd/config.toml

# The shipped login config is NOT the kiosk recipe, asserted here because here
# is where the file first exists. P2-016's third criterion is that kiosk policy
# is possible "without weakening ordinary desktop use", which is a claim about
# THIS file rather than about the recipe — and the only way to break it by
# accident is for the recipe to end up installed as the live config.
RUN set -eux; \
    test -f /etc/greetd/config.toml; \
    : 'greetd auto-login is [initial_session]. The ordinary config must not'; \
    : 'have one: a machine that logs a user in without asking is a kiosk,'; \
    : 'whatever else it calls itself.'; \
    if grep -qE '^[[:space:]]*\[initial_session\]' /etc/greetd/config.toml \
        ; then echo "FATAL: greetd is configured to fire once per boot"; exit 1; fi; \
    : 'And it must not BE the recipe. Compared by content, because a recipe'; \
    : 'copied into place would satisfy every other check in this file.'; \
    if cmp -s /etc/greetd/config.toml \
             /usr/share/rime/shared-machine/greetd-kiosk.toml \
        ; then echo "FATAL: the shipped greetd config IS the shared-machine kiosk recipe"; exit 1; fi; \
    echo "login config: no auto-login, and not the kiosk recipe"

# ── The login unlocks the keyring ──────────────────────────────────────────
# Fedora's /etc/pam.d/greetd already asks for pam_gnome_keyring.so in its auth
# and session stacks, but with a leading `-`, which means "skip it if the
# module is missing" — and it was missing: gnome-keyring (core) does not pull
# in gnome-keyring-pam. So a password typed at the login screen never reached
# the keyring. The daemon was started later by D-Bus activation, locked, and
# the first application to ask for a secret opened a password prompt. On
# 2026-09-29 that was Zen, opened at login by the Shell to show the release
# notes, so the first thing after an update was a keyring dialog.
#
# Here and not beside gnome-keyring in Containerfile.core, so the fix does not
# cost a core rebuild; dnf pins it to the installed gnome-keyring's version.
# The login keyring still has to share the account's password to open this way.
RUN dnf5 -y install gnome-keyring-pam && dnf5 clean all && rm -rf /var/cache/libdnf5
RUN set -eux; \
    test -f /usr/lib64/security/pam_gnome_keyring.so; \
    test "$(rpm -q --qf '%{VERSION}-%{RELEASE}' gnome-keyring-pam)" \
       = "$(rpm -q --qf '%{VERSION}-%{RELEASE}' gnome-keyring)"; \
    : 'The module is only useful where the login stack names it: the auth'; \
    : 'half takes the password, the session half starts and unlocks the'; \
    : 'daemon with it.'; \
    grep -qE '^-?auth[[:space:]]+optional[[:space:]]+pam_gnome_keyring\.so' /etc/pam.d/greetd; \
    grep -qE '^-?session[[:space:]]+optional[[:space:]]+pam_gnome_keyring\.so[[:space:]]+auto_start' /etc/pam.d/greetd; \
    echo "login: greetd hands the password to pam_gnome_keyring, so the keyring opens at login"

# ── …and the keyring a machine already has becomes the login keyring ──────
# pam_gnome_keyring opens only the keyring called `login`, and no Rime machine
# had one: without the module, the first app to store a secret got a gcr
# prompt and a keyring called Default_Keyring. Left alone, PAM would add an
# empty `login` beside it and the prompt would stay. rime-keyring-login runs
# with the typed password after system-auth has checked it and before
# pam_gnome_keyring gets it, and renames the default keyring to `login` when
# that password opens it (its header has the rules). Existing machines get
# this line because ostree carries an unmodified /etc/pam.d/greetd forward.
COPY --chmod=0755 files/system/libexec/rime-keyring-login /usr/libexec/rime-keyring-login
RUN set -eux; \
    python3 -c 'import ast, sys; ast.parse(open(sys.argv[1]).read())' /usr/libexec/rime-keyring-login; \
    test -x /usr/sbin/unix_chkpwd; \
    test -e /usr/lib64/libcrypto.so.3; \
    python3 -c 'import ctypes; ctypes.CDLL(None).renameat2'; \
    : 'pam_exec with expose_authtok PROMPTS for a password when none is set,'; \
    : 'so it has to run where one always is: after system-auth, which here can'; \
    : 'only succeed through pam_unix and a typed password. A fingerprint, token'; \
    : 'or homed module that succeeds without one would put a second password'; \
    : 'prompt in front of that login.'; \
    if grep -qE '^-?auth[[:space:]].*(pam_fprintd|pam_u2f|pam_sss|pam_pkcs11|pam_systemd_home|pam_howdy)' /etc/pam.d/system-auth; then \
        echo "FATAL: system-auth can succeed without a typed password; rime-keyring-login would prompt"; exit 1; fi; \
    sed -i '/^auth[[:space:]]\+substack[[:space:]]\+system-auth$/a auth       optional    pam_exec.so quiet expose_authtok /usr/libexec/rime-keyring-login' /etc/pam.d/greetd; \
    test "$(grep -c 'rime-keyring-login' /etc/pam.d/greetd)" = 1; \
    : 'Directly after the password check, and before pam_gnome_keyring.'; \
    awk '/^auth[[:space:]]+substack[[:space:]]+system-auth/ {s = NR} \
         /rime-keyring-login/ {h = NR} \
         /^-?auth[[:space:]].*pam_gnome_keyring/ {g = NR} \
         END {exit !(s && h == s + 1 && g > h)}' /etc/pam.d/greetd; \
    : 'Never stdout: pam_exec would hand it to the greeter as a message.'; \
    if grep -qE 'pam_exec\.so[^#]*[[:space:]]stdout' /etc/pam.d/greetd; then \
        echo "FATAL: a pam_exec line in greetd passes stdout to the greeter"; exit 1; fi; \
    echo "login: an existing default keyring becomes the login keyring when the login password opens it"

# ── The login screen's session bus ─────────────────────────────────────────
# greetd's command is this wrapper, not the compositor directly. It gives the
# greet session a D-Bus session bus and an accessibility bus and then EXECS the
# compositor, so greetd still holds the compositor's own PID and tears the
# greeter down exactly as before.
#
# Without it the greeter's accessibility markup reached nobody. Qt's AT-SPI
# bridge resolves org.a11y.Bus on the SESSION bus like every other desktop
# application, and the greet session had no session bus at all — so a login
# screen that is fully marked up, and that a screen reader can both read and
# operate under test, published zero nodes in production.
#
# THE ASSERTIONS BELOW ARE THE SAFETY ARGUMENT, and they are here rather than
# only in tests/ because greetd is boot-critical: a greeter whose command names
# a path nothing installed is a machine that cannot be logged into, and every
# source-reading assertion in the repository would stay green while it was true
# (the K12/K13 defect, where a launcher was repointed at a file no Containerfile
# copied and the ISO would have booted with no installer at all).
COPY --chmod=0755 files/system/libexec/rime-greet-session /usr/libexec/rime-greet-session
RUN set -eux; \
    sh -n /usr/libexec/rime-greet-session; \
    test -x /usr/libexec/rime-greet-session; \
    : 'greetd command must NAME the wrapper, and the wrapper must exist at the'; \
    : 'path it is named by. Read out of the live config, not out of the repo.'; \
    grep -q '^command = "/usr/libexec/rime-greet-session ' /etc/greetd/config.toml; \
    : 'and the wrapper last act must still be to exec what it was handed.'; \
    : 'A wrapper that forgot that line is a login screen that never paints.'; \
    tail -1 /usr/libexec/rime-greet-session | grep -qx 'exec "$@"'; \
    : 'The pieces it uses are optional at runtime and asserted here, because'; \
    : 'the greeter degrading gracefully is only interesting if the good path'; \
    : 'is the one that ships. at-spi2-core arrives as a transitive dependency'; \
    : 'of gtk4/Qt; if either ever stops being installed, this build says so'; \
    : 'instead of shipping a silently unreadable greeter.'; \
    command -v dbus-daemon >/dev/null; \
    test -x /usr/libexec/at-spi-bus-launcher; \
    test -x /usr/libexec/at-spi2-registryd; \
    : 'The one key a user who cannot see the screen can press, on both hosts.'; \
    grep -q 'rime-screen-reader' /usr/share/rime-greet/sway-greet.conf; \
    grep -q 'rime-screen-reader' /usr/share/rime-greet/labwc-greet/rc.xml; \
    test -x /usr/libexec/rime-screen-reader; \
    : 'The host config is NOT put through sway -C here, and that is measured'; \
    : 'rather than an oversight. /usr/bin/sway carries the file capability'; \
    : 'cap_sys_nice=ep, and exec of a binary with an EFFECTIVE file capability'; \
    : 'outside the bounding set returns EPERM -- so inside an image build sway'; \
    : 'cannot run at all: rc=126, Operation not permitted, for a good config'; \
    : 'and a deliberately broken one alike. A check that returns 126 either'; \
    : 'way is not a check. The parse check lives in'; \
    : 'tests/test-rime-greet-session-bus.sh, where it runs on a real machine'; \
    : 'and is proved in both directions, and SKIPs with a reason where sway'; \
    : 'cannot be executed.'; \
    echo "greeter session wrapper: installed, named by greetd, and both hosts bind the reader"

# ── The bounce watchdog: what makes the recovery session reachable ────────
# P2-018's first criterion is that a graphics/compositor/shell failure CAN
# ENTER the recovery desktop. Rime Safe Graphics shipped as a session a PERSON
# enters. Nothing NOTICED a failure: greetd is a stock Fedora unit with no
# Restart=, no StartLimitBurst and no OnFailure=, and rime-boot-health's units
# are inert on every published image because they condition on
# LoaderBootCountPath while every Rime image boots GRUB. So a machine whose
# driver stopped working bounced — session starts, dies in a second, login
# screen returns — for ever, and every bounce looked like the last one.
#
# The greeter is the one process demonstrably alive after each bounce, so it is
# the one that counts: it records what it launched on the way out and asks on
# the way in. Three sessions that did not survive the grace period and the
# picker preselects Rime Safe Graphics, with a line saying why.
#
# THESE ASSERTIONS ARE HERE FOR THE SAME REASON THE WRAPPER'S ARE, and they are
# the stronger half of the safety argument. This code runs on the only path
# that reaches Greetd.launch(): a helper that hangs there is a machine nobody
# can log in to, and a greeter naming a session no Containerfile installed is
# the K12/K13 defect with the login screen as its blast radius. A build that
# cannot prove BOTH is a build that must not ship.
COPY --chmod=0755 files/system/libexec/rime-session-watchdog \
     /usr/libexec/rime-session-watchdog
RUN set -eux; \
    sh -n /usr/libexec/rime-session-watchdog; \
    test -x /usr/libexec/rime-session-watchdog; \
    : 'Both hooks must be NAMED by the greeter that is actually installed.'; \
    : 'A watchdog nothing calls counts nothing, and would leave every test in'; \
    : 'tests/ green while the feature was absent from the image.'; \
    grep -q 'rime-session-watchdog record' /usr/share/rime-greet/GreetContext.qml; \
    grep -q 'rime-session-watchdog check' /usr/share/rime-greet/GreetContext.qml; \
    : 'and BOTH must be capped. `timeout` is the whole lockout argument: the'; \
    : 'greeter defers Greetd.launch() to persistProc.onExited, so an uncapped'; \
    : 'hook that never returns is a password prompt that never proceeds. Two'; \
    : 'calls, two caps — counted, so a third hook added later without one'; \
    : 'fails this build instead of shipping.'; \
    if [ "$(grep -c 'timeout 5 /usr/libexec/rime-session-watchdog' \
            /usr/share/rime-greet/GreetContext.qml)" != 2 ]; then \
        echo "FATAL: the greeter's watchdog hooks are not both capped by timeout"; \
        exit 1; fi; \
    command -v timeout >/dev/null; \
    : 'The greeter must act on the helper output ONLY when it equals its own'; \
    : 'recoverySession constant. Without that comparison the helper could name'; \
    : 'any session on the machine, and a preselection is the one thing on this'; \
    : 'screen the user did not ask for.'; \
    grep -q 's === ctx.recoverySession' /usr/share/rime-greet/GreetContext.qml; \
    : 'and the user cycling the picker must settle the question for good.'; \
    grep -q '_userPicked' /usr/share/rime-greet/GreetContext.qml; \
    : 'THE TWO HALVES MUST NAME THE SAME SESSION, AND IT MUST BE INSTALLED.'; \
    : 'Read out of the shipped files, not out of the repository: this is the'; \
    : 'assertion that would have caught a launcher repointed at a path no'; \
    : 'Containerfile copies.'; \
    _wd_id="$(sed -n 's/^RECOVERY="\([^"]*\)".*/\1/p' \
              /usr/libexec/rime-session-watchdog | head -n1)"; \
    _qml_id="$(sed -n 's/.*readonly property string recoverySession: *"\([^"]*\)".*/\1/p' \
               /usr/share/rime-greet/GreetContext.qml | head -n1)"; \
    if [ -z "$_wd_id" ] || [ "$_wd_id" != "$_qml_id" ]; then \
        echo "FATAL: watchdog recovery session [$_wd_id] != greeter's [$_qml_id]"; \
        exit 1; fi; \
    if ! test -f "/usr/share/wayland-sessions/$_wd_id.desktop"; then \
        echo "FATAL: the recovery session [$_wd_id] is not an installed session entry"; \
        exit 1; fi; \
    : 'The state directory is the greetd-owned one tmpfiles creates below. A'; \
    : 'watchdog pointed anywhere else would silently never count, because the'; \
    : 'greeter runs as greetd and can write nowhere else.'; \
    grep -q '/var/lib/rime-greet' /usr/libexec/rime-session-watchdog; \
    echo "session watchdog: installed, called on both greeter hooks, capped, and the recovery session exists"

# ── Greeter wallpaper: the user's own, not the shipped default ─────────────
# THE BUG: change your wallpaper in Rime Shell and the login/lock screen kept
# showing the factory image forever. GreetSurface.qml hardcoded
# file:///usr/share/backgrounds/rime/default.jpg, and nothing could ever have
# changed that — /usr is a read-only ostree mount, so there was no writable
# path for the greeter to read a per-user choice from.
#
# It cannot simply read ~/.curr_wall either: the greeter runs as the `greetd`
# system user, long before (and after) any session exists, and home directories
# are mode 0700. greetd has no business being able to read them.
#
# So the shell PUBLISHES its choice to a greeter-readable location, through a
# root helper reached by a narrow NOPASSWD sudoers rule — the same pattern the
# Windows-boot button uses above. The helper takes no caller-supplied path: it
# resolves the caller from SUDO_UID, and reads that user's wallpaper WITH THE
# CALLER'S OWN PRIVILEGES (setpriv --reuid), so it cannot be talked into
# copying /etc/shadow into a world-readable directory. It then validates the
# bytes really are a JPEG/PNG/WebP before publishing them. See the helper's
# own header for the full threat model.
#
# Unlike the Windows helper this rule is ALL rather than %wheel: setting your
# desktop wallpaper is not an administrative action, and a non-wheel user would
# otherwise get a login screen that silently refuses to follow their choice.
COPY files/system/libexec/rime-greet-wallpaper /usr/libexec/rime-greet-wallpaper
COPY files/system/sudoers/rime-greet-wallpaper /etc/sudoers.d/030-rime-greet-wallpaper
# ...and once at boot for every account, before greetd, so the first login
# screen after an update already carries each person's wallpaper and accent
# instead of waiting for them to log in once. Same helper, called as root with
# SUDO_UID set, so its reads still happen as the user.
COPY --chmod=0755 files/system/libexec/rime-greet-publish-all /usr/libexec/rime-greet-publish-all
# The boot and shutdown splash in the same accent: shutdown's plymouthd.conf and
# the ESP credential the initramfs reads (files/dracut/rime-plymouth-accent).
COPY --chmod=0755 files/system/libexec/rime-plymouth-accent /usr/libexec/rime-plymouth-accent
COPY files/system/units/rime-greet-publish.service /usr/lib/systemd/system/rime-greet-publish.service
RUN set -eux; \
    bash -n /usr/libexec/rime-greet-publish-all; \
    grep -q '^Before=greetd.service$' /usr/lib/systemd/system/rime-greet-publish.service; \
    systemctl enable rime-greet-publish.service; \
    test -L /etc/systemd/system/multi-user.target.wants/rime-greet-publish.service
RUN set -eux; \
    chmod 0755 /usr/libexec/rime-greet-wallpaper; \
    bash -n /usr/libexec/rime-greet-wallpaper; \
    chown root:root /etc/sudoers.d/030-rime-greet-wallpaper; \
    chmod 0440 /etc/sudoers.d/030-rime-greet-wallpaper; \
    # A syntax error or wrong mode makes sudo refuse the file at RUNTIME, which
    # would mean a password prompt no compositor-spawned script can answer.
    # visudo -c turns that into a build failure instead.
    visudo -cf /etc/sudoers.d/030-rime-greet-wallpaper; \
    # setpriv is what drops privileges for the read. It comes from util-linux
    # (always present), but assert it: without setpriv the helper would have to
    # read as root, which is exactly the escalation this design avoids.
    command -v setpriv >/dev/null; \
    # The greeter must actually consult the published copy. If an upstream edit
    # ever reverts GreetSurface/GreetContext to the hardcoded default, this
    # build fails instead of shipping the original bug back.
    grep -q 'rime-greet/wallpapers' /usr/share/rime-greet/GreetContext.qml; \
    grep -q 'ctx.wallpaper' /usr/share/rime-greet/GreetSurface.qml; \
    # A returning user must land in the PASSWORD field, not the username one.
    # That depends on re-applying focus when last-user resolves asynchronously;
    # if the guard disappears, the greeter silently regresses to eating the
    # first thing the user types into the wrong box.
    grep -q 'initialFocusApplied' /usr/share/rime-greet/GreetSurface.qml; \
    grep -q 'onTextEdited' /usr/share/rime-greet/GreetSurface.qml; \
    # The publisher is invoked from the session launcher (image content, so this
    # is always a hard failure) AND from the shell's wallpaper pipeline.
    grep -q 'rime-greet-wallpaper' /usr/libexec/rime-shell-autostart; \
    # P2-004: the launcher is the only thing that puts the Rime.I18n module on
    # the QML engine's import path (the module itself is built ~500 layers up,
    # from the vendored shell tree). Without this line the shell loads, reports
    # a missing module by name and runs untranslated — which is a silence, so
    # it gets an assertion. Named rather than a bare `grep -q`: a silent
    # non-zero inside a 3,000-line build file is undiagnosable.
    if ! grep -q 'QML_IMPORT_PATH' /usr/libexec/rime-shell-autostart; then \
        echo "FATAL: rime-shell-autostart no longer sets QML_IMPORT_PATH, so the"; \
        echo "       shell would never find Rime.I18n and would run untranslated."; \
        exit 1; \
    fi; \
    # The shell half lives in a DIFFERENT repository. On the default ref this
    # must hold — a main that lost the call is a regression and shipping it
    # would quietly restore the original bug. But RIME_SHELL_REF exists so an
    # older release can be rebuilt reproducibly, and those refs legitimately
    # predate the feature; failing that build would be obstructive. Same posture
    # as the windows-check probe above.
    if ! grep -q 'rime-greet-wallpaper' \
            /usr/share/rime-shell/src/services/WallpaperService.qml; then \
        if [ "${RIME_SHELL_STRICT}" = 1 ]; then \
            echo "FATAL: rime-shell main no longer publishes the greeter wallpaper"; exit 1; \
        else \
            echo "WARN: pinned rime-shell (${RIME_SHELL_REF}) predates the greeter-wallpaper publisher — the login screen will only follow the wallpaper after the next login, not immediately"; \
        fi; \
    fi; \
    echo "greeter wallpaper publisher installed and wired"

# System wiring, one layer (no dnf):
#   - Writable state dir for rime-greet's last-user/last-session memory, owned
#     by the greetd session user (Fedora's greetd package provisions the
#     `greetd` user via sysusers.d — there is NO `greeter` user); tmpfiles
#     creates it at boot after systemd-sysusers has run.
#   - Published-wallpaper dir underneath it, root-owned 0755: only the root
#     helper writes there, everyone (including greetd) may read. It is a
#     separate tmpfiles line rather than a subdirectory of the greetd-owned one
#     because greetd must NOT be able to replace the files it renders.
#   - Enable the flathub first-boot oneshot.
#   - greetd as the display manager (enabling it creates the
#     display-manager.service alias; graphical.target Wants it), so a graphical
#     boot starts greetd → sway → the rime-greet greeter on tty1.
#   - graphical.target as default.
# NOTE: VARIANT is deliberately NOT stamped here — Containerfile.rime owns the
# os-release VARIANT/VARIANT_ID stamp, which is what drives rime-greet's accent.
RUN set -eux; \
    printf 'd /var/lib/rime-greet 0755 greetd greetd -\nd /var/lib/rime-greet/wallpapers 0755 root root -\n' \
        > /usr/lib/tmpfiles.d/rime-greet.conf; \
    systemctl enable rime-flathub-setup.service; \
    systemctl enable greetd.service; \
    systemctl set-default graphical.target

# ── Stage 6y: the first boot after APEX-OS ────────────────────────────────── (rime-rename: keep)
# Every machine in the field ran APEX and wrote its state under that name:
# /var/lib/apex (packages, the boot-migrate phase, lid, AI models, channel),
# /var/lib/apex-secretd, /var/lib/apex-greet, /etc/apex, and systemd links
# naming apex-* units. Every service in this image reads the new names, and
# systemd-tmpfiles would create them EMPTY at the first boot, so a machine
# that updated would come up looking freshly installed — and katana, whose
# boot-migrate phase says `failed`, would try the systemd-boot move again.
#
# rime-migrate-from-apex renames that state once (rename(2), never a copy),
# leaves each old path as a link to the new one, and carries edited /etc
# files and old-name enablement over. The secret store is the exception: it
# stays at /var/lib/apex-secretd and systemd links the new name to it (see
# rime-secretd.service; rime-rename: keep). The migration's unit is ordered before tmpfiles,
# sysinit.target and rime-firewall, and is enabled STATICALLY from
# /usr/lib/systemd/system/sysinit.target.wants: the step every later boot
# depends on must not be something an /etc merge can drop. Here, below the
# static payload and above the binaries, because it is new in this release and
# will be tuned; an edit costs the layers under it, not eighty.
# tests/test-rime-migrate-from-apex.sh runs the script against APEX-shaped
# fixture roots.
COPY --chmod=0755 files/system/libexec/rime-migrate-from-apex \
     /usr/libexec/rime-migrate-from-apex
COPY files/system/units/rime-migrate-from-apex.service \
     /usr/lib/systemd/system/rime-migrate-from-apex.service
RUN set -eux; \
    bash -n /usr/libexec/rime-migrate-from-apex; \
    mkdir -p /usr/lib/systemd/system/sysinit.target.wants; \
    ln -sf ../rime-migrate-from-apex.service \
        /usr/lib/systemd/system/sysinit.target.wants/rime-migrate-from-apex.service; \
    test -f /usr/lib/systemd/system/sysinit.target.wants/rime-migrate-from-apex.service; \
    grep -qE '^Before=.*systemd-tmpfiles-setup[.]service' \
        /usr/lib/systemd/system/rime-migrate-from-apex.service \
        || { echo "FATAL: the migration must run before tmpfiles creates the new directories empty"; exit 1; }; \
    grep -qE '^Before=.*rime-firewall[.]service' \
        /usr/lib/systemd/system/rime-migrate-from-apex.service \
        || { echo "FATAL: the migration must run before rime-firewall reads /etc/rime/firewall.d"; exit 1; }; \
    # A dry run over an empty root must say nothing and change nothing: the
    # script runs on every boot of every machine, most of which have nothing
    # left to move.
    _mr="$(mktemp -d)"; \
    out="$(/usr/libexec/rime-migrate-from-apex --root "${_mr}" --dry-run)"; \
    test -z "${out}"; \
    rm -rf "${_mr}"; \
    # The one move that decides whether katana stays bootable, on the
    # image's own tools (mv --no-copy, stat, find), in a throwaway root.
    _mr="$(mktemp -d)"; \
    mkdir -p "${_mr}/var/lib/apex/boot-migrate" "${_mr}/etc"; : 'rime-rename: keep'; \
    printf failed > "${_mr}/var/lib/apex/boot-migrate/phase"; : 'rime-rename: keep'; \
    /usr/libexec/rime-migrate-from-apex --root "${_mr}"; \
    test "$(cat "${_mr}/var/lib/rime/boot-migrate/phase")" = failed; \
    test "$(readlink "${_mr}/var/lib/apex")" = rime; : 'rime-rename: keep'; \
    rm -rf "${_mr}"

# ── Stage 6z: rimed, rime, rime-agentd, rime-secretd and rime-aid ───────────
# LAST, and deliberately so. These are the most volatile artefacts in the image
# — every rimed commit changes them — and `podman build --cache-to` pushes each
# intermediate layer to the registry separately, so a cache miss high in this
# file costs both a rebuild AND a registry push for every layer beneath it.
#
# They used to be layer 1 of about eighty. The build after the agent-runtime
# merge therefore rebuilt and re-pushed the whole image and was killed at
# GitHub's six-hour job ceiling at step 76 of 83; the previous successful build
# took 3h16m. Down here, an rimed-only change invalidates these two layers and
# nothing else.
#
# Same reasoning the git-SHA labels below already follow: volatile content last.
#
# awww/matugen/yazi are NOT here — slow-moving third-party tools ship in core.
COPY --from=rime-builder /out/usr/bin/ /usr/bin/

# Every assertion that needs one of those binaries to exist, gathered here so
# the binaries have exactly one dependent layer.
RUN set -eux; \
    test -x /usr/bin/rimed; \
    test -x /usr/bin/rime; \
    test -x /usr/bin/rime-agentd; \
    test -x /usr/bin/rime-secretd; \
    test -x /usr/bin/rime-aid; \
    # The CLI must actually run in the image it ships in, not merely be present:
    # a dynamic-link or glibc mismatch against core is exactly the failure that
    # a file-existence check misses.
    /usr/bin/rime --help >/dev/null; \
    /usr/bin/rime agent --help >/dev/null; \
    /usr/bin/rime project --help >/dev/null; \
    /usr/bin/rime ai --help >/dev/null; \
    # Every §14 verb, by name. `rime ai --help` passing proves the subcommand
    # exists; it does not prove `run` was not renamed, and a renamed verb is a
    # silent no-op in every script and shell integration that calls it.
    for v in models pull rm run unload status serve; do \
        /usr/bin/rime ai "$v" --help >/dev/null || { echo "FATAL: rime ai $v is gone"; exit 1; }; \
    done; \
    # §19. Same rule, same reason: a renamed verb is a silent no-op in every
    # script, keybind and settings page that calls it.
    for v in status repair reset; do \
        /usr/bin/rime recover "$v" --help >/dev/null \
            || { echo "FATAL: rime recover $v is gone"; exit 1; }; \
    done; \
    for v in plan run list rm purge; do \
        /usr/bin/rime disposable "$v" --help >/dev/null \
            || { echo "FATAL: rime disposable $v is gone"; exit 1; }; \
    done; \
    # The CLI holds the disposable engine's path as a constant, exactly as
    # `rime install --source capsule` holds the capsule engine's, and for the
    # same reason: a caller-controlled variable naming a program is a hole. The
    # two files agree only by both being right, so the built binary is checked
    # against the path that was actually installed.
    grep -qa '/usr/libexec/rime-disposable' /usr/bin/rime; \
    test -x /usr/libexec/rime-disposable; \
    # Same rule for the VM engine, and the same reason: the CLI holds the path
    # as a constant so a caller-controlled variable cannot name the program
    # that deletes disk images.
    grep -qa '/usr/libexec/rime-vm' /usr/bin/rime; \
    test -x /usr/libexec/rime-vm; \
    for v in doctor create list info start stop console snapshot share usb rm; do \
        /usr/bin/rime vm "$v" --help >/dev/null \
            || { echo "FATAL: rime vm $v is gone"; exit 1; }; \
    done; \
    # `rime vm create` must not grow a way to weaken a VM by accident. These
    # two flags are the security posture of the guest, and clap refusing both
    # at once is what stops argument order deciding it.
    if /usr/bin/rime vm create box --secure-boot --no-secure-boot >/dev/null 2>&1 \
        ; then echo "FATAL: rime vm create accepted both secure-boot flags at once"; exit 1; fi; \
    if /usr/bin/rime vm create box --graphics spice >/dev/null 2>&1 \
        ; then echo "FATAL: rime vm create accepted a --graphics flag"; exit 1; fi; \
    # §19's "expose rime doctor results graphically" is this flag and nothing
    # else on the OS side. Losing it silently turns the settings page into a
    # screen that renders no diagnostics.
    /usr/bin/rime doctor --help | grep -q -- '--json'; \
    # P1-063. `rime-lid.service` names `/usr/bin/rime lid watch` and is enabled
    # in this image; a binary built before `rime lid` existed would pass
    # `test -x` and leave the unit failing at every boot with the lid policy
    # never running. Every verb by name, for the reason the lists above give.
    for v in status explain pin report plan watch; do \
        /usr/bin/rime lid "$v" --help >/dev/null \
            || { echo "FATAL: rime lid $v is gone"; exit 1; }; \
    done; \
    # `reset` refuses to run as root. Root's home is not the user's, so a
    # `sudo rime recover reset` would reset root's desktop and leave the user's
    # exactly as it is — while reporting success. This build runs as root, so
    # the refusal is checkable directly, and it is checked for the REASON as
    # well as the exit status: "it refused" has been true here while "it
    # refused for the reason under test" was false.
    if /usr/bin/rime recover reset --scope desktop >/dev/null 2>&1 \
        ; then echo "FATAL: rime recover reset ran as root instead of refusing"; exit 1; fi; \
    /usr/bin/rime recover reset --scope desktop 2>&1 | grep -q 'must not run as root'; \
    # `reset` is a dry run without --commit. This is the single most important
    # runtime property in §19, so it is proven against the shipped binary
    # rather than reasoned about: a throwaway HOME owned by an ordinary uid, a
    # file the plan names, and that file still present afterwards.
    command -v setpriv >/dev/null; \
    RIME_RESET_PROBE="$(mktemp -d)"; \
    mkdir -p "$RIME_RESET_PROBE/.config/rime-shell"; \
    echo '{}' > "$RIME_RESET_PROBE/.config/rime-shell/input.json"; \
    chown -R 1000:1000 "$RIME_RESET_PROBE"; \
    setpriv --reuid=1000 --regid=1000 --clear-groups \
        env HOME="$RIME_RESET_PROBE" /usr/bin/rime recover reset --scope desktop >/dev/null; \
    test -f "$RIME_RESET_PROBE/.config/rime-shell/input.json" \
        || { echo "FATAL: rime recover reset deleted a file without --commit"; exit 1; }; \
    # And --commit without --confirm must also change nothing.
    if setpriv --reuid=1000 --regid=1000 --clear-groups \
        env HOME="$RIME_RESET_PROBE" /usr/bin/rime recover reset --scope desktop --commit \
        >/dev/null 2>&1 \
        ; then echo "FATAL: rime recover reset --commit ran without --confirm"; exit 1; fi; \
    test -f "$RIME_RESET_PROBE/.config/rime-shell/input.json" \
        || { echo "FATAL: rime recover reset deleted a file without --confirm"; exit 1; }; \
    rm -rf "$RIME_RESET_PROBE"; \
    # The daemon must RUN in the image it ships in, not merely exist: a dynamic
    # link or glibc mismatch against core is exactly what a file-existence check
    # misses. `--help` is a pure print and binds no socket.
    /usr/bin/rime-aid --help >/dev/null; \
    # Same rule for the secret service: `--help` is a pure print and binds no
    # socket, so it proves the binary runs against this image's glibc.
    /usr/bin/rime-secretd --help >/dev/null; \
    # Every `rime secret` verb by name. A renamed one is a silent no-op in the
    # skills and shell functions that call it, and §12's whole point is that
    # those keep working unchanged.
    for v in add list remove capabilities grant revoke grants use migrate audit; do \
        /usr/bin/rime secret "$v" --help >/dev/null \
            || { echo "FATAL: rime secret $v is gone"; exit 1; }; \
    done; \
    # The two programs the broker execs to perform an operation. Asserted for
    # the reason rime-pkg's list is: a missing one turns `rime secret use` into
    # a runtime failure on the user's machine instead of a failed build here,
    # and the message would be about a child process rather than a missing tool.
    for t in git curl; do \
        command -v "$t" >/dev/null \
            || { echo "FATAL: rime-secretd brokers with $t"; exit 1; }; \
    done; \
    # The MCP bridge is what replaces a bearer token in ~/.claude.json, so a
    # rename here is a machine whose memory server stops answering after an
    # update, with the definition still pointing at a verb that is gone.
    /usr/bin/rime mcp bridge --help >/dev/null \
        || { echo "FATAL: rime mcp bridge is gone"; exit 1; }; \
    # The one thing the CLI must never grow: a verb that hands back a value.
    # Anchored to the command column, because the descriptions legitimately say
    # "read from stdin" and clap's own help verb says "Print this message".
    if /usr/bin/rime secret --help | grep -qE '^  (show|reveal|export|cat|print|read|dump|get)\b' \
        ; then echo "FATAL: rime secret grew a verb that hands a secret back"; exit 1; fi; \
    # And the refusal that carries §14's central security decision has to be
    # live in the shipped binary, not just in the source. Asserted on both the
    # daemon and the CLI, because each has its own argument parser.
    if /usr/bin/rime-aid --listen 127.0.0.1:11434 >/dev/null 2>&1 \
        ; then echo "FATAL: rime-aid accepted a TCP listener, which has no SO_PEERCRED"; exit 1; fi; \
    /usr/bin/rime-aid --listen 127.0.0.1:11434 2>&1 | grep -q SO_PEERCRED; \
    /usr/bin/rime ai serve --listen 127.0.0.1:11434 2>&1 | grep -q SO_PEERCRED; \
    # The compositor keybinds and the labwc root-menu replacement both invoke
    # `rime shell <verb>`; a renamed verb makes every one of them a silent
    # no-op, which is why the verb table is asserted and not just the binary.
    /usr/bin/rime shell list >/dev/null; \
    /usr/bin/rime shell list | grep -qw menu; \
    # The shell integration gates itself on `rime` being on PATH, so this is the
    # first point in the build where sourcing it can define anything. Checked in
    # both shells because the file carries a bash and a zsh completion block.
    bash -c 'set -e; . /usr/share/rime/shell/agent.sh; [ "$(type -t a)" = function ]'; \
    zsh -fc 'set -e; . /usr/share/rime/shell/agent.sh; [ "$(whence -w al)" = "al: function" ]'; \
    # And that an INTERACTIVE zsh with no ~/.zshrc still defines the a command:
    # that is root's exact situation, and the case the file-text greps above
    # cannot see. zsh sources /etc/zshrc for every interactive shell, so this
    # proves the system-wide hook and not a per-user dotfile. bash reaches
    # /etc/bashrc only through a ~/.bashrc that sources it, so its equivalent
    # needs a seeded home and is covered by the manual-source check above.
    RIMEHOME="$(mktemp -d)"; \
    env -i HOME="$RIMEHOME" TERM=xterm PATH=/usr/bin:/bin zsh -ic 'whence -w a >/dev/null' </dev/null; \
    rm -rf "$RIMEHOME"; \
    echo "rimed/rime/rime-agentd/rime-secretd/rime-aid installed and runnable; shell verbs and `a` intact"

# ── Stage 7: bootc container sanity lint (informational) ───────────────────
RUN bootc container lint || true

# Volatile provenance belongs last so a new git SHA does not invalidate every
# otherwise-cacheable payload layer above it.
ARG RIME_REVISION=dev
ARG RIME_VERSION=45
LABEL org.opencontainers.image.title="Rime OS base" \
      org.opencontainers.image.description="Rime OS shared base: rime-os-core + rimed/rime + Rime Shell + greeter payload" \
      org.opencontainers.image.source="https://github.com/AndreNijman/rime-os" \
      org.opencontainers.image.revision="${RIME_REVISION}" \
      org.opencontainers.image.version="${RIME_VERSION}" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.vendor="Rime OS"
