# Rime's kernel: CachyOS 7.2.9 (BORE + sched_ext) from kernel/kernel.pin, built with nixpkgs' linuxManualConfig.
#
# Inputs are exactly the bootc kernel tier's (Containerfile.kernel): the same source tarball, BORE patch and
# upstream config, each by the sha256 in kernel/kernel.pin. The config is ./config, generated by ./config.nix
# (the spec's %prep edits + the NixOS module-signing options) and committed; ./README.md lists every
# difference from the pinned upstream config and from the bootc kernel's final config.
#
# BTF: CONFIG_DEBUG_INFO_BTF=y with nixpkgs' pahole (1.32 at the flake's nixpkgs pin). ./gate.nix asserts
# CONFIG_PAHOLE_VERSION and runs both BTF readers on the built vmlinux (bootc: Containerfile.kernel's gate).
#
# Called with `import`, not callPackage: callPackage would wrap the kernel's own .override, which NixOS's
# boot.kernelPackages calls with `features`, `randstructSeed` and `kernelPatches`.
{ pkgs }:

let
  inherit (pkgs) lib;
  sources = import ./sources.nix { inherit (pkgs) lib fetchurl; };
  configHas = line: lib.elem line (lib.splitString "\n" (builtins.readFile ./config));
in
pkgs.linuxManualConfig {
  pname = "linux-rime";
  inherit (sources.pin) version;
  inherit (sources) src modDirVersion;

  kernelPatches = [
    {
      name = "bore-cachy";
      patch = sources.borePatch;
    }
  ];

  # A path, so linuxManualConfig reads it at eval time (kernel.config.isYes …) without import-from-derivation.
  configfile = ./config;

  # What NixOS modules ask of a kernel by attribute (hardware.graphics.enable32Bit asserts ia32Emulation, which
  # Steam's 32-bit graphics need). buildLinux sets these defaults itself; linuxManualConfig does not, so they
  # are read from ./config here. Passthru only: the kernel derivation does not change.
  features = {
    ia32Emulation = configHas "CONFIG_IA32_EMULATION=y";
    efiBootStub = configHas "CONFIG_EFI_STUB=y";
    netfilterRPFilter = configHas "CONFIG_IP6_NF_MATCH_RPFILTER=m" || configHas "CONFIG_IP6_NF_MATCH_RPFILTER=y";
  };

  extraMeta = {
    branch = lib.versions.majorMinor sources.pin.version;
    description = "Rime's CachyOS kernel (${sources.pin.tag}, BORE, sched_ext, x86-64-v3)";
  };
}
