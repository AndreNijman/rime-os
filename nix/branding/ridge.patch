+    _rime_variant=dark
+    if [ -z "${SSH_CONNECTION:-}${SSH_TTY:-}" ]; then
+        case "$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null)" in
+            *light*) _rime_variant=light ;;
+        esac
+    fi
