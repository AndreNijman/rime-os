+                _rime_graphics="${_rime_graphics#* }"
+                _rime_cols="${_rime_graphics%% *}"
+                RIME_TERM_GRAPHICS="${_rime_graphics##* }"
+                export RIME_TERM_GRAPHICS
+                ;;
+        esac
+        case "${_rime_cols}" in
+            ""|*[!0-9]*) _rime_proto=none ;;
