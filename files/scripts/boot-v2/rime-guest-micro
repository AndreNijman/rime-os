#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  rime-guest-micro — build the tiny initramfs the bootloader scenarios boot.
#
#  Why a synthetic guest exists at all, when the point of §22 is a real Rime
#  UKI: the boot-counting scenarios need FIVE sequential boots to walk a
#  +3-0 tally down to +0-3 and observe the fallback. The real Rime initramfs is
#  386 MB (measured on the katana, 2026-09-03), so those five boots would be
#  minutes of I/O to prove a filename rename that has nothing to do with what
#  is inside the initrd. The real-Rime-initramfs scenario is separate and runs
#  once.
#
#  What this guest proves is exactly and only: the firmware verified and loaded
#  a UKI, the kernel inside it started, userspace ran, and the command line the
#  UKI was SIGNED with is the command line the kernel received. It reports what
#  it can see about the boot — the selected entry, whether boot counting is in
#  effect, the sd-stub version — and powers off cleanly, because a guest that
#  hangs after printing must not be counted as a successful boot.
#
#  busybox is Fedora's statically linked build, so this is a single 800 KB
#  binary and one script. No libc, no dynamic loader, nothing to go stale.
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail
# shellcheck source=files/scripts/boot-v2/lib.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"

OUT="${1:?usage: rime-guest-micro OUT.cpio.gz}"

BB="$(command -v busybox)" || die "busybox not found"
# A dynamically linked busybox would need a libc and a dynamic loader in the
# cpio, and would fail at the point where the failure looks like a UKI problem.
if ! file -b "$BB" | grep 'statically linked' >/dev/null; then
    die "$BB is not statically linked; this initramfs assumes it is"
fi

WORK="$(mktemp -d)"; trap 'rm -rf "$WORK"' EXIT
# mktemp -d is 0700; an initramfs root the kernel mounts as / wants 0755.
chmod 0755 "$WORK"
mkdir -p "$WORK"/{bin,dev,proc,sys}
install -m 0755 "$BB" "$WORK/bin/busybox"
for l in sh mount umount echo cat poweroff sleep ls grep printf; do
    ln -sf busybox "$WORK/bin/$l"
done

cat > "$WORK/init" <<'INIT'
#!/bin/busybox sh
# Rime boot-lab micro guest. Everything it prints is prefixed RIME-BOOTLAB so
# the host-side assertions can key on a string that only this file emits into
# the serial log.
export PATH=/bin
/bin/busybox mount -t proc     proc     /proc
/bin/busybox mount -t sysfs    sysfs    /sys
/bin/busybox mount -t devtmpfs devtmpfs /dev 2>/dev/null

echo "RIME-BOOTLAB: userspace-reached"
echo "RIME-BOOTLAB: cmdline=$(/bin/busybox cat /proc/cmdline)"

# efivarfs is how the guest learns what the bootloader decided. Its absence is
# reported rather than ignored: on a boot where sd-boot did not run, none of
# these variables exist and the assertions must be able to tell that apart from
# "the guest could not read them".
if /bin/busybox mount -t efivarfs efivarfs /sys/firmware/efi/efivars 2>/dev/null; then
    E=/sys/firmware/efi/efivars
    G=4a67b082-0a4c-41cf-b6c7-440b29bb8c4f
    for v in LoaderEntrySelected LoaderBootCountPath StubInfo LoaderInfo; do
        if [ -f "$E/$v-$G" ]; then
            # EFI variable data is a 4-byte attribute prefix then UTF-16LE.
            # `tr -d '\000'` is enough to read it as ASCII for these values and
            # avoids needing iconv in an 800 KB userspace.
            val=$(/bin/busybox cat "$E/$v-$G" | /bin/busybox tr -d '\000' | /bin/busybox tail -c +2)
            echo "RIME-BOOTLAB: efivar $v=$val"
        else
            echo "RIME-BOOTLAB: efivar $v=<absent>"
        fi
    done
else
    echo "RIME-BOOTLAB: efivarfs=<unavailable>"
fi

echo "RIME-BOOTLAB: clean-poweroff"
/bin/busybox poweroff -f
# poweroff -f should never return. If it does, spin rather than falling off the
# end of init, which the kernel treats as a panic and which would look like a
# boot failure in the serial log.
while : ; do /bin/busybox sleep 60; done
INIT
chmod 0755 "$WORK/init"
ln -sf busybox "$WORK/bin/tr"
ln -sf busybox "$WORK/bin/tail"

mkdir -p "$(dirname "$OUT")"
( cd "$WORK" && find . -print0 | cpio --null -o -H newc --quiet ) | gzip -9 > "$OUT"

[[ -s "$OUT" ]] || die "produced no initramfs at $OUT"
# Postcondition: /init must be in the archive AND be executable. A cpio whose
# init is mode 0644 boots to "Failed to execute /init" — a kernel panic that
# reads like a broken UKI.
LISTING="$(zcat "$OUT" | cpio -itv --quiet 2>/dev/null)"
grep -qE '^-rwxr-xr-x .* (\./)?init$' <<<"$LISTING" \
    || die "./init is missing or not executable in $OUT:
$LISTING"
info "micro guest: $(stat -c %s "$OUT") bytes"
