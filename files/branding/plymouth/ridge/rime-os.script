# Rime OS boot splash -- the Origin mark ("Grow")
#
# The Origin lockup (the mark + "rime") grows out of the charcoal the way rime
# ice does, from its point of contact: the core first, then the ring, then the
# coat, 350 ms apart, with the wordmark. While the machine boots a slow wave
# runs outward through the mark (core, ring, coat), one body dimming at a time,
# so the screen says it is alive without anything moving. Shutdown, reboot and
# update modes show the settled splash from the first frame.
#
# The engine is the one the spark splash ("Focus") was rebuilt around, for the
# same measured reasons (files/branding/plymouth/README.md): plymouth has no
# vsync, truncates sprite positions to whole pixels, re-samples an image on
# every Image.Scale/Rotate and redraws a sprite only when its opacity moves by
# more than 0.01. So every image is scaled ONCE, below, nothing moves, and each
# refresh (60 Hz) only changes opacities on curves of real elapsed time that
# start and end at rest. The wave is opacity too.
#
# Per-owner accent: the mark is one colour, the owner's accent. Each
# rime-os-accent-NN theme is this script with its own HI_ line, its own
# lockup-core / lockup-ring / lockup-coat / bullet images, and the neutral
# images shared with rime-os (nix/pkgs/rime-plymouth.nix builds all 25).
#
# The background is one flat charcoal: equal top and bottom colours take
# plymouth's plain fill path, not its dithered gradient.

HI_R = 0.569; HI_G = 0.761; HI_B = 0.863;   # #91C2DC (Rime Blue, the mark)

RATE = 60;
Plymouth.SetRefreshRate(RATE);

Window.SetBackgroundTopColor(0.129, 0.133, 0.141);      # #212224 charcoal
Window.SetBackgroundBottomColor(0.129, 0.133, 0.141);

mode = Plymouth.GetMode();
intro = 0;
if (mode == "boot") { intro = 1; }

# ── helpers ────────────────────────────────────────────────────────────────
fun clamp01 (x) {
  if (x < 0) return 0;
  if (x > 1) return 1;
  return x;
}

fun absv (x) {
  if (x < 0) return -x;
  return x;
}

# smootherstep: 0 -> 1 with zero velocity AND acceleration at both ends
fun smooth (x) {
  local.u = clamp01(x);
  return local.u * local.u * local.u * (local.u * (local.u * 6 - 15) + 10);
}

# e^-x for x >= 0 (the script library has no exp): (1 - x/1024)^1024
fun expn (x) {
  if (x <= 0) return 1;
  if (x > 40) return 0;
  local.y = 1 - x / 1024;
  local.k = 0;
  while (local.k < 10) { local.y = local.y * local.y; local.k++; }
  return local.y;
}

# the fractional part of x >= 0
fun frac (x) {
  return x - Math.Int(x);
}

# ── layout ─────────────────────────────────────────────────────────────────
w = Window.GetWidth();
h = Window.GetHeight();
hd = 0;
if (h > 1500) { hd = 1; }

cx = Math.Int(w / 2);
cy = Math.Int(h * 0.46);

# Fixed-size masters are drawn 1:1 on a 1200-line (hd: 2400-line) screen and
# scaled once to the screen's height otherwise.
fun fit (img, ref) {
  local.k = h / ref;
  local.nw = Math.Int(img.GetWidth() * local.k + 0.5);
  local.nh = Math.Int(img.GetHeight() * local.k + 0.5);
  if (local.nw == img.GetWidth() && local.nh == img.GetHeight()) return img;
  if (local.nw < 1) local.nw = 1;
  if (local.nh < 1) local.nh = 1;
  return img.Scale(local.nw, local.nh);
}

# body 0 = core, 1 = ring, 2 = coat: the order they grow in, from the origin out
body_img[0] = NULL;                    # declared here so it is global
if (hd) {
  base_img = fit(Image("lockup-base-hd.png"), 2400);
  body_img[0] = fit(Image("lockup-core-hd.png"), 2400);
  body_img[1] = fit(Image("lockup-ring-hd.png"), 2400);
  body_img[2] = fit(Image("lockup-coat-hd.png"), 2400);
  bullet_img = fit(Image("bullet-hd.png"), 2400);
  prompt_fallback = fit(Image("prompt-hd.png"), 2400);
} else {
  base_img = fit(Image("lockup-base.png"), 1200);
  body_img[0] = fit(Image("lockup-core.png"), 1200);
  body_img[1] = fit(Image("lockup-ring.png"), 1200);
  body_img[2] = fit(Image("lockup-coat.png"), 1200);
  bullet_img = fit(Image("bullet.png"), 1200);
  prompt_fallback = fit(Image("prompt.png"), 1200);
}

LW = base_img.GetWidth();
LH = base_img.GetHeight();
lx = cx - Math.Int(LW / 2);
ly = cy - Math.Int(LH / 2);

# ── sprites (z: wordmark < bodies < prompt) ────────────────────────────────
base = Sprite(base_img);
base.SetPosition(lx, ly, 1);
base.SetOpacity(0);

body[0] = NULL;                        # declared here so it is global
i = 0;
while (i < 3) {
  body[i] = Sprite(body_img[i]);       # the same canvas as the base: same position
  body[i].SetPosition(lx, ly, 2 + i);
  body[i].SetOpacity(0);
  i++;
}

# ── password prompt (LUKS) ────────────────────────────────────────────────
# The prompt sits under the lockup, the bullets under it and any message
# (keyboard layout, "use your recovery key") under them. Nothing the user
# types is ever drawn: display_password() is only told how many.
prompt_y = ly + LH + Math.Int(h * 0.06);
prompt_sprite = Sprite();
prompt_sprite.SetOpacity(0);
prompt_text = "";
prompt_ready = 0;
BS = bullet_img.GetWidth();            # bullet size
SP = Math.Int(BS * 1.9);               # bullet pitch
MAXB = 40;                             # a longer passphrase keeps a full row
bullets_y = prompt_y + Math.Int(h * 0.045);
msg_y = bullets_y + Math.Int(h * 0.05);
bullets_n = 0;                         # how many the user has typed
bullets_made = 0;                      # sprites created so far
bullet_spr[0] = NULL;
bullet_a[0] = 0;
row_off = 0;                           # animated offset of bullet 0 from cx
bullet_text = Sprite();                # only if bullet.png failed to load
bullet_text.SetOpacity(0);

message_sprite = Sprite();
message_sprite.SetOpacity(0);
message_text = "";

# Prompt and message text grow with the screen (the label plugin's default is
# 12 pt on every screen). label-freetype honours only the size in "Family Size".
tsize = Math.Int(12 * h / 1200 + 0.5);
if (tsize < 12) { tsize = 12; }
if (tsize > 28) { tsize = 28; }
text_font = "Sans " + tsize;

pw_target = 0; pw_p = 0;               # 0 = splash, 1 = password prompt
msg_target = 0; msg_p = 0;             # progress of each transition, 0..1

# ── the clock ─────────────────────────────────────────────────────────────
# Animation time advances by 1/RATE per refresh and is steered toward real
# elapsed time, which plymouth only hands a script through the boot-progress
# callback. A slow frame does not stretch the timeline (it catches up), and if
# progress stops arriving the animation keeps running on the refresh alone.
# It never runs backwards.
clock = 0;
last_clock = 0;
prog_new = -1;
prog_last = -1;
sync_off = -1;

fun on_progress (duration, progress) {
  if (duration > global.prog_last) {   # a paused progress repeats itself: ignore it
    global.prog_last = duration;
    global.prog_new = duration;
  }
}

fun advance_clock () {
  local.dt = 1 / RATE;
  global.clock = global.clock + local.dt;
  if (global.prog_new >= 0) {
    if (global.sync_off < 0) { global.sync_off = global.prog_new - global.clock; }
    local.err = (global.prog_new - global.sync_off) - global.clock + local.dt / 2;
    if (local.err < -0.25) {
      global.sync_off = global.prog_new - global.clock;   # progress was paused: re-align
    } else if (local.err > 0.25) {
      global.clock = global.clock + local.err;            # a long stall: jump to real time
    } else if (local.err > 0) {
      global.clock = global.clock + local.err * 0.5;      # behind: catch up within ~3 samples
    } else {
      global.clock = global.clock + Math.Max(local.err * 0.1, -local.dt / 2);   # ahead: ease off
    }
    global.prog_new = -1;
  }
}

T0 = 0.12;                             # a beat of charcoal after the firmware hands over
GROW_STEP = 0.35;                      # core, ring, coat: each starts this long after the one inside it
GROW_FADE = 0.6;                       # how long each body takes to come in
WAVE_START = 2.0;                      # the wave begins once the mark has settled
WAVE_PERIOD = 2.4;                     # one pass outward, then a rest, seconds
WAVE_DIP = 0.45;                       # how far a body dims as the wave passes (to 55 %)

# ── the frame ─────────────────────────────────────────────────────────────
fun refresh () {
  advance_clock();
  local.fdt = global.clock - global.last_clock;
  global.last_clock = global.clock;

  if (intro) { local.t = global.clock - T0; } else { local.t = global.clock + 10; }

  # the mark grows from its origin: core, ring, coat; the wordmark with the ring
  local.a_base = smooth((local.t - GROW_STEP) / 0.7);

  # password prompt, over 0.4 s either way: the splash dims, the wave stops
  # and the prompt comes in the second half
  if (global.pw_target) { global.pw_p = Math.Min(global.pw_p + local.fdt / 0.4, 1); }
  else { global.pw_p = Math.Max(global.pw_p - local.fdt / 0.4, 0); }
  if (global.msg_target) { global.msg_p = Math.Min(global.msg_p + local.fdt / 0.3, 1); }
  else { global.msg_p = Math.Max(global.msg_p - local.fdt / 0.3, 0); }
  local.pw = smooth(global.pw_p);
  local.g = 1 - 0.3 * local.pw;

  base.SetOpacity(local.a_base * local.g);

  # the wave: position p runs from inside the core (-1) to past the coat (4,
  # a rest), and the body at p dips on a smooth pulse a little over half a body
  # wide: one body dims at a time (a neighbour by at most 6 % on the hand-over)
  # and the rest of the mark stays at full colour
  local.wv = smooth((local.t - WAVE_START) / 0.6) * (1 - smooth(global.pw_p / 0.5));
  local.p = frac(Math.Max(local.t - WAVE_START, 0) / WAVE_PERIOD) * 5 - 1;
  local.k = 0;
  while (local.k < 3) {
    local.grow = smooth((local.t - local.k * GROW_STEP) / GROW_FADE);
    local.dip = WAVE_DIP * local.wv * smooth(1 - absv(local.p - local.k) * 1.6);
    body[local.k].SetOpacity(local.grow * (1 - local.dip) * local.g);
    local.k++;
  }

  prompt_sprite.SetOpacity(smooth((global.pw_p - 0.4) / 0.6));
  message_sprite.SetOpacity(smooth(global.msg_p));

  if (global.pw_p > 0 || global.bullets_made > 0) { draw_bullets(local.fdt, local.pw); }
}

fun draw_bullets (fdt, pw) {
  local.n = global.bullets_n;
  if (local.n > MAXB) local.n = MAXB;
  if (BS < 1) {                        # no bullet image: text bullets in the accent
    bullet_text.SetOpacity(pw);
    return;
  }
  while (global.bullets_made < local.n) {
    bullet_spr[global.bullets_made] = Sprite(bullet_img);
    bullet_spr[global.bullets_made].SetOpacity(0);
    bullet_a[global.bullets_made] = 0;
    global.bullets_made++;
  }
  # the row re-centres on a quick spring as bullets come and go
  local.target = -(local.n - 1) * SP / 2;
  if (local.n < 1) local.target = global.row_off;
  global.row_off = global.row_off + (local.target - global.row_off) * (1 - expn(fdt / 0.07));
  local.kb = 1 - expn(fdt / 0.06);
  local.i = 0;
  while (local.i < global.bullets_made) {
    local.want = 0;
    if (local.i < local.n) local.want = 1;
    bullet_a[local.i] = bullet_a[local.i] + (local.want - bullet_a[local.i]) * local.kb;
    local.x = cx + global.row_off + local.i * SP - (BS - 1) / 2;
    bullet_spr[local.i].SetPosition(Math.Int(local.x), bullets_y, 21);
    bullet_spr[local.i].SetOpacity(bullet_a[local.i] * pw);
    local.i++;
  }
}

fun display_password (prompt, bullets) {
  global.pw_target = 1;
  if (!global.prompt_ready || prompt != global.prompt_text) {
    global.prompt_ready = 1;
    global.prompt_text = prompt;
    local.pimg = Image.Text(prompt, 0.980, 0.980, 0.980, 1, text_font);
    # No label plugin draws a 0x0 image; say something rather than nothing.
    if (!local.pimg || local.pimg.GetWidth() < 1) { local.pimg = prompt_fallback; }
    prompt_sprite.SetImage(local.pimg);
    prompt_sprite.SetPosition(cx - Math.Int(local.pimg.GetWidth() / 2), prompt_y, 20);
  }
  global.bullets_n = bullets;
  if (BS < 1) {
    local.btxt = "";
    local.i = 0;
    while (local.i < bullets && local.i < MAXB) { local.btxt = local.btxt + "* "; local.i++; }
    local.bimg = Image.Text(local.btxt, HI_R, HI_G, HI_B);
    bullet_text.SetImage(local.bimg);
    bullet_text.SetPosition(cx - Math.Int(local.bimg.GetWidth() / 2), bullets_y, 21);
  }
}

fun display_normal () {
  global.pw_target = 0;
}

# --- messages ---
# Not an empty function: an empty message() is plymouth accepting
# `plymouth message --text=...` and dropping it. At the passphrase prompt this
# is the only place that can say which keyboard layout is live or that a
# recovery key is wanted. Drawn UNDER the bullets; an empty text clears it.
fun message (text) {
  if (text == "") {
    global.msg_target = 0;
    return;
  }
  global.message_text = text;
  local.mimg = Image.Text(text, 0.62, 0.66, 0.72, 1, text_font);
  message_sprite.SetImage(local.mimg);
  message_sprite.SetPosition(cx - Math.Int(local.mimg.GetWidth() / 2), msg_y, 22);
  global.msg_target = 1;
}

fun hide_message (text) {
  if (text == global.message_text) { global.msg_target = 0; }
}

Plymouth.SetRefreshFunction(refresh);
Plymouth.SetBootProgressFunction(on_progress);
Plymouth.SetDisplayPasswordFunction(display_password);
Plymouth.SetDisplayNormalFunction(display_normal);
Plymouth.SetMessageFunction(message);
Plymouth.SetHideMessageFunction(hide_message);
