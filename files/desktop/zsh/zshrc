# ─────────────────────────────────────────────────────────────────────────────
#  Rime OS — default zsh configuration
#
#  Seeded per-user by rime-shell-firstrun. This is a STARTING POINT, not a
#  managed file: it is only written when ~/.zshrc does not already exist, so
#  anything you change here survives updates and re-logins.
#
#  No framework. oh-my-zsh and friends add a second config system, a slow
#  startup and a lot of behaviour you did not ask for. Everything below is
#  either a zsh builtin or one small package, and every block says why it exists.
# ─────────────────────────────────────────────────────────────────────────────

# ── history ──────────────────────────────────────────────────────────────────
# Big, shared across sessions, deduplicated, and written as you go so a crash or
# a hard poweroff does not lose the last hour of commands.
HISTFILE="${XDG_STATE_HOME:-$HOME/.local/state}/zsh/history"
mkdir -p "${HISTFILE:h}" 2>/dev/null
HISTSIZE=100000
SAVEHIST=100000
setopt SHARE_HISTORY INC_APPEND_HISTORY EXTENDED_HISTORY
setopt HIST_IGNORE_DUPS HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE
setopt HIST_REDUCE_BLANKS HIST_VERIFY

# ── navigation ───────────────────────────────────────────────────────────────
setopt AUTO_CD AUTO_PUSHD PUSHD_IGNORE_DUPS PUSHD_SILENT
setopt EXTENDED_GLOB NO_CASE_GLOB NUMERIC_GLOB_SORT
setopt INTERACTIVE_COMMENTS          # let you # comment in an interactive shell
unsetopt BEEP

# ── completion ───────────────────────────────────────────────────────────────
# Cached so shell startup stays fast; case-insensitive and substring matching so
# `cd dow<Tab>` and `cd Downloads` both work.
#
# zsh/complist MUST be loaded, and it must be loaded before compinit runs. It is
# what provides the `menuselect` keymap and the highlighted, arrow-navigable
# completion menu. Without it `zstyle ... menu select` below is a silent NO-OP:
# zsh falls back to dumping every match as a flat column list with no selection,
# no highlight and no keys — which is exactly how this config shipped, and why
# completion felt a decade out of date (rime-logs 14).
zmodload zsh/complist

autoload -Uz compinit
ZCOMPDUMP="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump"
mkdir -p "${ZCOMPDUMP:h}" 2>/dev/null
# Only re-scan the completion tree once a day — compinit is the single biggest
# cost in zsh startup.
if [[ -n ${ZCOMPDUMP}(#qN.mh+24) ]]; then compinit -d "$ZCOMPDUMP"; else compinit -C -d "$ZCOMPDUMP"; fi

# A second <Tab> enters the menu; accepting a match leaves the cursor at the end
# of the word rather than mid-word. MENU_COMPLETE stays OFF deliberately: it
# inserts the first match blindly instead of showing you the choices.
setopt AUTO_MENU ALWAYS_TO_END LIST_PACKED
unsetopt MENU_COMPLETE FLOW_CONTROL

zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' menu select
zstyle ':completion:*' group-name ''
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompcache"
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
# Labelled groups, and say WHY there is nothing rather than just beeping.
zstyle ':completion:*' verbose yes
zstyle ':completion:*:descriptions' format '%F{#8A93A6}%B%d%b%f'
zstyle ':completion:*:messages'     format '%F{#8A93A6}%d%f'
zstyle ':completion:*:warnings'     format '%F{#F87171}no matches for %d%f'
zstyle ':completion:*:corrections'  format '%F{#FDE047}%d (errors: %e)%f'
# Long lists get a position indicator instead of scrolling off into nowhere.
zstyle ':completion:*' select-prompt '%SMatch %m: %p%s'
# `sudo <Tab>` should complete the commands root can actually run.
zstyle ':completion:*:sudo:*' command-path /usr/local/sbin /usr/local/bin \
                                           /usr/sbin /usr/bin /sbin /bin
# Killing a process should show you what you are about to kill.
zstyle ':completion:*:*:*:*:processes' command 'ps -u $USER -o pid,user,comm -w -w'
zstyle ':completion:*:*:kill:*:processes' list-colors '=(#b) #([0-9]#)*=0=01;31'
zstyle ':completion:*:kill:*' force-list always
# Keep . and .. out of directory completion; they are never what you meant.
zstyle ':completion:*' special-dirs false

# Keys INSIDE the completion menu. Arrows work by default; these add the ones
# people reach for and expect to exist.
bindkey -M menuselect '^[[Z' reverse-menu-complete   # Shift-Tab steps backwards
bindkey -M menuselect '^M'   .accept-line            # Enter accepts and runs
bindkey -M menuselect '^['   send-break              # Esc leaves the menu alone
bindkey -M menuselect '/'    history-incremental-search-forward  # type to filter

# ── keys ─────────────────────────────────────────────────────────────────────
# Emacs bindings (what most people expect), plus the keys that are wrong by
# default on a lot of terminals.
bindkey -e
bindkey '^[[H'    beginning-of-line
bindkey '^[[F'    end-of-line
bindkey '^[[3~'   delete-char
bindkey '^[[1;5C' forward-word
bindkey '^[[1;5D' backward-word
bindkey '^H'      backward-kill-word
# Up/Down search history for what you have already typed, rather than walking
# blindly through every command. This is the single best zsh quality-of-life fix.
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search

# ── plugins (packaged, not vendored) ─────────────────────────────────────────
# Order matters: syntax highlighting must be sourced LAST or it does not see the
# widgets the other plugins define.
[[ -r /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]] && \
    source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
# The hex MUST be lower case. zle lower-cases a colour spec when it stores an
# entry in region_highlight, and zsh-autosuggestions removes its own highlight by
# comparing the stored entry against the string it built from this variable. With
# 'fg=#4A5162' the comparison never matches, so accepting a suggestion (right
# arrow) leaves the text grey even though it is now real input. Measured on
# zsh 5.9 with zsh-autosuggestions 0.7.1: the stale entry survives as
# '6 29 fg=#4a5162'.
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#4a5162'
ZSH_AUTOSUGGEST_STRATEGY=(history completion)

# ── aliases ──────────────────────────────────────────────────────────────────
# Modern replacements only when they are actually installed, so this file still
# works in a container or a rescue shell that has none of them.
if command -v eza >/dev/null 2>&1; then
    alias ls='eza --group-directories-first --icons=auto'
    alias ll='eza -l --group-directories-first --icons=auto --git'
    alias la='eza -la --group-directories-first --icons=auto --git'
    alias lt='eza --tree --level=2 --icons=auto'
else
    alias ls='ls --color=auto --group-directories-first'
    alias ll='ls -lh'
    alias la='ls -lah'
fi
command -v bat  >/dev/null 2>&1 && alias cat='bat --paging=never --style=plain'
command -v rg   >/dev/null 2>&1 && alias grep='rg'
alias ip='ip -color=auto'
alias df='df -h'
alias free='free -h'
alias ..='cd ..'
alias ...='cd ../..'

# Rime OS is image-based: these are the commands people actually need and
# usually have to look up. They go through `rime`, never bootc directly: a
# bare `bootc upgrade` skips the signature check and the live update.
alias rime-update='sudo rime update'
alias rime-status='rime live status'
alias rime-rollback='sudo rime rollback'

# ── tools ────────────────────────────────────────────────────────────────────
# fzf here (it defines widgets, so it must come before syntax highlighting below).
# zoxide is deliberately NOT here — see the note after the prompt.
command -v fzf     >/dev/null 2>&1 && source <(fzf --zsh) 2>/dev/null

# ── prompt ───────────────────────────────────────────────────────────────────
# starship, themed to the running edition (see ~/.config/starship.toml).
# If it is somehow missing, fall back to a readable built-in prompt rather than
# leaving the user staring at a bare `%`.
if command -v starship >/dev/null 2>&1; then
    eval "$(starship init zsh)"
else
    autoload -Uz colors && colors
    PROMPT='%F{green}%~%f %# '
fi

# zoxide AFTER starship, deliberately. zoxide installs a precmd hook and checks at
# startup that nothing registered another one after it; starship's init does exactly
# that. With zoxide first, every single new shell printed
#   "zoxide: detected a possible configuration issue. Please ensure that zoxide is
#    initialized right at the end of your shell configuration file"
# above the prompt — which is also the upstream-recommended ordering, so this is
# the fix rather than silencing the warning with _ZO_DOCTOR=0.
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh --cmd cd)"

# Syntax highlighting LAST — see the note above.
[[ -r /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] && \
    source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# ── agent runtime ────────────────────────────────────────────────────────────
# The universal `a` command and its siblings, plus completion for sessions and
# agent names. Shared verbatim with bash (/etc/bashrc sources the same file) so
# the two can never drift, exactly like the greeting below.
#
# BEFORE the local overrides on purpose: everything it defines is a plain shell
# function, so ~/.zshrc.local can redefine `a` or set RIME_NO_AGENT_ALIASES=1
# and have it actually take effect.
[[ -r /usr/share/rime/shell/agent.sh ]] && source /usr/share/rime/shell/agent.sh

# ── local overrides ──────────────────────────────────────────────────────────
# Anything you want that should NOT be touched by Rime. Sourced last so it wins.
[[ -r "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

# ── greeting ─────────────────────────────────────────────────────────────────
# fastfetch on every new terminal. Shared verbatim with bash (/etc/bashrc sources
# the same file), because zsh is the default login shell here and a bash-only
# greeting meant nobody actually saw it.
#
# LAST on purpose, after the local overrides above: that is what lets you put
# RIME_NO_GREETING=1 in ~/.zshrc.local and have it actually take effect.
[[ -r /usr/share/rime/shell/greeting.sh ]] && source /usr/share/rime/shell/greeting.sh
