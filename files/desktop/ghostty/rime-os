# rime-os fallback: Rime Shell replaces this file with your wallpaper's colours.
# Rime's Ghostty theme (~/.config/ghostty/themes/rime-os): the look Rime's terminal had in Alacritty.
# Your own settings go in ~/.config/ghostty/config.ghostty, which wins over every line here.
# rime-static-begin
font-family = monospace
font-size = 11.25
# Measured with DejaVu Sans Mono at 15 px (NixOS's monospace; nix/tests/terminal-look.nix): Ghostty's cells were 17 px
# tall, Alacritty's 18, and the block cursor fills the cell there. Re-measure if the monospace default changes.
adjust-cell-height = 1
adjust-cursor-height = 1
window-padding-x = 0
window-padding-y = 0
window-padding-balance = false
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor
scrollback-limit-lines = 10000
bell-features = no-title
cursor-color = cell-foreground
cursor-text = cell-background
selection-foreground = cell-background
selection-background = cell-foreground
palette = 1=#ac4242
palette = 2=#90a959
palette = 3=#f4bf75
palette = 4=#6a9fb5
palette = 5=#aa759f
palette = 6=#75b5aa
palette = 9=#c55555
palette = 10=#aac474
palette = 11=#feca88
palette = 12=#82b8c8
palette = 13=#c28cb8
palette = 14=#93d3c3
# rime-static-end
background = #181818
foreground = #d8d8d8
palette = 0=#181818
palette = 7=#d8d8d8
palette = 8=#6b6b6b
palette = 15=#f8f8f8
