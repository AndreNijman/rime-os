<?xml version="1.0" encoding="UTF-8"?>
<!--
  Rime OS — labwc root menu (seeded per-user by rime-shell-firstrun).

  This is the EMERGENCY menu, not the desktop menu. A plain right-click on the
  desktop opens the Rime QML context menu (see the Root mousebind in rc.xml);
  this one is reached with SUPER+right-click and exists for exactly one case:
  Rime Shell is not running and could not be restarted, so the QML menu cannot
  appear.

  Kept short on purpose. Rime Shell owns the launcher, the settings pages and
  the power menu; every entry here is either a way to get the shell back or a
  way to leave the session.
-->
<openbox_menu>
  <menu id="root-menu" label="Rime">
    <item label="Terminal">
      <action name="Execute" command="ghostty"/>
    </item>
    <item label="App launcher">
      <action name="Execute" command="rime shell launcher"/>
    </item>
    <item label="Settings">
      <action name="Execute" command="rime shell settings"/>
    </item>
    <separator/>
    <item label="Restart Rime Shell">
      <action name="Execute" command="/usr/libexec/rime-shell-autostart"/>
    </item>
    <item label="Reload labwc config">
      <action name="Reconfigure"/>
    </item>
    <separator/>
    <item label="Lock">
      <action name="Execute" command="rime shell lock"/>
    </item>
    <item label="Log out">
      <action name="Exit"/>
    </item>
  </menu>
</openbox_menu>
