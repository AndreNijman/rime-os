    <keybind key="A-space">
      <action name="Execute" command="rime shell launcher"/>
    </keybind>
    <keybind key="C-S-Escape">
      <action name="Execute" command="rime shell dashboard stats"/>
    </keybind>
    <keybind key="W-Down">
      <action name="MoveToEdge" direction="down"/>
      <action name="WarpCursor" to="window"/>
    </keybind>
    <keybind key="W-Left">
      <action name="MoveToEdge" direction="left"/>
