  <mouse>
    <!-- Desktop right-click opens the Rime QML context menu instead of the
         Openbox-derived root menu. That menu is the single loudest "this is a
         fallback" signal left in the Floating session, and the same QML surface
         serves the Hyprland and niri sessions, so the menu is one object rather
         than three that drift.

         The helper is what makes this safe: a mousebind is a fixed action and
         cannot express "…or the built-in menu if the shell is down", so the
         decision lives in /usr/libexec/rime-desktop-menu, which also tries to
         restart a dead shell — the most likely reason the desktop has no menu
         is that the shell died, and right-clicking is what people do when they
         notice.

         menu.xml is NOT removed. Super+right-click still shows it, which is the
         documented emergency path when the shell cannot be revived. -->
    <context name="Root">
      <mousebind button="Right" action="Press">
        <action name="Execute" command="/usr/libexec/rime-desktop-menu"/>
      </mousebind>
      <mousebind button="W-Right" action="Press">
        <action name="ShowMenu" menu="root-menu"/>
      </mousebind>
    </context>

    <context name="Frame">
      <mousebind button="W-Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
      <mousebind button="W-Left" action="Drag">
        <action name="Move"/>
      </mousebind>
      <mousebind button="W-Right" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
      <mousebind button="W-Right" action="Drag">
        <action name="Resize"/>
      </mousebind>
    </context>
  </mouse>

