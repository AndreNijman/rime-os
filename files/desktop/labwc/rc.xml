<?xml version="1.0"?>
<!--
  ─────────────────────────────────────────────────────────────────────────────
   Rime OS — labwc configuration (seeded per-user by rime-shell-firstrun).

   The labwc counterpart of files/desktop/hypr/hyprland.conf, kept deliberately
   in step with it: same modifier, same app keys, same screenshot bindings, same
   shell popups over the same IPC entry point.

   Two structural differences from the Hyprland session, both inherent to labwc:

     * labwc is a STACKING compositor, not a tiler. There is no split, no
       pseudo-tile and no layout cycling, so those binds have no equivalent and
       are deliberately absent rather than mapped to something approximate.

     * labwc has NO IPC of any kind — no D-Bus interface, no sway/i3 socket, no
       hyprctl. Everything the shell needs from the compositor arrives over
       Wayland protocols instead (labwc implements ext-workspace, session-lock,
       layer-shell, foreign-toplevel, idle-notify and gamma control). In the
       other direction, the shell is driven from here by `rime shell <verb>`,
       which wraps its IPC client so neither the install path nor the internal
       target names appear in this file.

   Decorations are server-side on purpose: labwc supplies the application
   titlebar, drag area and native window controls below Rime Shell's reserved
   top bar. Rime Shell still owns the outer frame and rounded screen corners.
  ─────────────────────────────────────────────────────────────────────────────
-->
<labwc_config>

  <core>
    <!-- `client` would hand decoration to the app, which many Wayland clients
         decline, leaving no controls or draggable titlebar. `server` keeps
         those native controls while Rime Shell reserves non-overlapping space. -->
    <decoration>server</decoration>
    <!-- 8 px, matching the Floating-mode spec. Was 6: close enough to look
         accidental rather than chosen, which is the difference this whole
         pass is about. -->
    <gap>8</gap>
    <adaptiveSync>no</adaptiveSync>
    <reuseOutputMode>no</reuseOutputMode>
  </core>

  <!-- Virtual desktops. These are what the shell's workspace dots reflect: labwc
       advertises them over ext-workspace-v1, and the bar reads them through
       Quickshell's WindowManager. Ten to match the Hyprland session's 1..10. -->
  <desktops>
    <popupTime>0</popupTime>
    <names>
      <name>1</name>
      <name>2</name>
      <name>3</name>
      <name>4</name>
      <name>5</name>
      <name>6</name>
      <name>7</name>
      <name>8</name>
      <name>9</name>
      <name>10</name>
    </names>
  </desktops>

  <focus>
    <!-- Focus follows the pointer. Hyprland's own Rime config uses
         follow_mouse=1, so this matches the other session rather than diverging
         from it, and it means focus never depends on a click landing on the
         right surface. -->
    <followMouse>yes</followMouse>
    <!-- Require actual pointer MOVEMENT before refocusing. Without this, a
         window appearing or closing under a stationary cursor steals focus,
         which is maddening when typing. -->
    <followMouseRequiresMovement>yes</followMouseRequiresMovement>
    <!-- Focus follows the mouse, but stacking does not: auto-raising on hover
         makes windows pop over each other as the pointer crosses them. -->
    <raiseOnFocus>no</raiseOnFocus>
  </focus>

  <theme>
    <!-- Keep native labwc controls explicit. Rime Shell reserves the top bar's
         complete height in the labwc session, so these no longer sit beneath a
         transparent layer-shell input surface. -->
    <titlebar>
      <layout>icon:iconify,max,close</layout>
      <showTitle>yes</showTitle>
    </titlebar>
    <!-- Rounded corners. Rime Floating is presented as the traditional
         overlapping-window mode, not a fallback, and square corners under a
         rounded shell were the single clearest tell that it was one. -->
    <cornerRadius>10</cornerRadius>
    <keepBorder>no</keepBorder>
    <maximizedDecoration>titlebar</maximizedDecoration>
    <!-- Soft drop shadows, sized in themerc-override. -->
    <dropShadows>yes</dropShadows>

    <!-- Window chrome is UI text, so it gets a PROPORTIONAL face. Monospace
         belongs in terminals and editors; using it for titlebars is what made
         the session read as an Openbox theme.
         Noto Sans rather than Inter: google-noto-sans-fonts is installed by
         Containerfile.core, so it is guaranteed present on every image, and a
         font that is not installed silently falls back to whatever fontconfig
         picks. Size 11, the low end of the 11-12 pt target, because labwc
         derives titlebar height from the font and 11 pt + the padding set in
         themerc-override lands inside the 36-40 px band. -->
    <font place="ActiveWindow">
      <name>Noto Sans</name>
      <size>11</size>
    </font>
    <font place="InactiveWindow">
      <name>Noto Sans</name>
      <size>11</size>
    </font>
    <font place="MenuItem">
      <name>Noto Sans</name>
      <size>11</size>
    </font>
    <font place="OnScreenDisplay">
      <name>Noto Sans</name>
      <size>11</size>
    </font>
  </theme>

  <!-- Thumbnail window switcher. labwc ships this and it is a large, free step
       up from the classic text list; the roadmap asks for it as the baseline
       now, with a full Rime Shell overview as the longer-term replacement.
       Scoped to the focused output so a switcher does not appear on every
       monitor at once. -->
  <windowSwitcher preview="yes" outlines="yes">
    <osd show="yes" style="thumbnail" output="focused" />
  </windowSwitcher>

  <!-- Touchpad behaviour, kept in step with the Hyprland session's input block.

       `tap`, NOT `tapToClick`. The element was `<tapToClick>` here, which labwc
       does not implement: it appears zero times in labwc-config(5) and zero
       times in the labwc package's own exhaustive rc.xml.all, whose libinput
       section spells it `<tap>yes</tap>`. labwc ignores an unrecognised element
       in silence, so the line did nothing.

       It LOOKED like it worked because tap-to-click is enabled by default for
       every device category. The intent was met by accident, and anyone who had
       tried to write `<tapToClick>no</tapToClick>` to turn tapping OFF would
       have found the setting simply ignored. The element-name guard in
       tests/test-rime-firstrun.sh now catches this whole class.

       Not set here, deliberately, because both are already labwc's defaults and
       writing them would be decoration rather than configuration:
         tapButtonMap  lrm  — one/two/three-finger tap = left/right/middle, so
                              two-finger tap is already right-click
         scrollMethod  twofinger -->
  <libinput>
    <device category="touchpad">
      <naturalScroll>yes</naturalScroll>
      <tap>yes</tap>
      <tapAndDrag>yes</tapAndDrag>
      <accelProfile>adaptive</accelProfile>
    </device>
  </libinput>

  <resistance>
    <screenEdgeStrength>20</screenEdgeStrength>
  </resistance>

  <keyboard>
    <!-- ── Rime Shell popups ────────────────────────────────────────────────
         These MUST match the shell's own defaults in
         src/services/config_tab/KeybindService.qml (_defaults). The shell's
         keybind editor generates Hyprland .conf/.lua and niri .kdl, but NOT
         labwc XML — labwc has no IPC and no include mechanism for keybinds — so
         these are maintained here by hand and cross-checked against
         KeybindService at image build time. Do not "tidy" them into a tidier
         set; they are a contract with the other two sessions. -->
    <!-- The same menu a desktop right-click opens, on a key, so it is reachable
         from a tiled session with no visible desktop. Matches the Hyprland and
         niri bindings the shell generates for them. -->

    <!-- Audio panels -->

    <!-- Network panels -->

    <!-- ── Apps ─────────────────────────────────────────────────────────── -->

    <!-- ── Screenshots ──────────────────────────────────────────────────── -->

    <!-- ── Window management ────────────────────────────────────────────── -->
    <!-- SUPER+SHIFT+SPACE is "toggle floating" on Hyprland. labwc stacks, so
         every window already floats and there is nothing to toggle; the key is
         kept on the nearest useful behaviour rather than left dead. -->
    <!-- ── Alt-Tab: labwc's own switcher, across every desktop ──────────────
         `workspace="all"` is the whole of Andre's "it goes for all windows
         including windows in other workspaces" for this session: labwc's
         switcher is already hold-ALT-tap-Tab-release-ALT, already draws
         thumbnails (see <windowSwitcher> above), and already cycles in focus
         order. The attribute is the only thing it was missing.

         ── Why this is NOT the Rime Shell switcher the Hyprland session gets ──
         The shell's switcher needs the compositor to tell it when ALT is
         RELEASED, because a switcher surface that took keyboard focus to see
         the release itself would be taking focus off the window it is about to
         activate — the defect this file's WarpCursor lines exist to fix, one
         layer up. Hyprland has a release bind for that. labwc has
         onRelease="yes", and it deliberately does not do this:

             "This is useful to bind actions to only modifier keys, where the
              action should fire when the modifier is used WITHOUT another key"
                                                        — labwc-config(5)

         Measured on labwc 0.9.6, 2026-09-20: with `Alt_L onRelease="yes"`
         bound, holding ALT, tapping Tab (which fires A-Tab) and releasing ALT
         fires the release binding ZERO times. Pressing and releasing ALT with
         no Tab in between fires it. It is documented behaviour, not a bug, and
         it makes a shell-drawn hold-and-release switcher impossible here.

         So the Floating session keeps the switcher labwc already has, which
         does the same job properly, and Rime's own is bound on the session
         that can support it. docs/window-switcher.md says which is which
         rather than implying the three sessions match. -->
    <keybind key="A-Tab">
      <action name="NextWindow" workspace="all"/>
    </keybind>
    <keybind key="A-S-Tab">
      <action name="PreviousWindow" workspace="all"/>
    </keybind>

    <!-- Hyprland binds SUPER+arrows to movefocus. labwc has NO directional
         focus action — `Focus` takes no arguments, because a stacking
         compositor has no spatial grid to traverse. Alt-Tab above is the
         equivalent, so the arrows move the window instead.

         What the arrows DO get is a WarpCursor, generated into the block below
         alongside every MoveToEdge and SnapToEdge. Moving a window out from
         under a stationary pointer is the labwc spelling of exactly the bug
         Andre reported on Hyprland: <followMouse>yes</followMouse> then hands
         focus to whatever the move uncovered. Carrying the pointer with the
         window keeps the window you just moved focused. -->

    <!-- SUPER+SHIFT+arrows is "move window" on Hyprland; snapping to an edge is
         the stacking analogue. -->

    <!-- ── Desktops 1..10 ──────────────────────────────────────────────── -->


    <!-- ── Media / brightness keys ──────────────────────────────────────── -->
    <!-- Volume goes through wpctl, matching the Hyprland session. Brightness
         goes through brightnessctl, whose sysfs write the shell's
         BrightnessService picks up over inotify — so the OSD appears without
         the compositor needing to tell the shell anything. -->
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+"/>
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"/>
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"/>
    </keybind>
    <keybind key="XF86AudioMicMute">
      <action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"/>
    </keybind>
    <keybind key="XF86MonBrightnessUp">
      <action name="Execute" command="brightnessctl set 5%+"/>
    </keybind>
    <keybind key="XF86MonBrightnessDown">
      <action name="Execute" command="brightnessctl set 5%-"/>
    </keybind>
    <keybind key="XF86AudioPlay">
      <action name="Execute" command="playerctl play-pause"/>
    </keybind>
    <keybind key="XF86AudioNext">
      <action name="Execute" command="playerctl next"/>
    </keybind>
    <keybind key="XF86AudioPrev">
      <action name="Execute" command="playerctl previous"/>
    </keybind>

    <!-- ── Media keys on CTRL+SUPER ────────────────────────────────────────
         Kept in step with the Media group in the shell's KeybindService, which
         is what the Hyprland session binds. A keyboard with no dedicated media
         keys otherwise cannot drive playback at all. The commands are the same
         ones the XF86 keys above use, so the shell's OSD still reacts to volume
         and brightness. `equal` and `minus` are the unshifted +/- keys. -->

    <!-- Reload this file after editing it. -->
    <keybind key="W-S-r">
      <action name="Reconfigure"/>
    </keybind>
