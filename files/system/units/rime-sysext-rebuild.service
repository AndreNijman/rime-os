[Unit]
Description=Rebuild Rime user packages for the booted OS version
Documentation=man:systemd-sysext(8)
# A system extension declares the OS it was built against, and systemd REFUSES
# to merge one that does not match. That refusal is the safety property which
# makes user packages compatible with atomic OS updates — but on its own it
# would mean "you updated the OS, your packages silently vanished". This unit is
# the other half: it notices the mismatch and rebuilds the extension against the
# OS that is now running.
#
# Nothing here runs on a normal boot: `rebuild --if-needed` exits immediately
# when the extension already matches and is merged.
ConditionPathExists=/var/lib/rime/pkg/state.json
#
# NOT ordered after network-online.target. That ordering put
# NetworkManager-wait-online (8 s on a laptop whose Wi-Fi profile waits for the
# keyring) on the critical path of multi-user.target and graphical.target on
# EVERY boot, to guard a rebuild that almost no boot needs. `rime-pkg rebuild
# --if-needed` now decides first and waits for the network itself, only when it
# has something to download. A boot that needs a rebuild still waits for it
# before the desktop starts, as before.
#
# A rebuild that CANNOT happen does not hold the desktop. Offline after the
# network wait, or a package set that does not fit this image, ends the unit
# at once with a non-zero status (it shows as failed, never "Finished") and a
# note in /run/rime-pkg that the user's session turns into a notice
# (rime-pkg-notice). A refused rebuild once held a desktop for 12.5 minutes
# downloading the whole set a second time only to name the package in the way;
# the boot path no longer does that, `sudo rime pkg rebuild` still does.
# `rime update`'s health gate does not count this unit's failure as a
# regression (rimed-core channel.rs): the next update is what fixes a refusal.
After=systemd-sysext.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/rime-pkg rebuild --if-needed
# Rebuilding means re-downloading and re-extracting every user package, which on
# a slow link can take a while; it must never race a boot timeout into failure.
TimeoutStartSec=infinity
# Where the note for the desktop goes (rime-pkg REBUILD_NOTICE). World-readable
# because a user unit reads it; kept after the unit stops, because a failed
# oneshot is exactly when it has something to say. /run is empty every boot.
RuntimeDirectory=rime-pkg
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
# This is background maintenance competing with a desktop that is starting up.
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
