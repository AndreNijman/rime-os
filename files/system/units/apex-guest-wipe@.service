# APEX-OS — clear a disposable guest account (systemd SYSTEM service, P2-016).
#
# %i is the account name, which must also appear in /etc/apex/guest-accounts;
# the engine refuses otherwise. See the engine's header for all four fences and
# files/system/shared-machine/README.md for the recipe this belongs to.
#
# NOT ENABLED BY THIS REPO. Nothing installs a guest account either, so on a
# stock APEX this unit exists and has nothing to act on — which is the whole of
# "kiosk/shared-device policy is possible without weakening ordinary desktop
# use" as it applies here: the machinery ships inert and enabling it is an
# explicit, per-machine act.
#
# WHY ROOT
# The credential namespace this exists to clear is /var/lib/apex-secretd/
# users/<uid>/, which is 0700 root-owned precisely so the account cannot read
# it (P0-002). Nothing running as the guest can clear it, which is the reason
# a tmpfs home is not disposability on this system.

[Unit]
Description=Clear the disposable guest account %i
Documentation=man:apex(1)
# THERE IS NO `After=user-%i.slice`, and the reason is worth writing down
# because a draft of this file had one. `%i` is the account NAME; logind's
# slices are named by UID — `user-1500.slice`, not `user-apex-guest.slice` — and
# a template unit cannot derive a uid from a name. systemd accepts an ordering
# against a unit that does not exist as a silent no-op, so that line ordered
# nothing at all while reading as though it did.
#
# What actually protects the live-session case is the engine's fourth fence: it
# asks logind who is logged in and refuses while the account still has a
# session. That is a runtime check on the real answer rather than an ordering
# against a guess at a unit name, and it is the one exercised by
# tests/test-apex-shared-machine.sh.

[Service]
Type=oneshot
ExecStart=/usr/libexec/apex-guest-wipe %i
# Exit 2 is the engine's refusal — a fence held. That is not a unit failure and
# must not be reported as one, or a machine with no guest configured would show
# a failed unit at every boot.
SuccessExitStatus=0 2

# Hardening. It needs to remove things under /var and under the guest's home,
# and nothing else.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/apex-secretd /var/lib/apex-greet /home /var/home
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
PrivateNetwork=yes

[Install]
# WantedBy names where the symlink GOES when somebody runs `systemctl enable`.
# It does not enable anything by itself — nothing in this repo runs `enable` for
# this unit, and Containerfile.base asserts the absence of the symlink, which is
# what "not enabled by default" actually means.
#
# An earlier draft left this empty, reasoning that no WantedBy meant not
# enabled. Measured with `systemctl --root=… enable`: an empty [Install] makes
# systemd refuse outright — "The unit files have no installation config … This
# means they are not meant to be enabled or disabled using systemctl" — so the
# README's own enable step could not work. Inert and enableable are different
# properties and this file needs both.
#
#   systemctl enable apex-guest-wipe@apex-guest.service
WantedBy=multi-user.target
