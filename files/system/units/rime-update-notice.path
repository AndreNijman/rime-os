# Rime OS — wake the update notice when the check's answer or a live
# update's result changes.
# inotify, not polling: this costs nothing while the file is quiet.

[Unit]
Description=Watch for a Rime OS update announcement

[Path]
PathChanged=/run/rime-update/state
PathChanged=/run/rime-live/status.json
Unit=rime-update-notice.service

[Install]
WantedBy=paths.target
