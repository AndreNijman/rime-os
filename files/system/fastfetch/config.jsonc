{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    // Rime OS system fastfetch config (rime-logs 33-fastfetch-terminal.md).
    // Invoked from /usr/share/rime/shell/greeting.sh (sourced by bash and by the
    // seeded ~/.zshrc) as `fastfetch --config /etc/fastfetch/config.jsonc
    // [--color <accent>] --logo-type <protocol> --logo <png> ...`: the greeting
    // picks the image (the symbol Rime Shell recoloured from the wallpaper, else
    // the shipped Rime Blue one) and the protocol the terminal speaks.
    //
    // The logo below is what a bare `fastfetch --config` shows, and what the
    // greeting shows in a terminal without image support: a plain "RIME OS"
    // label in the accent, never ASCII art.
    //
    // Every accent below is `{#keys}` — a reference to display.color.keys — and
    // never a literal escape, because that is the one thing `--color` can
    // override at runtime. The value set here is only what a session shows
    // before matugen has extracted a palette from a wallpaper: Rime Blue
    // (#91C2DC, docs/branding.md).
    "logo": {
        "type": "data",
        "source": "$1RIME OS",
        "color": { "1": "1;38;2;145;194;220" },
        "padding": { "top": 1, "left": 2, "right": 3 }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "38;2;145;194;220" }
    },
    "modules": [
        // Leading blank line vertically centres the info block against the taller
        // logo (fastfetch has no native vertical centring).
        "break",
        { "type": "title", "format": "{#keys}{user-name}{#}@{#keys}{host-name}{#}" },
        { "type": "custom", "format": "{#keys}╭──────────╮" },
        { "type": "os",     "key": "│ os       │", "format": "{name} {version-id}" },
        // Kernel: `uname -r` is 7.1.3-cachyos1.fc43.x86_64 — the CachyOS COPR
        // build id is compiled into the kernel package and cannot be renamed
        // without building the kernel from source. Show only the upstream
        // version so the greeting stays Rime-branded; the full string is still
        // one `uname -r` away for anyone who needs it.
        { "type": "command", "key": "│ kernel   │", "text": "uname -r | cut -d- -f1" },
        { "type": "uptime", "key": "│ uptime   │" },
        { "type": "wm",     "key": "│ wm       │" },
        { "type": "cpu",    "key": "│ cpu      │" },
        { "type": "memory", "key": "│ memory   │" },
        { "type": "custom", "format": "{#keys}╰──────────╯" }
    ]
}
