#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  Rime OS — put a Secret Service provider on this session's bus, and say which.
#
#  Installed to /usr/libexec/rime-secrets-start. Run once per session by
#  rime-shell-autostart (Hyprland, niri, labwc) and rime-gaming-session, before
#  anything in the session asks for a saved password.
#
#  WHY A SESSION HAS TO DO THIS AT ALL
#  pam_gnome_keyring starts `gnome-keyring-daemon --login` at login and unlocks
#  the login keyring with the password just typed. That daemon only waits: the
#  session has to run `gnome-keyring-daemon --start` to put it on the session
#  bus, and if nothing does it quits by itself about two minutes after login.
#  The first app that wanted a secret then D-Bus-activated a NEW daemon with the
#  keyring locked and asked for the password again. GNOME's session runs
#  `--start` from /etc/xdg/autostart; Rime's sessions run no autostart, so this
#  does it.
#
#  WHY IT IS ITS OWN PROGRAM
#  Fedora 45 moved its desktops from gnome-keyring to oo7-daemon. Rime stays on
#  gnome-keyring (/usr/share/rime/secrets-provider says why), and the image
#  build refuses oo7-daemon. This exists so that the two sessions start the
#  provider the same way, and so that a machine where gnome-keyring is gone and
#  oo7-daemon is present (a package someone installed, a provider change made
#  without updating the sessions) still gets a Secret Service instead of none.
#  Started this way, oo7's login keyring is LOCKED: Rime does not give oo7 the
#  login password. The first app then asks for it once. That is the fallback,
#  not the product.
#
#  WHAT IT DOES
#    1. picks the provider: the one /usr/share/rime/secrets-provider names when
#       its daemon is installed, otherwise gnome-keyring, otherwise oo7;
#    2. starts it the way that provider expects:
#         gnome-keyring  `gnome-keyring-daemon --start --components=secrets`,
#                        byte for byte what the sessions ran before this file
#         oo7            `systemctl --user start oo7-daemon.service` (its unit
#                        is Type=dbus, so the start returns once it owns the
#                        name); with no user service manager, the daemon itself,
#                        detached, unless something already owns the name.
#         If that start fails, or leaves nobody owning the name, the daemon
#         itself, detached, as with no service manager;
#    3. CONFIRMS that org.freedesktop.secrets has an owner on the session bus,
#       asking the bus (GetConnectionUnixProcessID never activates anything),
#       and logs which program owns it.
#
#  HOW LONG IT CAN HOLD A SESSION
#  The sessions run this before the Shell or gamescope starts, so every wait in
#  it is bounded by the clock, not by a count of tries:
#    - `gnome-keyring-daemon --start` and a Type=dbus `systemctl --user start`
#      return with the name already owned, so step 3 asks the bus ONCE, for at
#      most 1 s. A failed start therefore costs one question, not a wait;
#    - only after the detached oo7 start, which returns before the daemon is on
#      the bus, does step 3 keep asking until RIME_SECRETS_CONFIRM_SECS of wall
#      time have passed. Each question is capped at 1 s and at the time left.
#  The starts keep their own bounds: 5 s for gnome-keyring, 10 s for
#  systemctl. The log gives the real time spent when no owner turns up.
#
#  Exit 0 when the bus answers and the owner is the provider chosen in step 1.
#  Exit 1 otherwise, with a line saying why. Callers log it and carry on: a
#  session must never wait on, or fail over, a keyring.
#
#  Env (tests and debugging):
#    RIME_SECRETS_PROVIDER_FILE  default /usr/share/rime/secrets-provider
#    RIME_OO7_DAEMON             default /usr/libexec/oo7-daemon
#    RIME_SECRETS_CONFIRM_SECS   how long step 3 may wait for the detached oo7
#                                start to own the name (default 5)
#    RIME_SECRETS_TAG            the log prefix (the caller's name)
# ─────────────────────────────────────────────────────────────────────────────
# Deliberately NOT `set -e`: every probe below may fail, and each failure is
# reported rather than ending the run early.
set -uo pipefail

TAG="${RIME_SECRETS_TAG:-rime-secrets-start}"
PROVIDER_FILE="${RIME_SECRETS_PROVIDER_FILE:-/usr/share/rime/secrets-provider}"
OO7_DAEMON="${RIME_OO7_DAEMON:-/usr/libexec/oo7-daemon}"
CONFIRM_SECS="${RIME_SECRETS_CONFIRM_SECS:-5}"
case "$CONFIRM_SECS" in ''|*[!0-9]*) CONFIRM_SECS=5 ;; esac

log() { printf '[%s] %s\n' "$TAG" "$*" >&2; }

# ── 1. which provider ───────────────────────────────────────────────────────
configured() {
    local p=""
    if [ -r "$PROVIDER_FILE" ]; then
        p="$(sed -n 's/^provider=//p' "$PROVIDER_FILE" | tail -n 1)"
    fi
    printf '%s' "${p:-gnome-keyring}"
}

installed() {
    case "$1" in
        gnome-keyring) command -v gnome-keyring-daemon >/dev/null 2>&1 ;;
        oo7)           [ -x "$OO7_DAEMON" ] ;;
        *)             return 1 ;;
    esac
}

want="$(configured)"
case "$want" in
    gnome-keyring|oo7) ;;
    *) log "unknown provider '${want}' in ${PROVIDER_FILE}; trying gnome-keyring, then oo7"
       want="" ;;
esac
provider=""
for p in $want gnome-keyring oo7; do
    if installed "$p"; then provider="$p"; break; fi
done
if [ -z "$provider" ]; then
    log "no Secret Service provider is installed (neither gnome-keyring-daemon nor ${OO7_DAEMON}); apps cannot save passwords"
    exit 1
fi
if [ -n "$want" ] && [ "$provider" != "$want" ]; then
    log "the configured provider ${want} is not installed; starting ${provider} instead"
fi

# ── the session bus, and who owns the name on it ────────────────────────────
BUS=""
if [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    BUS="$DBUS_SESSION_BUS_ADDRESS"
elif [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -S "${XDG_RUNTIME_DIR}/bus" ]; then
    BUS="unix:path=${XDG_RUNTIME_DIR}/bus"
fi

# Microseconds on the wall clock: bash 5's EPOCHREALTIME (its separator
# follows the locale), else date. Never a constant: a clock that does not move
# would turn the deadline below into a loop with no end.
now_us() {
    local t="${EPOCHREALTIME:-}"
    if [ -n "$t" ]; then printf '%s' "${t//[.,]/}"; else printf '%s' "$(( $(date +%s%N) / 1000 ))"; fi
}

# The pid that owns org.freedesktop.secrets, or nothing. Asks the bus itself:
# a call to the name would D-Bus-activate a locked daemon, which is the very
# thing this program exists to prevent. $1 = how long the question may take,
# in milliseconds (default 1000): a bus that accepts the connection and never
# answers costs that much, and no more.
owner_pid() {
    [ -n "$BUS" ] || return 0
    local ms="${1:-1000}" lim out
    [ "$ms" -ge 100 ] 2>/dev/null || ms=100
    lim="$(printf '%d.%03d' $(( ms / 1000 )) $(( ms % 1000 )))"
    if command -v gdbus >/dev/null 2>&1; then
        out="$(DBUS_SESSION_BUS_ADDRESS="$BUS" timeout "$lim" gdbus call --session \
            --dest org.freedesktop.DBus --object-path /org/freedesktop/DBus \
            --method org.freedesktop.DBus.GetConnectionUnixProcessID \
            org.freedesktop.secrets 2>/dev/null)"
        printf '%s\n' "$out" | sed -n 's/^(uint32 \([0-9][0-9]*\),)$/\1/p'
    elif command -v busctl >/dev/null 2>&1; then
        out="$(DBUS_SESSION_BUS_ADDRESS="$BUS" timeout "$lim" busctl --user call \
            org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus \
            GetConnectionUnixProcessID s org.freedesktop.secrets 2>/dev/null)"
        printf '%s\n' "$out" | sed -n 's/^u \([0-9][0-9]*\)$/\1/p'
    fi
}

# gnome-keyring-daemon's comm is cut to 15 bytes by the kernel.
provider_of() {
    local comm
    comm="$(cat "/proc/$1/comm" 2>/dev/null)"
    case "$comm" in
        gnome-keyring-d*) printf 'gnome-keyring' ;;
        oo7-daemon)       printf 'oo7' ;;
        '')               printf 'unknown' ;;
        *)                printf '%s' "$comm" ;;
    esac
}

# ── 2. start it ─────────────────────────────────────────────────────────────
# detached=1 when the provider was started in a way that returns before it is
# on the bus; only then is it worth waiting for an owner in step 3.
detached=0
start_oo7_detached() {
    # What the unit would run, detached, with the session's bus. stderr stays
    # the session's log.
    if command -v setsid >/dev/null 2>&1; then
        DBUS_SESSION_BUS_ADDRESS="$BUS" setsid -f "$OO7_DAEMON" </dev/null >/dev/null
    else
        ( DBUS_SESSION_BUS_ADDRESS="$BUS" "$OO7_DAEMON" </dev/null >/dev/null & )
    fi
    detached=1
}
case "$provider" in
    gnome-keyring)
        # Unchanged from the line the sessions ran inline: --start hands the
        # session the daemon PAM unlocked, and with no such daemon starts one.
        timeout 5 gnome-keyring-daemon --start --components=secrets >/dev/null 2>&1 \
            || log "gnome-keyring-daemon --start failed; apps may ask to unlock the keyring"
        ;;
    oo7)
        by_systemd=0
        if command -v systemctl >/dev/null 2>&1 \
            && [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -S "${XDG_RUNTIME_DIR}/systemd/private" ]; then
            # Type=dbus: a successful start means the daemon owns the name.
            if ! timeout 10 systemctl --user start oo7-daemon.service; then
                log "systemctl --user start oo7-daemon.service failed; starting ${OO7_DAEMON} directly"
            elif [ -z "$(owner_pid)" ]; then
                log "oo7-daemon.service started but nothing owns org.freedesktop.secrets; starting ${OO7_DAEMON} directly"
            else
                by_systemd=1
            fi
        fi
        if [ "$by_systemd" = 1 ]; then
            :
        elif [ -z "$BUS" ]; then
            log "no session bus; not starting ${OO7_DAEMON}"
        elif [ -n "$(owner_pid)" ]; then
            : # something already serves secrets; a second daemon could not own the name
        else
            start_oo7_detached
        fi
        ;;
esac

# ── 3. confirm ──────────────────────────────────────────────────────────────
if [ -z "$BUS" ]; then
    log "no session bus to confirm on; started ${provider}, owner of org.freedesktop.secrets unknown"
    exit 1
fi
if ! command -v gdbus >/dev/null 2>&1 && ! command -v busctl >/dev/null 2>&1; then
    log "neither gdbus nor busctl is installed; started ${provider}, owner of org.freedesktop.secrets unknown"
    exit 1
fi
# One question after a start that returns with the name owned; after the
# detached start, questions until the deadline. Wall time throughout.
pid=""
t0="$(now_us)"
deadline=$(( t0 + CONFIRM_SECS * 1000000 ))
while :; do
    left_ms=$(( (deadline - $(now_us)) / 1000 ))
    ask_ms=1000
    [ "$left_ms" -lt "$ask_ms" ] && ask_ms="$left_ms"
    pid="$(owner_pid "$ask_ms")"
    [ -n "$pid" ] && break
    [ "$detached" = 1 ] || break
    [ $(( $(now_us) + 100000 )) -lt "$deadline" ] || break
    sleep 0.1
done
if [ -z "$pid" ]; then
    spent_ms=$(( ($(now_us) - t0) / 1000 ))
    log "nothing owns org.freedesktop.secrets ${spent_ms} ms after starting ${provider}; apps cannot reach saved passwords"
    exit 1
fi
owner="$(provider_of "$pid")"
if [ "$owner" = "$provider" ]; then
    log "org.freedesktop.secrets is served by ${owner} (pid ${pid})"
    exit 0
fi
log "org.freedesktop.secrets is served by ${owner} (pid ${pid}), not by ${provider}; saved passwords may sit in a keyring the login did not unlock"
exit 1
