#!/usr/bin/env bash
#
# Rime OS — reload the running compositor's configuration.
#
# Each compositor has its own verb and none of them share a name, so the Rime
# context menu asks for "reload" and this decides what that means. Keeping the
# knowledge here rather than in the QML is what lets one menu serve all three
# sessions.
#
# Detection is by XDG_CURRENT_DESKTOP, which every Rime session sets, then by
# HYPRLAND_INSTANCE_SIGNATURE (Hyprland sets it in everything it starts, and
# hyprctl needs it anyway), with a process check as the last fallback. The
# signature comes before the process name because on NixOS bin/Hyprland is a
# wrapper that execs .Hyprland-wrapped, whose comm is ".Hyprland-wrapp": `pgrep
# -x Hyprland` never matched it, so an apply from a shell without
# XDG_CURRENT_DESKTOP reloaded nothing.

set -uo pipefail

desktop="$(printf '%s' "${XDG_CURRENT_DESKTOP:-}" | tr '[:upper:]' '[:lower:]')"

reload_labwc()   { labwc --reconfigure; }
reload_hypr()    { hyprctl reload; }
# niri re-reads its config automatically on change and offers no reload verb;
# `validate` at least surfaces a broken config instead of doing nothing silently.
reload_niri()    { niri validate; }

case "$desktop" in
    *labwc*)    reload_labwc ;;
    *hyprland*) reload_hypr ;;
    *niri*)     reload_niri ;;
    *)
        if   [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then reload_hypr
        elif pgrep -u "$(id -u)" -x labwc    >/dev/null 2>&1; then reload_labwc
        elif pgrep -u "$(id -u)" -x Hyprland >/dev/null 2>&1 \
          || pgrep -u "$(id -u)" -x .Hyprland-wrapp >/dev/null 2>&1; then reload_hypr
        elif pgrep -u "$(id -u)" -x niri     >/dev/null 2>&1; then reload_niri
        else
            echo "rime: no known compositor is running (XDG_CURRENT_DESKTOP=${XDG_CURRENT_DESKTOP:-unset})" >&2
            exit 1
        fi
        ;;
esac
