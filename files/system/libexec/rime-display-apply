#!/usr/bin/env python3
"""Display settings for every Rime session: enumerate, apply, and persist.

The display half of what rime-input-apply does for input. One model, applied
live and then persisted so it survives a logout and a hotplug.

    ~/.config/rime-shell/display.json      the model (written by Rime Settings)
              |
    live      +--> wlr-randr                    labwc, niri
              +--> hyprctl eval hl.monitor{...}  Hyprland
              |
    persist   +--> ~/.config/kanshi/config      labwc, niri  (reapplied on hotplug)
              +--> ~/.config/hypr/rime/monitors.lua   Hyprland (required)

## Why Hyprland is handled separately

Hyprland does not implement wlr-output-management, so wlr-randr cannot see or
change its outputs at all. It is driven through hyprctl instead, from the same
model — which is exactly the adapter boundary §17 asks for rather than three
different settings implementations.

kanshi is the persistence layer for the wlroots sessions: it matches on the set
of connected outputs and reapplies the matching profile when one is plugged in
or removed. Hyprland has that built in via monitor rules, so its persistence is
a generated module hyprland.lua requires.

`hl.monitor` calls, not `monitor=` lines: Rime ships Hyprland 0.57, whose only
config manager is Lua (hyprlang is gone, and so is the `keyword` request). The
live half is `hyprctl eval` with the same Lua chunk the persisted module holds;
a reply other than "ok" is a refusal, reported and exited non-zero.

## The model is checked, not trusted

Names, positions, modes and scales are validated before any generator sees
them (no NaN/Infinity, no bool-as-number, no control characters), the mode
must be one the connected display lists, and the scale is snapped exactly the
way Hyprland would snap it (hypr_scale), so what is applied is what was asked
for or a note says why not.

## Enumeration is never guessed

`wlr-randr --json` is the source of truth on labwc and niri; `hyprctl -j
monitors` on Hyprland. Both report real modes, so the settings UI offers only
modes the hardware actually has. `--dry-run` uses wlr-randr's own `--dryrun`,
which validates a layout without applying it.

usage:
  rime-display-apply list                      outputs as JSON
  rime-display-apply apply [--model PATH]      apply the model, live AND persist
  rime-display-apply apply --no-persist        apply live ONLY; nothing on disk
  rime-display-apply save                      persist ONLY; never touches hardware
  rime-display-apply color                     colour management state, as JSON
  rime-display-apply color-assign OUT PROFILE  give an output an ICC profile
  rime-display-apply --dry-run apply           validate without applying
  rime-display-apply --self-test               check the generators

## Why `apply --no-persist` exists

A layout the user has not confirmed yet must not outlive the session that is
asking about it. Rime Settings applies a candidate layout, starts a countdown
and reverts if nobody says Keep — but `apply` persisted unconditionally, so a
session that died during those fifteen seconds came back at the next login on
the layout nobody confirmed, with kanshi reapplying it on every hotplug and no
transaction left anywhere to say it was never confirmed. `--no-persist` makes
the temporary apply genuinely temporary; Keep then runs `save`, which is
persistence with no hardware write. See ROADMAP/design/P0-018-display-recovery.md.
"""
import argparse
import glob
import json
import math
import os
import re
import shutil
import struct
import subprocess
import sys
import tempfile

HOME = os.path.expanduser("~")
MODEL_PATH = os.path.join(HOME, ".config/rime-shell/display.json")
KANSHI_OUT = os.path.join(HOME, ".config/kanshi/config")
HYPR_OUT = os.path.join(HOME, ".config/hypr/rime/monitors.lua")

BANNER = "Generated by rime-display-apply from Rime Settings. Do not edit."

TRANSFORMS = ("normal", "90", "180", "270",
              "flipped", "flipped-90", "flipped-180", "flipped-270")

# Hyprland spells rotation as an integer 0-7 rather than a name.
HYPR_TRANSFORM = {
    "normal": 0, "90": 1, "180": 2, "270": 3,
    "flipped": 4, "flipped-90": 5, "flipped-180": 6, "flipped-270": 7,
}


class _Failed:
    """Stand-in result for a command that could not be run at all."""

    returncode = 127
    stdout = ""
    stderr = ""


def run(cmd, **kw):
    """Run a command, treating "not installed" and "hung" as failures.

    Every caller already branches on `returncode`, so a missing binary must
    look like a non-zero exit rather than raising — otherwise one absent tool
    takes the whole program down with a traceback.

    That is not hypothetical. `compositor()` falls back to `pgrep` when the
    environment gives no hint, and on a machine without `pgrep` on PATH
    `rime-display-apply save` died with a FileNotFoundError instead of writing
    the layout. It reached CI, where the runner has no compositor and the test
    replaces PATH, and it would equally have hit any minimal container.

    The timeout is caught for the same reason: a compositor query that hangs
    must fail, not block a settings page forever.
    """
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=30, **kw)
    except (OSError, subprocess.SubprocessError):
        return _Failed()


def compositor():
    """Which session this is, from what every Rime session sets."""
    desktop = os.environ.get("XDG_CURRENT_DESKTOP", "").lower()
    for name in ("hyprland", "niri", "labwc"):
        if name in desktop:
            return name
    # hyprctl talks to the instance this names, and Hyprland sets it in every
    # process it starts. Checked before the process name because on NixOS
    # bin/Hyprland is a wrapper that execs .Hyprland-wrapped: the process is
    # ".Hyprland-wrapp" to `pgrep -x` (15-character comm), so the name check
    # never matched there and a session without XDG_CURRENT_DESKTOP was sent
    # down the wlr-randr path Hyprland does not implement.
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return "hyprland"
    # A session started outside the normal path; fall back to what is running.
    for proc, name in (("Hyprland", "hyprland"), (".Hyprland-wrapp", "hyprland"),
                       ("niri", "niri"), ("labwc", "labwc")):
        if run(["pgrep", "-x", proc]).returncode == 0:
            return name
    return "unknown"


# ── enumeration ─────────────────────────────────────────────────────────────
def outputs_wlr():
    """Outputs via wlr-output-management. labwc and niri."""
    if not shutil.which("wlr-randr"):
        return None
    res = run(["wlr-randr", "--json"])
    if res.returncode != 0:
        return None
    try:
        raw = json.loads(res.stdout)
    except json.JSONDecodeError:
        return None

    out = []
    for o in raw:
        modes = []
        for m in o.get("modes", []):
            modes.append({
                "width": m.get("width"), "height": m.get("height"),
                "refresh": round(m.get("refresh", 0), 3),
                "preferred": bool(m.get("preferred")),
                "current": bool(m.get("current")),
            })
        pos = o.get("position") or {}
        out.append({
            "name": o.get("name"),
            "description": o.get("description", ""),
            "make": o.get("make", ""), "model": o.get("model", ""),
            "serial": o.get("serial", ""),
            "enabled": bool(o.get("enabled")),
            "x": pos.get("x", 0), "y": pos.get("y", 0),
            "scale": o.get("scale", 1.0),
            "transform": o.get("transform", "normal"),
            "adaptive_sync": bool(o.get("adaptive_sync_status") == "enabled"),
            "modes": modes,
        })
    return out


def outputs_hypr():
    """Outputs via hyprctl. Hyprland does not serve wlr-output-management."""
    if not shutil.which("hyprctl"):
        return None
    res = run(["hyprctl", "-j", "monitors"])
    if res.returncode != 0:
        return None
    try:
        raw = json.loads(res.stdout)
    except json.JSONDecodeError:
        return None

    out = []
    for m in raw:
        modes = []
        # The top-level width/height/refreshRate ARE the current mode; the
        # availableModes strings carry no flag, so the current one is found by
        # the same 1 px / 1 Hz tolerance Hyprland matches a requested mode with.
        cur = (m.get("width"), m.get("height"), m.get("refreshRate"))
        for spec in m.get("availableModes", []):
            # "1920x1080@60.00Hz"
            try:
                dims, _, rate = spec.partition("@")
                w, _, h = dims.partition("x")
                mode = {
                    "width": int(w), "height": int(h),
                    "refresh": round(float(rate.rstrip("Hz")), 3),
                    "preferred": False, "current": False,
                }
            except (ValueError, AttributeError):
                continue
            if all(is_number(v) for v in cur):
                mode["current"] = mode_matches((cur[0], cur[1], cur[2]), mode)
            modes.append(mode)
        inv = {v: k for k, v in HYPR_TRANSFORM.items()}
        out.append({
            "name": m.get("name"),
            "description": m.get("description", ""),
            "make": m.get("make", ""), "model": m.get("model", ""),
            "serial": m.get("serial", ""),
            "enabled": not m.get("disabled", False),
            "x": m.get("x", 0), "y": m.get("y", 0),
            "scale": m.get("scale", 1.0),
            "transform": inv.get(m.get("transform", 0), "normal"),
            "adaptive_sync": bool(m.get("vrr")),
            "modes": modes,
        })
    return out


def outputs():
    """Whatever this session can actually report."""
    if compositor() == "hyprland":
        return outputs_hypr() or outputs_wlr() or []
    return outputs_wlr() or outputs_hypr() or []


# ── model ───────────────────────────────────────────────────────────────────
# Everything in the model ends up inside a Lua chunk (monitors.lua, hyprctl
# eval), a kanshi config and a wlr-randr argv, so nothing reaches a generator
# unchecked. Python's json takes NaN and Infinity (and 1e400 parses to inf), and
# bool is a subclass of int, so `isinstance(v, (int, float))` alone lets
# `"scale": true` and `"x": NaN` through: both are refused by name here.
POS_LIMIT = 32767            # a layout coordinate, either sign
NAME_MAX = 256
MODE_RE = re.compile(r"^(\d{1,5})x(\d{1,5})(?:@(\d{1,4}(?:\.\d{1,3})?))?(?:Hz)?$")


def _reject_constant(name):
    raise ValueError(f"{name} is not a number")


def is_number(v):
    """A finite int or float that is not a bool."""
    return (isinstance(v, (int, float)) and not isinstance(v, bool)
            and math.isfinite(v))


def is_int(v):
    return isinstance(v, int) and not isinstance(v, bool)


def name_problem(name):
    """Why an output name is unusable, or None.

    The name is quoted into kanshi (`output "NAME"`, which has no escape for a
    quote or backslash) and into Lua (lua_str escapes, but a control character
    in a connector name is never real and is the shape an injection takes).
    """
    if not isinstance(name, str) or not name:
        return "has no name"
    if len(name) > NAME_MAX:
        return f"has a name longer than {NAME_MAX} characters"
    if any(ord(c) < 0x20 or ord(c) == 0x7f for c in name):
        return "has a control character in its name"
    if '"' in name or "\\" in name:
        return "has a quote or backslash in its name"
    return None


def parse_mode(mode):
    """(width, height, refresh or None) for a valid mode, else None."""
    if isinstance(mode, str):
        m = MODE_RE.match(mode)
        if not m:
            return None
        w, h = int(m.group(1)), int(m.group(2))
        r = float(m.group(3)) if m.group(3) else None
    elif isinstance(mode, dict):
        w, h, r = mode.get("width"), mode.get("height"), mode.get("refresh")
        if not (is_int(w) and is_int(h)):
            return None
        if r is not None and not (is_number(r) and r > 0):
            return None
        if r is not None and r > 1000:
            return None
    else:
        return None
    if not (0 < w <= 16384 and 0 < h <= 16384):
        return None
    return (w, h, r or None)


def mode_matches(want, mode):
    """Hyprland's own test for "this is the mode you asked for".

    src/output/Monitor.cpp:778-780 (0.57.0): the best available mode counts as
    the requested one only within DELTALESSTHAN(…, 1) on width, height and Hz
    (src/macros.hpp:35). Anything further off is tried as a CUSTOM mode, which
    is how a typo becomes a black screen. A request with no refresh matches on
    size alone.
    """
    w, h, r = want
    try:
        if abs(mode["width"] - w) >= 1 or abs(mode["height"] - h) >= 1:
            return False
        return r is None or abs(mode["refresh"] - r) < 1
    except (KeyError, TypeError):
        return False


def load_model(path):
    """The desired layout: {"outputs": [{name, enabled, mode, x, y, ...}]}."""
    try:
        with open(path, encoding="utf-8") as fh:
            model = json.load(fh, parse_constant=_reject_constant)
    except FileNotFoundError:
        return {"outputs": []}, []
    except (ValueError, OSError) as e:   # JSONDecodeError is a ValueError
        return {"outputs": []}, [f"{path} is not usable ({e}); nothing to apply"]
    if not isinstance(model, dict) or not isinstance(model.get("outputs", []), list):
        return {"outputs": []}, [f"{path} is not a display model; nothing to apply"]

    notes = []
    clean = []
    for o in model.get("outputs", []):
        if not isinstance(o, dict):
            notes.append("skipping an output entry that is not an object")
            continue
        why = name_problem(o.get("name"))
        if why:
            notes.append(f"skipping an output entry that {why}")
            continue
        name = o["name"]
        for key, default in (("enabled", True), ("adaptive_sync", False)):
            if key in o and not isinstance(o[key], bool):
                notes.append(f"{name}: {key} {o[key]!r} is not true or false, using {default}")
                o[key] = default
        t = o.get("transform", "normal")
        if not isinstance(t, str) or t not in TRANSFORMS:
            notes.append(f"{name}: unknown transform {t!r}, using normal")
            o["transform"] = "normal"
        s = o.get("scale", 1.0)
        if not is_number(s) or not 0.25 <= s <= 5.0:
            notes.append(f"{name}: scale {s!r} is not a number from 0.25 to 5, using 1.0")
            o["scale"] = 1.0
        if "x" in o or "y" in o:
            x, y = o.get("x"), o.get("y")
            if not (is_int(x) and is_int(y)
                    and -POS_LIMIT <= x <= POS_LIMIT and -POS_LIMIT <= y <= POS_LIMIT):
                notes.append(f"{name}: position {x!r},{y!r} is not a pair of whole "
                             f"numbers within ±{POS_LIMIT}; placing it automatically")
                o.pop("x", None)
                o.pop("y", None)
        if o.get("mode") and parse_mode(o["mode"]) is None:
            notes.append(f"{name}: mode {o['mode']!r} is not WIDTHxHEIGHT[@HZ]; "
                         "using its preferred mode")
            o.pop("mode", None)
        clean.append(o)
    return {"outputs": clean}, notes


def mode_string(o):
    """`1920x1080@60Hz`, or None to leave the mode alone."""
    parsed = parse_mode(o.get("mode"))
    if not parsed:
        return None
    w, h, hz = parsed
    if hz is None:
        return f"{w}x{h}"
    return f"{w}x{h}@{hz:g}Hz"


def has_position(o):
    return is_int(o.get("x")) and is_int(o.get("y"))


# ── Hyprland's scale check, replicated ───────────────────────────────────────
def _f32(x):
    """The value a C++ `float` holds for x (CMonitorRule::m_scale is a float)."""
    return struct.unpack("f", struct.pack("f", x))[0]


def _is_whole(v):
    # std::round(inf) == inf, so a division by a zero scale "passes" in C++.
    return math.isinf(v) or v == math.floor(v)


def _divides(w, h, scale):
    if scale == 0:
        return True  # w / 0.0 is inf in C++, and inf == round(inf)
    return _is_whole(w / scale) and _is_whole(h / scale)


def _cround(x):
    """std::round: half away from zero (Python's round() is half to even)."""
    f = math.floor(abs(x))
    r = f + (1 if abs(x) - f >= 0.5 else 0)
    return math.copysign(r, x)


def hypr_scale(width, height, scale):
    """What Hyprland 0.57.0 does with `scale` on a WIDTHxHEIGHT mode.

    A line-for-line replica of src/output/Monitor.cpp:939-985 (CMonitor::
    applyMonitorRule, hyprwm/Hyprland v0.57.0), so Settings can apply the
    value Hyprland would end up with instead of letting it substitute one and
    show a red "Invalid scale" notification:

    - the rule's scale is a float (MonitorRule.hpp:45); the check divides the
      UNTRANSFORMED mode size (m_pixelSize) on both axes and wants whole numbers;
    - otherwise searchScale = round(scale * 120), and if size / (searchScale /
      120) is whole that is used silently;
    - otherwise it walks i = 1..89, trying (searchScale + i) / 120 before
      (searchScale - i) / 120, and takes the first that divides — with the
      notification;
    - nothing found: an error overlay and the monitor's default scale.

    Returns (scale, kind), kind one of "clean", "silent", "suggested", "none".
    """
    s = _f32(scale)
    if _divides(width, height, s):
        return scale, "clean"
    search = _f32(_cround(s * 120.0))
    zero = search / 120.0
    if _divides(width, height, zero):
        return zero, "silent"
    for i in range(1, 90):
        up = _f32(search + i) / 120.0
        down = _f32(search - i) / 120.0
        if _divides(width, height, up):
            return up, "suggested"
        if _divides(width, height, down):
            return down, "suggested"
    return None, "none"


def _fmt_scale(v):
    return f"{v:.2f}".rstrip("0").rstrip(".")


def fit_to_live(model, live):
    """Make the model something the connected hardware will take as asked.

    Two things Hyprland would otherwise substitute behind the user's back:

    - a mode the display does not list. Hyprland tries it as a custom mode
      (Monitor.cpp:777-782), which on a real panel is the black screen this
      page exists to avoid. It is replaced by the display's current mode (or
      its preferred one) and the user is told.
    - a scale that does not divide the mode. Snapped here exactly as Hyprland
      would (hypr_scale) so the value applied, persisted and shown agrees, and
      no compositor notification fires. A scale with no clean neighbour is
      refused: the current scale stays if it is clean, else 1.

    An output that is not connected is left as saved: there is nothing live to
    check it against, and kanshi / the monitor rule apply it when it appears.
    """
    notes = []
    by_name = {o.get("name"): o for o in (live or []) if isinstance(o, dict)}
    for o in model["outputs"]:
        if not o.get("enabled", True):
            continue
        lo = by_name.get(o["name"])
        if lo is None:
            continue
        modes = [m for m in (lo.get("modes") or [])
                 if isinstance(m, dict) and is_int(m.get("width"))
                 and is_int(m.get("height")) and is_number(m.get("refresh"))]
        current = next((m for m in modes if m.get("current")), None)
        want = parse_mode(o.get("mode"))
        if want:
            if not modes:
                notes.append(f"{o['name']}: the display reported no modes, so "
                             f"{mode_string(o)} could not be checked")
            elif not any(mode_matches(want, m) for m in modes):
                asked = mode_string(o)
                if current:
                    o["mode"] = {"width": current["width"], "height": current["height"],
                                 "refresh": current["refresh"]}
                    notes.append(f"{o['name']}: {asked} is not a mode this display "
                                 f"offers; keeping {mode_string(o)}")
                else:
                    o.pop("mode", None)
                    notes.append(f"{o['name']}: {asked} is not a mode this display "
                                 "offers; using its preferred mode")
        size = parse_mode(o.get("mode"))
        if size is None:
            pref = next((m for m in modes if m.get("preferred")), None) or current
            if pref:
                size = (pref["width"], pref["height"], pref["refresh"])
            elif is_int(lo.get("width")) and is_int(lo.get("height")):
                size = (lo["width"], lo["height"], None)
        scale = o.get("scale", 1.0)
        if not size or not is_number(scale):
            continue
        w, h, _ = size
        snapped, kind = hypr_scale(w, h, scale)
        if kind == "silent":
            o["scale"] = snapped
        elif kind == "suggested":
            o["scale"] = snapped
            notes.append(f"{o['name']}: scale {_fmt_scale(scale)} does not divide "
                         f"{w}x{h} evenly; using {_fmt_scale(snapped)}, the nearest "
                         "scale Hyprland accepts")
        elif kind == "none":
            was = lo.get("scale")
            keep = was if is_number(was) and hypr_scale(w, h, was)[1] == "clean" else 1.0
            o["scale"] = keep
            notes.append(f"{o['name']}: scale {_fmt_scale(scale)} has no clean value "
                         f"near it for {w}x{h}; keeping {_fmt_scale(keep)}")
    return notes


# ── live apply ──────────────────────────────────────────────────────────────
def wlr_args(model):
    """A single wlr-randr invocation for the whole layout.

    One call, not one per output: applying outputs separately makes intermediate
    states visible and can transiently overlap two outputs at the same position.
    """
    args = []
    for o in model["outputs"]:
        args += ["--output", o["name"]]
        if not o.get("enabled", True):
            args.append("--off")
            continue
        args.append("--on")
        ms = mode_string(o)
        if ms:
            args += ["--mode", ms]
        if has_position(o):
            args += ["--pos", f"{o['x']},{o['y']}"]
        if o.get("scale") is not None:
            args += ["--scale", str(o["scale"])]
        args += ["--transform", o.get("transform", "normal")]
        args += ["--adaptive-sync", "enabled" if o.get("adaptive_sync") else "disabled"]
    return args


def apply_wlr(model, dry_run):
    args = wlr_args(model)
    if not args:
        return ["nothing to apply"]
    cmd = ["wlr-randr"] + (["--dryrun"] if dry_run else []) + args
    res = run(cmd)
    if res.returncode != 0:
        return [f"wlr-randr rejected the layout: {(res.stderr or res.stdout).strip()[:200]}"]
    return []


def apply_hypr(model, dry_run, icc=None):
    """Apply the layout to the RUNNING Hyprland, through `hyprctl eval` only.

    Hyprland 0.57 has no hyprlang parser left (its config manager enum has one
    member, CONFIG_LUA) and no `keyword` request at all, so the old fallback to
    `hyprctl keyword monitor …` could only ever fail. eval takes a Lua chunk,
    which makes the live call and the persisted module the same `hl.monitor`
    expression. Its reply is exactly "ok" when the chunk ran
    (src/ipc/s1/Commands.cpp evalRequest); anything else is the error, and the
    output is reported as refused — never as applied.
    """
    notes = []
    icc = icc or {}
    for o in model["outputs"]:
        call = hypr_monitor_call(o, icc.get(o["name"]))
        if dry_run:
            notes.append(f"would run: hyprctl eval {call}")
            continue
        res = run(["hyprctl", "eval", call])
        if res.returncode == 0 and res.stdout.strip() == "ok":
            continue
        why = (res.stdout + res.stderr).strip()[:160] or f"exit {res.returncode}"
        notes.append(f"Hyprland refused the layout for {o['name']}: {why}")
    return notes


# ── persistence ─────────────────────────────────────────────────────────────
def gen_kanshi(model, live):
    """A kanshi profile keyed by the connected output set.

    kanshi matches a profile against which outputs are present, so the profile
    names every output currently connected. That is what makes the layout come
    back on hotplug rather than only at login.

    Outputs are matched by name. A description would survive re-plugging into a
    different port, but is not stable across kanshi versions in the way a
    connector name is, and a wrong match silently applies the wrong layout.
    """
    by_name = {o["name"]: o for o in model["outputs"]}
    names = [o["name"] for o in live] or list(by_name)
    profile = "rime-" + "-".join(sorted(n.lower() for n in names)) if names else "rime"

    lines = [
        f"# {BANNER}",
        "#",
        "# kanshi reapplies the matching profile whenever the set of connected",
        "# outputs changes, which is what makes a layout survive a hotplug.",
        "",
        f"profile {profile} {{",
    ]
    for name in names:
        o = by_name.get(name)
        if o is None:
            # Connected but not in the model: name it so the profile still
            # matches, and leave its settings to the compositor.
            lines.append(f'    output "{name}"')
            continue
        if not o.get("enabled", True):
            lines.append(f'    output "{name}" disable')
            continue
        body = []
        ms = mode_string(o)
        if ms:
            body.append(f"        mode {ms.replace('Hz', '')}")
        if has_position(o):
            body.append(f"        position {o['x']},{o['y']}")
        body.append(f"        scale {o.get('scale', 1.0)}")
        body.append(f"        transform {o.get('transform', 'normal')}")
        body.append(f"        adaptive_sync {'on' if o.get('adaptive_sync') else 'off'}")
        lines.append(f'    output "{name}" {{')
        lines += body
        lines.append("    }")
    lines += ["}", ""]
    return "\n".join(lines)


# ── lua_str: byte-identical in rime-input-apply (tests/test-rime-hypr-lua.sh compares) ──
def lua_str(value):
    """A double-quoted Lua string literal for any text.

    Backslash and the quote are escaped, and so is every control character (C0
    and DEL) as a three-digit decimal escape (\\010 for a newline): a raw
    newline in a name would end a `--` comment line or split the literal, and
    zero-padding to three digits stops a following digit extending the escape.
    `]]` needs nothing: it is only special inside a long bracket string.
    """
    out = []
    for ch in str(value):
        code = ord(ch)
        if ch == "\\":
            out.append("\\\\")
        elif ch == '"':
            out.append('\\"')
        elif code < 0x20 or code == 0x7f:
            out.append("\\%03d" % code)
        else:
            out.append(ch)
    return '"' + "".join(out) + '"'
# ── end lua_str ──


def hypr_monitor_call(o, icc=None):
    """One `hl.monitor` call for an output.

    The hyprlang form was a single comma-separated value whose meaning came from
    position — `monitor=DP-2,1920x1080@60,2560x0,1.0,transform,3,vrr,1`. The Lua
    form names every field, so `transform` and `vrr` stop being trailing
    key/value pairs bolted onto a positional list.
    """
    if not o.get("enabled", True):
        return f'hl.monitor({{ output = {lua_str(o["name"])}, disabled = true }})'

    mode = (mode_string(o) or "preferred").replace("Hz", "")
    position = "{}x{}".format(o["x"], o["y"]) if has_position(o) else "auto"
    scale = o.get("scale", 1.0)
    if not is_number(scale):
        scale = 1.0
    fields = [
        "output = " + lua_str(o["name"]),
        "mode = " + lua_str(mode),
        "position = " + lua_str(position),
        "scale = " + repr(float(scale)),
    ]
    t = HYPR_TRANSFORM.get(o.get("transform", "normal"), 0)
    if t:
        fields.append(f"transform = {t}")
    if o.get("adaptive_sync"):
        fields.append("vrr = 1")
    if icc:
        fields.append("icc = " + lua_str(icc))
    return "hl.monitor({ " + ", ".join(fields) + " })"


def gen_hypr(model, icc=None):
    lines = [
        f"-- {BANNER}",
        "--",
        "-- Required by hyprland.lua as `rime.monitors`. Hyprland does not implement",
        "-- wlr-output-management, so it gets monitor rules from the same model that",
        "-- drives wlr-randr and kanshi on the other sessions.",
        "",
        "-- The catch-all is always emitted. An empty output never matches a",
        "-- connector by name, and Hyprland falls back to the first empty-name rule",
        "-- for any display no rule names (MonitorRuleManager.cpp:94-105, 0.57.0), so",
        "-- a display plugged in after these settings were saved still comes up",
        "-- instead of dark. It goes first only for readability: named rules match",
        "-- by name, not by order.",
        "--",
        "-- It lived in the seeded hyprland.conf before P0-025. It has to be here",
        "-- now: this module is what Settings rewrites, and a fallback in a file",
        "-- that loads BEFORE it would be overridden by nothing when the model is",
        "-- empty, but a fallback that is not written at all is a black screen.",
        "--",
        "-- scale is a deliberate fixed 1.0 rather than `auto`. Hyprland's `auto`",
        "-- rejects ratios it cannot resolve to an integer buffer size for the given",
        "-- resolution and errors the monitor rule out entirely, which is a worse",
        "-- failure (no output configured) than a small UI.",
        'hl.monitor({ output = "", mode = "preferred", position = "auto", scale = 1.0 })',
        "",
    ]
    icc = icc or {}
    lines += [hypr_monitor_call(o, icc.get(o["name"])) for o in model["outputs"]]
    lines.append("")
    return "\n".join(lines)


def _hyprland_unprivileged(cmd, env, config_dir):
    """Run Hyprland's config check as nobody when we are root.

    Hyprland 0.57.0's --verify-config binds its event socket at /.socket2.sock
    (an empty instance path) and segfaults whenever that bind succeeds, which
    only root can make it do: a build step, or a self-test under sudo. Measured
    in the image: the first root check in a fresh container crashes every time,
    a check as any other user passes. Hyprland also warns against running as
    root at all. So as root, the check runs as nobody, in a runtime directory
    nobody owns. Returns (cmd, env, scratch dir to remove or None).
    """
    if os.geteuid() != 0 or not shutil.which("setpriv"):
        return cmd, env, None
    os.chmod(config_dir, 0o755)  # TemporaryDirectory is 0700
    runtime = tempfile.mkdtemp()
    os.chown(runtime, 65534, 65534)
    env = dict(env, XDG_RUNTIME_DIR=runtime, HOME=runtime)
    return (["setpriv", "--reuid=65534", "--regid=65534", "--clear-groups", "--"] + cmd,
            env, runtime)


def validate_hyprland(text):
    """Parse the generated Lua the way Hyprland will actually load it.

    Wrapped in a config that requires it from a directory laid out like
    ~/.config/hypr — `require("rime.monitors")` resolves only because Hyprland
    prepends the config file's own directory to package.path.

    This half had NO validator before P0-025: the hyprlang generator wrote
    `monitor=` lines straight out and --self-test only grepped its own strings.
    A bad monitor rule is the one that costs you the screen you would need to
    fix it, so it gets the same treatment the input generator always had.

    Returns True/False, or None when Hyprland is not installed.
    """
    if not shutil.which("Hyprland"):
        return None
    env = dict(os.environ)
    env.setdefault("XDG_RUNTIME_DIR", tempfile.mkdtemp())
    with tempfile.TemporaryDirectory() as d:
        os.mkdir(os.path.join(d, "rime"))
        with open(os.path.join(d, "rime", "monitors.lua"), "w", encoding="utf-8") as fh:
            fh.write(text)
        wrapper = os.path.join(d, "hyprland.lua")
        with open(wrapper, "w", encoding="utf-8") as fh:
            fh.write('require("rime.monitors")\n')
        cmd, env, scratch = _hyprland_unprivileged(
            ["Hyprland", "--i-am-really-stupid", "--verify-config", "--config", wrapper], env, d)
        try:
            res = run(cmd, env=env)
        finally:
            if scratch:
                shutil.rmtree(scratch, ignore_errors=True)
        # Everything Hyprland has to say lands under "Config parsing result:",
        # and only a clean config prints "config ok" there.
        return "config ok" in (res.stdout + res.stderr)


def atomic_write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".rime-display.")
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write(text)
    os.replace(tmp, path)


def persist(model, live, dry_run, icc=None):
    """Write kanshi + the Hyprland module. Returns (ok, notes)."""
    notes = []
    kanshi = gen_kanshi(model, live)
    hypr = gen_hypr(model, icc)
    if dry_run:
        print(f"--- {KANSHI_OUT} ---\n{kanshi}")
        print(f"--- {HYPR_OUT} ---\n{hypr}")
        return True, notes
    # Validate before replacing anything. A rejected module would be skipped by
    # hyprland.lua's loader rather than taking the config down, but skipped means
    # the saved layout silently does not apply — so refuse to write it instead.
    if validate_hyprland(hypr) is False:
        return False, ["the generated Hyprland monitor module was rejected; "
                       "the previous layout is untouched"]
    atomic_write(KANSHI_OUT, kanshi)
    atomic_write(HYPR_OUT, hypr)
    # kanshi reloads on SIGHUP; if it is not running the profile applies at the
    # next login, which is the same outcome as any other config change.
    if shutil.which("pkill"):
        run(["pkill", "-HUP", "-x", "kanshi"])
    return True, notes


# ── colour management ───────────────────────────────────────────────────────
# colord is the store, not this program. It ships with the image, it runs as a
# system service, and it already owns a device/profile database with a D-Bus API
# and a polkit policy that lets an active session write to it without a prompt.
# What it does NOT have on Rime is anything that registers a display with it:
# `colormgr get-devices` on a running Rime session is EMPTY, because the thing
# that normally creates those devices is a desktop's own colour daemon
# (gnome-settings-daemon, plasma's kded) and Rime has neither.
#
# So the shape here is the same adapter boundary as the layout half: the shell
# talks to one binary, and the binary talks to colord.
#
# Scope `normal`, not `temp`. Measured: a temp-scope device lives exactly as long
# as the D-Bus connection that made it, and `colormgr` is one-shot — a device
# created by one invocation is already gone by the next. A settings engine that
# runs, exits and is expected to have changed something durable has no choice.

# Overridable so the suite can hand it a fixture tree. Everything else in this
# program can be isolated with HOME or PATH; /sys can only be isolated by being
# named. Without it the EDID assertions would be assertions about the developer's
# own panel, which is the class of test that passes on one machine.
DRM_ROOT = os.environ.get("RIME_DISPLAY_DRM_ROOT", "/sys/class/drm")


def icc_has_vcgt(path):
    """Does this ICC profile carry a video card gamma table?

    Read out of the file rather than taken from colord, because it is the whole
    question for a Wayland session: everything else in a display profile is for
    applications that ask for it, and the vcgt is the only part that would have
    to be pushed into the hardware. An ICC v2/v4 file is a 128-byte header, a
    big-endian uint32 tag count at offset 128, then 12-byte (signature, offset,
    size) entries.

    None when the file cannot be read or is not an ICC profile at all — which is
    a different answer from "no curve", and the caller says so.
    """
    try:
        with open(path, "rb") as fh:
            head = fh.read(132)
            if len(head) < 132:
                return None
            # 'acsp' at offset 36 is the profile file signature.
            if head[36:40] != b"acsp":
                return None
            count = int.from_bytes(head[128:132], "big")
            if count > 4096:            # a corrupt or hostile tag table
                return None
            table = fh.read(12 * count)
    except OSError:
        return None
    if len(table) < 12 * count:
        return None
    for i in range(count):
        if table[12 * i:12 * i + 4] == b"vcgt":
            return True
    return False


# ── gamut: what the panel can show vs what a profile describes ─────────────
# A display profile says what colour space a screen HAS. Hyprland takes it at
# its word (an `icc` rule overrides the colour-management preset), so assigning
# "Adobe RGB" to a panel that cannot reach Adobe RGB's greens makes ordinary
# sRGB content look washed out: it is squeezed into a gamut the panel is only
# pretending to have. The page still lets the user choose any profile, but it
# has to say which ones the panel can honour, and it says it from the panel's
# own EDID chromaticities rather than from a table of guesses.
#
# Coverage is the share of the profile's gamut triangle that lies inside the
# panel's, in CIE 1976 u'v' (closer to perceptual than 1931 xy). A profile the
# panel covers to GAMUT_SUPPORTED or better is "supported".
GAMUT_SUPPORTED = 0.90


def _s15(b):
    return int.from_bytes(b, "big", signed=True) / 65536.0


def _mat_inv3(m):
    a, b, c = m[0]
    d, e, f = m[1]
    g, h, i = m[2]
    det = a * (e * i - f * h) - b * (d * i - f * g) + c * (d * h - e * g)
    if abs(det) < 1e-12:
        return None
    return [[(e * i - f * h) / det, (c * h - b * i) / det, (b * f - c * e) / det],
            [(f * g - d * i) / det, (a * i - c * g) / det, (c * d - a * f) / det],
            [(d * h - e * g) / det, (b * g - a * h) / det, (a * e - b * d) / det]]


def icc_primaries(path):
    """The red, green and blue primaries an ICC display profile describes, as
    absolute CIE xy, or None when it is not a matrix profile.

    rXYZ/gXYZ/bXYZ are stored adapted to the D50 connection space; the `chad`
    tag is the matrix that did that, so its inverse gives back the colours the
    profile actually means. Every profile colord ships here carries one
    (measured: all six display profiles, v4). Without it the D50 values are used
    as they are, which errs toward reporting a slightly different gamut rather
    than inventing an adaptation the file does not state.
    """
    try:
        with open(path, "rb") as fh:
            data = fh.read(1 << 20)
    except OSError:
        return None
    if len(data) < 132 or data[36:40] != b"acsp":
        return None
    count = int.from_bytes(data[128:132], "big")
    if count > 4096 or len(data) < 132 + 12 * count:
        return None
    tags = {}
    for i in range(count):
        e = data[132 + 12 * i:144 + 12 * i]
        off, size = int.from_bytes(e[4:8], "big"), int.from_bytes(e[8:12], "big")
        tags[e[:4]] = data[off:off + size]

    def xyz(tag):
        t = tags.get(tag, b"")
        if len(t) < 20 or t[:4] != b"XYZ ":
            return None
        return [_s15(t[8 + 4 * j:12 + 4 * j]) for j in range(3)]

    cols = [xyz(t) for t in (b"rXYZ", b"gXYZ", b"bXYZ")]
    if None in cols:
        return None
    chad = tags.get(b"chad", b"")
    inv = None
    if len(chad) >= 44 and chad[:4] == b"sf32":
        vals = [_s15(chad[8 + 4 * j:12 + 4 * j]) for j in range(9)]
        inv = _mat_inv3([vals[0:3], vals[3:6], vals[6:9]])
    out = []
    for c in cols:
        if inv:
            c = [sum(inv[r][k] * c[k] for k in range(3)) for r in range(3)]
        total = sum(c)
        if total <= 0:
            return None
        out.append((c[0] / total, c[1] / total))
    return out


def edid_primaries(raw):
    """The panel's red, green and blue primaries from EDID bytes 25-34, as CIE
    xy, or None when the EDID has none (all zero, or no EDID at all).

    Ten bits each: the high eight in bytes 27-32, the low two packed into bytes
    25 (red, green) and 26 (blue, white).
    """
    if not raw or len(raw) < 35:
        return None
    lo_rg, lo_bw, hi = raw[25], raw[26], raw[27:33]

    def c(h, lo):
        return ((h << 2) | lo) / 1024.0

    prim = [(c(hi[0], lo_rg >> 6 & 3), c(hi[1], lo_rg >> 4 & 3)),
            (c(hi[2], lo_rg >> 2 & 3), c(hi[3], lo_rg & 3)),
            (c(hi[4], lo_bw >> 6 & 3), c(hi[5], lo_bw >> 4 & 3))]
    if any(y <= 0 for _, y in prim):
        return None
    return prim


def _uv(p):
    x, y = p
    d = -2 * x + 12 * y + 3
    return (4 * x / d, 9 * y / d)


def _area(poly):
    return abs(sum(poly[i][0] * poly[i - 1][1] - poly[i - 1][0] * poly[i][1]
                   for i in range(len(poly)))) / 2.0


def _clip(subject, clipper):
    """Sutherland-Hodgman: the part of convex `subject` inside convex `clipper`."""
    def ccw(poly):
        s = sum(poly[i - 1][0] * poly[i][1] - poly[i][0] * poly[i - 1][1]
                for i in range(len(poly)))
        return poly if s > 0 else poly[::-1]

    def inside(p, a, b):
        return (b[0] - a[0]) * (p[1] - a[1]) - (b[1] - a[1]) * (p[0] - a[0]) >= 0

    def cross(p, q, a, b):
        x1, y1, x2, y2 = p[0], p[1], q[0], q[1]
        x3, y3, x4, y4 = a[0], a[1], b[0], b[1]
        den = (x1 - x2) * (y3 - y4) - (y1 - y2) * (x3 - x4)
        if abs(den) < 1e-15:
            return q
        t = ((x1 - x3) * (y3 - y4) - (y1 - y3) * (x3 - x4)) / den
        return (x1 + t * (x2 - x1), y1 + t * (y2 - y1))

    out = ccw(list(subject))
    clipper = ccw(list(clipper))
    for i in range(len(clipper)):
        a, b = clipper[i - 1], clipper[i]
        inp, out = out, []
        for j in range(len(inp)):
            p, q = inp[j - 1], inp[j]
            if inside(q, a, b):
                if not inside(p, a, b):
                    out.append(cross(p, q, a, b))
                out.append(q)
            elif inside(p, a, b):
                out.append(cross(p, q, a, b))
        if not out:
            return []
    return out


def gamut_coverage(profile, panel):
    """Share (0..1) of the profile's gamut the panel can show, or None."""
    if not profile or not panel:
        return None
    prof = [_uv(p) for p in profile]
    pan = [_uv(p) for p in panel]
    whole = _area(prof)
    if whole <= 0:
        return None
    inter = _clip(prof, pan)
    return min(1.0, _area(inter) / whole) if len(inter) >= 3 else 0.0


def edid_for(name):
    """The raw EDID for a connector, straight from DRM.

    wlr-randr and hyprctl both report make/model, but neither reports what a
    panel says about HDR, and a headless output has no EDID at all. The kernel
    exposes the bytes at /sys/class/drm/card*-<connector>/edid, empty when
    nothing is plugged in.
    """
    for path in sorted(glob.glob(os.path.join(DRM_ROOT, "card*-%s" % name, "edid"))):
        try:
            with open(path, "rb") as fh:
                raw = fh.read()
        except OSError:
            continue
        if len(raw) >= 128:
            return raw
    return None


def edid_identity(raw):
    """(manufacturer, model name, serial) out of the 128-byte base block."""
    if not raw or len(raw) < 128:
        return (None, None, None)
    packed = raw[8] << 8 | raw[9]
    mfg = "".join(chr(((packed >> s) & 0x1F) + 64) for s in (10, 5, 0))
    if not mfg.isalpha():
        mfg = None
    name = serial = None
    for off in range(54, 126, 18):
        d = raw[off:off + 18]
        if d[0:2] != b"\x00\x00":
            continue
        text = d[5:18].decode("cp437", "replace").split("\n")[0].strip()
        if d[3] == 0xFC:
            name = text or None
        elif d[3] == 0xFF:
            serial = text or None
    return (mfg, name, serial)


def edid_hdr(raw):
    """What the panel claims about HDR, from the CTA-861 extension blocks.

    HDR on Wayland needs three things to line up: a panel that advertises it, a
    compositor protocol to describe it, and a client that uses it. This answers
    only the first, and it answers it from the panel rather than from a guess —
    CTA-861 data block tag 7 is "use extended tag", and extended tag 6 is the
    HDR Static Metadata Data Block. Extended tag 5 is Colorimetry, which is what
    carries BT.2020.
    """
    out = {"edid": bool(raw), "static_metadata": False, "colorimetry": False,
           "eotf": None}
    if not raw:
        return out
    for base in range(128, len(raw), 128):
        block = raw[base:base + 128]
        if len(block) < 128 or block[0] != 0x02:
            continue
        end = block[2]
        if end <= 4 or end > 128:
            continue
        body = block[4:end]
        i = 0
        while i < len(body):
            header = body[i]
            tag, length = header >> 5, header & 0x1F
            payload = body[i + 1:i + 1 + length]
            if tag == 7 and payload:
                if payload[0] == 6:
                    out["static_metadata"] = True
                    if len(payload) > 1:
                        out["eotf"] = payload[1]
                elif payload[0] == 5:
                    out["colorimetry"] = True
            i += 1 + length
    return out


def colord_available():
    return shutil.which("colormgr") is not None and \
        run(["colormgr", "get-devices"]).returncode == 0


def _colormgr_records(args):
    """colormgr prints `Key:   value` blocks separated by blank lines."""
    res = run(["colormgr"] + args)
    if res.returncode != 0:
        return []
    records, cur = [], {}
    for line in res.stdout.splitlines():
        if not line.strip():
            if cur:
                records.append(cur)
                cur = {}
            continue
        if ":" not in line:
            continue
        key, _, value = line.partition(":")
        key = key.strip()
        value = value.strip()
        if key == "Metadata":
            cur.setdefault("Metadata", []).append(value)
        else:
            cur[key] = value
    if cur:
        records.append(cur)
    return records


def colour_profiles():
    """Every DISPLAY profile colord knows, with the one fact that matters here.

    Kind matters, and not academically. Measured on the L16: of the seven
    profiles shipped in /usr/share/color/icc/colord/, one — `x11-colors.icc` —
    is kind `named-color`, a lookup table of spot colours. It is not a monitor
    profile, there is nothing sensible to do with it on a display, and before
    this filter existed `color-assign eDP-1 "X11 Colors"` went through and the
    page would have offered it.

    Only what is OFFERED is filtered. `colour_state` reads a device's assigned
    profile back from colord directly and falls back to the record colord hands
    it, so a profile put there by something else still shows up on the page
    rather than vanishing from a list it is not in.
    """
    out = []
    for rec in _colormgr_records(["get-profiles"]):
        filename = rec.get("Filename", "")
        if not filename:
            continue
        if rec.get("Type", "") != "display-device":
            continue
        out.append({
            "id": rec.get("Profile ID", ""),
            "title": rec.get("Title", os.path.basename(filename)),
            "filename": filename,
            "kind": rec.get("Type", ""),
            # None means "could not be read", which is not the same as "no curve".
            "vcgt": icc_has_vcgt(filename),
            "primaries": icc_primaries(filename),
        })
    out.sort(key=lambda p: p["title"].lower())
    return out


def device_id(name, raw):
    """A colord device id for an output.

    EDID first, connector second. A connector name is a slot on the graphics
    card: unplug a calibrated monitor from DP-1 and plug a different one in, and
    an id keyed on the connector hands the second monitor the first one's
    profile. The EDID travels with the panel. `apex-display-` prefixed because
    nothing else on this image creates colord devices, so there is nothing to
    collide with and everything to explain.

    The prefix keeps its APEX spelling on purpose (rime-rename: keep). colord
    remembers which profile is the default for a device BY THIS ID, in its own
    database, across reboots; renaming it would drop every ICC assignment a
    user made before the rename, with nothing on screen saying so.
    """
    mfg, model, serial = edid_identity(raw)
    parts = [p for p in (mfg, model, serial) if p]
    if not parts:
        return "apex-display-" + name  # rime-rename: keep — colord's stored device id
    ident = "-".join(parts)
    ident = "".join(c if c.isalnum() or c == "-" else "-" for c in ident)
    while "--" in ident:
        ident = ident.replace("--", "-")
    return "apex-display-" + ident.strip("-")  # rime-rename: keep — colord's stored device id


def curve_verdict(which):
    """Can a calibration curve actually be loaded on this session?

    The honest answer on this image is no, and for two independent reasons that
    are worth keeping apart, because one of them is fixable by installing a
    package and the other is a protocol fact.

    1. Nothing on the image loads a vcgt. Not xcalib, not argyllcms, not
       wl-gammactl. gammastep is here, but it only computes a colour temperature
       ramp; it has no ICC input.
    2. On the wlroots compositors the gamma LUT is a single slot, and Rime's
       night light is already in it — `zwlr_gamma_control_manager_v1` replaces
       the whole ramp, it does not compose with one. So even with a loader, a
       calibration curve and a night light are the same control there and the
       second one to write wins. Hyprland is the exception: its night light is
       hyprland-ctm-control-v1, a colour matrix, which is a different slot from
       the gamma LUT, so both could be live at once.
    """
    if which == "hyprland":
        # Hyprland loads the whole profile itself through an `icc` monitor rule,
        # and with render:icc_vcgt_enabled (default on) also sends its vcgt to
        # KMS. The profiles colord ships have no vcgt, so for them the effect is
        # the colour description only — which is the part that changes colours.
        return {
            "loader": "Hyprland",
            "lut_shared_with_night_light": False,
            "reason": "Hyprland applies the assigned profile to the screen itself "
                      "(an icc monitor rule), and loads its curve when it has one",
        }
    loader = next((t for t in ("xcalib", "dispwin", "wl-gammactl")
                   if shutil.which(t)), None)
    shared = which in ("labwc", "niri", "sway", "unknown")
    return {
        "loader": loader,
        "lut_shared_with_night_light": shared,
        "reason": (
            "no ICC curve loader is installed (xcalib, argyll's dispwin and "
            "wl-gammactl are all absent), so an assigned profile's vcgt is "
            "stored and reported but not pushed into the hardware"
            if loader is None else
            "%s can load the curve" % loader
        ) + ("; and on this compositor the gamma LUT is the same slot the night "
             "light writes, so a curve and a night light cannot both be active"
             if shared else
             "; Hyprland's night light is a colour matrix (hyprland-ctm-control-v1), "
             "a different slot from the gamma LUT, so a curve could coexist with it"),
    }


def assigned_icc(names):
    """{output: ICC filename} for every output colord has a default profile
    for, keeping only files that exist. Empty when colord is not answering.

    This is what makes an assignment DO something on Hyprland: the filename
    goes into that output's `hl.monitor` rule as `icc = ...`, which Hyprland
    loads with lcms2 as the display's colour description.
    """
    if not colord_available():
        return {}
    out = {}
    for name in names:
        recs = _colormgr_records(["device-get-default-profile",
                                  device_id(name, edid_for(name))])
        f = recs[0].get("Filename", "") if recs else ""
        if f and os.path.isabs(f) and os.path.isfile(f):
            out[name] = f
    return out


def colour_state(live=None):
    """Everything the settings page needs, in one call."""
    which = compositor()
    have = colord_available()
    profiles = colour_profiles() if have else []
    by_id = {p["id"]: p for p in profiles}
    by_file = {p["filename"]: p for p in profiles}

    outs = []
    for o in (live if live is not None else outputs()):
        name = o.get("name", "")
        raw = edid_for(name)
        dev = device_id(name, raw)
        assigned = None
        if have:
            recs = _colormgr_records(["device-get-default-profile", dev])
            if recs:
                rec = recs[0]
                assigned = by_id.get(rec.get("Profile ID", "")) \
                    or by_file.get(rec.get("Filename", ""))
                if assigned is None and rec.get("Filename"):
                    assigned = {"id": rec.get("Profile ID", ""),
                                "title": rec.get("Title", ""),
                                "filename": rec["Filename"],
                                "kind": rec.get("Type", ""),
                                "vcgt": icc_has_vcgt(rec["Filename"])}
        mfg, model, serial = edid_identity(raw)
        panel = edid_primaries(raw)
        support = {}
        for p in profiles:
            cov = gamut_coverage(p.get("primaries"), panel)
            support[p["id"]] = {
                "coverage": None if cov is None else round(cov, 3),
                # Unknown is not unsupported: a panel with no chromaticities
                # (a headless output, a blank EDID) greys nothing out.
                "supported": cov is None or cov >= GAMUT_SUPPORTED,
            }
        outs.append({
            "name": name,
            "device": dev,
            "gamut": panel,
            "support": support,
            "make": mfg,
            "model": model,
            "serial": serial,
            "hdr": edid_hdr(raw),
            "profile": assigned,
        })
    return {
        "compositor": which,
        "colord": {
            "available": have,
            # A colord with no devices is the normal state on Rime and the
            # reason this verb exists; say it rather than leaving the page to
            # infer it from an empty list.
            "registered": len(_colormgr_records(["get-devices"])) if have else 0,
        },
        "profiles": profiles,
        "outputs": outs,
        "curve": curve_verdict(which),
    }


def colour_assign(name, profile, dry_run=False, model_path=None):
    """Give an output a profile, creating its colord device if need be.

    Returns (rc, notes). Every failure is named: a settings page that says
    "could not assign" and nothing else is a page the user cannot act on.
    """
    notes = []
    if not colord_available():
        return 1, ["colord is not answering; colour profiles cannot be assigned"]

    raw = edid_for(name)
    dev = device_id(name, raw)

    wanted = None
    for p in colour_profiles():
        if profile in (p["id"], p["filename"], p["title"]):
            wanted = p
            break
    if wanted is None:
        return 1, ["no colord profile matches %r; ask `color` for the list" % profile]

    if dry_run:
        return 0, ["would assign %s to %s (device %s)" % (wanted["title"], name, dev)]

    if not _colormgr_records(["find-device", dev]):
        res = run(["colormgr", "create-device", dev, "normal", "display"])
        if res.returncode != 0:
            return 1, ["colord refused to create a device for %s: %s"
                       % (name, res.stderr.strip() or res.stdout.strip())]
        mfg, model, serial = edid_identity(raw)
        for verb, value in (("device-set-vendor", mfg),
                            ("device-set-model", model),
                            ("device-set-serial", serial)):
            if value:
                run(["colormgr", verb, dev, value])
        notes.append("registered %s with colord as %s" % (name, dev))

    # add-profile is not idempotent in colord: adding one that is already on the
    # device answers "profile object path already exists". Not an error here.
    run(["colormgr", "device-add-profile", dev, wanted["id"]])
    res = run(["colormgr", "device-make-profile-default", dev, wanted["id"]])
    if res.returncode != 0:
        return 1, ["colord refused to make %s the default for %s: %s"
                   % (wanted["title"], name, res.stderr.strip() or res.stdout.strip())]

    notes.append("%s is now the profile for %s" % (wanted["title"], name))
    if wanted["vcgt"] is False:
        notes.append("this profile carries no vcgt, so there is no curve to load "
                     "even where one could be")
    cov = gamut_coverage(wanted.get("primaries"), edid_primaries(raw))
    if cov is not None and cov < GAMUT_SUPPORTED:
        notes.append("you can apply this, but your panel does not properly support "
                     "it: it can show about %d%% of %s's colours, so colours will "
                     "look duller or shifted" % (round(cov * 100), wanted["title"]))
    notes += hypr_push_icc(name, wanted["filename"], model_path or MODEL_PATH)
    return 0, notes


def hypr_push_icc(name, filename, model_path):
    """Make a colord assignment take effect on Hyprland, live and at login.

    Only Hyprland: it is the one session here that loads an ICC profile itself
    (an `icc` monitor rule, lcms2). The live call is the output's FULL rule —
    a bare `hl.monitor({ output, icc })` replaces the rule and would reset the
    mode, position and scale to defaults.
    """
    if compositor() != "hyprland":
        return ["on this session nothing applies an ICC profile to the screen; "
                "it is recorded for applications that read colord"]
    model, _ = load_model(model_path)
    live = outputs()
    entry = next((o for o in model["outputs"] if o["name"] == name), None)
    if entry is None:
        # Not in the saved layout: describe it from what is live now, and add it
        # to what is persisted so the profile survives a login too.
        entry = next((dict(o) for o in live if o.get("name") == name), None)
        if entry is None:
            return ["%s is not connected; the profile applies when it is" % name]
        entry.pop("modes", None)
        model = {"outputs": model["outputs"] + [entry]}
    icc = assigned_icc([o["name"] for o in model["outputs"]])
    icc[name] = filename
    notes = fit_to_live(model, live)
    if os.environ.get("RIME_DISPLAY_NO_LIVE"):
        notes.append("RIME_DISPLAY_NO_LIVE is set; the live screen was not changed")
    else:
        notes += apply_hypr({"outputs": [entry]}, False, icc)
    notes += persist(model, live, False, icc)[1]
    return notes


# ── self-test ───────────────────────────────────────────────────────────────
SAMPLE = {
    "outputs": [
        {"name": "eDP-1", "enabled": True, "x": 0, "y": 0, "scale": 1.5,
         "transform": "normal", "adaptive_sync": False,
         "mode": {"width": 2560, "height": 1600, "refresh": 165}},
        {"name": "DP-2", "enabled": True, "x": 2560, "y": 0, "scale": 1.0,
         "transform": "270", "adaptive_sync": True,
         "mode": {"width": 1920, "height": 1080, "refresh": 60}},
        {"name": "HDMI-A-1", "enabled": False},
    ]
}


def self_test():
    rc = 0
    srgb = [(0.64, 0.33), (0.30, 0.60), (0.15, 0.06)]
    narrow = [(0.60, 0.36), (0.35, 0.57), (0.15, 0.11)]
    adobe = [(0.64, 0.33), (0.21, 0.71), (0.15, 0.06)]
    for label, got, want in (
            ("a gamut covers itself fully", gamut_coverage(srgb, srgb), lambda c: c > 0.999),
            ("a narrow panel does not cover sRGB", gamut_coverage(srgb, narrow), lambda c: c < GAMUT_SUPPORTED),
            ("sRGB covers less of Adobe RGB than of itself",
             gamut_coverage(adobe, srgb), lambda c: 0.5 < c < 0.95),
            ("a wide panel covers sRGB", gamut_coverage(srgb, adobe), lambda c: c > 0.999),
            ("no panel primaries is unknown, not zero", gamut_coverage(srgb, None), lambda c: c is None)):
        if want(got):
            print(f"PASS  gamut: {label}")
        else:
            print(f"FAIL  gamut: {label} (got {got})")
            rc = 1
    # EDID chromaticity round trip: encode sRGB's primaries the way bytes 25-34 do.
    raw = bytearray(128)
    enc = [round(v * 1024) for pt in srgb + [(0.3127, 0.329)] for v in pt]
    raw[25] = ((enc[0] & 3) << 6) | ((enc[1] & 3) << 4) | ((enc[2] & 3) << 2) | (enc[3] & 3)
    raw[26] = ((enc[4] & 3) << 6) | ((enc[5] & 3) << 4) | ((enc[6] & 3) << 2) | (enc[7] & 3)
    for i, v in enumerate(enc):
        raw[27 + i] = v >> 2
    back = edid_primaries(bytes(raw))
    if back and all(abs(a - b) < 0.002 for pa, pb in zip(back, srgb) for a, b in zip(pa, pb)):
        print("PASS  EDID chromaticities decode to the primaries they encode")
    else:
        print(f"FAIL  EDID chromaticities decode to the primaries they encode (got {back})")
        rc = 1
    if edid_primaries(bytes(128)) is None:
        print("PASS  an EDID with no chromaticities reports none")
    else:
        print("FAIL  an EDID with no chromaticities reports none")
        rc = 1
    call = hypr_monitor_call({"name": "eDP-1"}, "/usr/share/color/icc/colord/sRGB.icc")
    if 'icc = "/usr/share/color/icc/colord/sRGB.icc"' in call and 'mode = ' in call:
        print("PASS  an assigned profile rides in the output's full monitor rule")
    else:
        print(f"FAIL  an assigned profile rides in the output's full monitor rule ({call})")
        rc = 1
    live = [{"name": o["name"]} for o in SAMPLE["outputs"]]

    k = gen_kanshi(SAMPLE, live)
    for want in ('profile rime-dp-2-edp-1-hdmi-a-1 {', 'output "eDP-1" {',
                 "mode 2560x1600@165", "position 2560,0", "transform 270",
                 "adaptive_sync on", 'output "HDMI-A-1" disable'):
        if want in k:
            print(f"PASS  kanshi emits: {want}")
        else:
            print(f"FAIL  kanshi is missing: {want}")
            rc = 1

    h = gen_hypr(SAMPLE)
    for want in ('hl.monitor({ output = "", mode = "preferred", position = "auto", scale = 1.0 })',
                 'hl.monitor({ output = "eDP-1", mode = "2560x1600@165", position = "0x0", scale = 1.5 })',
                 'hl.monitor({ output = "DP-2", mode = "1920x1080@60", position = "2560x0", '
                 "scale = 1.0, transform = 3, vrr = 1 })",
                 'hl.monitor({ output = "HDMI-A-1", disabled = true })'):
        if want in h:
            print(f"PASS  hyprland emits: {want}")
        else:
            print(f"FAIL  hyprland is missing: {want}")
            rc = 1

    # The catch-all has to come before any named output, because later rules win
    # and a fallback that lands last would override every saved layout.
    first = h.find("hl.monitor({")
    named = h.find('hl.monitor({ output = "eDP-1"')
    if -1 < first < named:
        print("PASS  the catch-all monitor rule is emitted first")
    else:
        print("FAIL  the catch-all monitor rule is not emitted first")
        rc = 1

    if "monitor=" in h:
        print("FAIL  hyprland output still carries hyprlang monitor= lines")
        rc = 1
    else:
        print("PASS  no hyprlang left in the Hyprland output")

    valid = validate_hyprland(h)
    if valid is None:
        print("SKIP  Hyprland not installed; cannot validate its output")
    elif valid:
        print("PASS  Hyprland accepts the generated monitor module")
    else:
        print("FAIL  Hyprland rejects the generated monitor module")
        rc = 1

    a = wlr_args(SAMPLE)
    joined = " ".join(a)
    for want in ("--output eDP-1 --on --mode 2560x1600@165Hz --pos 0,0 --scale 1.5",
                 "--transform 270", "--adaptive-sync enabled",
                 "--output HDMI-A-1 --off"):
        if want in joined:
            print(f"PASS  wlr-randr args include: {want}")
        else:
            print(f"FAIL  wlr-randr args missing: {want}")
            rc = 1

    # One invocation for the whole layout, so no intermediate state is visible.
    if joined.count("--output") == 3 and a[0] == "--output":
        print("PASS  the whole layout is one wlr-randr invocation")
    else:
        print("FAIL  the layout is not a single wlr-randr invocation")
        rc = 1
    rc |= self_test_hardening()
    return rc


def _model_from(text):
    """load_model on a JSON text, through a real file like the CLI reads."""
    with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as fh:
        fh.write(text)
    try:
        return load_model(fh.name)
    finally:
        os.unlink(fh.name)


def self_test_hardening():
    """The Lua-only / validated-model contract. Each case names what it guards."""
    rc = 0

    def check(label, ok, got=None):
        nonlocal rc
        if ok:
            print(f"PASS  {label}")
        else:
            print(f"FAIL  {label}" + (f" (got {got!r})" if got is not None else ""))
            rc = 1

    # lua_str: quote, backslash, newline, ]], DEL, a digit right after an escape.
    nasty = 'a"b\\c\nd]]e\x7f1'
    want = '"a\\"b\\\\c\\010d]]e\\1271"'
    check("lua_str escapes quote, backslash, newline and DEL as \\ddd",
          lua_str(nasty) == want, lua_str(nasty))
    check("lua_str leaves no raw control character",
          not any(ord(c) < 0x20 or ord(c) == 0x7f for c in lua_str("x\r\n\t\x00\x1b")))
    # The escaped literal must survive Hyprland's own Lua parser: a module whose
    # comment and string carry a newline-injection attempt still loads clean.
    inj = 'DP-1"})\nhl.exec_cmd("touch /tmp/pwned")\n--]]'
    mod = gen_hypr({"outputs": [{"name": inj, "enabled": True, "scale": 1.0}]})
    check("an injected name stays one string literal", mod.count("\n") ==
          gen_hypr({"outputs": [{"name": "DP-1", "enabled": True, "scale": 1.0}]}).count("\n")
          and "hl.exec_cmd" not in mod.replace(lua_str(inj), ""))
    valid = validate_hyprland(mod)
    if valid is None:
        print("SKIP  Hyprland not installed; cannot parse the injection module")
    else:
        check("Hyprland parses the injection module as data, not code", valid)

    # The model: names, bools, NaN/Infinity, positions, modes.
    m, notes = _model_from('{"outputs": [{"name": "A\\nB"}, {"name": "q\\"x"}, '
                           '{"name": "DP-1"}]}')
    check("output names with a control character or quote are refused",
          [o["name"] for o in m["outputs"]] == ["DP-1"] and len(notes) == 2, notes)
    m, notes = _model_from('{"outputs": [{"name": "DP-1", "scale": true, "x": true, '
                           '"y": 0, "enabled": "false"}]}')
    o = m["outputs"][0]
    check("a bool is not a number: scale true is refused", o["scale"] == 1.0
          and any("scale" in n for n in notes), notes)
    check("a bool is not a coordinate: x true places the output automatically",
          "x" not in o and "y" not in o and 'position = "auto"' in hypr_monitor_call(o))
    check("enabled must be a bool, not the string \"false\"", o["enabled"] is True
          and any("enabled" in n for n in notes), notes)
    m, notes = _model_from('{"outputs": [{"name": "DP-1", "scale": NaN}]}')
    check("NaN anywhere refuses the whole model", m["outputs"] == [] and notes, notes)
    m, notes = _model_from('{"outputs": [{"name": "DP-1", "x": Infinity, "y": 0}]}')
    check("Infinity anywhere refuses the whole model", m["outputs"] == [] and notes, notes)
    m, notes = _model_from('{"outputs": [{"name": "DP-1", "scale": 1e400, "x": 0, '
                           '"y": 1e400}]}')
    o = m["outputs"][0]
    check("1e400 (inf after parsing) is refused as scale and coordinate",
          o["scale"] == 1.0 and "y" not in o and len(notes) == 2, notes)
    for bad in ('"10"', "1.5", "99999", "-40000"):
        m, notes = _model_from('{"outputs": [{"name": "DP-1", "x": %s, "y": 0}]}' % bad)
        check(f"x = {bad} is not a usable coordinate", "x" not in m["outputs"][0]
              and notes, notes)
    m, notes = _model_from('{"outputs": [{"name": "DP-1", "x": -1920, "y": 0}]}')
    check("a negative coordinate in range is kept", m["outputs"][0].get("x") == -1920
          and not notes, notes)
    m, notes = _model_from('{"outputs": [{"name": "DP-1", '
                           '"mode": "1920x1080@60\\", x = 1"}]}')
    check("a mode string that is not WIDTHxHEIGHT[@HZ] is refused",
          "mode" not in m["outputs"][0] and notes, notes)
    m, notes = _model_from('{"outputs": [{"name": "DP-1", "mode": {"width": 1920, '
                           '"height": true, "refresh": 60}}]}')
    check("a bool mode height is refused", "mode" not in m["outputs"][0] and notes, notes)

    # The live check: a mode the display does not list is never applied.
    live = [{"name": "DP-1", "width": 1920, "height": 1080, "scale": 1.0,
             "modes": [{"width": 1920, "height": 1080, "refresh": 60.0,
                        "preferred": False, "current": True},
                       {"width": 1280, "height": 720, "refresh": 60.0,
                        "preferred": False, "current": False}]}]
    model = {"outputs": [{"name": "DP-1", "enabled": True, "scale": 1.0,
                          "mode": {"width": 1234, "height": 567, "refresh": 60}}]}
    notes = fit_to_live(model, live)
    check("an unknown mode falls back to the current mode, with a note",
          mode_string(model["outputs"][0]) == "1920x1080@60Hz" and len(notes) == 1, notes)
    model = {"outputs": [{"name": "DP-1", "enabled": True, "scale": 1.0,
                          "mode": {"width": 1920, "height": 1080, "refresh": 59.94}}]}
    check("a listed mode within 1 Hz is accepted silently",
          fit_to_live(model, live) == [] and model["outputs"][0]["mode"]["refresh"] == 59.94)
    model = {"outputs": [{"name": "HDMI-A-9", "enabled": True, "scale": 1.0,
                          "mode": {"width": 1234, "height": 567, "refresh": 60}}]}
    check("an output that is not connected is left as saved",
          fit_to_live(model, live) == [] and model["outputs"][0]["mode"]["width"] == 1234)

    # Scale: Hyprland's own snap, replicated (Monitor.cpp:939-985).
    for w, h, asked, want_scale, kind in (
            (1920, 1080, 1.5, 1.5, "clean"),
            (2560, 1600, 1.6, 1.6, "silent"),
            (1920, 1080, 1.249, 1.25, "silent"),
            (1920, 1080, 1.1, 1.2, "suggested"),
            (1280, 800, 1.1, 128 / 120, "suggested"),
            (1366, 768, 1.3, 1.0, "suggested"),
            (1367, 769, 2.0, None, "none")):
        got = hypr_scale(w, h, asked)
        check(f"hypr_scale {w}x{h} @ {asked} -> {want_scale} ({kind})",
              got == (want_scale if kind != "clean" else asked, kind), got)
        if got[0] is not None:
            again = hypr_scale(w, h, got[0])
            check(f"the snapped {w}x{h} scale {got[0]:.4f} raises no notification",
                  again[1] in ("clean", "silent") and abs(again[0] - got[0]) < 1e-9, again)
    model = {"outputs": [{"name": "DP-1", "enabled": True, "scale": 1.1,
                          "mode": {"width": 1920, "height": 1080, "refresh": 60}}]}
    notes = fit_to_live(model, live)
    check("an unclean scale is snapped to Hyprland's choice, with a note",
          model["outputs"][0]["scale"] == 1.2 and len(notes) == 1 and "1.2" in notes[0], notes)
    model = {"outputs": [{"name": "DP-1", "enabled": True, "scale": 1.1}]}
    fit_to_live(model, live)
    check("with no mode in the model the current mode decides the snap",
          model["outputs"][0]["scale"] == 1.2, model)

    # apply_hypr: eval only, and a refusal is reported, never a fallback.
    global run
    real_run = run
    calls = []
    try:
        for reply, expect_notes in (("ok\n", 0), ("[string]:1: attempt to call nil", 1)):
            calls.clear()

            def fake(cmd, _reply=reply, **_kw):
                calls.append(list(cmd))

                class R:
                    returncode = 0
                    stdout = _reply
                    stderr = ""
                return R()
            run = fake
            notes = apply_hypr(SAMPLE, False)
            check(f"apply_hypr reply {reply.strip()[:20]!r}: "
                  f"{'applied' if not expect_notes else 'reported as refused'}",
                  len(notes) == expect_notes * len(SAMPLE["outputs"]), notes)
            check("apply_hypr never runs `hyprctl keyword`",
                  calls and all(c[:2] == ["hyprctl", "eval"] for c in calls), calls)
    finally:
        run = real_run
    return rc


def main(argv=None):
    ap = argparse.ArgumentParser(description="Apply and persist Rime display settings.")
    ap.add_argument("action", nargs="?", default="list",
                    choices=("list", "apply", "save", "compositor",
                             "color", "color-assign"))
    ap.add_argument("rest", nargs="*", help="OUTPUT PROFILE, for color-assign")
    ap.add_argument("--model", default=MODEL_PATH)
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--no-persist", action="store_true",
                    help="apply live without writing kanshi/Hyprland persistence; "
                         "for a layout the user has not confirmed yet")
    ap.add_argument("--self-test", action="store_true")
    args = ap.parse_args(argv)

    if args.self_test:
        return self_test()

    # `save` IS the persistence verb, so `save --no-persist` asks for nothing at
    # all. Silently doing nothing would look exactly like a successful save to
    # the caller that just promoted a model, so it is refused by name.
    if args.no_persist and args.action != "apply":
        print(f"rime-display: --no-persist applies to `apply`, not `{args.action}`",
              file=sys.stderr)
        return 2

    if args.action == "compositor":
        print(compositor())
        return 0

    if args.action == "list":
        print(json.dumps(outputs(), indent=2))
        return 0

    # Colour is read and written through colord, which is a different store from
    # the layout model, so it is a different verb rather than a field the layout
    # apply would have to carry. A calibration outlives a layout.
    if args.action == "color":
        # Enumeration first, the saved model second. A session that cannot be
        # enumerated — Hyprland before P0-025, a compositor that is not up yet —
        # still has a colour page worth showing, and the names in the model are
        # the names colord devices are keyed on.
        live = outputs()
        if not live:
            saved, _ = load_model(args.model)
            live = [{"name": o["name"]} for o in saved["outputs"]]
        print(json.dumps(colour_state(live), indent=2))
        return 0

    if args.action == "color-assign":
        if len(args.rest) != 2:
            print("rime-display: color-assign takes OUTPUT and PROFILE",
                  file=sys.stderr)
            return 2
        rc, notes = colour_assign(args.rest[0], args.rest[1], args.dry_run,
                                  args.model)
        for n in notes:
            print(f"rime-display: {n}", file=sys.stderr)
        return rc

    model, notes = load_model(args.model)
    for n in notes:
        print(f"rime-display: {n}", file=sys.stderr)
    if not model["outputs"]:
        print("rime-display: no outputs in the model; nothing to do", file=sys.stderr)
        return 0

    live = outputs()
    which = compositor()
    icc = assigned_icc([o["name"] for o in model["outputs"]])
    # Checked against what is connected now, before anything is applied or
    # written: the live call, kanshi and monitors.lua all get the same answer.
    for n in fit_to_live(model, live):
        print(f"rime-display: {n}", file=sys.stderr)

    if args.action == "apply":
        # RIME_DISPLAY_NO_LIVE is a hard refusal, not a hint. `apply` reaches the
        # RUNNING compositor through hyprctl or wlr-randr, and neither of those
        # cares what HOME is set to — so a test that isolates HOME still
        # reconfigures the real desktop. That happened: a test fixture of
        # 2560x1600@165 scale 1.5 was pushed onto a live session whose panel is
        # 1920x1200. Persisting is safe and lives under `save`; only `apply`
        # touches hardware, and now it can be forbidden outright.
        if os.environ.get("RIME_DISPLAY_NO_LIVE"):
            print("rime-display: RIME_DISPLAY_NO_LIVE is set; refusing to touch the "
                  "live compositor (use `save` to write persistence only)",
                  file=sys.stderr)
            return 2
        problems = apply_hypr(model, args.dry_run, icc) if which == "hyprland" \
            else apply_wlr(model, args.dry_run)
        for p in problems:
            print(f"rime-display: {p}", file=sys.stderr)
        if problems and not args.dry_run:
            return 1

    # Persist on both apply and save: a layout that is applied but not persisted
    # is a layout the user has to set again after every logout. The one exception
    # is an apply the user has not confirmed yet — see --no-persist above.
    if args.no_persist:
        print("rime-display: --no-persist; the live layout changed and nothing "
              "was written", file=sys.stderr)
        return 0
    ok, pnotes = persist(model, live, args.dry_run, icc)
    for n in pnotes:
        print(f"rime-display: {n}", file=sys.stderr)
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
