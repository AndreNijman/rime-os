#!/usr/bin/env bash
#
# Rime OS — end the graphical session.
#
# Same reasoning as rime-compositor-reload: the exit verb differs per
# compositor, so the Rime context menu asks for "logout" and this resolves it.
#
# systemd's loginctl is tried FIRST and is the right answer wherever the session
# is registered with logind: it tears the session down properly, so user units
# stop and the greeter comes back. Killing the compositor directly leaves that
# to chance, so it is the fallback rather than the default.

set -uo pipefail

if command -v loginctl >/dev/null 2>&1 && [ -n "${XDG_SESSION_ID:-}" ]; then
    loginctl terminate-session "${XDG_SESSION_ID}" && exit 0
fi

desktop="$(printf '%s' "${XDG_CURRENT_DESKTOP:-}" | tr '[:upper:]' '[:lower:]')"
case "$desktop" in
    *labwc*)    exec labwc --exit ;;
    # Under Lua, `hyprctl dispatch X` is `return hl.dispatch(X)` (Hyprland 0.57
    # src/ipc/s1/Commands.cpp): the hyprlang word `exit` is refused.
    *hyprland*) exec hyprctl dispatch 'hl.dsp.exit()' ;;
    *niri*)     exec niri msg action quit --skip-confirmation ;;
esac

# The signature before the process name: NixOS's wrapped Hyprland is
# ".Hyprland-wrapp" to `pgrep -x` (see rime-compositor-reload).
if   [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then exec hyprctl dispatch 'hl.dsp.exit()'
elif pgrep -u "$(id -u)" -x labwc    >/dev/null 2>&1; then exec labwc --exit
elif pgrep -u "$(id -u)" -x Hyprland >/dev/null 2>&1 \
  || pgrep -u "$(id -u)" -x .Hyprland-wrapp >/dev/null 2>&1; then exec hyprctl dispatch 'hl.dsp.exit()'
elif pgrep -u "$(id -u)" -x niri     >/dev/null 2>&1; then exec niri msg action quit --skip-confirmation
fi

echo "rime: could not determine how to end this session" >&2
exit 1
