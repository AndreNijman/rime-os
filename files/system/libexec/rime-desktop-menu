#!/usr/bin/env bash
#
# Rime OS — desktop right-click handler.
#
# Bound to a right-click on the desktop root in every compositor's config. Opens
# the Rime QML context menu, which replaces the compositor's own root menu.
#
# WHY A HELPER AND NOT A DIRECT `rime shell` CALL
# The compositor cannot express "open the Rime menu, or the built-in one if the
# shell is down" — labwc mousebinds are a fixed action, not a conditional. So the
# decision lives here, where it can actually be made:
#
#   shell reachable        -> Rime menu
#   shell not reachable    -> try to restart it once, then retry
#   still not reachable    -> tell the user how to get the fallback menu
#
# The restart attempt is the useful part. The single most likely reason the
# desktop has no menu is that the shell died, and right-clicking the desktop is
# exactly what somebody does when they notice.
#
# The emergency path remains `menu.xml`, reachable with SUPER+right-click on
# labwc — see the Root mousebind comment in rc.xml.

set -uo pipefail

readonly AUTOSTART=${RIME_SHELL_AUTOSTART:-/usr/libexec/rime-shell-autostart}
readonly LOG_TAG=rime-desktop-menu

log() { command -v systemd-cat >/dev/null 2>&1 && printf '%s\n' "$*" | systemd-cat -t "$LOG_TAG" -p info || true; }

# Ask the shell to open the menu. `rime shell` wraps the Quickshell IPC call and
# returns non-zero when the shell is not answering.
open_menu() {
    rime shell ipc context-menu open >/dev/null 2>&1
}

if open_menu; then
    exit 0
fi

log "Rime Shell did not answer; attempting a restart before giving up"

if [ -x "$AUTOSTART" ]; then
    # Idempotent by design: it refuses to start a second instance, so calling it
    # when the shell is actually alive is harmless. It execs quickshell and so
    # returns only when the Shell exits: start it detached, or the poll below
    # would never run while the restarted Shell lives.
    if ! setsid -f "$AUTOSTART" </dev/null >/dev/null 2>&1; then
        log "could not start $AUTOSTART"
    fi

    # The shell needs a moment to claim its IPC socket. Poll (up to 10 s) rather
    # than sleeping a fixed amount, so the common case stays fast.
    for _ in $(seq 40); do
        sleep 0.25
        if open_menu; then
            log "Rime Shell restarted and the menu opened"
            exit 0
        fi
    done
fi

# Out of options. Say so somewhere the user can see rather than failing mutely.
log "Rime Shell is not running; use the compositor fallback menu"
if command -v notify-send >/dev/null 2>&1; then
    notify-send -u critical "Rime Shell is not running" \
        "The desktop menu is unavailable. Super+right-click gives the fallback menu." \
        >/dev/null 2>&1 || true
fi
exit 1
