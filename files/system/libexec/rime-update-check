#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  rime-update-check — find out, cheaply, whether a newer Rime OS is published.
#
#  Runs as root from rime-update-check.timer because `bootc upgrade --check`
#  needs root to open the image store. It fetches ONE registry manifest and
#  pulls no layers, so a check is a few KB of network and a few milliseconds of
#  CPU; the unit runs at idle CPU and idle I/O priority on top of that.
#
#  It writes the answer to /run/rime-update/state (world-readable, wiped every
#  boot so it can never describe a previous boot's image):
#
#      state=available|none
#      digest=sha256:…          (the published image; empty when unknown)
#      release=2026.11.04.4     (that image's release ID; empty when unknown)
#      running=2026.11.03       (the release this machine booted; empty: "dev")
#
#  release= and running= are the keys the NixOS checker writes (rimed/rime/src/
#  nixos/update.rs), so Rime Shell builds the same "What's in this update" link
#  (rimeos.com/updates/<release>?from=<running>) on both. Readers that predate
#  them ignore unknown keys. The release ID is the image's
#  org.rimeos.release.id label (Containerfile.rime), read without a second
#  registry request where it can be: `bootc upgrade --check` already fetched
#  the image config and ostree keeps it with the booted image's ref
#  (ostree-ext.cached.*). Only where that cache is not there (another bootc
#  backend, an older bootc) is the config fetched again, once per new digest,
#  by that digest, so the label is the published image's and nothing else's.
#  It is display data: a value that is not a release ID is written as empty.
#
#  The user-side half (rime-update-notice) is woken by a systemd .path unit
#  when this file changes — nothing polls — and says it once per digest.
#
#  ── What it will not do ─────────────────────────────────────────────────────
#  * It never downloads or stages an update. That is `sudo rime update`.
#  * It never reports "available" on a guess. An unreachable registry, a bootc
#    failure or output it does not recognise leaves the previous answer alone.
#  * It reports "none" while an update is already staged: the user has done
#    their part and needs a reboot, not a reminder to update.
# ─────────────────────────────────────────────────────────────────────────────
set -uo pipefail

BOOTC="${RIME_BOOTC_BIN:-/usr/bin/bootc}"
OSTREE="${RIME_OSTREE_BIN:-/usr/bin/ostree}"
OSTREE_REPO="${RIME_OSTREE_REPO:-/ostree/repo}"
SKOPEO="${RIME_SKOPEO_BIN:-/usr/bin/skopeo}"
RELEASE_JSON="${RIME_RELEASE_JSON:-/usr/share/rime/release.json}"
DIR="${RIME_UPDATE_DIR:-/run/rime-update}"
STATE="$DIR/state"
# files/scripts/stamp-release's rule: YYYY.MM.DD, or YYYY.MM.DD.N with N >= 2.
RELEASE_RE='^[0-9]{4}\.[0-9]{2}\.[0-9]{2}(\.([2-9]|[1-9][0-9]+))?$'

log() { printf 'rime-update-check: %s\n' "$*" >&2; }

[[ -x "$BOOTC" ]] || { log "no bootc at $BOOTC"; exit 0; }

# A release ID, or nothing: whatever else a file or a label says is dropped.
release_id() {
    [[ "${1:-}" =~ $RELEASE_RE ]] && printf '%s' "$1"
    return 0
}

# The release this machine booted: the image's own release.json (a "dev" build
# has none worth naming).
running_release() {
    [[ -r "$RELEASE_JSON" ]] || return 0
    release_id "$(python3 -I -c 'import json, sys
try:
    d = json.load(open(sys.argv[1]))
    print(d.get("id", "") if isinstance(d, dict) else "")
except Exception:
    pass' "$RELEASE_JSON" 2>/dev/null)"
}

# org.rimeos.release.id from an image config, given as JSON on stdin, or as the
# GVariant string `ostree show --print-detached-metadata-key` prints around it.
label_from_config() {
    python3 -I -c 'import ast, json, sys
t = sys.stdin.read().strip()
try:
    if t[:1] in ("\x27", "\x22"):
        t = ast.literal_eval(t)
    d = json.loads(t)
    labels = (d.get("config") or {}).get("Labels") or d.get("Labels") or {}
    v = labels.get("org.rimeos.release.id", "")
    print(v if isinstance(v, str) else "")
except Exception:
    pass' 2>/dev/null
}

# The release ID of the image `bootc upgrade --check` just found, by its digest.
#   1. ostree's cache: the check stored the image's manifest digest and config
#      on the booted image's ref. Used only when that digest is this one.
#   2. Otherwise the config itself, fetched by digest (a few KB, no layers).
# $1 digest, $2 the image reference from the check ("docker://host/repo:tag").
available_release() {
    local digest="$1" ref="$2" r md
    if [[ -x "$OSTREE" && -d "$OSTREE_REPO" ]]; then
        while IFS= read -r r; do
            [[ -n "$r" ]] || continue
            md="$("$OSTREE" --repo="$OSTREE_REPO" show \
                    --print-detached-metadata-key=ostree-ext.cached.manifest-digest \
                    "ostree/container/image/$r" 2>/dev/null)" || continue
            [[ "$md" == "'$digest'" ]] || continue
            release_id "$("$OSTREE" --repo="$OSTREE_REPO" show \
                    --print-detached-metadata-key=ostree-ext.cached.config \
                    "ostree/container/image/$r" 2>/dev/null | label_from_config)"
            return 0
        done < <("$OSTREE" --repo="$OSTREE_REPO" refs ostree/container/image 2>/dev/null)
    fi
    # By digest, so the label is this image's: the repository without its tag.
    [[ "$ref" == docker://* && -x "$SKOPEO" ]] || return 0
    local repo="${ref#docker://}" last
    repo="${repo%%@*}"
    last="${repo##*/}"
    [[ "$last" == *:* ]] && repo="${repo%/*}/${last%%:*}"
    [[ "$repo" == */* ]] || return 0
    local auth=()
    [[ -r /etc/ostree/auth.json ]] && auth=(--authfile /etc/ostree/auth.json)
    [[ -r /run/ostree/auth.json ]] && auth=(--authfile /run/ostree/auth.json)
    release_id "$("$SKOPEO" inspect --no-tags --retry-times 1 --command-timeout 30s "${auth[@]}" \
            --config "docker://$repo@$digest" 2>/dev/null | label_from_config)"
}

write_state() {
    local body
    body="$(printf 'state=%s\ndigest=%s\nrelease=%s\nrunning=%s\n' \
        "$1" "${2:-}" "${3:-}" "$(running_release)")"
    mkdir -p "$DIR"
    # Rewrite only on a change: the notice unit wakes on every write.
    if [[ -f "$STATE" && "$(cat "$STATE")" == "$body" ]]; then
        return 0
    fi
    # In place, not rename: the path unit fires on close-after-write.
    printf '%s\n' "$body" > "$STATE"
    chmod 0644 "$STATE"
}

# The move to Rime OS on NixOS. Once `rime migrate start` has run, this machine
# takes no more bootc updates (`rime update` refuses them by name), so it must
# not be told one is waiting: say "none" and never ask the registry. The start
# also masks this timer; this is the same answer for a machine where something
# unmasked it. Allowed again only after a start that rolled itself back: the
# table in rimed/rime/src/nixos_bridge.rs, which this predicate matches.
BRIDGE_STATE="${RIME_BRIDGE_STATE:-/var/lib/rime/nixos-bridge/state.json}"
if [[ -e "$BRIDGE_STATE" ]]; then
    if ! python3 -I -c '
import json, sys
try:
    s = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(1)
steps = s.get("steps") if isinstance(s, dict) else None
rolled_back = (isinstance(steps, list) and steps and steps[-1] == "rolled back"
               and "failed" in s and s.get("done") is None)
sys.exit(0 if rolled_back else 1)
' "$BRIDGE_STATE" 2>/dev/null; then
        log "REFUSED [nixos-migration-started] this machine has started its move to Rime OS on NixOS ($BRIDGE_STATE); no bootc update is checked"
        write_state none
        exit 0
    fi
fi

status="$("$BOOTC" status --format=json 2>/dev/null)" || status=""
if printf '%s' "$status" | grep -Eq '"staged"[[:space:]]*:[[:space:]]*\{'; then
    write_state none
    exit 0
fi

out="$("$BOOTC" upgrade --check 2>&1)" || { log "bootc upgrade --check failed; keeping the last answer"; exit 0; }

if printf '%s\n' "$out" | grep '^No changes in:' >/dev/null; then
    write_state none
elif printf '%s\n' "$out" | grep '^Update available for:' >/dev/null; then
    digest="$(printf '%s\n' "$out" | sed -n 's/^[[:space:]]*Digest:[[:space:]]*\(sha256:[0-9a-f]\{64\}\).*/\1/p' | head -n1)"
    # bootc builds that omit the digest line: fall back to the text's own hash
    # so a later, different update still counts as new.
    [[ -n "$digest" ]] || digest="text:$(printf '%s' "$out" | sha256sum | cut -d' ' -f1)"
    # Its release ID, looked up once per digest: an answer already written
    # for this digest is kept rather than asked for again every six hours.
    release=""
    if [[ -f "$STATE" ]] && grep -Fx "digest=$digest" "$STATE" >/dev/null; then
        release="$(release_id "$(sed -n 's/^release=//p' "$STATE" | head -n1)")"
    fi
    if [[ -z "$release" && "$digest" == sha256:* ]]; then
        imgref="$(printf '%s\n' "$out" | sed -n 's/^Update available for:[[:space:]]*\([^[:space:]]*\).*/\1/p' | head -n1)"
        release="$(available_release "$digest" "$imgref")"
    fi
    write_state available "$digest" "$release"
else
    log "unrecognised bootc output; keeping the last answer"
fi
exit 0
