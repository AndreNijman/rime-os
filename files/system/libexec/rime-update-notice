#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  rime-update-notice — tell the user, once per release, that a Rime update is
#  available and what to run.
#
#  A USER unit (notify-send needs the session bus). It does no work of its own:
#  rime-update-check (root) decides, this only reads /run/rime-update/state. It
#  runs when that file changes (rime-update-notice.path, inotify, no polling)
#  and once at login, and exits in milliseconds.
#
#  Once per digest: a notification that repeats at every login gets muted. A
#  newer release after the user ignored one is a new digest and is announced.
#
#  It also says, once per transaction, what the last live update did
#  (/run/rime-live/status.json, written by `rime update`): applied, undone,
#  or failed. Deferred and planned transactions are not announced: the
#  terminal that ran `rime update` already said so.
# ─────────────────────────────────────────────────────────────────────────────
set -uo pipefail

STATE="${RIME_UPDATE_STATE:-/run/rime-update/state}"
SEEN_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/rime"
SEEN="$SEEN_DIR/update-notice.seen"
LIVE="${RIME_LIVE_STATUS:-/run/rime-live/status.json}"
LIVE_SEEN="$SEEN_DIR/live-notice.seen"

log() { printf 'rime-update-notice: %s\n' "$*" >&2; }

notify() {
    if command -v notify-send >/dev/null 2>&1; then
        notify-send --app-name='Rime OS' --urgency=normal --icon=system-software-update "$1" "$2" \
            || { log "notify-send failed"; return 1; }
    else
        log "no notify-send; printing instead"
    fi
    printf '%s. %s\n' "$1" "$2"
}

available() {
    [[ -r "$STATE" ]] || return 0
    local state="" digest="" k v
    while IFS='=' read -r k v; do
        case "$k" in
            state)  state="$v" ;;
            digest) digest="$v" ;;
        esac
    done < "$STATE"
    # Partial write or nothing to say: the next change wakes us again.
    [[ "$state" == "available" && -n "$digest" ]] || return 0
    [[ -f "$SEEN" && "$(cat "$SEEN")" == "$digest" ]] && return 0
    notify "A new Rime update is available" "Run: sudo rime update" || return 0
    mkdir -p "$SEEN_DIR"
    printf '%s\n' "$digest" > "$SEEN"
}

# What the last live update did, once per transaction, in the engine's own
# words (status.json "summary"; the engine writes it from measured state).
# Only finished transactions are announced: a plan or one in progress is not.
live() {
    [[ -r "$LIVE" ]] || return 0
    local line txn state summary
    line="$(python3 -I -c 'import json,sys
try:
    d=json.load(open(sys.argv[1]))
except Exception:
    sys.exit(0)
if d.get("schema")!=1: sys.exit(0)
s=str(d.get("summary","")).replace("\t"," ").replace("\n"," ")
n=sum(1 for c in d.get("components") or [] if c.get("state") in ("active","active-at-next-use"))
print("%s\t%s\t%d\t%s" % (d.get("txn",""), d.get("state",""), n, s))' "$LIVE" 2>/dev/null)"
    IFS=$'\t' read -r txn state n summary <<< "$line"
    [[ -n "$txn" ]] || return 0
    case "$state" in
        # "active" with nothing activated (every change waits for a restart)
        # is not news: the terminal said so.
        active) [[ "${n:-0}" -gt 0 ]] || return 0; title="Rime update applied" ;;
        rolled-back) title="A Rime update was undone" ;;
        failed) title="A Rime update needs attention" ;;
        *) return 0 ;;
    esac
    [[ -f "$LIVE_SEEN" && "$(cat "$LIVE_SEEN")" == "$txn" ]] && return 0
    notify "$title" "${summary:-Run: rime live status}" || return 0
    mkdir -p "$SEEN_DIR"
    printf '%s\n' "$txn" > "$LIVE_SEEN"
}

available
live
exit 0
