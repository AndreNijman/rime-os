#!/usr/bin/env python3
"""Generate labwc keybinds from Rime Shell's keybind model (roadmap §17).

§17 asks Rime to "generate compositor config from one Rime settings model".
Three of the four artefacts already did: the shell writes Hyprland `.conf` and
`.lua` and niri `.kdl` every time a shortcut changes. labwc did not, because it
has no IPC to push bindings over and no include mechanism to append a generated
file to — so its bindings were maintained by hand in rc.xml.

That left a real bug, not just an inconsistency. On labwc the Keybinds page is
fully interactive: you can rebind the launcher, the UI confirms it, three files
are written, and **nothing reaches the compositor**. The setting silently does
not work, which is worse than a setting that says it cannot.

    rime-labwc-keybinds apply     generate and splice into rc.xml, then reload
    rime-labwc-keybinds print     print the block that would be spliced in
    rime-labwc-keybinds check     verify an rc.xml matches what defaults generate

`check` is what the image build runs, and it replaces the old hand-comparison in
`files/scripts/check-labwc-keybinds`: instead of asserting that two hand-written
lists agree, it asserts the shipped rc.xml is exactly what this generator
produces from the shell's defaults. One source of truth, and the seeded config
cannot drift from it by construction.

WHY A SPAN REPLACEMENT AND NOT AN ElementTree ROUND-TRIP

Same reasons rime-input-apply gives, learned the same way: ElementTree discards
comments unless told otherwise and cannot represent one outside the root
element, and rc.xml opens with a forty-line header explaining every decision in
it. A round-trip also reindents regions nobody touched, so changing one shortcut
produces a whole-file diff. The tree is used only to VALIDATE — before, to
refuse an unparseable file, and after, to refuse a bad result.

WHAT DOES NOT TRANSLATE

labwc is a floating compositor and has no equivalent for some of Hyprland's
tiling dispatchers. Those bindings are skipped and reported rather than mapped
to something approximate:

    pseudo, layoutmsg togglesplit   no concept in a floating WM

A wart reproduced deliberately: the seeded rc.xml maps `movefocus` (the shell
labels it "Focus Left") to labwc's MoveToEdge, which MOVES THE WINDOW rather
than moving focus — labwc has no directional-focus action. This generator
reproduces that mapping so switching to generated output changes no behaviour.
It is wrong and it is recorded as wrong; fixing it is a UX decision about what
SUPER+Left should do on a floating desktop, not a detail of this generator.

WHY EVERY ARROW BINDING ALSO WARPS THE CURSOR

Both arrow mappings move a window, and the session sets
<followMouse>yes</followMouse>. Move a window out from under a stationary
pointer and labwc hands focus to whatever the move uncovered — the window you
just moved loses focus without you touching anything, which is the labwc
spelling of the Hyprland complaint this generator's sibling change fixes.

`<action name="WarpCursor" to="window"/>` carries the pointer to the middle of
the active window, so it arrives with the window instead of being left behind.
It is a second <action> inside the same <keybind>: labwc runs a keybind's
actions in order, and WarpCursor acts on whatever is active when it runs.

The pair is generated rather than hand-written in rc.xml because these bindings
live inside the generated span — `check` compares the shipped file against this
function's output, so a WarpCursor added only to rc.xml would fail the build.
"""

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import xml.etree.ElementTree as ET

HOME = os.path.expanduser("~")

# The shell ROOT — the directory holding shell.qml, which is what
# Quickshell.shellDir resolves to and therefore what the model means by
# root._shellDir when it builds the screenshot commands.
SHELL_DIR = os.path.join(HOME, ".config/rime-shell")
RC_XML = os.path.join(HOME, ".config/labwc/rc.xml")
OVERRIDES = os.path.join(HOME, ".config/rime-shell/src/user_data/keybinds.json")

KEYBIND_SERVICE = "src/services/config_tab/KeybindService.qml"

BEGIN = "<!-- RIME-KEYBINDS-BEGIN — generated by rime-labwc-keybinds. Do not edit. -->"
END = "<!-- RIME-KEYBINDS-END -->"
# The region an APEX image generated, in every rc.xml upgraded from one.
# Recognised so `apply` REPLACES it (with the markers above) rather than
# inserting a second region beside it, which would leave every stale bind live.
OLD_BEGIN = "<!-- APEX-KEYBINDS-BEGIN — generated by apex-labwc-keybinds. Do not edit. -->"  # rime-rename: keep — marker on disk
OLD_END = "<!-- APEX-KEYBINDS-END -->"  # rime-rename: keep — marker on disk


def find_region(text):
    """(begin, end_marker_start, end_marker) of the generated region, or None.

    The new markers first; the APEX-era ones when the new are absent.
    end_marker_start is -1 when the region has a begin and no end.
    """
    for begin, end in ((BEGIN, END), (OLD_BEGIN, OLD_END)):
        begin_at = text.find(begin)
        if begin_at != -1:
            return begin_at, text.find(end, begin_at), end
    return None

# ── Translation tables ───────────────────────────────────────────────────────

# Shell action id -> the `rime shell` verb rc.xml runs for it. `rime shell`
# rather than `qs -p … ipc call` because it resolves the shell path itself, and
# because it is the documented CLI a user would type.
VERBS = {
    "dashboard-launcher": "launcher",
    "dashboard-home": "dashboard home",
    "dashboard-stats": "dashboard stats",
    "dashboard-kanban": "dashboard kanban",
    "dashboard-config": "settings",
    "PowerMenu-toggle": "power",
    "notification-toggle": "notifications",
    "clipboard-toggle": "clipboard",
    "wallpaper-toggle": "wallpaper",
    "context-menu": "menu",
    "session-lock": "lock",
    "focus-toggle": "focus",
    "screenrec-on": "record",
    "voice-ptt": "voice",
    "audioOut-toggle": "audio out",
    "audioIn-toggle": "audio in",
    "audioMix-toggle": "audio mixer",
    "wifi-toggle": "network wifi",
    "bluetooth-toggle": "network bluetooth",
    "vpn-toggle": "network vpn",
    "hotspot-toggle": "network hotspot",
}

# Hyprland config variables, resolved to what the images actually install.
# The shell keeps these symbolic because Hyprland expands them; labwc does not.
APPS = {
    "$terminal": "ghostty",
    # NOT a browser name. The keybind opens whatever the user has set as their
    # default, so it follows them to any browser they install and choose — the
    # same reason hyprland.conf no longer says `firefox` here. Naming a browser
    # made the shortcut contradict the user's own setting the moment a second
    # browser existed, which shipping Zen guarantees.
    "$browser": "/usr/libexec/rime-open-browser",
    "$fileManager": "thunar",
}

# Carry the pointer to the middle of the active window. Appended to every
# binding that MOVES a window, because <followMouse>yes</followMouse> gives
# focus to whatever a move uncovers — see the module docstring.
WARP_CURSOR = '<action name="WarpCursor" to="window"/>'

# Hyprland dispatcher -> the labwc action element. None = no equivalent.
DISPATCH = {
    "killactive": '<action name="Close"/>',
    "fullscreen": '<action name="ToggleFullscreen"/>',
    "togglefloating": '<action name="ToggleAlwaysOnTop"/>',
    # See the header: MoveToEdge moves the window, and the shell calls this
    # "Focus Left". Reproduced, not invented here — but now followed by the
    # WarpCursor that keeps the moved window focused under <followMouse>yes</>.
    "movefocus": {
        d: f'<action name="MoveToEdge" direction="{w}"/>\n{WARP_CURSOR}'
        for d, w in (("l", "left"), ("r", "right"), ("u", "up"), ("d", "down"))
    },
    "movewindow": {
        d: f'<action name="SnapToEdge" direction="{w}"/>\n{WARP_CURSOR}'
        for d, w in (("l", "left"), ("r", "right"), ("u", "up"), ("d", "down"))
    },
    "pseudo": None,
    "layoutmsg": None,
    # labwc calls them desktops. `arg` is the 1-based number in both.
    "workspace": "GoToDesktop",
    "movetoworkspace": "SendToDesktop",
}

MODS = {"SUPER": "W", "ALT": "A", "CTRL": "C", "SHIFT": "S"}
MOD_ORDER = ["W", "C", "A", "S"]

# Keys whose labwc/xkb spelling is not simply the lowercased shell name.
KEYNAMES = {
    "SPACE": "space",
    "ESCAPE": "Escape",
    "PRINT": "Print",
    "TAB": "Tab",
    "RETURN": "Return",
    "LEFT": "Left",
    "RIGHT": "Right",
    "UP": "Up",
    "DOWN": "Down",
    # The unshifted +/- keys. Hyprland accepts the upper-case spelling the shell
    # stores; labwc/xkb wants the keysym name.
    "EQUAL": "equal",
    "MINUS": "minus",
}


def to_labwc(mods, key):
    """Translate a shell "SUPER + SHIFT"/"W" pair into labwc's "W-S-w"."""
    parts = [MODS[m.strip()] for m in mods.split("+") if m.strip() in MODS]
    parts.sort(key=lambda m: MOD_ORDER.index(m))

    key = key.strip()
    if key.upper() in KEYNAMES:
        k = KEYNAMES[key.upper()]
    elif re.fullmatch(r"F\d+", key.upper()):
        k = key.upper()
    elif len(key) == 1:
        k = key.lower()
    else:
        k = key
    return "-".join(parts + [k])


# ── Reading the model ────────────────────────────────────────────────────────
def shell_defaults(shell_dir, shell_path=None):
    """Parse KeybindService's `_defaults` into id -> field dict.

    The QML is the source of truth for the model and there is no machine-readable
    export of it, so this reads the declaration. Each entry is one line, which is
    what makes a regex honest here rather than a parser held together with hope.
    """
    # Where the model is READ from and what `root._shellDir` RESOLVES TO are two
    # different things at image build time: the model is read out of the source
    # checkout, but the commands it builds must name the installed path. Passing
    # one for both silently bakes a build-host path into the shipped config, and
    # then `check` compares a stale installed shell against it and passes.
    path = os.path.join(shell_dir, KEYBIND_SERVICE)
    shell_path = shell_path or shell_dir
    with open(path, encoding="utf-8") as fh:
        src = fh.read()

    # Bounded to the _defaults object literal, not "everything after it". The
    # scan used to run to the end of the file, so any later `"id": { … }` in
    # KeybindService.qml would have become a keybind — one refactor away from
    # inventing shortcuts nobody declared.
    start = src.index("_defaults")
    end = src.find("\n    })", start)
    if end == -1:
        raise ValueError("could not find the end of the _defaults block")
    block = src[start:end]

    out = {}
    # Digits belong in the character class. Without them `workspace-1` through
    # `move-workspace-10` — 20 of the 68 bindings, every workspace shortcut
    # there is — never entered the model at all. They were not reported as
    # unmappable either, because they never reached the code that reports that,
    # so the build-time check cheerfully printed "48 defaults" and passed.
    for m in re.finditer(r'"([A-Za-z0-9-]+)":\s*\{([^}]*)\}', block):
        action, body = m.groups()
        entry = {}
        for field in ("mods", "key", "type", "dispatcher", "arg", "command"):
            fm = re.search(rf'\b{field}:\s*"([^"]*)"', body)
            if fm:
                entry[field] = fm.group(1)
        # `command: "bash " + root._shellDir + "/src/scripts/…"` — a
        # concatenation, so the plain-string match above catches only its first
        # piece. Rebuild it with the path resolved.
        cm = re.search(r'command:\s*"([^"]*)"\s*\+\s*root\._shellDir\s*\+\s*"([^"]*)"', body)
        if cm:
            entry["command"] = cm.group(1) + shell_path + cm.group(2)
        if "key" in entry and entry["key"]:
            out[action] = entry
    return out


def load_overrides(path):
    """The user's rebinds: id -> {mods, key}. Absent or broken means none."""
    if not os.path.exists(path):
        return {}
    try:
        with open(path, encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, json.JSONDecodeError):
        return {}
    return data if isinstance(data, dict) else {}


def resolve(defaults, overrides):
    """Apply the user's rebinds over the defaults."""
    out = {}
    for action, entry in defaults.items():
        merged = dict(entry)
        ov = overrides.get(action)
        if isinstance(ov, dict):
            if "mods" in ov:
                merged["mods"] = ov["mods"]
            if ov.get("key"):
                merged["key"] = ov["key"]
        out[action] = merged
    return out


# ── Generating ───────────────────────────────────────────────────────────────
def action_for(action, entry):
    """The labwc <action> line for one binding, or None if it does not map."""
    if action in VERBS:
        return f'<action name="Execute" command="rime shell {VERBS[action]}"/>'

    kind = entry.get("type", "")

    if kind == "exec":
        cmd = entry.get("command", "")
        if not cmd:
            return None
        for var, real in APPS.items():
            if cmd.startswith(var):
                cmd = real + cmd[len(var):]
        if cmd.startswith("$"):
            return None  # an unresolved variable is not a command
        return f'<action name="Execute" command="{xml_attr(cmd)}"/>'

    if kind == "dispatch":
        dispatcher = entry.get("dispatcher", "")
        mapped = DISPATCH.get(dispatcher)
        if mapped is None:
            return None
        if isinstance(mapped, dict):
            return mapped.get(entry.get("arg", ""))
        # GoToDesktop / SendToDesktop take the desktop number as `to`.
        if mapped in ("GoToDesktop", "SendToDesktop"):
            arg = entry.get("arg", "")
            if not arg.isdigit():
                return None
            return f'<action name="{mapped}" to="{arg}"/>'
        return mapped

    # No type at all: a shell IPC toggle whose verb we do not know.
    return None


def xml_attr(text):
    """Escape a command for an XML attribute."""
    return (text.replace("&", "&amp;").replace("<", "&lt;")
                .replace(">", "&gt;").replace('"', "&quot;"))


def generate(binds, indent="    "):
    """Return (block, skipped) — the <keybind> XML and what did not translate."""
    lines = [BEGIN]
    skipped = []

    for action in sorted(binds):
        entry = binds[action]
        act = action_for(action, entry)
        if act is None:
            skipped.append(action)
            continue
        key = to_labwc(entry.get("mods", ""), entry["key"])
        lines.append(f'<keybind key="{key}">')
        # A mapping may be more than one <action> — the arrow bindings add a
        # WarpCursor. Split on the newline so each lands as its own ELEMENT of
        # `lines`, because the indent below is applied per element: a two-line
        # string appended whole is indented once and the second action comes out
        # against the left margin. `check` catches that, which is how it was
        # found, but the generated file is also read by people.
        for one in act.split("\n"):
            lines.append(f"  {one}")
        lines.append("</keybind>")

    lines.append(END)
    return ("\n".join(indent + ln for ln in lines), skipped)


# ── Splicing into rc.xml ─────────────────────────────────────────────────────
def splice(rc_path, block, dry_run=False):
    """Replace the marked region in rc.xml, byte-for-byte elsewhere."""
    if not os.path.exists(rc_path):
        return [f"{rc_path} does not exist; skipped"]

    try:
        with open(rc_path, encoding="utf-8") as fh:
            text = fh.read()
    except OSError as e:
        return [f"cannot read {rc_path}: {e}"]

    try:
        ET.fromstring(text)
    except ET.ParseError as e:
        # Never rewrite a file we cannot parse. A broken rc.xml already makes
        # labwc fall back to defaults silently; overwriting it would destroy the
        # user's own bindings along with whatever the real problem was.
        return [f"{rc_path} is not parseable ({e}); refusing to touch it"]

    region = find_region(text)
    if region is not None:
        begin_at, end_at, end = region
        if end_at == -1:
            return [f"{rc_path} has an unterminated Rime keybind region; refusing to touch it"]
        line_start = text.rfind("\n", 0, begin_at) + 1
        updated = text[:line_start] + block + text[end_at + len(end):]
    else:
        # No markers yet: insert before the </keyboard> that closes the real
        # <keyboard> element.
        #
        # NOT rfind(). The last "</keyboard>" in the file can easily be inside a
        # comment — rc.xml is heavily commented and its comments discuss the
        # element by name. Anchoring there splices the whole block in as a
        # sibling of <keyboard> instead of a child, which still parses, so
        # `apply` reports success, `check` afterwards confirms the corrupted
        # layout, and labwc ignores every one of the generated <keybind>s
        # because they are outside the element it reads them from. Silent, total
        # failure of the feature, on the very first apply against a user's own
        # config.
        open_at = text.find("<keyboard>")
        if open_at == -1:
            return [f"{rc_path} has no <keyboard>; refusing to touch it"]
        anchor = text.find("</keyboard>", open_at)
        if anchor == -1:
            return [f"{rc_path} has an unterminated <keyboard>; refusing to touch it"]
        line_start = text.rfind("\n", 0, anchor) + 1
        updated = text[:line_start] + block + "\n" + text[line_start:]

    try:
        tree = ET.fromstring(updated)
    except ET.ParseError as e:
        return [f"the generated rc.xml would not parse ({e}); the original is untouched"]

    # Well-formed is not the same as correct. A block spliced in as a sibling of
    # <keyboard> parses perfectly and does nothing at all, because labwc reads
    # keybinds only from inside that element. So count them where they have to
    # be, and refuse a result that would be silently inert.
    want = block.count("<keybind key=")
    got = sum(len(kb.findall("keybind")) for kb in tree.iter("keyboard"))
    if got < want:
        return [f"the generated bindings would land outside <keyboard> "
                f"({got} of {want} inside it); the original is untouched"]

    if dry_run:
        return []

    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(rc_path), prefix=".rc.xml.rime.")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(updated)
        shutil.copymode(rc_path, tmp)
        os.replace(tmp, rc_path)
    except OSError as e:
        if os.path.exists(tmp):
            os.unlink(tmp)
        return [f"could not replace {rc_path}: {e}"]
    return []


def reload_labwc():
    """Ask a running labwc to re-read rc.xml. Absent labwc is not an error."""
    if not shutil.which("labwc"):
        return
    try:
        subprocess.run(["labwc", "--reconfigure"], capture_output=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        pass


# ── check ────────────────────────────────────────────────────────────────────
def extract_region(rc_path):
    """The current Rime region of an rc.xml, or None when it has no markers."""
    with open(rc_path, encoding="utf-8") as fh:
        text = fh.read()
    region = find_region(text)
    if region is None or region[1] == -1:
        return None
    begin_at, end_at, end = region
    line_start = text.rfind("\n", 0, begin_at) + 1
    return text[line_start:end_at + len(end)]


def do_check(shell_dir, rc_path, shell_path=None):
    """Assert an rc.xml's Rime region is exactly what defaults generate."""
    defaults = shell_defaults(shell_dir, shell_path)
    block, skipped = generate(defaults)

    print(f"rime-labwc-keybinds: {len(defaults)} defaults, "
          f"{len(skipped)} without a labwc equivalent")
    for s in sorted(skipped):
        print(f"  skipped  {s}")

    current = extract_region(rc_path)
    if current is None:
        print(f"FAIL  {rc_path} has no Rime keybind region; run `apply` or add the markers")
        return 1

    if current.rstrip() == block.rstrip():
        print(f"PASS  {rc_path} matches what the shell's defaults generate")
        return 0

    print(f"FAIL  {rc_path} does not match the generated block")
    import difflib
    for line in difflib.unified_diff(
            block.splitlines(), current.rstrip().splitlines(),
            fromfile="generated", tofile=rc_path, lineterm=""):
        print("  " + line)
    return 1


# ── main ─────────────────────────────────────────────────────────────────────
def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("action", nargs="?", default="apply",
                    choices=("apply", "print", "check"))
    ap.add_argument("--shell-dir", default=SHELL_DIR,
                    help="where to READ the shell's keybind model from")
    ap.add_argument("--shell-path", default=None,
                    help="what root._shellDir resolves to in generated commands "
                         "(defaults to --shell-dir; the image build reads from the "
                         "source tree and generates for the installed path)")
    ap.add_argument("--rc", default=RC_XML)
    ap.add_argument("--overrides", default=OVERRIDES)
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--no-reload", action="store_true")
    args = ap.parse_args(argv)

    try:
        defaults = shell_defaults(args.shell_dir, args.shell_path)
    except (OSError, ValueError) as e:
        print(f"rime-labwc-keybinds: cannot read the shell's keybind model: {e}",
              file=sys.stderr)
        return 2

    if not defaults:
        print("rime-labwc-keybinds: the shell's keybind model parsed as empty",
              file=sys.stderr)
        return 2

    if args.action == "check":
        return do_check(args.shell_dir, args.rc, args.shell_path)

    binds = resolve(defaults, load_overrides(args.overrides))
    block, skipped = generate(binds)

    if args.action == "print":
        print(block)
        for s in sorted(skipped):
            print(f"<!-- no labwc equivalent: {s} -->")
        return 0

    problems = splice(args.rc, block, args.dry_run)
    for p in problems:
        print(f"rime-labwc-keybinds: {p}", file=sys.stderr)
    if problems:
        return 1

    if not args.dry_run and not args.no_reload:
        reload_labwc()
    return 0


if __name__ == "__main__":
    sys.exit(main())
