#!/usr/bin/env python3
"""Generate every compositor's input configuration from one Rime model.

This is the input half of what the keybind pipeline already does: one
compositor-neutral description, three generated configs, each validated before
it replaces anything.

    ~/.config/rime-shell/input.json          the model (written by Rime Settings)
              |
              +--> ~/.config/hypr/rime/input.lua       required by hyprland.lua
              +--> ~/.config/rime-shell/RimeShellInput.kdl   included by niri
              +--> the <libinput> element inside ~/.config/labwc/rc.xml
              |
          validate -> atomic replace -> reload

## Why labwc is edited in place

Hyprland has `require` and niri has `include` (25.11+; the image ships 26.04),
so both get a generated file they pull in. Neither line is added by this script:
the seeded hyprland.lua already requires rime/input.lua, and rime-shell-firstrun
appends `include` to the seeded niri config.kdl.

Hyprland's half stopped being a `source =` line in P0-025. hyprlang was
deprecated in 0.55 with "1-2 releases" of life left and the image ships 0.56.2,
so the compositor config is Lua now. `require("rime.input")` resolves because
Hyprland prepends the config file's own directory to package.path, and an ABSENT
module is skipped by the loader in hyprland.lua rather than being the fatal
error a missing `source =` was.

labwc has neither: rc.xml is the only file it reads. So the `<libinput>`
element is replaced inside it, with ElementTree rather than a regex, and the
result is parsed before it is moved into place. Everything else in rc.xml —
keybinds, theme, window rules — is preserved untouched, which a whole-file
regeneration could not promise.

## Option names are verified, not remembered

Every name here was checked against the compositor that consumes it:

  * labwc  — labwc-config(5) and the package's own rc.xml.all. Note `tap`, not
             `tapToClick`: labwc ignores an unknown element in silence, which is
             how `<tapToClick>` shipped doing nothing for months.
  * Hypr   — `Hyprland --verify-config` rejects an unknown option, so
             `--self-test` runs the generated file through it.
  * niri   — `niri validate` likewise.

`--self-test` generates from the defaults and runs all three validators. Run it
after touching any mapping in this file.

## Nothing may be shown that cannot be done

A settings page whose controls quietly do nothing is the complaint this file
exists to answer, so three questions are answered here rather than guessed at
in the QML:

  --devices       what input devices are present, classified as touchpad,
                  trackpoint, mouse, tablet, touchscreen or keyboard. Read from
                  sysfs and udev's database, both world-readable: `libinput
                  list-devices` needs the `input` group and a user who is not in
                  it gets a permission error per device, which is not an empty
                  list.
  --capabilities  what each compositor can actually do, and the reason where it
                  cannot. Settings disables the control and shows the reason;
                  it never writes a value the compositor will ignore. Some
                  answers depend on the hardware — four touchpad settings exist
                  on Hyprland only as a named device.
  --read-back     what is in effect now, and where that answer came from.
                  `hyprctl getoption` is a real query; niri has no input query
                  in `niri msg` and labwc has no IPC, so those two are read from
                  the file the compositor loads and say so.

usage:
  rime-input-apply [--model PATH] [--dry-run] [--no-reload] [--self-test]
  rime-input-apply --devices | --capabilities | --read-back
"""
import argparse
import json
import re
import os
import shutil
import subprocess
import sys
import tempfile
import xml.etree.ElementTree as ET

HOME = os.path.expanduser("~")

MODEL_PATH = os.path.join(HOME, ".config/rime-shell/input.json")
HYPR_OUT = os.path.join(HOME, ".config/hypr/rime/input.lua")
NIRI_OUT = os.path.join(HOME, ".config/rime-shell/RimeShellInput.kdl")
LABWC_RC = os.path.join(HOME, ".config/labwc/rc.xml")

GENERATED_BANNER = "Generated by rime-input-apply from Rime Settings. Do not edit."

# Defaults chosen to match what the images already ship, so the FIRST
# generation is a no-op diff against the seeded configs. Changing a default here
# silently changes behaviour for every user who has not overridden it.
DEFAULTS = {
    "touchpad": {
        "natural_scroll": True,       # labwc naturalScroll yes; hypr natural_scroll true
        "tap": True,                  # labwc <tap>yes; hypr tap-to-click true
        "tap_and_drag": True,         # labwc tapAndDrag yes
        "tap_button_map": "lrm",      # one/two/three finger = left/right/middle
        # Both of these were chosen, and both disagreed with every compositor
        # that has to carry them. Hyprland 0.56.2 with no config at all reports
        # drag_lock 0 and clickfinger_behavior false; the shipped rc.xml sets
        # neither, so labwc leaves them to libinput, whose drag lock is off and
        # whose click method on an ordinary clickpad is button areas.
        #
        # A default that disagrees with the shipped state is not a preference,
        # it is a change nobody asked for: the page writes the WHOLE model on
        # any edit, so moving the scroll-speed slider also turned drag lock and
        # clickfinger clicking on. Making them agree is what lets
        # rime/input-defaults.lua state them explicitly without that being a
        # behaviour change on the next `rime update`.
        "drag_lock": False,
        "disable_while_typing": True,
        "click_method": "buttonAreas",
        "scroll_method": "twofinger",
        "middle_emulation": False,
        "accel_profile": "adaptive",  # labwc accelProfile adaptive
        "speed": 0.0,                 # labwc pointerSpeed / hypr sensitivity
        "scroll_factor": 1.0,
        "left_handed": False,
        "three_finger_drag": False,
    },
    "pointer": {
        # A mouse deliberately does NOT inherit the touchpad's natural scroll:
        # inverting a wheel is not the same gesture as inverting a two-finger
        # swipe, and applying one setting to both is a common annoyance.
        "natural_scroll": False,
        "accel_profile": "adaptive",
        "speed": 0.0,
        "scroll_factor": 1.0,
        "left_handed": False,
        "middle_emulation": False,
    },
    "keyboard": {
        "repeat_rate": 25,
        "repeat_delay": 600,
    },
}

TAP_BUTTON_MAPS = ("lrm", "lmr")
ACCEL_PROFILES = ("adaptive", "flat")
CLICK_METHODS = ("none", "buttonAreas", "clickfinger")
SCROLL_METHODS = ("none", "twofinger", "edge")

# The model's vocabulary is labwc's, because labwc's is the one with a spelling
# for every value. Each compositor gets its own translation, and a value with no
# translation is a capability gap rather than a silent substitution.
#
# Hyprland's `drag_3fg` is an enum: 0 off, 1 three fingers, 2 four.
HYPR_DRAG_3FG = {False: 0, True: 1}
# Hyprland's own spellings for input:scroll_method. Nothing catches a wrong one:
# --verify-config accepts ANY string here and the compositor then matches none
# of them, so "twofinger" parses clean and does nothing.
HYPR_SCROLL_METHODS = {"twofinger": "2fg", "edge": "edge", "none": "no_scroll"}
NIRI_SCROLL_METHODS = {"twofinger": "two-finger", "edge": "edge", "none": "no-scroll"}
NIRI_CLICK_METHODS = {"clickfinger": "clickfinger", "buttonAreas": "button-areas"}
NIRI_TAP_BUTTON_MAPS = {"lrm": "left-right-middle", "lmr": "left-middle-right"}


# ── input devices ───────────────────────────────────────────────────────────
# Six kinds, because that is what the kernel and libinput distinguish and what
# a per-device page has to keep apart. A trackpoint is not a mouse: it reports
# ID_INPUT_POINTINGSTICK *and* ID_INPUT_MOUSE, and a touchpad ships a companion
# node that reports ID_INPUT_MOUSE alone. So the order below is what separates
# the three pointing devices on a ThinkPad, and getting it wrong silently files
# a touchpad under Mouse.
DEVICE_TYPES = ("touchpad", "trackpoint", "tablet", "touchscreen", "mouse",
                "keyboard", "other")
UDEV_TYPE_FLAGS = (
    ("ID_INPUT_TOUCHPAD", "touchpad"),
    ("ID_INPUT_POINTINGSTICK", "trackpoint"),
    ("ID_INPUT_TABLET", "tablet"),
    ("ID_INPUT_TOUCHSCREEN", "touchscreen"),
    ("ID_INPUT_MOUSE", "mouse"),
    ("ID_INPUT_KEYBOARD", "keyboard"),
)
POINTING_TYPES = ("touchpad", "trackpoint", "mouse")

# Which model keys a device of each type may carry. A tap setting on a mouse is
# a user error the model should report, not carry to a generator that will emit
# an option libinput ignores.
TOUCH_ONLY_KEYS = ("tap", "tap_and_drag", "drag_lock", "tap_button_map",
                   "disable_while_typing", "click_method", "scroll_method",
                   "three_finger_drag")
COMMON_DEVICE_KEYS = ("natural_scroll", "speed", "accel_profile", "left_handed",
                      "scroll_factor", "middle_emulation", "enabled")
DEVICE_KEYS_BY_TYPE = {
    "touchpad":    COMMON_DEVICE_KEYS + TOUCH_ONLY_KEYS,
    "trackpoint":  COMMON_DEVICE_KEYS,
    "mouse":       COMMON_DEVICE_KEYS,
    "tablet":      ("left_handed", "enabled"),
    "touchscreen": ("enabled",),
    "keyboard":    ("enabled",),
    "other":       ("enabled",),
}
DEVICE_KEYS = tuple(sorted(set(COMMON_DEVICE_KEYS) | set(TOUCH_ONLY_KEYS)))


def parse_udev_flags(text, prefix=""):
    """ID_INPUT_* flags that are SET, from udev property lines.

    The VALUE is the whole point. udev writes ID_INPUT_POINTINGSTICK=0 on a
    device that is not one, and every touchpad ships a companion mouse node that
    carries exactly that line — so reading the key's presence as the answer
    files half the touchpads on the machine under Trackpoint.
    """
    flags = set()
    for line in text.splitlines():
        if prefix:
            if not line.startswith(prefix):
                continue
            line = line[len(prefix):]
        if line.startswith("ID_INPUT") and line.rstrip().endswith("=1"):
            flags.add(line.split("=", 1)[0])
    return flags


def _udev_flags(minor):
    """ID_INPUT_* flags for one event node, without udevadm and without root.

    /run/udev/data/c13:<minor> is udev's own database record — mode 0644, the
    same `E:` lines `udevadm info --query=property` prints. Reading it directly
    keeps this working inside a container that has no udevadm, and costs nothing
    where there is one. udevadm is the fallback, not the other way round.
    """
    try:
        with open(f"/run/udev/data/c13:{minor}", encoding="utf-8", errors="replace") as fh:
            return parse_udev_flags(fh.read(), prefix="E:")
    except OSError:
        pass
    if not which("udevadm"):
        return set()
    try:
        out = subprocess.run(
            ["udevadm", "info", "--query=property", f"--name=/dev/char/13:{minor}"],
            capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return set()
    return parse_udev_flags(out.stdout)


def _hypr_name(name):
    """The name Hyprland gives a device: lowercased, spaces to hyphens.

    Checked against `hyprctl -j devices` on a machine with seven pointing
    devices: "ELAN06DA:00 04F3:320B Touchpad" is elan06da:00-04f3:320b-touchpad
    and "TPPS/2 Elan TrackPoint" is tpps/2-elan-trackpoint — the slash stays.
    """
    return name.lower().replace(" ", "-")


# Which list in `hyprctl devices` holds a device of each kind. A touchpad and a
# trackpoint are both mice to Hyprland; a touchscreen is `touch`.
HYPRCTL_GROUP = {
    "touchpad": "mice", "trackpoint": "mice", "mouse": "mice",
    "keyboard": "keyboards", "tablet": "tablets", "touchscreen": "touch",
}


def _hyprctl_names():
    """Device names the running Hyprland matches hl.device against, per group.

    Worth asking rather than deriving: Hyprland appends -1, -2 … to break ties
    between devices whose derived names collide, and which suffix a device gets
    depends on what else is plugged in. On this laptop a "Logitech G305" is both
    a keyboard and a mouse; the keyboard is logitech-g305 and the mouse is
    logitech-g305-1.

    Which is also why the answer is per group rather than one flat set. Matching
    the mouse against every name Hyprland knows finds the KEYBOARD's, and the
    generated hl.device block then names a keyboard and sets a mouse option on
    it — the setting applies to nothing, silently, on exactly the hardware the
    suffix exists for.

    Returns None — not an empty mapping — when there is no Hyprland to ask, so
    the caller can tell "no devices" from "did not look".
    """
    if not which("hyprctl") or not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return None
    try:
        out = subprocess.run(["hyprctl", "-j", "devices"],
                             capture_output=True, text=True, timeout=10)
        return hyprctl_groups(json.loads(out.stdout))
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError, ValueError):
        return None


def hyprctl_groups(data):
    """`hyprctl -j devices` as {group: [name, …]}."""
    groups = {}
    for group in ("mice", "keyboards", "tablets", "touch", "switches"):
        groups[group] = [e["name"] for e in (data.get(group) or [])
                         if isinstance(e, dict) and e.get("name")]
    return groups


def resolve_hypr_names(devices, groups):
    """Give each device the name Hyprland knows it by. Pure, so it can be tested.

    `groups` is what hyprctl_groups returned, or None when Hyprland was not
    asked; in that case every device keeps the plain derivation.
    """
    taken = set()
    for dev in devices:
        derived = _hypr_name(dev["name"])
        dev["hypr_name"], dev["hypr_name_source"] = derived, "derived"
        if groups is None:
            continue
        # Only the list for this kind of device, and never a name another
        # device of the same kind already claimed.
        candidates = groups.get(HYPRCTL_GROUP.get(dev["type"], ""), [])
        for cand in [derived] + [f"{derived}-{i}" for i in range(1, 10)]:
            if cand in candidates and cand not in taken:
                dev["hypr_name"], dev["hypr_name_source"] = cand, "compositor"
                taken.add(cand)
                break
    return devices


def enumerate_devices():
    """Every input device, classified. Returns (devices, notes).

    Reads sysfs and udev's database, both world-readable, because the obvious
    tool does not work: `libinput list-devices` opens /dev/input/event*, which
    needs the `input` group, and a user who is not in it gets "Permission
    denied" per device rather than a short list. A refusal reported as an empty
    list is how a page comes to say "no touchpad found" on a laptop with one.
    """
    devices, notes = [], []
    # A fixture, so a test can assert what is generated for a trackpoint on a
    # machine that has none, and so the shell can hand back the enumeration it
    # already made rather than paying for a second one.
    fixture = os.environ.get("RIME_INPUT_DEVICES", "")
    if fixture:
        try:
            with open(fixture, encoding="utf-8") as fh:
                return json.load(fh), []
        except (OSError, json.JSONDecodeError, ValueError) as e:
            return [], [f"RIME_INPUT_DEVICES={fixture} is not usable ({e})"]

    try:
        nodes = sorted(os.listdir("/sys/class/input"))
    except OSError as e:
        return [], [f"cannot list input devices ({e}); no per-device settings"]

    for node in nodes:
        if not re.fullmatch(r"event\d+", node):
            continue
        base = os.path.join("/sys/class/input", node)
        try:
            with open(os.path.join(base, "device", "name"), encoding="utf-8",
                      errors="replace") as fh:
                name = fh.read().strip()
            with open(os.path.join(base, "dev"), encoding="utf-8") as fh:
                minor = fh.read().strip().split(":")[1]
        except OSError:
            continue
        if not name:
            continue

        flags = _udev_flags(minor)
        kind = "other"
        for flag, typed in UDEV_TYPE_FLAGS:
            if flag in flags:
                kind = typed
                break

        devices.append({"name": name, "type": kind, "event": node})

    resolve_hypr_names(devices, _hyprctl_names())

    # Whether the Hyprland name was asked for or derived is recorded per device
    # in hypr_name_source, not raised as a note: it is a property of the answer,
    # and a note here would print on every single run in a niri session.
    if not devices:
        notes.append("/sys/class/input listed no usable event device")
    return devices, notes


# ── capabilities ────────────────────────────────────────────────────────────
# What each compositor can actually do, and the reason where it cannot.
#
# This table is the answer to "changing Input configuration has no effect". A
# control the running compositor cannot honour is disabled in Settings and shows
# the reason from here — it is never written, never reported as applied, and
# never quietly turned into the setting next to it.
#
# Every entry was established against the shipped binary: Hyprland by
# --verify-config, niri by `niri validate`, labwc by labwc-config(5) and the
# package's own rc.xml.all. Not from a wiki.
#
# The reasons are read by users. They say what the compositor will not do, in
# the words of the setting, and they do not name config options.
SUPPORTED = True

CAPABILITIES = {
    "touchpad.speed": {
        "hyprland": "hyprland-touchpad-device",
    },
    "touchpad.accel_profile": {
        "hyprland": "hyprland-touchpad-device",
    },
    "touchpad.left_handed": {
        "hyprland": "hyprland-touchpad-device",
    },
    "touchpad.scroll_method": {
        "hyprland": "hyprland-touchpad-device",
    },
    "touchpad.click_method": {
        "hyprland": {"none": "Hyprland's touchpad can click by finger count or "
                             "by button area, and has no way to stop a click "
                             "producing a button at all"},
        "niri": {"none": "niri's touchpad can click by finger count or by "
                         "button area, and has no way to stop a click "
                         "producing a button at all"},
    },
    "touchpad.three_finger_drag": {
        "niri": "niri has no three-finger drag",
    },
    "pointer.middle_emulation": {
        "hyprland": "hyprland-pointer-device",
    },
}

# Filled in from the live enumeration, because whether Hyprland can do these
# depends on whether there is a device to name.
CONDITIONAL_REASONS = {
    "hyprland-touchpad-device":
        ("Hyprland sets this per device and Rime found no touchpad to name, so "
         "the setting has nowhere to go"),
    "hyprland-pointer-device":
        ("Hyprland sets this per device and Rime found no mouse to name, so the "
         "setting has nowhere to go"),
}

# Per-device settings, separately: two of the three compositors match a device
# by its name and one does not.
DEVICE_CAPABILITY = {
    "hyprland": SUPPORTED,
    "labwc": SUPPORTED,
    "niri": ("niri configures input by device kind — touchpad, mouse, "
             "trackpoint, tablet, touchscreen — and not by device name, so a "
             "setting for one named device is not applied in a niri session"),
}


def running_compositor():
    """hyprland, niri, labwc, or None. Same detection as rime-compositor-reload."""
    desktop = os.environ.get("XDG_CURRENT_DESKTOP", "").lower()
    for known in ("hyprland", "niri", "labwc"):
        if known in desktop:
            return known
    for proc, known in (("Hyprland", "hyprland"), ("niri", "niri"), ("labwc", "labwc")):
        if subprocess.run(["pgrep", "-x", proc], capture_output=True).returncode == 0:
            return known
    return None


def capabilities(devices=None):
    """The capability table, resolved against the devices actually present."""
    if devices is None:
        devices, _ = enumerate_devices()
    kinds = {d["type"] for d in devices}
    have = {
        "hyprland-touchpad-device": "touchpad" in kinds,
        "hyprland-pointer-device": bool(kinds & {"mouse", "trackpoint"}),
    }

    controls = {}
    for control in sorted(
            set(CAPABILITIES) | {f"{s}.{k}" for s in DEFAULTS for k in DEFAULTS[s]}):
        entry = {}
        for comp in ("hyprland", "niri", "labwc"):
            rule = CAPABILITIES.get(control, {}).get(comp, SUPPORTED)
            if isinstance(rule, str) and rule in CONDITIONAL_REASONS:
                rule = SUPPORTED if have[rule] else CONDITIONAL_REASONS[rule]
            if rule is SUPPORTED:
                entry[comp] = {"supported": True}
            elif isinstance(rule, dict):
                entry[comp] = {"supported": True, "unsupported_values": rule}
            else:
                entry[comp] = {"supported": False, "reason": rule}
        controls[control] = entry

    return {
        "running": running_compositor(),
        "controls": controls,
        "per_device": {
            comp: ({"supported": True} if rule is SUPPORTED
                   else {"supported": False, "reason": rule})
            for comp, rule in DEVICE_CAPABILITY.items()
        },
        "device_types": list(DEVICE_TYPES),
        "device_keys": {k: list(v) for k, v in DEVICE_KEYS_BY_TYPE.items()},
    }


# ── model ───────────────────────────────────────────────────────────────────
def load_model(path):
    """The model, with every missing key filled from DEFAULTS."""
    model = {k: dict(v) for k, v in DEFAULTS.items()}
    try:
        with open(path, encoding="utf-8") as fh:
            user = json.load(fh)
    except FileNotFoundError:
        return model, []
    except (json.JSONDecodeError, OSError) as e:
        # A malformed settings file must not leave the user with no input
        # configuration at all; fall back to defaults and say so.
        return model, [f"{path} is not usable ({e}); using defaults"]

    notes = []
    for section in model:
        for key, value in (user.get(section) or {}).items():
            if key not in model[section]:
                notes.append(f"ignoring unknown {section}.{key}")
                continue
            model[section][key] = value

    # `devices` is a different shape from the three global sections — a map of
    # kernel device name to that one device's settings — so it is merged
    # separately rather than through the key-by-key loop above.
    #
    # It is keyed on the name the KERNEL reports ("ELAN06DA:00 04F3:320B
    # Touchpad"), which is also the name labwc matches a device category
    # against. Hyprland's own lowercased-and-hyphenated form is derived at
    # generation time from the live enumeration, because its tie-break suffix
    # depends on what else is plugged in and cannot be stored.
    model["devices"] = {}
    for name, settings in (user.get("devices") or {}).items():
        if not isinstance(settings, dict):
            notes.append(f"ignoring devices.{name}: not a table of settings")
            continue
        kind = settings.get("type")
        if kind not in DEVICE_KEYS_BY_TYPE:
            notes.append(f"devices.{name}: unknown type {kind!r}, treating it as a mouse")
            kind = "mouse"
        allowed = DEVICE_KEYS_BY_TYPE[kind]
        kept = {"type": kind}
        for key, value in settings.items():
            if key == "type":
                continue
            if key not in DEVICE_KEYS:
                notes.append(f"ignoring unknown devices.{name}.{key}")
                continue
            if key not in allowed:
                # Not a spelling mistake but a category one: a tap setting on a
                # mouse is a control that should never have been shown.
                notes.append(f"ignoring devices.{name}.{key}: a {kind} has no such setting")
                continue
            kept[key] = value
        if len(kept) > 1:
            model["devices"][name] = kept

    notes += validate(model)
    notes += validate_devices(model)
    return model, notes


def validate_devices(model):
    """Clamp and correct per-device values, the same way the global ones are."""
    notes = []
    for name, settings in model.get("devices", {}).items():
        def fix(key, value, reason):
            notes.append(f"devices.{name}.{key}: {reason}, dropped")
            settings.pop(key, None)

        if "speed" in settings and (
                not isinstance(settings["speed"], (int, float))
                or isinstance(settings["speed"], bool)
                or not -1.0 <= settings["speed"] <= 1.0):
            fix("speed", None, "must be between -1.0 and 1.0")
        if "scroll_factor" in settings and (
                not isinstance(settings["scroll_factor"], (int, float))
                or isinstance(settings["scroll_factor"], bool)
                or not 0.1 <= settings["scroll_factor"] <= 10.0):
            fix("scroll_factor", None, "must be between 0.1 and 10.0")
        for key, allowed in (("accel_profile", ACCEL_PROFILES),
                             ("click_method", CLICK_METHODS),
                             ("scroll_method", SCROLL_METHODS),
                             ("tap_button_map", TAP_BUTTON_MAPS)):
            if key in settings and settings[key] not in allowed:
                fix(key, None, f"must be one of {allowed}")
    return notes


def validate(model):
    """Clamp and correct anything unusable, reporting each correction."""
    notes = []

    def fix(section, key, value, reason):
        notes.append(f"{section}.{key}: {reason}, using {value}")
        model[section][key] = value

    for section in ("touchpad", "pointer"):
        s = model[section]
        if not isinstance(s.get("speed"), (int, float)) or not -1.0 <= s["speed"] <= 1.0:
            fix(section, "speed", DEFAULTS[section]["speed"], "must be between -1.0 and 1.0")
        if s.get("accel_profile") not in ACCEL_PROFILES:
            fix(section, "accel_profile", "adaptive", f"must be one of {ACCEL_PROFILES}")
        if not isinstance(s.get("scroll_factor"), (int, float)) or not 0.1 <= s["scroll_factor"] <= 10.0:
            fix(section, "scroll_factor", 1.0, "must be between 0.1 and 10.0")

    t = model["touchpad"]
    if t.get("tap_button_map") not in TAP_BUTTON_MAPS:
        fix("touchpad", "tap_button_map", "lrm", f"must be one of {TAP_BUTTON_MAPS}")
    if t.get("click_method") not in CLICK_METHODS:
        fix("touchpad", "click_method", "clickfinger", f"must be one of {CLICK_METHODS}")
    if t.get("scroll_method") not in SCROLL_METHODS:
        fix("touchpad", "scroll_method", "twofinger", f"must be one of {SCROLL_METHODS}")

    k = model["keyboard"]
    if not isinstance(k.get("repeat_rate"), int) or not 1 <= k["repeat_rate"] <= 100:
        fix("keyboard", "repeat_rate", 25, "must be between 1 and 100")
    if not isinstance(k.get("repeat_delay"), int) or not 100 <= k["repeat_delay"] <= 2000:
        fix("keyboard", "repeat_delay", 600, "must be between 100 and 2000")

    return notes


def yn(value):
    return "yes" if value else "no"


# ── Hyprland ────────────────────────────────────────────────────────────────
def lua_str(value):
    """A Lua double-quoted string literal."""
    return '"' + str(value).replace("\\", "\\\\").replace('"', '\\"') + '"'


def lua_value(value):
    """A Lua literal for a model value.

    Booleans are the reason this exists: Python prints `True`, Lua wants `true`,
    and Hyprland rejects the unknown identifier rather than coercing it.
    """
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (int, float)):
        return repr(value)
    return lua_str(value)


# Model key -> HL.DeviceSpec field. Verified against
# /usr/share/hypr/stubs/hl.meta.lua for the Hyprland in the image, not from the
# wiki: the stub is generated from the compositor's own option table, so an
# entry here that Hyprland does not implement fails --self-test.
#
# The model does NOT speak Hyprland. It says `speed` and `tap`, labwc's words,
# because labwc is the one with a spelling for every value; each generator
# translates. A model in one compositor's vocabulary is how a settings page ends
# up knowing which compositor is running, which is the thing this whole file
# exists to avoid.
HYPR_DEVICE_KEY = {
    "natural_scroll": "natural_scroll",
    "speed": "sensitivity",
    "accel_profile": "accel_profile",
    "left_handed": "left_handed",
    "scroll_factor": "scroll_factor",
    "middle_emulation": "middle_button_emulation",
    "enabled": "enabled",
    "tap": "tap_to_click",
    "tap_and_drag": "tap_and_drag",
    "drag_lock": "drag_lock",
    "tap_button_map": "tap_button_map",
    "disable_while_typing": "disable_while_typing",
    "click_method": "clickfinger_behavior",
    "scroll_method": "scroll_method",
    "three_finger_drag": "drag_3fg",
}

LABWC_DEVICE_KEY = {
    "natural_scroll": "naturalScroll",
    "speed": "pointerSpeed",
    "accel_profile": "accelProfile",
    "left_handed": "leftHanded",
    "scroll_factor": "scrollFactor",
    "middle_emulation": "middleEmulation",
    "enabled": "sendEventsMode",
    "tap": "tap",
    "tap_and_drag": "tapAndDrag",
    "drag_lock": "dragLock",
    "tap_button_map": "tapButtonMap",
    "disable_while_typing": "disableWhileTyping",
    "click_method": "clickMethod",
    "scroll_method": "scrollMethod",
    "three_finger_drag": "threeFingerDrag",
}

# The four touchpad settings Hyprland has NO touchpad-block option for. Proved
# against the shipped 0.56.2 with --verify-config, which answers "unknown config
# key 'input.touchpad.sensitivity'" for each: the touchpad block carries taps,
# scrolling and clicks, and everything to do with pointer motion sits on the
# parent `input` block, where it applies to every mouse as well.
#
# So writing them globally would set the user's mouse from the Touchpad page.
# The only way to mean "this touchpad" is hl.device, by name — which is why
# these four are the reason enumerate_devices() exists rather than a nicety.
HYPR_TOUCHPAD_VIA_DEVICE = ("speed", "accel_profile", "left_handed", "scroll_method")
# Same shape on the pointer side: there is no input:middle_button_emulation,
# only input:touchpad:middle_button_emulation and the per-device field.
HYPR_POINTER_VIA_DEVICE = ("middle_emulation",)


def hypr_device_value(key, value):
    """One model value as its HL.DeviceSpec literal, or None where it has none."""
    if key == "click_method":
        # clickfinger_behavior is a boolean: on, or button areas. There is no
        # third state, so "none" has no expression here at all.
        return None if value == "none" else lua_value(value == "clickfinger")
    if key == "scroll_method":
        spelled = HYPR_SCROLL_METHODS.get(value)
        return None if spelled is None else lua_str(spelled)
    if key == "three_finger_drag":
        return str(HYPR_DRAG_3FG[bool(value)])
    return lua_value(value)


def gen_hyprland(model, devices=None):
    """rime/input.lua — one hl.config call, plus one hl.device per named device.

    Loaded AFTER rime/input-defaults.lua by hyprland.lua, and hl.config is
    last-write-wins, so everything here overrides the shipped default. That is
    the same ordering the hyprlang config got from putting its `source =` lines
    at the bottom, expressed as load order instead.
    """
    t, p, k = model["touchpad"], model["pointer"], model["keyboard"]
    # Hyprland's touchpad block has no accel_profile or left_handed of its own;
    # those live on the parent input block and apply to both. Only the options
    # Hyprland actually accepts appear here — `Hyprland --verify-config` rejects
    # an unknown one, which --self-test relies on.
    lines = [
        f"-- {GENERATED_BANNER}",
        "--",
        "-- Required by hyprland.lua as `rime.input`. Values come from",
        "-- ~/.config/rime-shell/input.json.",
        "",
        "hl.config({",
        "    input = {",
        f"        sensitivity    = {lua_value(p['speed'])},",
        f"        accel_profile  = {lua_value(p['accel_profile'])},",
        f"        natural_scroll = {lua_value(p['natural_scroll'])},",
        f"        left_handed    = {lua_value(p['left_handed'])},",
        f"        scroll_factor  = {lua_value(p['scroll_factor'])},",
        f"        repeat_rate    = {lua_value(k['repeat_rate'])},",
        f"        repeat_delay   = {lua_value(k['repeat_delay'])},",
        "",
        "        touchpad = {",
        f"            natural_scroll          = {lua_value(t['natural_scroll'])},",
        # hyprlang spelled the first two `tap-to-click` and `tap-and-drag`.
        # The Lua keys are underscored, and a wrong one is rejected outright.
        f"            tap_to_click            = {lua_value(t['tap'])},",
        f"            tap_and_drag            = {lua_value(t['tap_and_drag'])},",
        f"            drag_lock               = {lua_value(t['drag_lock'])},",
        f"            disable_while_typing    = {lua_value(t['disable_while_typing'])},",
        f"            middle_button_emulation = {lua_value(t['middle_emulation'])},",
        f"            clickfinger_behavior    = {lua_value(t['click_method'] == 'clickfinger')},",
        f"            tap_button_map          = {lua_value(t['tap_button_map'])},",
        f"            scroll_factor           = {lua_value(t['scroll_factor'])},",
        # drag_3fg is an ENUM, not a boolean: 0 off, 1 three fingers, 2 four.
        # It was missing entirely, so the Three-finger drag switch wrote the
        # model, regenerated every config and changed nothing on Hyprland.
        f"            drag_3fg                = {HYPR_DRAG_3FG[bool(t['three_finger_drag'])]},",
        "        },",
        "    },",
        "})",
        "",
    ]

    # ── the per-device pass ─────────────────────────────────────────────────
    # Two things land here. The user's own per-device overrides, and the four
    # touchpad settings plus one pointer setting Hyprland has no global option
    # for at all (HYPR_TOUCHPAD_VIA_DEVICE). Without the second group, Pointer
    # speed, Acceleration, Left-handed and Scroll method on the Touchpad page
    # are switches that write the model and change nothing — which is UI-003.
    devices = devices if devices is not None else []
    by_name = {d["name"]: d for d in devices}
    routed = {}

    def route(name, key, value):
        routed.setdefault(name, {})[key] = value

    for dev in devices:
        if dev["type"] == "touchpad":
            for key in HYPR_TOUCHPAD_VIA_DEVICE:
                route(dev["name"], key, t[key])
        elif dev["type"] in ("mouse", "trackpoint"):
            for key in HYPR_POINTER_VIA_DEVICE:
                route(dev["name"], key, p[key])

    # The user's explicit choice for one device wins over the section-wide value
    # routed to it above.
    for name, settings in model.get("devices", {}).items():
        for key, value in settings.items():
            if key != "type":
                route(name, key, value)

    for name in sorted(routed):
        dev = by_name.get(name)
        hypr_name = dev["hypr_name"] if dev else _hypr_name(name)
        emitted = []
        for key in sorted(routed[name]):
            field = HYPR_DEVICE_KEY.get(key)
            literal = hypr_device_value(key, routed[name][key]) if field else None
            if field is None or literal is None:
                continue
            emitted.append(f"    {field} = {literal},")
        if not emitted:
            continue
        lines.append(f"-- {name}" + ("" if dev is None else f"  ({dev['type']})"))
        lines.append("hl.device({")
        lines.append(f"    name = {lua_str(hypr_name)},")
        lines += emitted
        lines.append("})")
        lines.append("")

    return "\n".join(lines)


# ── niri ────────────────────────────────────────────────────────────────────
def gen_niri(model):
    t, p, k = model["touchpad"], model["pointer"], model["keyboard"]
    # niri spells its flags kebab-case, and a boolean-false option is expressed
    # by OMITTING it rather than by `option false` — `niri validate` is what
    # confirms that per option.
    lines = [
        f"// {GENERATED_BANNER}",
        "//",
        "// Nothing to do by hand: rime-shell-firstrun appends",
        "//",
        f'//     include "{NIRI_OUT}"',
        "//",
        "// to ~/.config/niri/config.kdl, after every other section. niri",
        "// includes are positional and later definitions win, so these values",
        "// override the seeded config above them; niri watches this file and",
        "// live-reloads, so a change applies without a logout.",
        "",
        "input {",
        "    keyboard {",
        f"        repeat-delay {k['repeat_delay']}",
        f"        repeat-rate {k['repeat_rate']}",
        "    }",
        "",
        "    touchpad {",
    ]
    if t["tap"]:
        lines.append("        tap")
    if t["natural_scroll"]:
        lines.append("        natural-scroll")
    if t["disable_while_typing"]:
        lines.append("        dwt")
    if t["middle_emulation"]:
        lines.append("        middle-emulation")
    if t["left_handed"]:
        lines.append("        left-handed")
    # `drag-lock` is a bare flag in niri 26.04 — it takes NO argument, so
    # `drag-lock false` is a parse error rather than a way to turn it off.
    # Absence is off.
    if t["drag_lock"]:
        lines.append("        drag-lock")
    lines += [
        # `drag` is niri's tap-and-drag, and it is the one touchpad option here
        # that takes an explicit boolean. Written both ways on purpose: niri
        # enables tap-and-drag by default, so omitting it when the user turned
        # it off would leave it on.
        f"        drag {'true' if t['tap_and_drag'] else 'false'}",
        f"        accel-speed {t['speed']}",
        f'        accel-profile "{t["accel_profile"]}"',
        f'        scroll-method "{NIRI_SCROLL_METHODS[t["scroll_method"]]}"',
        f'        tap-button-map "{NIRI_TAP_BUTTON_MAPS[t["tap_button_map"]]}"',
        f"        scroll-factor {t['scroll_factor']}",
    ]
    # niri's click-method has two values and no "off". Emitting button-areas
    # for a user who asked for neither is a wrong answer dressed as a right
    # one, so the option is omitted and the gap is declared in CAPABILITIES.
    if t["click_method"] in NIRI_CLICK_METHODS:
        lines.append(f'        click-method "{NIRI_CLICK_METHODS[t["click_method"]]}"')
    lines += [
        "    }",
        "",
        "    mouse {",
    ]
    if p["natural_scroll"]:
        lines.append("        natural-scroll")
    if p["middle_emulation"]:
        lines.append("        middle-emulation")
    if p["left_handed"]:
        lines.append("        left-handed")
    lines += [
        f"        accel-speed {p['speed']}",
        f'        accel-profile "{p["accel_profile"]}"',
        f"        scroll-factor {p['scroll_factor']}",
        "    }",
        "}",
        "",
    ]
    return "\n".join(lines)


# ── labwc ───────────────────────────────────────────────────────────────────
def libinput_element(model):
    """The <libinput> element, built from the model."""
    t, p = model["touchpad"], model["pointer"]
    root = ET.Element("libinput")

    def device(category, cfg, is_touchpad):
        dev = ET.SubElement(root, "device", {"category": category})

        def sub(tag, text):
            ET.SubElement(dev, tag).text = text

        sub("naturalScroll", yn(cfg["natural_scroll"]))
        sub("leftHanded", yn(cfg["left_handed"]))
        sub("pointerSpeed", str(cfg["speed"]))
        sub("accelProfile", cfg["accel_profile"])
        sub("middleEmulation", yn(cfg["middle_emulation"]))
        sub("scrollFactor", str(cfg["scroll_factor"]))
        if is_touchpad:
            # Touchpad-only elements. `tap` is the real name; `tapToClick` is
            # not a labwc element and is silently ignored.
            sub("tap", yn(cfg["tap"]))
            sub("tapButtonMap", cfg["tap_button_map"])
            sub("tapAndDrag", yn(cfg["tap_and_drag"]))
            sub("dragLock", yn(cfg["drag_lock"]))
            sub("disableWhileTyping", yn(cfg["disable_while_typing"]))
            sub("clickMethod", cfg["click_method"])
            sub("scrollMethod", cfg["scroll_method"])
            if cfg["three_finger_drag"]:
                sub("threeFingerDrag", "yes")

    device("touchpad", t, True)
    device("default", p, False)

    # Per-device profiles, LAST, because labwc-config(5) says a category value
    # that is not one of its keywords "will be used to match the device name
    # directly" and a more specific profile is meant to win. Ordering them after
    # the two category profiles is belt and braces on that.
    for name in sorted(model.get("devices", {})):
        settings = model["devices"][name]
        dev = ET.SubElement(root, "device", {"category": name})
        wrote = False
        for key in sorted(settings):
            if key == "type":
                continue
            tag = LABWC_DEVICE_KEY.get(key)
            if tag is None:
                continue
            value = settings[key]
            if key == "enabled":
                text = yn(value)
            elif key in ("speed", "scroll_factor"):
                text = str(value)
            elif isinstance(value, bool):
                text = yn(value)
            else:
                text = str(value)
            ET.SubElement(dev, tag).text = text
            wrote = True
        if not wrote:
            root.remove(dev)
    return root


def set_keyboard_repeat(text, model):
    """Put repeat rate and delay into <keyboard>, returning (text, notes).

    Keyboard repeat is NOT a libinput setting in labwc: it lives in
    <keyboard><repeatRate> and <repeatDelay>, which is why the Repeat rate and
    Repeat delay sliders reached Hyprland and niri and did nothing at all in a
    labwc session.

    A span edit like the <libinput> one, and for the same reason — the shipped
    <keyboard> block is ninety lines of keybinds with a comment on most of them,
    and it carries the RIME-KEYBINDS markers another generator writes between.
    """
    k = model["keyboard"]
    notes = []
    open_m = re.search(r"<keyboard(?:\s[^>]*)?>", text)
    if open_m is None:
        return text, [f"{LABWC_RC} has no <keyboard> block; repeat rate not applied"]
    close_at = text.find("</keyboard>", open_m.end())
    if close_at == -1:
        return text, [f"{LABWC_RC} has an unterminated <keyboard>; repeat rate not applied"]

    for tag, value in (("repeatRate", k["repeat_rate"]), ("repeatDelay", k["repeat_delay"])):
        # Scoped to the block, re-derived each pass because an insertion moves
        # the closing tag. A repeatRate outside <keyboard> is not labwc's.
        block = text[open_m.end():close_at]
        found = re.search(rf"<{tag}>[^<]*</{tag}>", block)
        if found:
            start = open_m.end() + found.start()
            text = text[:start] + f"<{tag}>{value}</{tag}>" + text[start + len(found.group(0)):]
        else:
            text = (text[:open_m.end()] + f"\n    <{tag}>{value}</{tag}>"
                    + text[open_m.end():])
        open_m = re.search(r"<keyboard(?:\s[^>]*)?>", text)
        close_at = text.find("</keyboard>", open_m.end())
    return text, notes


def write_labwc(rc_path, model, dry_run):
    """Replace only the <libinput> span in rc.xml, byte-for-byte elsewhere.

    A span replacement rather than an ElementTree round-trip. Two reasons, both
    learned the hard way:

      * ElementTree discards comments unless the parser is told to keep them,
        and even then it CANNOT represent a comment outside the root element.
        rc.xml opens with a forty-line header explaining every decision in it,
        and a tree rewrite deleted that header silently.
      * A round-trip reindents and requotes regions nobody asked it to touch,
        so the diff a user sees after changing tap-to-click covers the whole
        file.

    So the tree is used only to VALIDATE — before, to refuse an unparseable
    file, and after, to refuse a bad result — while the edit itself is a
    substring swap. Everything outside <libinput> is preserved exactly.
    """
    if not os.path.exists(rc_path):
        return [f"{rc_path} does not exist; skipped"]

    try:
        with open(rc_path, encoding="utf-8") as fh:
            text = fh.read()
    except OSError as e:
        return [f"cannot read {rc_path}: {e}"]

    try:
        ET.fromstring(text)
    except ET.ParseError as e:
        # Never rewrite a file we cannot parse. A broken rc.xml already makes
        # labwc fall back to defaults silently; overwriting it would destroy the
        # user's keybinds along with whatever the real problem was.
        return [f"{rc_path} is not parseable ({e}); refusing to touch it"]

    element = libinput_element(model)
    ET.indent(element, space="  ", level=1)
    block = "  " + ET.tostring(element, encoding="unicode").strip()

    open_at = text.find("<libinput>")
    close_tag = "</libinput>"
    if open_at != -1:
        close_at = text.find(close_tag, open_at)
        if close_at == -1:
            return [f"{rc_path} has an unterminated <libinput>; refusing to touch it"]
        # Swallow the indentation on the opening line so the replacement lands
        # at the same depth rather than doubling it.
        line_start = text.rfind("\n", 0, open_at) + 1
        updated = text[:line_start] + block + text[close_at + len(close_tag):]
    else:
        # No existing block: insert before the closing root tag.
        root_close = text.rfind("</labwc_config>")
        if root_close == -1:
            return [f"{rc_path} has no </labwc_config>; refusing to touch it"]
        updated = text[:root_close] + block + "\n\n" + text[root_close:]

    updated, notes = set_keyboard_repeat(updated, model)

    try:
        ET.fromstring(updated)
    except ET.ParseError as e:
        return notes + [f"the generated rc.xml would not parse ({e}); the original is untouched"]

    if dry_run:
        return notes

    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(rc_path), prefix=".rc.xml.rime.")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(updated)
        shutil.copymode(rc_path, tmp)
        os.replace(tmp, rc_path)
    except OSError as e:
        if os.path.exists(tmp):
            os.unlink(tmp)
        return notes + [f"could not replace {rc_path}: {e}"]
    return notes


# ── validation and reload ───────────────────────────────────────────────────
def which(cmd):
    return shutil.which(cmd)


def _hyprland_unprivileged(cmd, env, config_dir):
    """Run Hyprland's config check as nobody when we are root.

    Hyprland 0.57.0's --verify-config binds its event socket at /.socket2.sock
    (an empty instance path) and segfaults whenever that bind succeeds, which
    only root can make it do: a build step, or a self-test under sudo. Measured
    in the image: the first root check in a fresh container crashes every time,
    a check as any other user passes. Hyprland also warns against running as
    root at all. So as root, the check runs as nobody, in a runtime directory
    nobody owns. Returns (cmd, env, scratch dir to remove or None).
    """
    if os.geteuid() != 0 or not shutil.which("setpriv"):
        return cmd, env, None
    os.chmod(config_dir, 0o755)  # TemporaryDirectory is 0700
    runtime = tempfile.mkdtemp()
    os.chown(runtime, 65534, 65534)
    env = dict(env, XDG_RUNTIME_DIR=runtime, HOME=runtime)
    return (["setpriv", "--reuid=65534", "--regid=65534", "--clear-groups", "--"] + cmd,
            env, runtime)


def validate_hyprland(text):
    """Parse the generated Lua the way Hyprland will actually load it.

    Wrapped in a config that `require`s it from a directory laid out like
    ~/.config/hypr, not checked as a standalone config. Two reasons:

      * `require("rime.input")` only resolves because Hyprland prepends the
        CONFIG FILE'S directory to package.path, so the module has to sit at
        rime/input.lua under the config being verified or the name will not
        resolve at all;
      * a Lua file that merely parses proves nothing. hl.config rejects an
        unknown option at call time, which is the mistake worth catching, and
        that only happens when Hyprland runs the chunk.

    Returns True/False, or None when Hyprland is not installed.
    """
    if not which("Hyprland"):
        return None
    env = dict(os.environ)
    env.setdefault("XDG_RUNTIME_DIR", tempfile.mkdtemp())
    with tempfile.TemporaryDirectory() as d:
        os.mkdir(os.path.join(d, "rime"))
        with open(os.path.join(d, "rime", "input.lua"), "w", encoding="utf-8") as fh:
            fh.write(text)
        wrapper = os.path.join(d, "hyprland.lua")
        with open(wrapper, "w", encoding="utf-8") as fh:
            fh.write('require("rime.input")\n')
        cmd, env, scratch = _hyprland_unprivileged(
            ["Hyprland", "--i-am-really-stupid", "--verify-config", "--config", wrapper], env, d)
        try:
            out = subprocess.run(cmd, capture_output=True, text=True, env=env, timeout=60)
        except (OSError, subprocess.SubprocessError):
            return None
        finally:
            if scratch:
                shutil.rmtree(scratch, ignore_errors=True)
        # Everything Hyprland has to say lands under "Config parsing result:",
        # and a clean config prints exactly "config ok" there. Checked against
        # the four ways this file can be wrong — an unknown config key, a value
        # of the wrong type, an unparseable bind string and a Lua error — and
        # none of them print it. So the banner's presence is the whole test.
        return "config ok" in (out.stdout + out.stderr)


def validate_niri(path):
    """Validate the generated file the way niri will actually see it.

    Wrapped in an `include`, not checked bare. niri accepts a fragment as a
    whole config, so validating the file directly proves only that the KDL
    parses — and that is precisely how a generated file no config ever included
    passed its own self-test while doing nothing on a real machine. The wrapper
    is the shipped shape: rime-shell-firstrun appends this same `include` line
    to ~/.config/niri/config.kdl.
    """
    if not which("niri"):
        return None
    with tempfile.TemporaryDirectory() as d:
        wrapper = os.path.join(d, "config.kdl")
        with open(wrapper, "w", encoding="utf-8") as fh:
            fh.write(f'include "{path}"\n')
        try:
            out = subprocess.run(["niri", "validate", "--config", wrapper],
                                 capture_output=True, text=True, timeout=60)
        except (OSError, subprocess.SubprocessError):
            return None
        if out.returncode == 0:
            return True
        # Say which half failed. "The mapping is wrong" and "this niri is too
        # old to have includes" need different fixes, and the wrapped run
        # cannot tell them apart on its own.
        try:
            bare = subprocess.run(["niri", "validate", "--config", path],
                                  capture_output=True, text=True, timeout=60)
        except (OSError, subprocess.SubprocessError):
            return False
        if bare.returncode == 0:
            print("      the generated file itself is valid; niri rejected the "
                  "`include` that reaches it (includes need niri 25.11+)",
                  file=sys.stderr)
        return False


def reload_compositor():
    desktop = os.environ.get("XDG_CURRENT_DESKTOP", "").lower()
    helper = "/usr/libexec/rime-compositor-reload"
    if not os.path.exists(helper):
        return "no reload helper; the compositor will pick it up on next reload"
    subprocess.run([helper], check=False)
    note = f"reloaded via rime-compositor-reload ({desktop or 'unknown desktop'})"
    # A reload that returns 0 is not a config that loaded. Hyprland keeps its
    # complaints in `configerrors` and carries on with the last good values, so
    # without this the page would report a successful apply over a config the
    # compositor rejected.
    if running_compositor() == "hyprland" and which("hyprctl"):
        try:
            out = subprocess.run(["hyprctl", "configerrors"],
                                 capture_output=True, text=True, timeout=15)
            errors = out.stdout.strip()
        except (OSError, subprocess.SubprocessError):
            return note
        if errors and errors.lower() != "no errors.":
            return f"{note}; Hyprland reports config errors: {errors}"
    return note


# ── reading back what is actually in effect ─────────────────────────────────
# The control has to show what the compositor is doing, not what we asked it to
# do. A page that writes and never reads cannot tell a working setting from one
# whose option was renamed upstream, which is how this page came to be full of
# switches that did nothing.
#
# `hyprctl getoption` is the only one of the three that answers at all: niri has
# no input query in `niri msg` and labwc has no IPC. Those two are read back
# from the file the compositor loads, which is weaker and is labelled as such
# rather than dressed up as a device query.
#
# The paths are NOT the Lua keys. `tap_to_click` in hl.config is `tap-to-click`
# to getoption, `tap_and_drag` is `tap-and-drag`, and the rest are underscored —
# asking for the Lua spelling gets "no such option", which a naive reader would
# report as "unset". tests/test-rime-input.sh asserts every path here answers.
HYPR_GETOPTION = {
    "touchpad.natural_scroll":       "input:touchpad:natural_scroll",
    "touchpad.tap":                  "input:touchpad:tap-to-click",
    "touchpad.tap_and_drag":         "input:touchpad:tap-and-drag",
    "touchpad.drag_lock":            "input:touchpad:drag_lock",
    "touchpad.disable_while_typing": "input:touchpad:disable_while_typing",
    "touchpad.middle_emulation":     "input:touchpad:middle_button_emulation",
    "touchpad.click_method":         "input:touchpad:clickfinger_behavior",
    "touchpad.tap_button_map":       "input:touchpad:tap_button_map",
    "touchpad.scroll_factor":        "input:touchpad:scroll_factor",
    "touchpad.three_finger_drag":    "input:touchpad:drag_3fg",
    "pointer.speed":                 "input:sensitivity",
    "pointer.accel_profile":         "input:accel_profile",
    "pointer.natural_scroll":        "input:natural_scroll",
    "pointer.left_handed":           "input:left_handed",
    "pointer.scroll_factor":         "input:scroll_factor",
    "keyboard.repeat_rate":          "input:repeat_rate",
    "keyboard.repeat_delay":         "input:repeat_delay",
}

BOOL_CONTROLS = {f"{s}.{k}" for s in DEFAULTS for k, v in DEFAULTS[s].items()
                 if isinstance(v, bool)}


def _from_hypr(control, answer):
    """One getoption answer as a model value, or None where it says nothing.

    Hyprland reports the TYPE it holds an option as, and which one that is is
    not predictable from the config key: drag_3fg comes back as `int` and
    tap-to-click as `bool`. Reading only `int` made every boolean control read
    False — the page then showed a setting the user had just turned on as off,
    and reported it diverged. So the answer is taken from whichever key is
    there rather than from a guess per option.
    """
    truth = answer.get("bool", answer.get("int"))
    if control == "touchpad.click_method":
        return None if truth is None else ("clickfinger" if truth else "buttonAreas")
    if control == "touchpad.three_finger_drag" or control in BOOL_CONTROLS:
        return None if truth is None else bool(truth)
    if "str" in answer:
        text = answer["str"]
        return None if text == "[[EMPTY]]" else text
    if "float" in answer:
        return round(float(answer["float"]), 4)
    if "int" in answer:
        return int(answer["int"])
    return None


def read_back_hyprland():
    values, notes = {}, []
    if not which("hyprctl") or not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return values, ["Hyprland is not running, so nothing could be queried"]
    for control, path in HYPR_GETOPTION.items():
        try:
            out = subprocess.run(["hyprctl", "-j", "getoption", path],
                                 capture_output=True, text=True, timeout=10)
            answer = json.loads(out.stdout)
        except (OSError, subprocess.SubprocessError, json.JSONDecodeError, ValueError):
            notes.append(f"{control}: Hyprland did not answer for {path}")
            continue
        # `set` is Hyprland's own word for "the config told me this". An option
        # nothing has set reads back as [[EMPTY]], and the value in effect is
        # then Hyprland's built-in default, which this cannot name. Reporting
        # null with set=false says that; dropping the control would leave the
        # page with nothing to show and no reason why.
        values[control] = {"value": _from_hypr(control, answer),
                           "set": bool(answer.get("set")),
                           "source": "compositor", "path": path}
    return values, notes


# The bare flags are the awkward half: niri says a boolean is false by leaving
# the line out, so absence is a real answer — but only once the block has been
# read. An unreadable file must yield NO answer rather than false for every
# control, or a session where the file has never been written reports the whole
# page as diverged from settings nobody has touched.
NIRI_FLAGS = {
    "touchpad": {"tap": "tap", "natural_scroll": "natural-scroll",
                 "disable_while_typing": "dwt", "drag_lock": "drag-lock",
                 "middle_emulation": "middle-emulation", "left_handed": "left-handed"},
    "pointer":  {"natural_scroll": "natural-scroll",
                 "middle_emulation": "middle-emulation", "left_handed": "left-handed"},
}
NIRI_VALUES = {
    "touchpad": {
        "tap_and_drag":   (r"^\s+drag (true|false)$", lambda m: m.group(1) == "true"),
        "speed":          (r"^\s+accel-speed (\S+)$", lambda m: float(m.group(1))),
        "accel_profile":  (r'^\s+accel-profile "(\w+)"$', lambda m: m.group(1)),
        "scroll_factor":  (r"^\s+scroll-factor (\S+)$", lambda m: float(m.group(1))),
        "scroll_method":  (r'^\s+scroll-method "([\w-]+)"$',
                           lambda m: {v: k for k, v in NIRI_SCROLL_METHODS.items()}[m.group(1)]),
        "click_method":   (r'^\s+click-method "([\w-]+)"$',
                           lambda m: {v: k for k, v in NIRI_CLICK_METHODS.items()}[m.group(1)]),
        "tap_button_map": (r'^\s+tap-button-map "([\w-]+)"$',
                           lambda m: {v: k for k, v in NIRI_TAP_BUTTON_MAPS.items()}[m.group(1)]),
    },
    "pointer": {
        "speed":         (r"^\s+accel-speed (\S+)$", lambda m: float(m.group(1))),
        "accel_profile": (r'^\s+accel-profile "(\w+)"$', lambda m: m.group(1)),
        "scroll_factor": (r"^\s+scroll-factor (\S+)$", lambda m: float(m.group(1))),
    },
    "keyboard": {
        "repeat_rate":  (r"^\s+repeat-rate (\d+)$", lambda m: int(m.group(1))),
        "repeat_delay": (r"^\s+repeat-delay (\d+)$", lambda m: int(m.group(1))),
    },
}
NIRI_BLOCK = {"touchpad": "touchpad", "pointer": "mouse", "keyboard": "keyboard"}

# The five Hyprland can only express per device, and so cannot be asked about:
# `hyprctl getoption` has no path for a device field. Read from the module the
# compositor loaded instead, and labelled `file` so the page does not claim a
# device query it did not make.
HYPR_DEVICE_READ = {
    "touchpad.speed":            (r"^    sensitivity = (\S+),$", float),
    "touchpad.accel_profile":    (r'^    accel_profile = "(\w+)",$', str),
    "touchpad.left_handed":      (r"^    left_handed = (true|false),$",
                                  lambda s: s == "true"),
    "touchpad.scroll_method":    (r'^    scroll_method = "(\w+)",$',
                                  lambda s: {v: k for k, v in HYPR_SCROLL_METHODS.items()}[s]),
    "pointer.middle_emulation":  (r"^    middle_button_emulation = (true|false),$",
                                  lambda s: s == "true"),
}


def _read_hypr_device_block(values, devices):
    """The routed per-device settings, read out of the Lua module on disk."""
    try:
        with open(HYPR_OUT, encoding="utf-8") as fh:
            text = fh.read()
    except OSError:
        return
    wanted = {"touchpad": [d for d in devices if d["type"] == "touchpad"],
              "pointer": [d for d in devices if d["type"] in ("mouse", "trackpoint")]}
    for control, (pattern, cast) in HYPR_DEVICE_READ.items():
        section = control.split(".", 1)[0]
        if not wanted[section]:
            continue
        name = wanted[section][0]["hypr_name"]
        block = re.search(rf'^hl\.device\(\{{\n    name = "{re.escape(name)}",\n'
                          r"(.*?)^\}\)$", text, re.M | re.S)
        if block is None:
            continue
        found = re.search(pattern, block.group(1), re.M)
        if found:
            values[control] = {"value": cast(found.group(1)), "source": "file",
                               "path": HYPR_OUT, "device": name}


def _read_niri(values, notes):
    try:
        with open(NIRI_OUT, encoding="utf-8") as fh:
            whole = fh.read()
    except OSError as e:
        notes.append(f"cannot read {NIRI_OUT}: {e}; nothing was read back")
        return
    for section, block_name in NIRI_BLOCK.items():
        # Per block, because every block uses the same option names and a
        # whole-file regex cannot tell a mouse's accel-speed from a touchpad's.
        block = re.search(rf"^ *{block_name} \{{$(.*?)^    \}}$", whole, re.M | re.S)
        if block is None:
            continue
        body = block.group(1)
        for key, flag in NIRI_FLAGS.get(section, {}).items():
            values[f"{section}.{key}"] = {
                "value": re.search(rf"^\s+{flag}$", body, re.M) is not None,
                "source": "file", "path": NIRI_OUT}
        for key, (pattern, cast) in NIRI_VALUES.get(section, {}).items():
            found = re.search(pattern, body, re.M)
            if found:
                values[f"{section}.{key}"] = {"value": cast(found), "source": "file",
                                              "path": NIRI_OUT}


def _read_labwc(values, notes):
    try:
        with open(LABWC_RC, encoding="utf-8") as fh:
            text = fh.read()
        root = ET.fromstring(text)
    except (OSError, ET.ParseError) as e:
        notes.append(f"cannot read {LABWC_RC}: {e}; nothing was read back")
        return
    tag_to_key = {v: k for k, v in LABWC_DEVICE_KEY.items()}
    numeric = {"speed", "scroll_factor"}
    for dev in root.iter("device"):
        section = {"touchpad": "touchpad", "default": "pointer"}.get(
            dev.get("category", ""))
        if section is None:
            continue
        for child in dev:
            key = tag_to_key.get(child.tag)
            if key is None or child.text is None:
                continue
            control = f"{section}.{key}"
            raw = child.text.strip()
            if control in BOOL_CONTROLS:
                value = raw in ("yes", "true")
            elif key in numeric:
                try:
                    value = float(raw)
                except ValueError:
                    continue
            else:
                value = raw
            values[control] = {"value": value, "source": "file", "path": LABWC_RC}
        # threeFingerDrag is written only when it is on, so its absence is the
        # answer "off" rather than "unknown" — and without this the one labwc
        # control that can be off by omission has no read-back at all.
        if section == "touchpad" and dev.find("threeFingerDrag") is None:
            values["touchpad.three_finger_drag"] = {
                "value": False, "source": "file", "path": LABWC_RC}
    # Keyboard repeat is not in <libinput> and would otherwise be the one pair
    # of controls with no read-back at all on labwc.
    kb = root.find("keyboard")
    if kb is not None:
        for tag, key, cast in (("repeatRate", "repeat_rate", int),
                               ("repeatDelay", "repeat_delay", int)):
            child = kb.find(tag)
            if child is not None and child.text:
                values[f"keyboard.{key}"] = {"value": cast(child.text.strip()),
                                             "source": "file", "path": LABWC_RC}


def read_back(model_path):
    """What is actually in effect, per control, and where the answer came from."""
    comp = running_compositor()
    values, notes = {}, []
    # One enumeration for the whole call. It shells out to `hyprctl -j devices`,
    # and this used to do it twice — once here and once inside capabilities()
    # below — on a path the settings page runs after every apply.
    devices, _ = enumerate_devices()
    if comp == "hyprland":
        values, notes = read_back_hyprland()
        _read_hypr_device_block(values, devices)
        notes.append("pointer speed, acceleration, left-handed and scroll "
                     "method for the touchpad have no Hyprland query, so those "
                     "are read from the module Hyprland loads")
    elif comp == "niri":
        _read_niri(values, notes)
        notes.append("niri has no input query in `niri msg`, so these are read "
                     "from the file niri loads rather than from the compositor")
    elif comp == "labwc":
        _read_labwc(values, notes)
        notes.append("labwc has no IPC, so these are read from rc.xml rather "
                     "than from the compositor")
    else:
        notes.append("no supported compositor is running, so nothing could be "
                     "read back")

    model, model_notes = load_model(model_path)
    wanted = {f"{s}.{k}": v for s in ("touchpad", "pointer", "keyboard")
              for k, v in model[s].items()}
    caps = capabilities(devices)
    diverged = []
    for control, want in wanted.items():
        seen = values.get(control)
        # A null is "the compositor was never told", which is a state to show,
        # not a mismatch to shout about.
        if seen is None or seen["value"] is None:
            continue
        cap = caps["controls"].get(control, {}).get(comp or "", {})
        if not cap.get("supported", True):
            continue
        if isinstance(want, float) or isinstance(seen["value"], float):
            same = abs(float(want) - float(seen["value"])) < 1e-4
        else:
            same = want == seen["value"]
        if not same:
            diverged.append({"control": control, "wanted": want,
                             "effective": seen["value"], "source": seen["source"]})

    return {"compositor": comp, "values": values, "diverged": diverged,
            "notes": notes + model_notes}


def atomic_write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".rime-input.")
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write(text)
    os.replace(tmp, path)


# ── entry points ────────────────────────────────────────────────────────────
def self_test():
    """Generate from the defaults and run every available validator."""
    model = {k: dict(v) for k, v in DEFAULTS.items()}
    rc = 0

    # A device the defaults do not mention, so --self-test covers the hl.device
    # path as well as the global block. In the MODEL's vocabulary, which is what
    # the Settings page writes: `speed` and `tap`, not Hyprland's `sensitivity`
    # and `tap_to_click`. If the translation table is wrong, the validators
    # below are what says so.
    model["devices"] = {
        "Rime Self Test Touchpad": {
            "type": "touchpad",
            "natural_scroll": True, "tap": True, "speed": 0.3,
            "accel_profile": "adaptive", "disable_while_typing": True,
            "scroll_method": "twofinger", "left_handed": False,
            "click_method": "clickfinger", "three_finger_drag": True,
        },
        "Rime Self Test Mouse": {
            "type": "mouse", "middle_emulation": True, "speed": -0.2,
        },
    }
    # A synthetic touchpad in the enumeration too, so the routed pass — the
    # four settings Hyprland can only express per device — is generated and
    # validated even on a build host with no input devices at all.
    fake_devices = [
        {"name": "Rime Self Test Touchpad", "type": "touchpad",
         "hypr_name": "rime-self-test-touchpad", "hypr_name_source": "derived"},
        {"name": "Rime Self Test Mouse", "type": "mouse",
         "hypr_name": "rime-self-test-mouse", "hypr_name_source": "derived"},
    ]

    hypr = gen_hyprland(model, fake_devices)
    niri = gen_niri(model)

    with tempfile.TemporaryDirectory() as d:
        np_ = os.path.join(d, "input.kdl")
        with open(np_, "w", encoding="utf-8") as fh:
            fh.write(niri)

        for name, result in (("Hyprland", validate_hyprland(hypr)),
                             ("niri", validate_niri(np_))):
            if result is None:
                print(f"SKIP  {name} not installed; cannot validate its output")
            elif result:
                print(f"PASS  {name} accepts the generated config")
            else:
                print(f"FAIL  {name} rejects the generated config")
                rc = 1

    # The generated file must be Lua that hyprland.lua can require, not hyprlang.
    # Asserted here as well as parsed above, because a file that happens to parse
    # as both is exactly the regression this migration exists to prevent.
    for want in ("hl.config({", "input = {", "hl.device({",
                 'name = "rime-self-test-touchpad"',
                 # The four Hyprland has no touchpad-block option for. If the
                 # routed pass stops running, these vanish and the Touchpad
                 # page silently loses pointer speed, acceleration, left-handed
                 # and scroll method.
                 "sensitivity = 0.3", 'accel_profile = "adaptive"',
                 'scroll_method = "2fg"', "middle_button_emulation = true"):
        if want in hypr:
            print(f"PASS  hyprland emits: {want}")
        else:
            print(f"FAIL  hyprland is missing: {want}")
            rc = 1
    leftovers = [s for s in ("source =", "tap-to-click", "tap-and-drag")
                 if s in hypr]
    if leftovers:
        print(f"FAIL  hyprland output still carries hyprlang: {', '.join(leftovers)}")
        rc = 1
    else:
        print("PASS  no hyprlang left in the Hyprland output")

    # labwc has no config validator, so check the XML is well formed and that
    # every element name is one labwc documents.
    el = libinput_element(model)
    try:
        ET.fromstring(ET.tostring(el))
        print("PASS  the labwc <libinput> element is well-formed XML")
    except ET.ParseError as e:
        print(f"FAIL  labwc element is not well-formed: {e}")
        rc = 1

    known = labwc_known_elements()
    if known is None:
        print("SKIP  labwc's rc.xml.all unavailable; cannot check element names")
    else:
        used = {c.tag for d in el for c in d}
        unknown = sorted(used - known)
        if unknown:
            print(f"FAIL  labwc does not implement: {', '.join(unknown)}")
            rc = 1
        else:
            print(f"PASS  all {len(used)} labwc element names are implemented")
    return rc


def labwc_known_elements():
    """Element names labwc implements, read from its own annotated reference.

    Every libinput region is scanned and unioned, not just the first: rc.xml.all
    contains more than one `<libinput>` block and the first is empty, so taking
    `find()` alone produced an empty set and then declared every correct element
    name unimplemented.
    """
    for cand in ("/usr/share/doc/labwc/rc.xml.all",):
        if not os.path.exists(cand):
            continue
        with open(cand, encoding="utf-8") as fh:
            text = fh.read()
        names = set()
        for region in re.findall(r"<libinput>(.*?)</libinput>", text, re.S):
            names |= set(re.findall(r"<([a-zA-Z]+)>", region))
        names -= {"libinput", "device"}
        return names or None
    return None


def main(argv=None):
    ap = argparse.ArgumentParser(description="Generate compositor input configs from the Rime model.")
    ap.add_argument("--model", default=MODEL_PATH)
    ap.add_argument("--dry-run", action="store_true", help="print what would be written")
    ap.add_argument("--no-reload", action="store_true")
    ap.add_argument("--self-test", action="store_true",
                    help="generate from defaults and run every compositor validator")
    ap.add_argument("--devices", action="store_true",
                    help="list the input devices present, classified, as JSON")
    ap.add_argument("--capabilities", action="store_true",
                    help="what each compositor can do, and the reason where it cannot")
    ap.add_argument("--read-back", action="store_true",
                    help="what is actually in effect, and where the answer came from")
    args = ap.parse_args(argv)

    if args.self_test:
        return self_test()

    if args.devices:
        devices, notes = enumerate_devices()
        print(json.dumps({"devices": devices, "notes": notes}, indent=2))
        return 0

    if args.capabilities:
        print(json.dumps(capabilities(), indent=2))
        return 0

    if args.read_back:
        print(json.dumps(read_back(args.model), indent=2))
        return 0

    model, notes = load_model(args.model)
    devices, device_notes = enumerate_devices()
    notes += device_notes
    for note in notes:
        print(f"rime-input: {note}", file=sys.stderr)

    hypr = gen_hyprland(model, devices)
    niri = gen_niri(model)

    if args.dry_run:
        print(f"--- {HYPR_OUT} ---\n{hypr}")
        print(f"--- {NIRI_OUT} ---\n{niri}")
        el = libinput_element(model)
        ET.indent(el, space="  ")
        print(f"--- {LABWC_RC} <libinput> ---\n{ET.tostring(el, encoding='unicode')}")
        return 0

    # Validate before replacing anything, per compositor, so one bad value
    # cannot take a session down.
    #
    # PER COMPOSITOR, and that is the whole point of the word. This used to
    # refuse to write ANYTHING when either validator said no, which meant a
    # machine with a broken or half-installed niri could not change a touchpad
    # setting in a Hyprland session: the page reported success, no config was
    # written, and the reason went to a stderr line about niri. One compositor's
    # opinion of its own config is not a veto over the other two.
    with tempfile.TemporaryDirectory() as d:
        hypr_ok = validate_hyprland(hypr) is not False
        np_ = os.path.join(d, "input.kdl")
        with open(np_, "w", encoding="utf-8") as fh:
            fh.write(niri)
        niri_ok = validate_niri(np_) is not False

    if not hypr_ok:
        print("rime-input: the generated Hyprland config was rejected; the "
              "previous one is left in place", file=sys.stderr)
    if not niri_ok:
        print("rime-input: the generated niri config was rejected; the previous "
              "one is left in place", file=sys.stderr)
    # Refusing every write is only right when the model itself is the problem,
    # which is what both validators disagreeing with it means.
    if not hypr_ok and not niri_ok:
        return 1

    if hypr_ok:
        atomic_write(HYPR_OUT, hypr)
    if niri_ok:
        atomic_write(NIRI_OUT, niri)
    for note in write_labwc(LABWC_RC, model, args.dry_run):
        print(f"rime-input: {note}", file=sys.stderr)

    if not args.no_reload:
        print(f"rime-input: {reload_compositor()}")
    return 0 if (hypr_ok and niri_ok) else 1


if __name__ == "__main__":
    sys.exit(main())
