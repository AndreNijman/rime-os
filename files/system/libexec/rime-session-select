#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  Rime OS — choose which session the greeter will preselect next
#
#  WHAT THIS IS FOR
#  Entering Gaming Mode from the desktop (the shell's power menu) and leaving it
#  again. Both directions come down to the same thing: remember which session
#  should be preselected, then end the current one so greetd shows the greeter.
#
#  WHY IT NEEDS ROOT
#  The greeter's memory lives in /var/lib/rime-greet, which tmpfiles creates
#  0755 greetd:greetd — the greeter runs as `greetd` and a session user has no
#  write access to it (nor should it). Exactly the same wall the wallpaper
#  publisher hit, solved the same way: a narrow root helper behind a NOPASSWD
#  rule, taking no caller-supplied paths.
#
#  THE SWITCH IS A TOGGLE (2026-10-08)
#  `--switch` used to end the session and leave the user at the greeter, to type
#  their password again. Gaming Mode is now a toggle, the way SteamOS and Bazzite
#  have it: the switch hands greetd a ONE-SHOT `[initial_session]` for the
#  caller's own account and the requested session, and greetd logs them straight
#  in. What makes that safe to offer:
#
#    * Only an already-authenticated session can ask: the grant is the existing
#      NOPASSWD sudoers rule (%wheel), and the account is SUDO_UID's own, never a
#      caller-chosen user. Nothing becomes reachable that the caller did not
#      already have open in front of them.
#    * It is spent on use. The config lives in /run (gone at reboot), root-owned
#      0600, and /usr/libexec/rime-greetd consumes it the next time greetd starts
#      and refuses it if it is more than 60 seconds old. /etc/greetd/config.toml
#      never gains an [initial_session]; the image build still asserts that.
#    * A locked desktop cannot ask (the power menu is behind the lock), and the
#      one-shot is only ever written by this helper.
#
#  Leaving Gaming Mode lands on the desktop the user came from
#  (/var/lib/rime-greet/last-desktop), through the same path.
#
#  SAFETY
#  The requested session is validated against the .desktop files actually
#  installed in /usr/share/wayland-sessions — a caller cannot name something
#  that is not a real session, and cannot smuggle a path. Terminating the
#  session is something an unprivileged user can already do (loginctl,
#  logging out of the desktop), so the only privileged effect here is writing
#  one short, validated string into the greeter's state directory.
#
#  NOTE ON --switch: it uses `loginctl terminate-user`, which ends EVERY session
#  belonging to the caller — including an SSH login. That is deliberate (a
#  graphical session owns several logind sessions and terminating only the
#  "current" one can leave the display half torn down), but it will surprise
#  anyone driving this over SSH.
#
#  Usage:
#    rime-session-select <session-id>            remember it, do NOT log out
#    rime-session-select <session-id> --switch [--from <session-id>]
#                                                switch to it now: end this
#                                                session and log straight in
#    rime-session-select --list                  print valid session ids
#    rime-session-select --desktop               print the desktop session to
#                                                return to from Gaming Mode
#
#  Env overrides for tests/test-rime-session-toggle.sh only: RIME_SESSION_DIR,
#  RIME_GREET_STATE_DIR, RIME_GREET_RUN_DIR, RIME_GREETD_CONFIG, and
#  RIME_SWITCH_TOOLS (a directory of stand-ins for loginctl, systemctl,
#  systemd-run and getent).
# ─────────────────────────────────────────────────────────────────────────────
set -uo pipefail

STATE_DIR="${RIME_GREET_STATE_DIR:-/var/lib/rime-greet}"
SESSION_DIR="${RIME_SESSION_DIR:-/usr/share/wayland-sessions}"
RUN_DIR="${RIME_GREET_RUN_DIR:-/run/rime-greet}"
GREETD_CONFIG="${RIME_GREETD_CONFIG:-/etc/greetd/config.toml}"
GAMING_SESSION=rime-gaming
[ -n "${RIME_SWITCH_TOOLS:-}" ] && PATH="${RIME_SWITCH_TOOLS}:${PATH}"

say() { printf 'rime-session-select: %s\n' "$*" >&2; }
die() { say "$*"; exit 1; }

valid_sessions() {
    for f in "${SESSION_DIR}"/*.desktop; do
        [ -r "$f" ] || continue
        basename "$f" .desktop
    done
}

[ "$(id -u)" -eq 0 ] || [ -n "${RIME_SWITCH_TOOLS:-}" ] \
    || die "must run as root (via sudo -n /usr/libexec/rime-session-select)"

is_session() {  # $1 = id; true when it is a plain id naming an installed session
    case "$1" in '' | *[!A-Za-z0-9._-]* | .* | *--*) return 1 ;; esac
    # A loop, not `| grep -q`: under pipefail an early-exiting grep kills the
    # writer with SIGPIPE and a MATCH comes back as failure.
    local s
    while read -r s; do [ "$s" = "$1" ] && return 0; done < <(valid_sessions)
    return 1
}

# ── The finisher, run as a transient root unit so it outlives the session it
#    ends. Never through sudo: SUDO_UID set means a caller typed it.
if [ "${1:-}" = "--finish-switch" ]; then
    [ -z "${SUDO_UID:-}" ] || die "--finish-switch is internal"
    uid="${2:-}"
    case "${uid}" in '' | *[!0-9]*) die "--finish-switch: bad uid" ;; esac
    seat_sessions() {
        for sid in $(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $1}'); do
            [ "$(loginctl show-session "$sid" -p User --value 2>/dev/null)" = "${uid}" ] || continue
            [ "$(loginctl show-session "$sid" -p Seat --value 2>/dev/null)" = seat0 ] || continue
            [ "$(loginctl show-session "$sid" -p State --value 2>/dev/null)" = closing ] && continue
            printf '%s\n' "$sid"
        done
    }
    for sid in $(seat_sessions); do loginctl terminate-session "$sid" 2>/dev/null; done
    for _ in $(seq 1 75); do [ -z "$(seat_sessions)" ] && break; sleep 0.2; done
    say "restarting greetd for the switch"
    exec systemctl restart greetd.service
fi

if [ "${1:-}" = "--desktop" ]; then
    d="$(cat "${STATE_DIR}/last-desktop" 2>/dev/null)"
    if is_session "$d" && [ "$d" != "${GAMING_SESSION}" ]; then printf '%s\n' "$d"; else printf 'hyprland\n'; fi
    exit 0
fi

if [ "${1:-}" = "--list" ]; then
    valid_sessions
    exit 0
fi

want="${1:-}"
[ -n "${want}" ] || die "no session given (try --list)"

# Reject anything that is not a plain id BEFORE it is used in a path.
case "${want}" in
    '' | *[!A-Za-z0-9._-]* | .* | *--*) die "refusing suspicious session id '${want}'" ;;
esac

# And reject anything that is not actually installed. This is the check that
# makes the sudoers grant safe to hand out: the only strings that reach the
# state file are names of real, shipped sessions.
found=0
while read -r s; do
    [ "$s" = "${want}" ] && { found=1; break; }
done < <(valid_sessions)
[ "${found}" = 1 ] || die "'${want}' is not an installed session (try --list)"

mkdir -p "${STATE_DIR}"
# Owned by greetd, because greetd rewrites this file itself on every successful
# login; leaving it root-owned would break the greeter's own bookkeeping.
printf '%s' "${want}" > "${STATE_DIR}/last-session"
chown greetd:greetd "${STATE_DIR}/last-session" 2>/dev/null || true
chmod 0644 "${STATE_DIR}/last-session"
# Force it to disk BEFORE the session is torn down. Without this the write sits
# in page cache while `loginctl terminate-user` below kills everything, and the
# failure mode is "asked for Gaming Mode, got the desktop back" — intermittent,
# and miserable to diagnose.
sync "${STATE_DIR}/last-session" 2>/dev/null || sync
say "next session: ${want}"

[ "${2:-}" = "--switch" ] || exit 0

# The CALLER's account, never a caller-chosen one. SUDO_UID is set by sudo and
# cannot be forged by an unprivileged caller.
uid="${SUDO_UID:-}"
case "${uid}" in
    '' | *[!0-9]*) die "no usable SUDO_UID; refusing to switch anything" ;;
esac
user="$(getent passwd "${uid}" | cut -d: -f1)"
case "${user}" in '' | *[!A-Za-z0-9._-]*) die "uid ${uid} has no usable account name" ;; esac

# Where to come back to: the desktop the switch into Gaming Mode came from.
if [ "${want}" = "${GAMING_SESSION}" ] && [ "${3:-}" = "--from" ] && is_session "${4:-}" \
   && [ "${4}" != "${GAMING_SESSION}" ]; then
    printf '%s' "$4" > "${STATE_DIR}/last-desktop"
    chmod 0644 "${STATE_DIR}/last-desktop"
fi

# The one-shot. The session's own Exec line, run the way the greeter runs it
# (`sh -lc`), and only when that line is plain enough to put in TOML verbatim;
# anything else falls back to the greeter, which is the old behaviour.
exec_line="$(sed -n 's/^Exec=//p' "${SESSION_DIR}/${want}.desktop" | head -n1)"
autologin=0
case "${exec_line}" in
    '' | *[!A-Za-z0-9/._\ -]*) say "session ${want}: Exec line is not plain; the greeter will ask instead" ;;
    *)
        mkdir -p "${RUN_DIR}"; chmod 0700 "${RUN_DIR}"
        tmp="$(mktemp "${RUN_DIR}/switch.XXXXXX")" || die "cannot write ${RUN_DIR}"
        { grep -v '^[[:space:]]*\[initial_session\]' "${GREETD_CONFIG}"
          printf '\n[initial_session]\ncommand = "sh -lc '"'"'exec %s'"'"'"\nuser = "%s"\n' "${exec_line}" "${user}"
        } > "${tmp}"
        chmod 0600 "${tmp}"
        mv -f "${tmp}" "${RUN_DIR}/switch.toml"
        autologin=1
        ;;
esac
sync "${STATE_DIR}/last-session" 2>/dev/null || sync

if [ "${autologin}" = 1 ]; then
    say "switching ${user} to ${want}"
    # Outlives this session: the finisher ends it, then restarts greetd.
    exec systemd-run --quiet --collect --unit="rime-session-switch-$$" \
        /usr/libexec/rime-session-select --finish-switch "${uid}"
fi
say "ending session for uid ${uid} — the greeter will come back with ${want} selected"
exec loginctl terminate-user "${uid}"
