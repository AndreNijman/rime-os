#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  rime-gamescope-steam — starts Steam inside Gaming Mode's gamescope, keeps
#  gamescope compositing while HDR is off, and turns opacity micromaps off for
#  Proton games on NVIDIA GPUs older than Ada.
#
#  Usage (rime-gaming-session runs it as gamescope's command):
#    gamescope … -- rime-gamescope-steam steam -gamepadui -steamos3
#
#  ── Why ─────────────────────────────────────────────────────────────────────
#  Measured on katana (RTX 3070 Laptop, NVIDIA 615.71.09, HDMI monitor,
#  2026-10-08): with HDR on, gamescope composites every frame and the picture
#  is right. With HDR off it scans Steam's buffer out directly, and the screen
#  showed the image three times over, with lines, flicker and wrong colours.
#  Setting gamescope's GAMESCOPE_COMPOSITE_FORCE root property to 1 fixed it
#  on the spot. Steam writes that property itself (its developer "Force
#  Composite" setting, 0 by default), so it is not set once: a guard watches
#  it, and HDR, for as long as Steam runs.
#
#  HDR is kept OFF as well. Rime never passes --hdr-enabled, but Steam turns
#  HDR on by itself on an HDR-capable display (GAMESCOPE_DISPLAY_HDR_ENABLED),
#  and it costs 4-5 % of the frame rate there.
#
#  ── Knobs ───────────────────────────────────────────────────────────────────
#    RIME_GAMING_HDR=steam            let Steam's HDR setting through
#    RIME_GAMING_FORCE_COMPOSITE=0    leave composition to gamescope
#    RIME_GAMING_OMM=on               keep opacity micromaps on an older NVIDIA GPU
#    __GL_SHADER_DISK_CACHE_SIZE      NVIDIA shader cache size per game (12 GB)
#
#  The guard is the property watcher only: if xprop is missing or the X
#  server is gone, Steam still starts and nothing else changes.
# ─────────────────────────────────────────────────────────────────────────────
set -uo pipefail

log() { printf 'rime-gamescope-steam: %s\n' "$*" >&2; }

HDR_POLICY="${RIME_GAMING_HDR:-off}"
FORCE_COMPOSITE="${RIME_GAMING_FORCE_COMPOSITE:-1}"

# ── NVIDIA shader cache size ────────────────────────────────────────────────
# Steam gives every game its own NVIDIA cache directory and sets
# __GL_SHADER_DISK_CACHE_SKIP_CLEANUP=1, but no size, so the driver's 1 GB
# default applies; for Mesa it sets MESA_SHADER_CACHE_MAX_SIZE=5G. Once a
# game's cache is over the limit, new shaders are not kept. Measured on katana
# (RTX 3070 Laptop, 615.71.09) with THE FINALS, whose cache had reached 2.1 GB:
# by default every launch preloaded its shaders from scratch (24 % and 26 % of
# the preload after ~3.5 min, ~3,000-3,500 CPU-seconds each). With 12 GB the
# preload finished inside 220 s and the next launch used 660 CPU-seconds. A
# value the user already set is left alone. Ignored by every other driver.
export __GL_SHADER_DISK_CACHE_SIZE="${__GL_SHADER_DISK_CACHE_SIZE:-12000000000}"

set_root() { xprop -root -f "$1" 32c -set "$1" "$2" 2>/dev/null; }

# One `xprop -spy` line in, the properties put right. Only a value that
# differs is written: every write comes back as another line. Nothing is
# decided about a property before its first line arrives (an absent property
# reads as an empty value, which is not `unread`).
hdr=unread composite=unread
enforce() {
    local line="$1" value=""
    case "$line" in *" = "*) value="${line##* = }" ;; esac
    case "$line" in
        GAMESCOPE_DISPLAY_HDR_ENABLED*) hdr="$value" ;;
        GAMESCOPE_COMPOSITE_FORCE*)     composite="$value" ;;
        *) return 0 ;;
    esac
    if [ "$HDR_POLICY" = off ] && [ "$hdr" = 1 ]; then
        set_root GAMESCOPE_DISPLAY_HDR_ENABLED 0 && log "HDR turned off"
        hdr=0
    fi
    if [ "$FORCE_COMPOSITE" = 1 ] && [ "$hdr" != 1 ] && [ "$hdr" != unread ] \
       && [ "$composite" != 1 ] && [ "$composite" != unread ]; then
        set_root GAMESCOPE_COMPOSITE_FORCE 1 && log "HDR is off: compositing forced"
        composite=1
    fi
}

# Runs until the process it was started for ($1, Steam) is gone, or the X
# server closes the watch. It must not outlive Steam: gamescope's reaper may
# wait for every process in the session before gamescope exits.
guard() {
    local owner="$1" line rc spy
    exec 3< <(exec xprop -root -spy GAMESCOPE_DISPLAY_HDR_ENABLED GAMESCOPE_COMPOSITE_FORCE 2>/dev/null)
    spy=$!
    while kill -0 "$owner" 2>/dev/null; do
        if IFS= read -r -t 2 line <&3; then
            enforce "$line"
        else
            rc=$?
            [ "$rc" -gt 128 ] || break   # not a timeout: the watch ended
        fi
    done
    kill "$spy" 2>/dev/null
}

# ── NVIDIA GPUs older than Ada: no opacity micromaps ────────────────────────
# Measured on katana (RTX 3070 Laptop, GA104, NVIDIA 615.71.09): since
# vkd3d-proton 6ef5e11e (in Proton Experimental from 2026-10-01) enables
# VK_KHR_opacity_micromap whenever DXR is on, Cyberpunk 2077 with ray tracing
# hangs the GPU while loading (Xid 109) and its watchdog kills it after 120 s.
# With the extension disabled it runs the benchmark at RT Ultra. Ada (device
# 0x2600) and later have the micromap hardware and are left alone. Upstream:
# https://github.com/HansKristian-Work/vkd3d-proton/pull/3362 . Remove this once
# Proton ships that or an NVIDIA driver fixes the hang.
nvidia_before_ada() {
    local dev class id
    for dev in "${RIME_SYSFS:-/sys}"/bus/pci/devices/*; do
        [ "$(cat "$dev/vendor" 2>/dev/null)" = 0x10de ] || continue
        class="$(cat "$dev/class" 2>/dev/null)"
        case "$class" in 0x03*) ;; *) continue ;; esac
        id="$(cat "$dev/device" 2>/dev/null)"
        [ -n "$id" ] && [ $(( id )) -lt $(( 0x2600 )) ] && return 0
    done
    return 1
}
if [ "${RIME_GAMING_OMM:-auto}" != on ] && nvidia_before_ada; then
    case ",${VKD3D_DISABLE_EXTENSIONS:-}," in
        *,VK_KHR_opacity_micromap,*) ;;
        *) export VKD3D_DISABLE_EXTENSIONS="${VKD3D_DISABLE_EXTENSIONS:+${VKD3D_DISABLE_EXTENSIONS},}VK_KHR_opacity_micromap" ;;
    esac
    log "NVIDIA GPU older than Ada: opacity micromaps off for Proton games"
fi

if [ $# -eq 0 ]; then
    log "usage: rime-gamescope-steam COMMAND [ARGS…]"
    exit 2
fi

if [ "$HDR_POLICY" = steam ] && [ "$FORCE_COMPOSITE" != 1 ]; then
    : # nothing to guard
elif ! command -v xprop >/dev/null 2>&1; then
    log "no xprop: HDR and composition are left to Steam and gamescope"
elif [ -z "${DISPLAY:-}" ]; then
    log "no DISPLAY: HDR and composition are left to Steam and gamescope"
else
    guard "$$" &
fi

exec "$@"
