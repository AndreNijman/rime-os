#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  rime-firewall — the exception list in front of Rime's default-drop policy.
#
#  The policy itself is /usr/share/rime/nftables/rime.nft and is not editable
#  from here. This adds and removes named exceptions, and nothing else: a user
#  who wants to open a port opens a *service*, because "5353/udp" is a thing you
#  paste from a forum and "mdns" is a thing you can decide about.
#
#  Exceptions live in /etc/rime/firewall.d/<name>.conf, one file per service, so
#  removing one is removing a file and the set is readable without this tool.
#  They are applied into two named nftables sets rather than by rewriting the
#  ruleset, so a malformed exception can never take the base policy with it.
#
#  They are also applied ONE AT A TIME. The first version built a single
#  `nft add element` per protocol, which meant one typo in one file failed the
#  whole command and closed every other port the user had opened — silently,
#  because the unit runs this with ExecStart=- and it printed "exceptions
#  reapplied" either way. The base policy survived, which was the architectural
#  claim; the user's other exceptions did not, which is the same bug wearing a
#  smaller hat.
#
#  Run as root for anything that changes state. Reading is unprivileged, and
#  says so when it cannot see the live ruleset rather than reporting an empty
#  one — `nft list` needs CAP_NET_ADMIN, and a firewall tool that answers "no
#  rules" to a user who merely lacks permission is the worst possible answer.
# ─────────────────────────────────────────────────────────────────────────────
set -uo pipefail

readonly TABLE="inet rime"
readonly CONF_DIR=/etc/rime/firewall.d
readonly CATALOGUE=/usr/share/rime/firewall/services
readonly HOTSPOT_SET=hotspot_ifaces

# Written once because it is now said twice — the prose status prints it and
# `status --json` reports it. Two copies of a sentence listing what a firewall
# never drops is two chances to tell a user something that stopped being true.
readonly ALWAYS_ALLOWED='established replies, loopback, ICMP, DHCP, mDNS, ssh'

msg()  { printf 'rime-firewall: %s\n' "$*"; }
warn() { printf 'rime-firewall: warning: %s\n' "$*" >&2; }
die()  { printf 'rime-firewall: error: %s\n' "$*" >&2; exit 1; }

need_root() {
    [ "$(id -u)" = 0 ] || die "$1 needs root; try: sudo rime firewall $1"
}

# The name becomes a path, and `deny` reaches the path before it reaches the
# catalogue. Without this, `rime firewall deny ../../../etc/issue` was an
# `rm -f` outside the exception directory, run as root.
valid_name() {
    case "$1" in
        *[!a-z0-9-]*|"" ) return 1 ;;
        -*)               return 1 ;;
        *)                return 0 ;;
    esac
}

# An interface name, before it becomes an nft element. The kernel's own limit
# is IFNAMSIZ-1 = 15 characters, and the character class is what `ip link` will
# accept; a name that reached `nft add element` unchecked would be a shell word
# in a command built by string concatenation.
valid_ifname() {
    case "$1" in
        ""|-*)             return 1 ;;
        *[!A-Za-z0-9_.-]*) return 1 ;;
    esac
    [ "${#1}" -le 15 ]
}

# tcp or udp, and a port or a port range the set's `flags interval` can hold.
valid_spec() {
    case "$1" in tcp|udp) ;; *) return 1 ;; esac
    case "$2" in
        *[!0-9-]*|"") return 1 ;;
        *-*) [ "${2%%-*}" -ge 1 ] 2>/dev/null && [ "${2##*-}" -le 65535 ] 2>/dev/null ;;
        *)   [ "$2" -ge 1 ] 2>/dev/null && [ "$2" -le 65535 ] 2>/dev/null ;;
    esac
}

# The named services a user may open, as `name proto port description`.
# A catalogue rather than free-form ports: the point of the exception list is
# that a user can read it back later and know what they decided.
catalogue() {
    if [ -r "$CATALOGUE" ]; then
        grep -vE '^\s*(#|$)' "$CATALOGUE"
        return
    fi
    # Built in, so the tool still works if the image's copy is missing.
    cat <<'EOF'
ssh          tcp 22    Remote shell, and how Rime remote agents and `rime host run` reach this machine
http         tcp 80    A web server you are running
https        tcp 443   A web server you are running, over TLS
mdns         udp 5353  Local name discovery, for printers and `rime host`
samba        tcp 445   Windows file sharing
nfs          tcp 2049  NFS file sharing
ipp          tcp 631   Sharing a printer attached to this machine
steam-remote udp 27036 Steam Remote Play from another machine on this network
sunshine     tcp 47989 Sunshine game streaming host
ollama       tcp 11434 A local model server, reachable from other machines
rime-remote  tcp 7717  Rime Remote on this network, so a paired phone reaches this machine directly
syncthing    tcp 22000 Syncthing peer connections
EOF
}

lookup() {
    catalogue | awk -v n="$1" '$1 == n { print $2, $3; found=1 } END { exit !found }'
}

# Is the ruleset actually loaded? Distinguishes "no exceptions" from "cannot
# look", for the same reason the rest of this codebase does.
ruleset_state() {
    if ! command -v nft >/dev/null 2>&1; then
        printf 'absent\n'; return
    fi
    local out rc
    out="$(nft list table $TABLE 2>&1)"; rc=$?
    if [ "$rc" -eq 0 ]; then
        printf 'loaded\n'
    elif printf '%s' "$out" | grep -iE 'permission denied|operation not permitted' >/dev/null; then
        printf 'unreadable\n'
    else
        printf 'notloaded\n'
    fi
}

# ── one reader for /etc/rime/firewall.d ─────────────────────────────────────
# The prose status and `status --json` must never disagree about whether a port
# is open — "this is open" printed next to a reload that dropped it is the one
# answer this tool must never give, and the way that happens is two loops over
# the same directory drifting apart. So there is one loop, and it calls back.
#
# A CALLBACK and not a tab-separated line: a filename may contain any byte but
# `/` and NUL, `valid_name` gates what this tool creates but not what a person
# can drop in by hand, and a name with a tab in it would arrive at the renderer
# as two fields. `proto` and `port` are safe — `read -r proto port _` splits on
# IFS, so neither can hold whitespace.
#
#   $1 = callback, invoked as:  cb <name> ok|rejected <proto> <port> <detail>
each_exception() {
    local cb="$1" f name proto port
    for f in "$CONF_DIR"/*.conf; do
        [ -e "$f" ] || continue
        name="$(basename "$f" .conf)"
        proto=""; port=""
        # Re-read every time rather than remembered from the last reload, so a
        # status run tells the truth even if nothing has reloaded since.
        read -r proto port _ < "$f" 2>/dev/null
        if valid_spec "${proto:-}" "${port:-}"; then
            "$cb" "$name" ok "$proto" "$port" ""
        else
            "$cb" "$name" rejected "" "" \
                "$(printf '%s %s' "${proto:-}" "${port:-}" | sed 's/^ *//;s/ *$//')"
        fi
    done
}

# The shared links the loaded ruleset has open, ONE PER LINE. The caller must
# have established that the ruleset is readable; this cannot tell an empty set
# from a set it was not allowed to read, which is the distinction the whole
# file is built around.
#
# nft prints a set's elements quoted, and wraps them one per line as soon as
# there is more than one:
#
#     elements = { "rimehost",
#                  "rimehost2" }
#
# A line-at-a-time `s/.*elements = { \(.*\) }.*/\1/` matches neither line, so
# with two shared links it came back EMPTY and the tool said "not sharing this
# machine's connection on any link" while both were open — a firewall tool
# reporting a shut link as the answer for an open one. Measured in a namespace
# against the real `nft list set`, not guessed at;
# tests/test-device-services-netns.sh keeps it measured.
hotspot_open_links() {
    nft list set $TABLE "$HOTSPOT_SET" 2>/dev/null |
    tr '\n\t' '  ' |
    sed -n 's/.*elements = {\([^}]*\)}.*/\1/p' |
    tr -d '"' | tr ',' '\n' |
    sed 's/^ *//; s/ *$//' |
    grep -v '^$'
}

cmd_list() {
    printf '%-13s %-5s %-6s %s\n' NAME PROTO PORT DESCRIPTION
    catalogue | while read -r name proto port desc; do
        printf '%-13s %-5s %-6s %s\n' "$name" "$proto" "$port" "$desc"
    done
}

# The prose renderer's half of each_exception.
_status_any=0
_status_row() {  # name kind proto port detail
    _status_any=1
    if [ "$2" = ok ]; then
        printf '  %-13s %s %s\n' "$1" "$3" "$4"
    else
        # Reporting a port as open when the reload rejected it is the one
        # answer this tool must never give.
        printf '  %-13s could not be applied — rejected: %s\n' "$1" "$5"
    fi
}

cmd_status() {
    case "${1:-}" in
        --json) cmd_status_json; return ;;
        "")     ;;
        *)      die "usage: rime firewall status [--json]" ;;
    esac
    local state; state="$(ruleset_state)"
    case "$state" in
        absent)     msg "nft is not installed; no policy is being enforced" ;;
        notloaded)  msg "policy: NOT LOADED — incoming traffic is not being filtered"
                    msg "  load it with: sudo systemctl start rime-firewall" ;;
        unreadable) msg "policy: cannot read the ruleset; reading it needs root"
                    msg "  try: sudo rime firewall status" ;;
        loaded)     msg "policy: incoming dropped by default, outgoing allowed" ;;
    esac
    echo
    echo "always allowed, and not removable here:"
    echo "  $ALWAYS_ALLOWED"
    echo
    # Named here rather than left to `hotspot list`, because it is the one
    # opening a user did not choose in this file and would not otherwise find.
    # Only when the ruleset can be read: the case above has already said why
    # not, and saying it twice in one screen is how a tool trains people to
    # skim it.
    if [ "$state" = loaded ]; then
        cmd_hotspot list | sed 's/^rime-firewall: /  /'
        echo
    fi
    echo "exceptions you have added:"
    _status_any=0
    each_exception _status_row
    [ "$_status_any" = 1 ] || echo "  (none)"
}

# ── status --json ───────────────────────────────────────────────────────────
#
#  WHY THIS EXISTS. Rime Shell's Firewall settings page reads this tool and,
#  having nothing else to read, parsed its PROSE — heading by heading, sentence
#  by sentence. That coupling failed the first time the prose moved, and it
#  failed silently, which is the only way this kind of coupling ever fails:
#
#  `c7a28f2c` added the shared-links line to the status screen, between the
#  "always allowed" heading and the "exceptions you have added" heading. The
#  shell assigns every unprefixed line under the first heading to its
#  "always allowed" field, so on a machine where the ruleset is readable the
#  settings page began reporting
#
#      always allowed:  not sharing this machine's connection on any link
#
#  in place of the list of things the policy never drops. Nothing failed. No
#  test went red — the shell's fixture had been captured before the line
#  existed, so its suite went on checking a shape this tool can no longer
#  print. A user reading that page would have been told the wrong thing about
#  what their firewall lets through.
#
#  So the machine-readable answer is a separate surface with a shape, and the
#  prose stays free to be prose. They are rendered from the same two readers —
#  `each_exception` and `ALWAYS_ALLOWED` — so they cannot disagree.
#
#  CONTRACT (stdout is JSON and nothing else; warnings go to stderr; the exit
#  status is 0 in every policy state, exactly as the prose is, because "the
#  ruleset could not be read" is an answer and not a failure):
#
#    policy          "absent" | "notloaded" | "unreadable" | "loaded"
#                    — the ruleset_state enum verbatim, not a re-derivation
#    always_allowed  the sentence the prose prints, as one string
#    hotspot_links   array of interface names when policy is "loaded";
#                    null otherwise. NULL AND NOT [] ON PURPOSE: [] says "this
#                    machine is sharing nothing", and a caller that cannot read
#                    the ruleset has not learned that. It is the same
#                    distinction that makes ruleset_state separate "unreadable"
#                    from "notloaded" in the first place.
#    exceptions      array, one per /etc/rime/firewall.d/*.conf, each
#                    {name, proto, port, rejected, detail}. A rejected entry
#                    carries empty proto/port and the offending text in detail,
#                    so a caller rendering it cannot accidentally show a port.
#
#  NO `jq`, AND NO SHELLING OUT TO A JSON WRITER. This runs at boot from
#  rime-firewall.service, Before=network-pre.target, where the dependency graph
#  is small on purpose.
# ─────────────────────────────────────────────────────────────────────────────

# One JSON string literal, quotes included.
#
# `name` comes from a filename and `detail` from the first line of a file the
# user wrote by hand — neither has been through valid_name, because this tool
# reports what is in the directory rather than only what it put there. Both can
# therefore contain a quote or a backslash, and an unescaped one would not
# produce a wrong field: it would produce a document the caller cannot parse at
# all, and a settings page that falls back to "could not be read" because
# somebody named a file `my"printer.conf`.
#
# Order matters: backslashes first, or the escapes added afterwards get escaped
# themselves. The trailing `tr -d` removes the control characters that have no
# two-character escape — JSON requires \uXXXX for those and bash has no clean
# way to emit it; dropping them keeps the document parseable, which is the
# property that matters here.
json_str() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '"%s"' "$(printf '%s' "$s" | tr -d '\000-\037')"
}

_json_first=1
_json_row() {  # name kind proto port detail
    [ "$_json_first" = 1 ] || printf ','
    _json_first=0
    printf '\n    '
    if [ "$2" = ok ]; then
        printf '{"name": %s, "proto": %s, "port": %s, "rejected": false, "detail": ""}' \
            "$(json_str "$1")" "$(json_str "$3")" "$(json_str "$4")"
    else
        printf '{"name": %s, "proto": "", "port": "", "rejected": true, "detail": %s}' \
            "$(json_str "$1")" "$(json_str "$5")"
    fi
}

cmd_status_json() {
    local state; state="$(ruleset_state)"
    printf '{\n'
    printf '  "policy": %s,\n' "$(json_str "$state")"
    printf '  "always_allowed": %s,\n' "$(json_str "$ALWAYS_ALLOWED")"

    if [ "$state" = loaded ]; then
        local first=1 link
        printf '  "hotspot_links": ['
        while read -r link; do
            [ -n "$link" ] || continue
            [ "$first" = 1 ] || printf ', '
            first=0
            printf '%s' "$(json_str "$link")"
        done < <(hotspot_open_links)
        printf '],\n'
    else
        printf '  "hotspot_links": null,\n'
    fi

    printf '  "exceptions": ['
    _json_first=1
    each_exception _json_row
    [ "$_json_first" = 1 ] || printf '\n  '
    printf ']\n}\n'
}

# One file. Returns non-zero without touching the sets if it cannot be read as
# an exception, so a neighbouring file's typo costs nothing.
apply_one() {
    local f="$1" proto="" port=""
    read -r proto port _ < "$f" 2>/dev/null
    valid_spec "${proto:-}" "${port:-}" || return 1
    nft add element $TABLE "allowed_$proto" "{ $port }" 2>/dev/null
}

apply_sets() {
    local state; state="$(ruleset_state)"
    [ "$state" = loaded ] || { warn "the ruleset is not loaded; the exception is recorded and will apply when it is"; return 0; }
    nft flush set $TABLE allowed_tcp 2>/dev/null
    nft flush set $TABLE allowed_udp 2>/dev/null
    local f rejected=0
    for f in "$CONF_DIR"/*.conf; do
        [ -e "$f" ] || continue
        if ! apply_one "$f"; then
            warn "$(basename "$f") is not a service exception; leaving it out"
            rejected=$((rejected + 1))
        fi
    done
    [ "$rejected" = 0 ]
}

# ── the shared link ─────────────────────────────────────────────────────────
# A hotspot is the one case where this machine answers DHCP and DNS instead of
# asking them, and both arrive inbound on ports the policy shuts. That is not a
# decision the user makes once and keeps — it is true while a `method=shared`
# connection is up and false the moment it goes down — so it is NOT recorded in
# /etc/rime/firewall.d. It lives in a set of interface names that empties with
# the table, and NetworkManager's dispatcher puts it back.
#
# Scoped to the link on purpose. The alternative, a `dns` entry in the service
# catalogue, would open a resolver on the café Wi-Fi as well.

hotspot_ifaces() {  # the shared links NetworkManager has up, one per line
    command -v nmcli >/dev/null 2>&1 || return 1
    local uuid dev
    # `--active` alone, so a saved-but-down hotspot profile is not reopened.
    nmcli -t -f UUID,DEVICE connection show --active 2>/dev/null |
    while IFS=: read -r uuid dev; do
        [ -n "${dev:-}" ] && [ "$dev" != "--" ] || continue
        case "$(nmcli -g ipv4.method connection show uuid "$uuid" 2>/dev/null)" in
            shared) printf '%s\n' "$dev" ;;
        esac
    done
}

hotspot_add() {  # $1 = interface name, already validated
    nft add element $TABLE "$HOTSPOT_SET" "{ $1 }" 2>/dev/null
}

hotspot_remove() {
    # Idempotent: the dispatcher fires `down` for links that were never shared,
    # and deleting an element that is not there is not a failure to report.
    nft delete element $TABLE "$HOTSPOT_SET" "{ $1 }" 2>/dev/null || true
}

# `nft -f rime.nft` deletes and rebuilds the table, so a restart of the unit
# empties this set — and NetworkManager will not re-run its dispatcher for a
# connection that was already up. Without this, restarting the firewall killed
# a running hotspot until the user toggled it off and on. Silent when NM is not
# answering: at boot this runs Before=network-pre.target, where there is no
# NetworkManager yet and no shared link to restore.
reapply_hotspot() {
    local ifname n=0
    while read -r ifname; do
        [ -n "$ifname" ] || continue
        valid_ifname "$ifname" || { warn "NetworkManager named a shared link '$ifname', which is not an interface name"; continue; }
        hotspot_add "$ifname" && n=$((n + 1))
    done < <(hotspot_ifaces)
    [ "$n" = 0 ] || msg "reopened DHCP and DNS on $n shared link$([ "$n" = 1 ] || echo s)"
}

cmd_hotspot() {
    local verb="${1:-}" ifname="${2:-}"
    case "$verb" in
        add|remove) ;;
        list|"")    ;;
        *) die "usage: rime firewall hotspot add|remove <interface>" ;;
    esac

    if [ "$verb" = list ] || [ -z "$verb" ]; then
        case "$(ruleset_state)" in
            absent)     msg "nft is not installed; no policy is being enforced" ;;
            notloaded)  msg "the policy is not loaded, so nothing is being filtered on any link" ;;
            unreadable) msg "cannot read the ruleset; reading it needs root"
                        msg "  try: sudo rime firewall hotspot list" ;;
            loaded)
                # One reader, shared with `status --json` — see
                # hotspot_open_links for what nft's set printing actually looks
                # like, and which bug the old line-at-a-time parser had. Names
                # cannot contain a comma (valid_ifname), so joining on one and
                # spacing it out afterwards is safe.
                local out
                out="$(hotspot_open_links | paste -sd, - | sed 's/,/, /g')"
                if [ -n "$out" ]; then
                    msg "sharing this machine's connection on: $out"
                    msg "  DHCP and DNS are open on those links only"
                else
                    msg "not sharing this machine's connection on any link"
                fi ;;
        esac
        return 0
    fi

    [ -n "$ifname" ] || die "which interface? usage: rime firewall hotspot $verb <interface>"
    valid_ifname "$ifname" || die "'$ifname' is not an interface name"
    need_root "hotspot $verb"

    if [ "$(ruleset_state)" != loaded ]; then
        # Not an error. Nothing is filtering, so the hotspot already works; the
        # dispatcher calls this on every shared link coming up and a machine
        # with the unit stopped should not collect failures for it.
        msg "the policy is not loaded, so nothing needs opening for '$ifname'"
        return 0
    fi

    if [ "$verb" = add ]; then
        hotspot_add "$ifname" || die "could not open DHCP and DNS on '$ifname'"
        msg "opened DHCP and DNS on '$ifname' while it is shared"
    else
        hotspot_remove "$ifname"
        msg "closed DHCP and DNS on '$ifname'"
    fi
}

cmd_allow() {
    local name="${1:-}"
    [ -n "$name" ] || die "which service? see: rime firewall list"
    valid_name "$name" || die "'$name' is not a service name; see: rime firewall list"
    # Resolve the name BEFORE demanding root. Reading the catalogue needs no
    # privilege, and making someone type a password to be told they misspelled
    # a service is a worse command than one that answers first.
    local spec
    spec="$(lookup "$name")" || die "no service called '$name'; see: rime firewall list"
    need_root allow
    mkdir -p "$CONF_DIR"
    printf '%s %s\n' $spec > "${CONF_DIR}/${name}.conf"
    apply_sets || warn "another exception file could not be applied; see: rime firewall status"
    msg "allowed '$name' ($spec) on every interface"
}

cmd_deny() {
    local name="${1:-}"
    [ -n "$name" ] || die "which service? see: rime firewall status"
    # Before the -e test, not after: the name is about to become a path, and
    # answering "that was never open" for ../../etc/issue would mean this had
    # already gone looking outside the exception directory.
    valid_name "$name" || die "'$name' is not a service name; see: rime firewall list"
    # Same order as allow: say it was never open before asking for a password.
    # /etc/rime/firewall.d is world-readable precisely so this can answer.
    [ -e "${CONF_DIR}/${name}.conf" ] || die "'$name' was not allowed"
    need_root deny
    rm -f "${CONF_DIR}/${name}.conf"
    apply_sets || warn "another exception file could not be applied; see: rime firewall status"
    msg "removed '$name'"
}

# The unit runs this as ExecStart=-, so its exit status is not what keeps the
# machine up — but it is what a person and a test can read, and reporting
# success for a reload that dropped an exception is how a closed port looks
# open.
cmd_reload() {
    need_root reload
    # Before the exception report, because a shared link that is up right now
    # has just lost its rules to the table being rebuilt.
    [ "$(ruleset_state)" = loaded ] && reapply_hotspot
    if apply_sets; then
        msg "exceptions reapplied"
    else
        warn "some exceptions were not applied; see: rime firewall status"
        return 1
    fi
}

usage() {
    cat <<'EOF'
Incoming traffic is dropped by default. This manages the exceptions.

Usage: rime firewall <command>

Commands:
  status          What the policy is, and what you have opened
  status --json   The same, as JSON, for a program rather than a person
  list            The services you can open, by name
  allow <name>    Open one, on every interface. Needs root.
  deny <name>     Close one again. Needs root.
  reload          Reapply the recorded exceptions. Needs root.
  hotspot         Which links this machine is sharing its connection on

ssh is always open: Rime remote agents and `rime host run` are ssh, and closing
it would strand you on the machine you were driving from.

Sharing this machine's connection opens DHCP and DNS on that link alone, for as
long as it is shared. NetworkManager's dispatcher does that; `hotspot add` and
`hotspot remove` are how, and are not something to run by hand.
EOF
}

case "${1:-}" in
    status)      shift; cmd_status "$@" ;;
    "")          cmd_status ;;
    list)        cmd_list ;;
    allow)       shift; cmd_allow "$@" ;;
    deny)        shift; cmd_deny "$@" ;;
    hotspot)     shift; cmd_hotspot "$@" ;;
    reload)      cmd_reload ;;
    -h|--help)   usage ;;
    *)           usage >&2; exit 2 ;;
esac
