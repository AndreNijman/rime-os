From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Andre Nijman <andre.perth.2010@gmail.com>
Date: Tue, 3 Nov 2026 00:00:00 +0000
Subject: [PATCH] ply-device-manager: tell the daemon when a renderer's
 keyboard goes away

free_keyboards_for_renderer() freed each keyboard without calling the
keyboard_removed_handler, unlike free_pixel_displays_for_renderer(). The
daemon had already handed that keyboard to the splash plugin. When the
simpledrm renderers are freed for a new DRM device that then cannot be
opened (a device with no usable display: "Could not get card
resources"), no new keyboard replaces it, the script plugin keeps the
freed keyboard, and plymouthd crashes in
ply_keyboard_remove_input_handler() when the splash is hidden
(stop_script_animation -> hide_splash_screen).

Call the handler before freeing, have the splash forget the keyboard it
was told to unset, and hand it a remaining keyboard if there is one.
---
 src/libply-splash-core/ply-boot-splash.c    |  1 +
 src/libply-splash-core/ply-device-manager.c |  6 ++++++
 src/main.c                                  | 18 +++++++++++++++++-
 3 files changed, 24 insertions(+), 1 deletion(-)

diff --git a/src/libply-splash-core/ply-boot-splash.c b/src/libply-splash-core/ply-boot-splash.c
index 217f455..a47cc4d 100644
--- a/src/libply-splash-core/ply-boot-splash.c
+++ b/src/libply-splash-core/ply-boot-splash.c
@@ -125,6 +125,7 @@ ply_boot_splash_unset_keyboard (ply_boot_splash_t *splash)
                 return;
 
         splash->plugin_interface->unset_keyboard (splash->plugin, splash->keyboard);
+        splash->keyboard = NULL;
 }
 
 void
diff --git a/src/libply-splash-core/ply-device-manager.c b/src/libply-splash-core/ply-device-manager.c
index b5f793d..b699419 100644
--- a/src/libply-splash-core/ply-device-manager.c
+++ b/src/libply-splash-core/ply-device-manager.c
@@ -166,6 +166,12 @@ free_keyboards_for_renderer (ply_device_manager_t *manager,
                 keyboard_renderer = ply_keyboard_get_renderer (keyboard);
 
                 if (keyboard_renderer == renderer) {
+                        /* The daemon and the splash plugin still hold this
+                         * keyboard (the pixel displays above get the same
+                         * call); without it the script plugin keeps a freed
+                         * keyboard and plymouthd crashes when the splash hides. */
+                        if (manager->keyboard_removed_handler != NULL)
+                                manager->keyboard_removed_handler (manager->event_handler_data, keyboard);
                         ply_keyboard_free (keyboard);
                         ply_list_remove_node (manager->keyboards, node);
                 }
diff --git a/src/main.c b/src/main.c
index aac5125..ea19d51 100644
--- a/src/main.c
+++ b/src/main.c
@@ -1146,8 +1146,24 @@ on_keyboard_removed (state_t        *state,
                                            (ply_keyboard_enter_handler_t)
                                            on_enter);
 
-        if (state->boot_splash != NULL)
+        if (state->boot_splash != NULL) {
+                ply_list_t *keyboards;
+                ply_list_node_t *node;
+
                 ply_boot_splash_unset_keyboard (state->boot_splash);
+
+                /* hand the splash another keyboard that is still there, if any */
+                keyboards = ply_device_manager_get_keyboards (state->device_manager);
+                for (node = ply_list_get_first_node (keyboards); node != NULL;
+                     node = ply_list_get_next_node (keyboards, node)) {
+                        ply_keyboard_t *other = ply_list_node_get_data (node);
+
+                        if (other != keyboard) {
+                                ply_boot_splash_set_keyboard (state->boot_splash, other);
+                                break;
+                        }
+                }
+        }
 }
 
 static void
