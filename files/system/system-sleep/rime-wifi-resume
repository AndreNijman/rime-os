#!/usr/bin/env bash
# Rime: repair the MT7925 receive path after resume, but only when it is broken.
#
# WHY THIS EXISTS
#
# Closing the lid and reopening it leaves mt7925e in a state where the link looks
# healthy and is not: -45 dBm signal, tx negotiated at 156 Mbit/s, rx pinned to
# VHT-MCS 0 (7.2 Mbit/s), and 66% of pings to the local gateway lost. TCP
# connects and then stalls, which reads as "the internet is slow" rather than as
# a driver fault. Rebooting fixed it, which is why it kept being rebooted.
#
# Neither of the cheap repairs is enough on its own:
#   * turning power save off      66% loss -> 50%
#   * re-associating the AP       50% loss -> 33%, rx still MCS 0
# Reloading the driver clears it completely: 0% loss, rx 144 Mbit/s.
#
# WHY IT IS CONDITIONAL
#
# An unconditional reload would add ~15 seconds of no network to every single
# lid-open, including the majority where nothing is wrong. So this probes the
# gateway first and only reloads when the link is genuinely failing. A resume
# with a working radio costs three pings.
set -u

# Two phases. systemd-sleep runs this with "post" while the whole session is
# still frozen — user.slice is thawed only after every system-sleep hook has
# returned — so anything slow here is time the user spends looking at a frozen
# screen after opening the lid. The probe therefore runs detached, as "probe",
# once systemd-sleep has finished and the session is live.
#
# It also cannot work from here. The probe waits for a default route, and
# NetworkManager starts reconnecting only when logind announces the wake —
# which logind does when the suspend operation completes, i.e. after this hook
# exits. Waiting here waited for something that could only happen afterwards:
# measured on the L16 on 2026-09-23, lid open 12:45:57.7, this hook gave up at
# 12:46:17.8, NetworkManager was told of the wake 27 ms later, the session
# thawed with it, and Wi-Fi came back at 12:46:20. Every lid-open that needed a
# reconnect froze for the full twenty seconds.
phase="${1:-}"
[ "$phase" = "post" ] || [ "$phase" = "probe" ] || exit 0

log() { logger -t rime-wifi-resume -- "$*"; }

SYSFS="${RIME_SYSFS:-/sys}"

# A glob, not `ls | grep`. This runs as root out of the system-sleep directory,
# and an interface name is attacker-influenced in the sense that matters: a USB
# adapter names itself. `ls` would hand a name containing a newline to the
# capture as two names.
#
# Only this driver. The images run on more than one machine, and cycling the
# radio on hardware that does not have this fault would be a regression
# invented by a fix for someone else's laptop. The driver picks the interface,
# not the glob order: a USB Wi-Fi adapter (wlp197s0f3u1) sorts before the
# built-in card (wlp3s0), and taking the first name skipped the repair for as
# long as the adapter was plugged in.
dev=""
for _d in "$SYSFS"/class/net/wl*; do
    [ -e "$_d" ] || continue          # the unmatched glob itself
    _drv="$(readlink -f "$_d/device/driver" 2>/dev/null)"
    if [ "${_drv##*/}" = "mt7925e" ]; then
        dev="${_d##*/}"
        break
    fi
done
[ -n "${dev:-}" ] || exit 0

# Hand the rest to a transient unit and return, so the session thaws now. A
# second lid-open while a probe is still running finds the unit name taken and
# simply does not start another.
if [ "$phase" = "post" ]; then
    systemd-run --no-block --quiet --collect \
        --unit=rime-wifi-resume-probe \
        --description="Rime: check the Wi-Fi receive path after resume" \
        "$0" probe >/dev/null 2>&1 || true
    exit 0
fi

# Give the radio a chance to re-associate on its own before judging it. This
# now runs with NetworkManager awake, so a route can actually arrive. The route
# and the probe are this card's own: with a second adapter (USB Wi-Fi,
# Ethernet) the default route may leave through it, and a ping that way would
# judge the wrong link in both directions.
for _ in $(seq 1 20); do
    gw="$(ip route show default dev "$dev" 2>/dev/null | awk '/default/{print $3; exit}')"
    [ -n "${gw:-}" ] && break
    sleep 1
done
[ -n "${gw:-}" ] || { log "no default route on $dev after resume; leaving it alone"; exit 0; }

# Three packets is enough to tell "wedged" from "fine": the failure mode loses
# a third to two thirds of them, and a healthy link loses none.
if ping -I "$dev" -c 3 -W 2 -q "$gw" >/dev/null 2>&1; then
    log "link to $gw on $dev is healthy after resume; no repair needed"
    exit 0
fi

log "link to $gw on $dev is failing after resume; reloading mt7925e"
nmcli radio wifi off >/dev/null 2>&1
sleep 2
modprobe -r mt7925e mt7925_common mt792x_lib mt76_connac_lib mt76 >/dev/null 2>&1
sleep 2
modprobe mt7925e >/dev/null 2>&1
sleep 3
nmcli radio wifi on >/dev/null 2>&1
log "mt7925e reloaded"
