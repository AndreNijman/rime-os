#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  install-e2e — Rime installed from Windows, start to finish, on a real
#  Windows Server 2022 guest with Secure Boot on. Four boots of ONE machine:
#
#    1. WINDOWS   jobs/install: shrink C: with Windows' own tool, then the
#                 real .exe: `candidates`, `install`. Windows shuts down.
#    2. SETUP     nothing is chosen: the firmware's BootNext starts Rime's
#                 installer from Rime's new ESP. The live session is driven
#                 through a test-only debug shell (typed into GRUB's editor
#                 over serial, never written to the disk) by
#                 tests/staged-install.py: hand-off accepted, install run
#                 with the GUI's own answers, result inspected.
#    3. WINDOWS   BootNext -> Windows Boot Manager, jobs/after-install: does
#                 Windows still start and see a healthy disk?
#    4. RIME      the firmware's own BootOrder, Rime's signing key added to db
#                 (what enrolling the MOK does on a real machine): shim ->
#                 GRUB -> Rime. Screenshots of the GRUB menu and of Rime.
#
#  Plus, from the host, outside every guest: the Windows ESP's file list
#  before and after (no Rime file may appear in it) and the firmware
#  variables after each boot.
#
#  Usage: install-e2e ISO EXE WORKDIR
#    ISO  the installer image the EXE is pinned to
#    EXE  rime-windows-installer.exe built with that pin
# ─────────────────────────────────────────────────────────────────────────────
set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ISO="$(realpath "$1")"; EXE="$(realpath "$2")"; W="$(realpath -m "$3")"
DIR="${RIME_WINLAB_DIR:-/var/lab-scratch/winlab}"
IMAGE="${RIME_WINLAB_IMAGE:-localhost/apex-winlab:latest}"
[ -s "$DIR/golden.raw" ] || { echo "no golden image; run winlab golden"; exit 2; }
mkdir -p "$W"
say() { printf '\n══ %s ══ %s\n' "$*" "$(date +%T)"; }
lab() { podman run --rm --device /dev/kvm -v "$W":/w:z -v "$DIR":/g:ro,z -v "$HERE":/lab:ro,z "$@"; }

say "prepare: overlay on the golden Windows, its firmware, the transport and the image disk"
lab -v "$ISO":/iso:ro,z -v "$EXE":/x/rime-windows-installer.exe:ro,z "$IMAGE" bash -euo pipefail -c '
  rm -f /w/sys.qcow2 /w/vars.fd /w/transport.raw /w/iso.raw
  qemu-img create -q -f qcow2 -b /g/golden.raw -F raw /w/sys.qcow2
  cp /g/golden-VARS.fd /w/vars.fd
  qemu-img create -q -f raw /w/transport.raw 256M
  printf "label: gpt\nsize=250MiB, type=EBD0A0A2-B9E5-4433-87C0-68B6B72699C7, name=APEXLAB\n" | sfdisk -q /w/transport.raw
  mformat -i /w/transport.raw@@1048576 -F -v APEXLAB ::
  mcopy -i /w/transport.raw@@1048576 /lab/jobs/install/run.ps1 /x/rime-windows-installer.exe ::/
  mdir -i /w/transport.raw@@1048576 ::
  sz=$(( $(stat -c %s /iso) / 1048576 + 300 ))
  qemu-img create -q -f raw /w/iso.raw ${sz}M
  printf "label: gpt\ntype=EBD0A0A2-B9E5-4433-87C0-68B6B72699C7, name=RIMEISO\n" | sfdisk -q /w/iso.raw
  mformat -i /w/iso.raw@@1048576 -F -v RIMEISO ::
  mcopy -i /w/iso.raw@@1048576 /iso ::/rime-os-netinstall-x86_64.iso
  virt-fw-vars -i /w/vars.fd --print 2>/dev/null | grep -E "^(Boot[0-9A-F]{4}|BootOrder|BootNext|SecureBootEnable)" | tee /w/fw-0.txt
'

esp_files() {  # the Windows ESP, listed from outside any guest
  lab "$IMAGE" bash -euo pipefail -c '
    qemu-img convert -O raw /w/sys.qcow2 /w/.sys.raw
    off=$(( $(sfdisk -J /w/.sys.raw | python3 -c "import json,sys; ps=json.load(sys.stdin)[\"partitiontable\"][\"partitions\"]; print([p for p in ps if p[\"type\"].upper()==\"C12A7328-F81F-11D2-BA4B-00A0C93EC93B\"][0][\"start\"])") * 512 ))
    mdir -/ -b -i "/w/.sys.raw@@$off" :: | sort
    rm -f /w/.sys.raw'
}
esp_files > "$W/winesp-before.txt"

qemu_cmd='
  qemu_run() {
    timeout "$1" qemu-system-x86_64 -name e2e -machine q35,accel=kvm,smm=on -cpu host -smp 4 -m 6144 \
      -global driver=cfi.pflash01,property=secure,value=on \
      -drive if=pflash,format=raw,unit=0,readonly=on,file=/usr/share/edk2/ovmf/OVMF_CODE.secboot.fd \
      -drive if=pflash,format=raw,unit=1,file=/w/vars.fd \
      -device ich9-ahci,id=ahci \
      -drive id=sys,file=/w/sys.qcow2,format=qcow2,if=none,cache=unsafe \
      -device ide-hd,drive=sys,bus=ahci.0,bootindex=1,model=RIME-LAB-SYSTEM,serial=SYS0000000001 \
      "${@:2}" -display none -vga std -monitor unix:/w/mon.sock,server,nowait -no-reboot -rtc base=utc
  }'

say "boot 1: Windows runs the installer"
lab "$IMAGE" bash -uo pipefail -c "$qemu_cmd"'
  qemu_run 1500 \
    -drive id=tr,file=/w/transport.raw,format=raw,if=none -device ide-hd,drive=tr,bus=ahci.1 \
    -drive id=iso,file=/w/iso.raw,format=raw,if=none -device ide-hd,drive=iso,bus=ahci.2 \
    -serial file:/w/serial-1.log
  echo "qemu rc=$?"
  mtype -i /w/transport.raw@@1048576 ::/result.txt | tr -d "\r" > /w/result-1.txt || true
  mtype -i /w/transport.raw@@1048576 ::/status.txt | tr -d "\r" || true
  virt-fw-vars -i /w/vars.fd --print 2>/dev/null | grep -E "^(Boot[0-9A-F]{4}|BootOrder|BootNext)" | tee /w/fw-1.txt'
grep -q INSTALL-JOB-OK "$W/result-1.txt" || { echo "FAIL  the Windows job did not finish"; tail -40 "$W/result-1.txt"; exit 1; }
echo "PASS  Windows shrank C:, the .exe staged Rime and asked for one boot of it"
grep -q '^BootNext' "$W/fw-1.txt" && echo "PASS  BootNext is set" || { echo "FAIL  no BootNext"; exit 1; }
esp_files > "$W/winesp-staged.txt"

say "boot 2: the firmware starts Rime's installer; the install is driven over serial"
rm -f "$W/serial0.sock" "$W/serial1.sock"
lab "$IMAGE" bash -uo pipefail -c "$qemu_cmd"'
  qemu_run 5400 -netdev user,id=n0 -device virtio-net-pci,netdev=n0 \
    -chardev socket,id=s0,path=/w/serial0.sock,server=on,wait=off,logfile=/w/serial-2.log -serial chardev:s0 \
    -chardev socket,id=s1,path=/w/serial1.sock,server=on,wait=off -serial chardev:s1
  echo "qemu rc=$?"
  virt-fw-vars -i /w/vars.fd --print 2>/dev/null | grep -E "^(Boot[0-9A-F]{4}|BootOrder|BootNext)" | tee /w/fw-2.txt' &
qpid=$!
# GRUB draws Rime's setup menu on the first serial port. Open the entry's
# editor, go to the end of its `linux` line, add the test-only debug shell
# on the second port, and boot it. The disk is not touched.
python3 - "$W/serial0.sock" <<'EOF'
import socket, sys, time
p = sys.argv[1]
s = socket.socket(socket.AF_UNIX)
for _ in range(300):
    try:
        s.connect(p); break
    except OSError:
        time.sleep(1)
buf = b""; s.settimeout(1); end = time.time() + 600
while time.time() < end and b"Install Rime OS" not in buf:
    try: buf += s.recv(4096)
    except socket.timeout: pass
if b"Install Rime OS" not in buf:
    print("FAIL  Rime's setup menu never appeared on serial"); sys.exit(1)
print("PASS  the firmware started Rime's setup menu from Rime's ESP")
# The editor opens on the entry's first line, `setparams`; the `linux` line
# is the next one. Type slowly: GRUB redraws the screen after every key.
for k in (b"e", b"\x0e", b"\x05"):
    s.sendall(k); time.sleep(1.0)
for ch in b" systemd.debug_shell=ttyS1":
    s.sendall(bytes([ch])); time.sleep(0.15)
time.sleep(1.0)
s.sendall(b"\x18")
EOF
python3 "$HERE/../tests/staged-install.py" "$W/serial1.sock" "$W/shell-2.log" --save-mok "$W/rime-mok.der" | tee "$W/install-2.txt"
wait $qpid
grep -q '^0 failure' "$W/install-2.txt" || echo "FAIL  the install inside the live session reported failures"
esp_files > "$W/winesp-after.txt"
if grep -iqE 'fedora|rimeinst' "$W/winesp-after.txt"; then
  echo "FAIL  a Rime file appeared on Windows' ESP"; grep -iE 'fedora|rimeinst' "$W/winesp-after.txt"
else
  echo "PASS  Windows' ESP holds no Rime file"
fi
diff <(sed 's/ .*//' "$W/winesp-before.txt") <(sed 's/ .*//' "$W/winesp-after.txt") >/dev/null \
  && echo "PASS  Windows' ESP has the same file list as before" \
  || { echo "NOTE  Windows' ESP file list differs (Windows rewrites its own BCD each boot):"; diff "$W/winesp-before.txt" "$W/winesp-after.txt" | head; }

say "boot 3: Windows again"
lab "$IMAGE" bash -euo pipefail -c '
  mdel -i /w/transport.raw@@1048576 ::/run.ps1 ::/result.txt ::/status.txt 2>/dev/null || true
  mcopy -i /w/transport.raw@@1048576 /lab/jobs/after-install/run.ps1 ::/
  wbm=$(virt-fw-vars -i /w/vars.fd --print 2>/dev/null | sed -n "s/^Boot\([0-9A-F]\{4\}\) *: boot entry: title=\"Windows Boot Manager\".*/\1/p" | head -1)
  bn_le=$(printf "%s" "$wbm" | sed -E "s/(..)(..)/\2\1/")
  printf "{\"version\": 2, \"variables\": [{\"name\": \"BootNext\", \"guid\": \"8be4df61-93ca-11d2-aa0d-00e098032b8c\", \"attr\": 7, \"data\": \"%s\"}]}" "$bn_le" > /tmp/n.json
  virt-fw-vars -i /w/vars.fd -o /w/vars.fd --set-json /tmp/n.json >/dev/null 2>&1
  echo "BootNext -> Boot$wbm (Windows Boot Manager)"'
lab "$IMAGE" bash -uo pipefail -c "$qemu_cmd"'
  qemu_run 1200 -drive id=tr,file=/w/transport.raw,format=raw,if=none -device ide-hd,drive=tr,bus=ahci.1 -serial file:/w/serial-3.log
  mtype -i /w/transport.raw@@1048576 ::/result.txt | tr -d "\r" > /w/result-3.txt || true'
grep -q AFTER-INSTALL-JOB-OK "$W/result-3.txt" && echo "PASS  Windows starts and runs normally after Rime was installed" \
  || { echo "FAIL  Windows did not run its job after the install"; tail -30 "$W/result-3.txt"; }

say "boot 4: the firmware's own boot order, Rime's key in db"
if [ -s "$W/rime-mok.der" ]; then
  lab "$IMAGE" bash -euo pipefail -c '
    virt-fw-vars -i /w/vars.fd -o /w/vars.fd --add-db 605dab50-e046-4300-abb6-3dd810dd8b23 /w/rime-mok.der >/dev/null 2>&1
    virt-fw-vars -i /w/vars.fd --print 2>/dev/null | grep -E "^(BootOrder|Boot[0-9A-F]{4})"'
fi
lab "$IMAGE" bash -uo pipefail -c "$qemu_cmd"'
  qemu_run 240 -serial file:/w/serial-4.log &
  q=$!
  for t in 4 9 60 120 200; do
    sleep $(( t - ${prev:-0} )); prev=$t
    printf "screendump /w/boot4-%03d.ppm\n" $t | socat - unix-connect:/w/mon.sock >/dev/null 2>&1 || true
  done
  wait $q'
ls "$W"/boot4-*.ppm 2>/dev/null
echo "DONE: $W"
