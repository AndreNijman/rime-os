#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  winlab — the Windows virtual machine this installer is tested against.
#
#  ═══ WHY THERE IS A WHOLE VM IN A TEST DIRECTORY ═══
#
#  The first round of `windows-installer/` shipped a careful GPT parser and an
#  emptiness validator and recorded, honestly, that none of it had ever seen a
#  Windows machine. It could not have: katana dual-boots Windows and katana is
#  Andre's, the L16 is the machine this is typed on, and a disk-writing tool
#  whose first real disk is somebody's laptop is how you get an unbootable
#  laptop. There is no Windows machine in this program that may be written to,
#  so the Windows machine has to be built.
#
#  Everything below is a file under $RIME_WINLAB_DIR. No host disk, no host
#  ESP, no host firmware variable is in reach of any guest. /dev/kvm is passed
#  as a device to an unprivileged container, which is a device pass-through and
#  not a privilege.
#
#  ═══ THE FOUR THINGS THAT MAKE A HEADLESS WINDOWS INSTALL WORK ═══
#
#  1. The El Torito UEFI boot image is swapped for efisys_noprompt.bin. The
#     stock one prints "Press any key to boot from CD or DVD" and waits for a
#     keyboard that a headless run does not have.
#  2. autounattend.xml goes in the ISO root, and names /IMAGE/INDEX 1 — read
#     out of install.wim with wiminfo rather than guessed, because a wrong
#     index stops Setup on a picker dialog nobody can see.
#  3. Setup reboots two or three times. qemu runs with -no-reboot so each boot
#     is a separate process the harness controls: the CD boots first once, the
#     disk boots first afterwards. Otherwise the CD wins every reboot and Setup
#     starts over, forever.
#  4. Nothing is asked of the guest over a network or a shared folder, because
#     Windows Setup media carries no virtio driver. The transport is a FAT disk
#     labelled APEXLAB that the host writes with mtools and the guest reads as  (rime-rename: keep)
#     an ordinary drive letter. Everything comes back the same way.
#
#  ═══ THE MACHINE ═══
#
#  q35 + AHCI, deliberately. Stock Windows Server 2022 media has no virtio
#  storage driver, so a virtio-blk system disk is a guest that never finds a
#  disk to install to. AHCI also takes model= and serial=, which is exactly the
#  hardware identity the installer has to name its target by.
#
#  ═══ USAGE ═══
#
#      winlab image              build the container
#      winlab media              remaster the Microsoft ISO
#      winlab golden             run Setup; produce golden.raw + golden-VARS.fd
#      winlab fixtures           build the target-disk fixtures
#      winlab run DIR [--swap] [--boots N]
#                                boot the golden with DIR/run.ps1, print results.
#                                --boots N lets the job ask for another boot: it
#                                writes reboot.txt on the transport and exits, and
#                                the host powers the machine back on with the same
#                                overlays. Up to N boots; the default is 1.
#      winlab status             what exists and what does not
#
#  $RIME_WINLAB_DIR defaults to /var/lab-scratch/winlab. It is not /tmp on
#  purpose: /tmp here is a tmpfs on a 29 GB machine and a 5 GB ISO plus a 40 GB
#  disk image would be RAM.
# ─────────────────────────────────────────────────────────────────────────────
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DIR="${RIME_WINLAB_DIR:-/var/lab-scratch/winlab}"
# The lab keeps its APEX-era names wherever an artifact already built under  (rime-rename: keep)
# them depends on them: the podman image, the remastered media, and the
# APEXLAB transport volume the golden image's baked agent looks for.  (rime-rename: keep)
IMAGE="${RIME_WINLAB_IMAGE:-localhost/apex-winlab:latest}"  # rime-rename: keep (an existing lab artifact carries this name)

ISO="$DIR/ws2022-eval.iso"
MEDIA="$DIR/apex-winsetup.iso"  # rime-rename: keep (an existing lab artifact carries this name)
GOLDEN="$DIR/golden.raw"
GOLDVARS="$DIR/golden-VARS.fd"

# The Microsoft evaluation media. 180-day evaluation, no product key, no
# Microsoft account, no TPM requirement — the reasons this edition and not
# Windows 11. The link is Microsoft's own permanent fwlink.
ISO_URL='https://go.microsoft.com/fwlink/p/?LinkID=2195280'
ISO_BYTES=5044094976

say()  { printf '%s\n' "$*"; }
die()  { printf 'winlab: %s\n' "$*" >&2; exit 1; }
need() { [ -e "$1" ] || die "missing $1 — run 'winlab $2' first"; }

have_kvm() { [ -r /dev/kvm ] && [ -w /dev/kvm ]; }

# Run a script inside the lab container. $DIR is /w, this directory is /lab.
#
# `:z` and not `:Z`. `:Z` labels the directory with the calling container's
# own private MCS category pair, so the moment a second container is started
# against the same work directory the first one loses write access to it —
# which shows up as qemu failing to unlock its own qcow2 and a shell failing
# to create a file it had just listed. Two of these containers run at once
# routinely: a long guest run and a media rebuild.
inlab() {
    local kvm=()
    have_kvm && kvm=(--device /dev/kvm)
    podman run --rm "${kvm[@]}" \
        -v "$DIR":/w:z -v "$HERE":/lab:ro,z \
        "$IMAGE" bash -uo pipefail -c "$1"
}

# ── winlab image ─────────────────────────────────────────────────────────────
cmd_image() {
    command -v podman >/dev/null 2>&1 || die "podman is absent"
    podman build -t "$IMAGE" -f "$HERE/Containerfile" "$HERE"
}

# ── winlab fetch ─────────────────────────────────────────────────────────────
cmd_fetch() {
    mkdir -p "$DIR"
    if [ -s "$ISO" ] && [ "$(stat -c %s "$ISO")" = "$ISO_BYTES" ]; then
        say "have $ISO ($ISO_BYTES bytes)"
        return 0
    fi
    say "fetching Windows Server 2022 Evaluation (~5.0 GB) …"
    curl -sS -L -C - -o "$ISO" "$ISO_URL" || die "download failed"
    local got; got="$(stat -c %s "$ISO")"
    [ "$got" = "$ISO_BYTES" ] || die "size $got, expected $ISO_BYTES"
    say "fetched $ISO"
}

# ── winlab media ─────────────────────────────────────────────────────────────
#  Extract, add, re-author. The obvious one-pass `xorriso -indev … -outdev …`
#  does NOT work on this media and the reason is worth writing down: the
#  Microsoft ISO's ISO-9660 tree contains exactly one file, README.TXT. Every
#  real file — sources/install.wim, efi/, boot/ — lives in the UDF volume, and
#  libisofs reads no UDF, so xorriso loads an image with nothing in it and
#  reports "Cannot find path '/efi/microsoft/boot/efisys_noprompt.bin'" as
#  though the file were absent. It is not absent; it is in a filesystem the
#  loader cannot see. 7z reads UDF, so extraction goes through it and xorriso
#  authors the replacement from a directory.
#
#  install.wim is 4.34 GB and xorriso's mkisofs emulation writes no UDF, so the
#  replacement media cannot carry it as one file: ISO-9660 caps a file at 4 GiB
#  and Windows' CDFS driver does not read multi-extent files. So the image is
#  SPLIT with wimlib into sources/install.swm + install2.swm, which is the
#  arrangement Microsoft documents for FAT32 install media and which Setup
#  picks up with no answer-file help. Joliet carries the long names.
#
#  The BIOS boot record is dropped — only the EFI El Torito entry is authored.
#  The guest is UEFI-only on purpose: a CSM boot produces an MBR Windows
#  install, and then every GPT, ESP and firmware-variable assertion this lab
#  exists to make would be measuring the wrong machine.
cmd_media() {
    need "$ISO" fetch
    inlab '
        set -e
        test -f /lab/autounattend.xml
        rm -rf /w/isoroot && mkdir -p /w/isoroot
        echo "extracting the Microsoft media (UDF) …"
        7z x -y -bso0 -bsp0 -o/w/isoroot /w/ws2022-eval.iso
        test -s /w/isoroot/efi/microsoft/boot/efisys_noprompt.bin
        test -s /w/isoroot/sources/install.wim
        chmod -R u+w /w/isoroot
        cp /lab/autounattend.xml     /w/isoroot/autounattend.xml
        cp /lab/apexlab-agent.ps1    /w/isoroot/apexlab-agent.ps1  # rime-rename: keep (an existing lab artifact carries this name)
        echo "splitting install.wim (4.34 GB does not fit an ISO-9660 file) …"
        wimsplit /w/isoroot/sources/install.wim /w/isoroot/sources/install.swm 3800 >/dev/null
        rm -f /w/isoroot/sources/install.wim
        ls -l /w/isoroot/sources/install*.swm
        echo "authoring …"
        rm -f /w/apex-winsetup.iso  # rime-rename: keep (an existing lab artifact carries this name)
        xorriso -as mkisofs \
            -iso-level 3 -J -joliet-long -V RIME_WINSETUP \
            -e efi/microsoft/boot/efisys_noprompt.bin -no-emul-boot \
            -o /w/apex-winsetup.iso /w/isoroot 2>&1 | tail -8  # rime-rename: keep (an existing lab artifact carries this name)
        rm -rf /w/isoroot
        ls -l /w/apex-winsetup.iso  # rime-rename: keep (an existing lab artifact carries this name)
        echo "--- the produced media, as the firmware will see it ---"
        xorriso -indev /w/apex-winsetup.iso -report_el_torito plain 2>&1 |  # rime-rename: keep (an existing lab artifact carries this name)
            grep -E "El Torito (boot img|images|catalog)"
        echo "--- autounattend.xml is in the root, and it is ours ---"
        7z l /w/apex-winsetup.iso 2>/dev/null | grep -iE "autounattend|apexlab-agent" | head  # rime-rename: keep (an existing lab artifact carries this name)
    ' || die "remaster failed"
    say "media: $MEDIA"
}

# ── the qemu command line, in one place ──────────────────────────────────────
#  Emitted as shell text for the container. $1 selects who boots first.
qemu_args() {
    cat <<'QEMU'
# $VARS $SYSDISK $MON $SHOTTAG must be set. $1 = who boots first: cd|disk.
# Everything after $1 is appended to the command line verbatim.
#
# A headless Windows Setup that stops shows you nothing at all, so a watcher
# takes a monitor screendump every 30 s into /w/shot-$SHOTTAG.ppm, overwriting.
# When a phase ends the file holds the last frame before it did — which is the
# difference between "Setup failed" and knowing which dialog it failed on.
qemu_run() {
    local first="$1"; shift
    local cdidx=2 dkidx=1
    [ "$first" = cd ] && { cdidx=1; dkidx=2; }
    local cd=()
    if [ "$first" = cd ] && [ -f /w/apex-winsetup.iso ]; then  # rime-rename: keep (an existing lab artifact carries this name)
        cd=(-drive "id=cd,file=/w/apex-winsetup.iso,format=raw,if=none,media=cdrom,readonly=on"  # rime-rename: keep (an existing lab artifact carries this name)
            -device "ide-cd,drive=cd,bus=ahci.4,bootindex=$cdidx")
    fi
    rm -f "$MON"
    timeout "${QEMU_TIMEOUT:-2700}" qemu-system-x86_64 \
        -name rime-winlab \
        -machine q35,accel=kvm,smm=on -cpu host -smp 4 -m 4096 \
        -global driver=cfi.pflash01,property=secure,value=on \
        -drive "if=pflash,format=raw,unit=0,readonly=on,file=/usr/share/edk2/ovmf/OVMF_CODE.secboot.fd" \
        -drive "if=pflash,format=raw,unit=1,file=$VARS" \
        -device ich9-ahci,id=ahci \
        -drive "id=sys,file=$SYSDISK,format=${SYSFMT:-raw},if=none,cache=unsafe" \
        -device "ide-hd,drive=sys,bus=ahci.0,bootindex=$dkidx,model=RIME-LAB-SYSTEM,serial=SYS0000000001" \
        "${cd[@]}" "$@" \
        -display none -vga std -monitor "unix:$MON,server,nowait" \
        -no-reboot -rtc base=utc -boot menu=off &
    local qpid=$!
    (
        while kill -0 "$qpid" 2>/dev/null; do
            sleep 30
            [ -S "$MON" ] || continue
            printf 'screendump /w/shot-%s.ppm\n' "$SHOTTAG" |
                timeout 10 socat - "unix-connect:$MON" >/dev/null 2>&1
        done
    ) &
    local wpid=$!
    local rc=0
    wait "$qpid" || rc=$?
    kill "$wpid" 2>/dev/null
    wait "$wpid" 2>/dev/null
    return "$rc"
}
QEMU
}

# ── winlab golden ────────────────────────────────────────────────────────────
cmd_golden() {
    need "$MEDIA" media
    have_kvm || die "/dev/kvm is not usable; the Windows install needs it"
    rm -f "$GOLDEN" "$GOLDVARS" "$DIR/transport.raw"
    inlab "$(qemu_args)"'
        set -e
        export VARS=/w/golden-VARS.fd SYSDISK=/w/golden.raw MON=/w/mon.sock
        cp /usr/share/edk2/ovmf/OVMF_VARS.secboot.fd "$VARS"
        qemu-img create -f raw "$SYSDISK" 64G >/dev/null

        # The transport disk exists from phase 2 onward only. During phase 1
        # the system disk is the ONLY disk attached, so autounattend.xml`s
        # "DiskID 0, WillWipeDisk true" cannot possibly address anything else.
        mkfs_transport() {
            qemu-img create -f raw /w/transport.raw 64M >/dev/null
            printf "label: gpt\nsize=60MiB, type=EBD0A0A2-B9E5-4433-87C0-68B6B72699C7, name=APEXLAB\n" |  # rime-rename: keep (the baked agent looks for APEXLAB)
                sfdisk /w/transport.raw >/dev/null 2>&1
            mformat -i /w/transport.raw@@1048576 -F -v APEXLAB ::  # rime-rename: keep (the baked agent looks for APEXLAB)
            # The agent rides in on the transport, not on the install CD: the
            # CD is detached after the first Setup phase and a copy from it
            # silently finds nothing.
            mcopy -i /w/transport.raw@@1048576 /lab/apexlab-agent.ps1 ::/  # rime-rename: keep (the name the autounattend.xml on the media copies)
        }

        phase=1
        while [ $phase -le 8 ]; do
            echo "── golden phase $phase ── $(date -u +%H:%M:%S)"
            export SHOTTAG="golden-p$phase"
            rc=0
            if [ $phase = 1 ]; then
                qemu_run cd || rc=$?
            else
                [ -f /w/transport.raw ] || mkfs_transport
                qemu_run disk \
                    -drive "id=tr,file=/w/transport.raw,format=raw,if=none" \
                    -device "ide-hd,drive=tr,bus=ahci.1,model=RIME-LAB-TRANSPORT,serial=TRN0000000001" \
                    || rc=$?
            fi
            echo "   qemu exited rc=$rc at $(date -u +%H:%M:%S)"
            if [ -f /w/transport.raw ] &&
               mdir -i /w/transport.raw@@1048576 ::/golden.txt >/dev/null 2>&1; then
                echo "GOLDEN-READY marker found after phase $phase"
                break
            fi
            phase=$((phase+1))
        done

        marker="$(mtype -i /w/transport.raw@@1048576 ::/golden.txt 2>/dev/null | tr -d "\r\n")"
        case "$marker" in
            GOLDEN-READY) echo "golden marker: $marker" ;;
            *) echo "FATAL: golden marker is \"$marker\", not GOLDEN-READY" >&2; exit 1 ;;
        esac
        mdir -i /w/transport.raw@@1048576 ::/golden.txt >/dev/null 2>&1 || {
            echo "FATAL: Setup never produced the completion marker" >&2
            echo "--- partitions the guest left on the system disk ---" >&2
            sfdisk -d /w/golden.raw 2>&1 | head -20 >&2
            exit 1
        }

        echo "--- firmware boot entries after Setup (the before-baseline) ---"
        virt-fw-vars -i "$VARS" --print 2>&1 | grep -iE "Boot[0-9]{4}|BootOrder" | head -20
        echo "--- partition table Windows created ---"
        sfdisk -d /w/golden.raw
    ' || die "golden build failed"
    say "golden: $GOLDEN + $GOLDVARS"
}

# ── winlab status ────────────────────────────────────────────────────────────
cmd_status() {
    local f
    for f in "$ISO" "$MEDIA" "$GOLDEN" "$GOLDVARS"; do
        if [ -e "$f" ]; then printf '  present  %-14s %s\n' "$(du -h --apparent-size "$f" | cut -f1)" "$f"
        else                 printf '  ABSENT   %-14s %s\n' '' "$f"; fi
    done
    have_kvm && say "  /dev/kvm usable" || say "  /dev/kvm NOT usable — no guest can run"
    podman image exists "$IMAGE" 2>/dev/null && say "  container $IMAGE present" \
        || say "  container $IMAGE ABSENT"
}

# ── winlab build ─────────────────────────────────────────────────────────────
#  Cross-build the installer and drop it where the guest can be handed it.
cmd_build() {
    local builder="$HERE/../build-windows.sh"
    [ -x "$builder" ] || die "no $builder"
    "$builder" "$DIR" || die "cross-build failed"
}

# ── winlab fixtures ──────────────────────────────────────────────────────────
#  The target disks. These are what the installer is pointed at; the Windows
#  system disk is never a candidate.
#
#  Fixture A is AHCI and carries three partitions chosen to be the three
#  answers the tool must give:
#
#     1  Linux filesystem type, every byte zero      — eligible
#     2  basic data, formatted NTFS, Windows mounts  — refuse, and name the
#                                                      drive letter
#     3  basic data, every byte zero                 — the partition a user
#                                                      actually produces by
#                                                      shrinking C: in Disk
#                                                      Management
#
#  Fixture B is an NVMe device with one eligible partition, and it exists for
#  one reason: to be enumerated in both orders. On Andre's own hardware NVMe
#  names have reordered across three ordinary reboots, so any identity the tool
#  prints that changes when the order changes is an identity that will one day
#  name the wrong disk.
cmd_fixtures() {
    inlab '
        set -e
        mk() {   # $1 image  $2 size  $3 sfdisk script
            rm -f "$1"; qemu-img create -f raw "$1" "$2" >/dev/null
            printf "%s" "$3" | sfdisk "$1" >/dev/null
        }
        # The partitions are 17 GiB because the installer refuses anything
        # under 16 decimal GB, which is the number installer/rime-install
        # refuses too. Fixtures small enough to be convenient would have
        # exercised every rule except the one that fires in real life. The
        # images are sparse: 17 GiB of zeroes costs no disk.
        mk /w/fixture-a.raw 36G "label: gpt
size=17GiB, type=0FC63DAF-8483-4772-8E79-3D69D8477DE4, name=\"RIME-TARGET-A\"
size=1GiB,  type=EBD0A0A2-B9E5-4433-87C0-68B6B72699C7, name=\"Windows data\"
size=17GiB, type=EBD0A0A2-B9E5-4433-87C0-68B6B72699C7, name=\"Blank basic\"
"
        mk /w/fixture-b.raw 18G "label: gpt
size=17GiB, type=0FC63DAF-8483-4772-8E79-3D69D8477DE4, name=\"RIME-TARGET-B\"
"
        # Partition 2 gets a real NTFS filesystem. Offsets come from sfdisk
        # rather than arithmetic, so a layout change cannot silently format the
        # wrong extent.
        start=$(sfdisk -d /w/fixture-a.raw | awk -F"start=|," "/raw2/ {print \$2+0}")
        size=$(sfdisk -d /w/fixture-a.raw  | awk -F"size=|," "/raw2/ {print \$3+0}")
        # mkntfs cannot write into an offset inside a file, so the filesystem
        # is built standalone and copied into place. dd with seek and count
        # keeps the write inside the partition by construction.
        rm -f /w/.ntfs.img
        truncate -s $((size*512)) /w/.ntfs.img
        mkntfs --force --quiet --fast --label WINDATA /w/.ntfs.img >/dev/null 2>&1
        dd if=/w/.ntfs.img of=/w/fixture-a.raw bs=512 seek="$start" count="$size" \
            conv=notrunc status=none
        rm -f /w/.ntfs.img
        echo "--- fixture A ---"; sfdisk -d /w/fixture-a.raw | grep raw
        echo "--- fixture B ---"; sfdisk -d /w/fixture-b.raw | grep raw
        echo "--- partition 2 now holds ---"; file -s /w/fixture-a.raw | head -1
    ' || die "fixture build failed"
    say "fixtures: $DIR/fixture-a.raw $DIR/fixture-b.raw"
}

# ── winlab run ───────────────────────────────────────────────────────────────
#  Boot the golden image with a job on the transport disk. The golden itself is
#  never written to: the guest runs on a qcow2 overlay and a copy of the
#  firmware variables, so a run that corrupts Windows costs one `rm`. The two
#  target-disk fixtures now get the same treatment, and for longer — see the
#  comment at the overlay creation below for why that used to not be true.
cmd_run() {
    local rundir="${1:-}" swap=no boots=1
    [ -n "$rundir" ] || die "usage: winlab run DIR [--swap] [--boots N]"
    shift || true
    while [ $# -gt 0 ]; do
        case "$1" in
            --swap)  swap=yes ;;
            --boots) shift; boots="${1:-1}" ;;
            *)       die "unknown argument $1" ;;
        esac
        shift
    done
    case "$boots" in ''|*[!0-9]*) die "--boots wants a number" ;; esac
    [ "$boots" -ge 1 ] || die "--boots must be at least 1"
    rundir="$(cd "$rundir" && pwd)"
    [ -f "$rundir/run.ps1" ] || die "$rundir/run.ps1 is missing"
    need "$GOLDEN" golden
    need "$DIR/fixture-a.raw" fixtures
    need "$DIR/fixture-b.raw" fixtures
    have_kvm || die "/dev/kvm is not usable"

    podman run --rm --device /dev/kvm \
        -v "$DIR":/w:z -v "$HERE":/lab:ro,z -v "$rundir":/job:ro,z \
        -e SWAP="$swap" -e BOOTS="$boots" \
        "$IMAGE" bash -uo pipefail -c "$(qemu_args)"'
        set -e
        export VARS=/w/run-VARS.fd SYSDISK=/w/run.qcow2 SYSFMT=qcow2 \
               MON=/w/run-mon.sock SHOTTAG=run

        rm -f "$SYSDISK" "$VARS" /w/run-transport.raw
        qemu-img create -f qcow2 -b /w/golden.raw -F raw "$SYSDISK" >/dev/null
        cp /w/golden-VARS.fd "$VARS"

        # Fixture disks are attached RAW, with no per-run overlay, unlike the
        # system disk above. A run that writes anything to fixture-a.raw or
        # fixture-b.raw directly would permanently mutate the fixture, and
        # every later run would silently measure a different disk than it
        # thinks it does. Give each fixture the same qcow2-over-raw treatment
        # SYSDISK gets, fresh every run, and point the guest at the overlay,
        # never at the fixture file itself. The overlays are deliberately NOT
        # cleaned up at the end of this function: host-side verification (a
        # `cmp` against what the guest just wrote) reads them after qemu exits.
        rm -f /w/run-fixture-a.qcow2 /w/run-fixture-b.qcow2
        qemu-img create -f qcow2 -b /w/fixture-a.raw -F raw /w/run-fixture-a.qcow2 >/dev/null
        qemu-img create -f qcow2 -b /w/fixture-b.raw -F raw /w/run-fixture-b.qcow2 >/dev/null

        # The firmware baseline, taken from the varstore the guest is about to
        # boot — not from a note about what it should contain.
        virt-fw-vars -i /w/golden-VARS.fd --print 2>/dev/null |
            grep -E "^(Boot[0-9]{4}|BootOrder)" | sort > /w/fw-before.txt

        # Fresh transport every run: a stale result.txt from a previous run is
        # indistinguishable from a run that produced one.
        qemu-img create -f raw /w/run-transport.raw 256M >/dev/null
        printf "label: gpt\nsize=250MiB, type=EBD0A0A2-B9E5-4433-87C0-68B6B72699C7, name=APEXLAB\n" |  # rime-rename: keep (the baked agent looks for APEXLAB)
            sfdisk /w/run-transport.raw >/dev/null
        mformat -i /w/run-transport.raw@@1048576 -F -v APEXLAB ::  # rime-rename: keep (the baked agent looks for APEXLAB)
        mcopy -i /w/run-transport.raw@@1048576 /job/* ::/ 
        [ -f /w/rime-windows-installer.exe ] &&
            mcopy -i /w/run-transport.raw@@1048576 /w/rime-windows-installer.exe ::/
        echo "--- transport contents ---"
        mdir -i /w/run-transport.raw@@1048576 ::

        # --swap changes the AHCI PORT the fixture sits on, not the order of
        # the arguments. Reordering `-device` proves nothing: ich9-ahci is a
        # fixed q35 device, nvme takes the next free PCI slot whichever way
        # round they are written, and Windows numbers storahci disks by port
        # and then stornvme — so the first attempt at this produced byte-
        # identical Get-Disk tables in both runs and demonstrated nothing at
        # all. Exchanging the ports of the transport and fixture A does move
        # the numbers, which is the whole point: the identity the tool prints
        # must not move with them.
        trport=1; faport=2
        [ "$SWAP" = yes ] && { trport=2; faport=1; }

        # ── the boot loop ────────────────────────────────────────────────
        #  One boot is the common case and behaves exactly as it always has.
        #  A job that needs more than one -- installing a Windows FEATURE, for
        #  instance, which is what BitLocker is on Server -- writes reboot.txt
        #  on the transport volume and exits 0; the agent then powers the
        #  machine off as usual and this loop powers it back on with the SAME
        #  overlays, the SAME varstore and the SAME transport. The host owns
        #  the reboot rather than the guest calling Restart-Computer, because
        #  Restart-Computer races the agent`s own status.txt write and the
        #  result is a run that sometimes has a status and sometimes does not.
        #
        #  The agent TRUNCATES result.txt at the start of every boot (its
        #  first Out-File has no -Append), so each boot`s transcript is
        #  copied out before the next one starts and the copies are
        #  concatenated at the end. A job that wants more than the agent`s
        #  transcript writes its own phase files next to result.txt; they are
        #  copied out too.
        tag=normal; [ "$SWAP" = yes ] && tag=swapped
        rm -f "/w/guest-$tag.txt"
        boot=1; rc=0
        while :; do
            echo "-- boot $boot of at most ${BOOTS:-1} -- $(date -u +%H:%M:%S)"
            export SHOTTAG="run-b$boot"
            rc=0
            QEMU_TIMEOUT=900 qemu_run disk \
                -drive "id=tr,file=/w/run-transport.raw,format=raw,if=none" \
                -device "ide-hd,drive=tr,bus=ahci.$trport,model=RIME-LAB-TRANSPORT,serial=TRN0000000001" \
                -drive "id=fa,file=/w/run-fixture-a.qcow2,format=qcow2,if=none" \
                -device "ide-hd,drive=fa,bus=ahci.$faport,model=RIME-FIXTURE-A,serial=FIXA00000001" \
                -drive "id=fb,file=/w/run-fixture-b.qcow2,format=qcow2,if=none" \
                -device "nvme,drive=fb,serial=FIXB00000002" || rc=$?
            echo "qemu exited rc=$rc after boot $boot"

            # The firmware baseline after EVERY boot, not only the last one.
            # A fault-injection run has to be able to say WHICH boot changed
            # a variable, and a single after-image cannot.
            virt-fw-vars -i "$VARS" --print 2>/dev/null |
                grep -E "^(Boot[0-9]{4}|BootOrder)" | sort > "/w/fw-after-b$boot.txt"
            cp "/w/fw-after-b$boot.txt" /w/fw-after.txt

            {
                echo "=== BOOT $boot ==="
                mtype -i /w/run-transport.raw@@1048576 ::/result.txt 2>/dev/null ||
                    echo "(no result.txt from boot $boot)"
            } >> "/w/guest-$tag.txt"

            # reboot.txt is the job asking for another boot. It is deleted
            # here rather than by the guest, so a guest that died before it
            # could clean up cannot loop this harness forever.
            if mtype -i /w/run-transport.raw@@1048576 ::/reboot.txt >/dev/null 2>&1; then
                mdel -i /w/run-transport.raw@@1048576 ::/reboot.txt 2>/dev/null
                if [ "$boot" -ge "${BOOTS:-1}" ]; then
                    echo "the job asked for another boot but --boots ${BOOTS:-1} is exhausted"
                    break
                fi
                boot=$((boot+1))
                continue
            fi
            break
        done

        # Whatever the job left on the transport besides result.txt and
        # status.txt. A job that produces more than one transcript writes
        # phase-N.txt; the host copies each one out so the evidence is a file
        # on the host and not a scrollback line.
        for n in 1 2 3 4 5 6 7 8; do
            mtype -i /w/run-transport.raw@@1048576 "::/phase-$n.txt" \
                > "/w/job-phase-$n.txt" 2>/dev/null &&
                [ -s "/w/job-phase-$n.txt" ] &&
                echo "job artefact: /w/job-phase-$n.txt" ||
                rm -f "/w/job-phase-$n.txt"
        done

        echo "=== GUEST RESULT ($tag, $boot boot(s); saved as /w/guest-$tag.txt) ==="
        cat "/w/guest-$tag.txt" 2>/dev/null ||
            echo "(no result.txt - the guest produced nothing)"
        echo "═══ STATUS ═══"
        mtype -i /w/run-transport.raw@@1048576 ::/status.txt 2>/dev/null ||
            echo "(no status.txt)"
        echo "═══ FIRMWARE VARIABLES: before vs after ═══"
        if diff -u /w/fw-before.txt /w/fw-after.txt; then
            echo "IDENTICAL — no boot entry and no boot order changed"
        fi
    ' || die "run failed"
}

case "${1:-}" in
    image)    cmd_image ;;
    build)    cmd_build ;;
    fixtures) cmd_fixtures ;;
    run)      shift; cmd_run "$@" ;;
    fetch)    cmd_fetch ;;
    media)    cmd_media ;;
    golden)   cmd_golden ;;
    status)   cmd_status ;;
    *) sed -n '/^#  ═══ USAGE ═══/,/^# ────/p' "$0" | sed 's/^#\s\?//'; exit 2 ;;
esac
