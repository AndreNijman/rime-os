// The manifest is resource 1 of type 24 (RT_MANIFEST): what makes Windows
// ask for administrator rights, use the current common controls and scale
// the window per monitor.
1 24 "rime-installer.manifest"

1 VERSIONINFO
FILEVERSION 0,2,0,0
PRODUCTVERSION 0,2,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Rime OS"
      VALUE "FileDescription", "Rime OS installer for Windows"
      VALUE "FileVersion", "0.2.0"
      VALUE "ProductName", "Rime OS"
      VALUE "ProductVersion", "0.2.0"
      VALUE "OriginalFilename", "rime-windows-installer.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
