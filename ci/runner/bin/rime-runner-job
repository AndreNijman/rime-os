#!/bin/bash
# rime-runner-job SLOT: run exactly one GitHub job in a fresh container, then exit.
# ExecStart of rime-runner@SLOT.service (Restart=always starts the next one).
# Runs as root on the host; the job itself never does.
#
#   1. paused? (rime-runner-ctl pause) -> wait, take nothing.
#   2. mint a just-in-time runner config for a unique name with the root-only
#      token (POST /repos/{repo}/actions/runners/generate-jitconfig). A JIT runner
#      is ephemeral by construction: one job, then GitHub drops it. Unlike
#      today's apex-runner-register, nothing is written to disk and no
#      config.sh/.credentials files exist on the host.
#   3. hand the config to the container on stdin; `podman run --rm` waits for
#      the job and deletes the container and its writable layer.
#   4. delete the registration if GitHub has not already (a job that never
#      arrived, a crash).
set -euo pipefail
RIME_RUNNER_HOME=${RIME_RUNNER_HOME:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}
# shellcheck source=../lib/common.sh
. "$RIME_RUNNER_HOME/lib/common.sh"

slot=${1:?usage: rime-runner-job SLOT}
case $slot in '' | *[!0-9]*) rr_die "slot must be a number" ;; esac

if [ -e /run/rime-runner/paused ] || [ -e /etc/rime-runner/paused ]; then
	rr_log "slot $slot: paused, taking no job"
	sleep 30
	exit 0
fi

mountpoint -q /var/lab || rr_die "/var/lab is not mounted"
[ -S "$RIME_RUNNER_NIX/var/nix/daemon-socket/socket" ] || rr_die "builder socket missing (rime-runner-builder.service down?)"
[ -s "$RIME_RUNNER_TOKEN_FILE" ] || rr_die "$RIME_RUNNER_TOKEN_FILE missing or empty (see ci/runner/README.md, 'Token')"
[ "$(stat -c '%u %a' "$RIME_RUNNER_TOKEN_FILE")" = "0 600" ] || rr_die "$RIME_RUNNER_TOKEN_FILE must be root:root 0600"

api() {
	local method=$1 path=$2
	shift 2
	# The token reaches curl through a pipe (builtin printf), never argv, so
	# `ps` on the host does not show it.
	curl -fsS -X "$method" \
		-H @<(printf 'Authorization: Bearer %s\n' "$(<"$RIME_RUNNER_TOKEN_FILE")") \
		-H "Accept: application/vnd.github+json" \
		-H "X-GitHub-Api-Version: 2022-11-28" \
		"https://api.github.com/repos/${RIME_RUNNER_REPO}${path}" "$@"
}

name="katana-nix-$slot-$(date +%Y%m%d%H%M%S)-$(od -An -N3 -tx1 /dev/urandom | tr -d ' \n')"
body=$(python3 -c '
import json, sys
name, group, labels = sys.argv[1], int(sys.argv[2]), sys.argv[3]
print(json.dumps({"name": name, "runner_group_id": group,
                  "labels": [l for l in labels.split(",") if l], "work_folder": "_work"}))
' "$name" "$RIME_RUNNER_GROUP_ID" "$RIME_RUNNER_LABELS")

rr_log "slot $slot: minting JIT config for $name (labels $RIME_RUNNER_LABELS)"
resp=$(api POST /actions/runners/generate-jitconfig -d "$body")
runner_id=$(printf '%s' "$resp" | python3 -c 'import json,sys; print(json.load(sys.stdin)["runner"]["id"])')
jit=$(printf '%s' "$resp" | python3 -c 'import json,sys; print(json.load(sys.stdin)["encoded_jit_config"])')
unset resp
[ -n "$jit" ] || rr_die "empty JIT config"

# shellcheck disable=SC2329 # called by the EXIT trap
deregister() {
	# 404 = GitHub already removed the ephemeral runner after its job: the normal case.
	api DELETE "/actions/runners/$runner_id" >/dev/null 2>&1 || true
}
trap deregister EXIT

rr_podman_env
RIME_RUNNER_CGROUP_PARENT=${RIME_RUNNER_CGROUP_PARENT:-rime-runner.slice}
job_args "$slot" "$RIME_RUNNER_NETWORK"
rr_log "slot $slot: runner id $runner_id, starting container (uid block $(rr_uid_base $((slot + 1))))"
set +e
printf '%s\n' "$jit" | timeout --kill-after=60 "$RIME_RUNNER_JOB_TIMEOUT" \
	podman run "${JOB_ARGS[@]}" "$RIME_RUNNER_JOB_IMAGE"
rc=$?
set -e
unset jit
rr_log "slot $slot: container exited $rc"
exit 0
