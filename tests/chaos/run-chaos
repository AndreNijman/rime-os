#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  run-chaos — the APEX chaos/torture driver. Roadmap P1-062.
#
#  Usage:
#    run-chaos [--out DIR] [--seed N] [--cases-dir DIR] [CASE ...]
#    run-chaos --list
#    run-chaos --replay BUNDLE-DIR
#
#  A case is a file in `cases/` that defines, and defines nothing else that
#  matters:
#
#    CASE_TITLE      one line, what the fault is
#    CASE_CRITERION  which of P1-062's three criteria it serves
#    CASE_NEEDS      space-separated prerequisites: apex-binary userns netns
#                    tmpfs-ns kvm
#    case_setup      build the fixture tree at $CASE_ROOT
#    case_inject     apply the fault
#    case_prove      an observation INDEPENDENT of the injector: rc 0 means the
#                    fault is really present. This is the function that stops
#                    the harness reporting "no corruption" having injected
#                    nothing.
#    case_baseline   run the subject with NO fault (optional but expected)
#    case_observe    run the subject WITH the fault; its stdout is the
#                    diagnostic a human reads
#    case_judge      record expectations with expect_says / expect_rc /
#                    expect_no_corruption / expect_differs_from_baseline
#
#  The driver, not the case, owns the verdict. The ordering below is the whole
#  argument of this unit:
#
#      prerequisite unmet ─────────────────► could-not-inject
#      case_prove said the fault is absent ► could-not-inject
#      subject could not be run at all ────► could-not-inject
#      an expectation failed ──────────────► failed
#      otherwise ─────────────────────────► survived
#
#  There is no arm in which a case that injected nothing reports a pass, and
#  tests/test-apex-chaos.sh proves that by feeding the driver cases whose
#  injector and whose observer each cannot run.
#
#  ═══ EXIT CODES ═══
#
#    0  every requested case survived
#    1  at least one case failed, OR at least one case in the DEFAULT set
#       could not inject
#    2  the harness itself is broken (a malformed case, a missing cases dir)
#
#  `could-not-inject` failing the run is deliberate and has no opt-out. This
#  repository's own history records five separate occasions where something
#  skipped, the workflow passed, and nobody could see the difference. A case
#  that needs hardware a runner does not have goes in STAGED and is asked for
#  by name; it is never silently dropped from a default run.
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=tests/chaos/lib.sh
. "$HERE/lib.sh"

CASES_DIR="$HERE/cases"
OUT="${CHAOS_OUT:-}"
SEED="${CHAOS_SEED:-}"
LIST=0
REPLAY=""
WANT=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --out)       OUT="$2"; shift 2 ;;
        --seed)      SEED="$2"; shift 2 ;;
        --cases-dir) CASES_DIR="$2"; shift 2 ;;
        --list)      LIST=1; shift ;;
        --replay)    REPLAY="$2"; shift 2 ;;
        --help|-h)   sed -n '2,55p' "${BASH_SOURCE[0]}"; exit 0 ;;
        --*)         chaos_die "unknown option $1" ;;
        *)           WANT+=("$1"); shift ;;
    esac
done

[[ -d "$CASES_DIR" ]] || chaos_die "no cases directory at $CASES_DIR"

# ── the default set, and the set that must be asked for by name ─────────────
#
# Copied in shape from files/scripts/boot-v2/run-scenarios: a scenario needing
# something the environment cannot produce for itself is kept OUT of the
# default list, so a default run cannot silently skip it and still report
# success. Membership is declared by the case itself, in CASE_STAGED.
declare -a DEFAULT_CASES=() STAGED_CASES=()
declare -A CASE_FILE=()

for f in "$CASES_DIR"/*.sh; do
    [[ -e "$f" ]] || continue
    name="$(basename "$f" .sh)"
    CASE_FILE["$name"]="$f"
    # Read the declaration without executing the case: sourcing every case to
    # find out which are staged would run their top-level code, and a case's
    # top level is allowed to do nothing at all.
    if grep -qE '^CASE_STAGED=1' "$f"; then
        STAGED_CASES+=("$name")
    else
        DEFAULT_CASES+=("$name")
    fi
done

if (( LIST )); then
    printf 'default:\n'
    printf '  %s\n' "${DEFAULT_CASES[@]:-}"
    printf 'staged (ask for these by name):\n'
    printf '  %s\n' "${STAGED_CASES[@]:-}"
    exit 0
fi

# ── replay ──────────────────────────────────────────────────────────────────
#
# Reproducibility, made checkable rather than claimed. A bundle carries the
# seed and the revision it was produced at; replay re-runs that one case with
# that seed and diffs the verdict. A revision mismatch is REPORTED and the
# replay still runs — a verdict that changed because the tree moved is the most
# interesting result replay can produce, and refusing to run would hide it.
if [[ -n "$REPLAY" ]]; then
    [[ -f "$REPLAY/verdict.json" ]] || chaos_die "no verdict.json in $REPLAY"
    rname="$(sed -n 's/.*"case": "\([^"]*\)".*/\1/p' "$REPLAY/verdict.json")"
    rseed="$(sed -n 's/.*"seed": \([0-9]*\).*/\1/p' "$REPLAY/verdict.json")"
    rrev="$(sed -n 's/.*"revision": "\([^"]*\)".*/\1/p' "$REPLAY/verdict.json")"
    rstate="$(sed -n 's/.*"state": "\([^"]*\)".*/\1/p' "$REPLAY/verdict.json")"
    now="$(git -C "$CHAOS_REPO" rev-parse HEAD 2>/dev/null || echo unknown)"
    chaos_log "replaying '$rname' at seed $rseed (bundle recorded at $rrev)"
    [[ "$rrev" == "$now" ]] || chaos_info \
        "NOTE: the tree has moved since the bundle was written ($rrev -> $now)"
    tmp="$(mktemp -d)"
    rc=0
    "$0" --out "$tmp" --seed "$rseed" --cases-dir "$CASES_DIR" "$rname" || rc=$?
    nstate="$(sed -n 's/.*"state": "\([^"]*\)".*/\1/p' "$tmp/$rname/verdict.json" 2>/dev/null || echo '<no verdict>')"
    printf '\nreplay: recorded=%s reproduced=%s\n' "$rstate" "$nstate"
    if [[ "$rstate" == "$nstate" ]]; then
        printf 'replay: the verdict reproduced\n'
        rm -rf "$tmp"; exit 0
    fi
    printf 'replay: THE VERDICT DID NOT REPRODUCE (bundle kept at %s)\n' "$tmp"
    exit 1
fi

# ── what to run ─────────────────────────────────────────────────────────────
if (( ${#WANT[@]} == 0 )); then
    RUN=("${DEFAULT_CASES[@]:-}")
else
    RUN=("${WANT[@]}")
    for n in "${RUN[@]}"; do
        [[ -n "${CASE_FILE[$n]:-}" ]] || chaos_die "no such case '$n' (try --list)"
    done
fi
(( ${#RUN[@]} )) || chaos_die "no cases to run in $CASES_DIR"

[[ -n "$SEED" ]] || SEED="$(date +%s)"
if [[ -z "$OUT" ]]; then
    OUT="$(mktemp -d -t apex-chaos-XXXXXX)"
fi
mkdir -p "$OUT"

APEX_BIN="${APEX_BIN:-$CHAOS_REPO/apexd/target/debug/apex}"
export APEX_BIN

chaos_log "APEX chaos run — seed $SEED, bundles in $OUT"
chaos_write_env "$OUT/env.txt"
sed 's/^/    /' "$OUT/env.txt" >&2

# ── the case loop ───────────────────────────────────────────────────────────
declare -i N_SURVIVED=0 N_FAILED=0 N_CANNOT=0
declare -a SUMMARY=()

for name in "${RUN[@]}"; do
    file="${CASE_FILE[$name]}"
    dir="$OUT/$name"
    mkdir -p "$dir"
    CASE_ROOT="$dir/root"
    mkdir -p "$CASE_ROOT"
    export CASE_ROOT CASE_DIR="$dir"

    case_seed="$(chaos_seed_for_case "$SEED" "$name")"
    printf '%s\n' "$case_seed" > "$dir/seed"
    chaos_write_env "$dir/env.txt"

    # Each case runs in its own subshell-free scope but with fresh function
    # definitions: undefine first, so a case that forgets `case_prove` inherits
    # the previous case's and silently passes. That is precisely the class of
    # bug this harness exists to refuse.
    unset -f case_setup case_inject case_prove case_baseline case_observe case_judge case_cleanup 2>/dev/null || true
    CASE_TITLE=""; CASE_CRITERION=""; CASE_NEEDS=""; CASE_STAGED=0
    CASE_ALLOW_CHANGED=""
    # shellcheck disable=SC1090
    . "$file"

    [[ -n "$CASE_TITLE" ]] || chaos_die "$file declares no CASE_TITLE"
    for fn in case_setup case_inject case_prove case_observe case_judge; do
        declare -F "$fn" >/dev/null || chaos_die "$file defines no $fn"
    done

    chaos_log "$name — $CASE_TITLE"
    chaos_info "criterion $CASE_CRITERION, seed $case_seed"
    chaos_reset_expectations
    RANDOM="$case_seed"

    state="" reason=""

    # 1 ── prerequisites. Probed capabilities, never `command -v`.
    for need in $CASE_NEEDS; do
        if ! why="$(chaos_prereq "$need")"; then
            state="$CHAOS_CANNOT"; reason="$why"
            break
        fi
    done

    # 2 ── setup, then the pristine snapshot and the no-fault baseline.
    if [[ -z "$state" ]]; then
        if ! case_setup > "$dir/setup.out" 2> "$dir/setup.err"; then
            state="$CHAOS_CANNOT"
            reason="the fixture could not be built: $(tail -1 "$dir/setup.err" 2>/dev/null)"
        fi
    fi
    if [[ -z "$state" ]]; then
        chaos_snapshot "$CASE_ROOT" "$dir/state.before"
        if declare -F case_baseline >/dev/null; then
            case_baseline > "$dir/baseline.out" 2> "$dir/baseline.err" || true
        else
            : > "$dir/baseline.out"; : > "$dir/baseline.err"
        fi
    fi

    # 3 ── inject. The injector's exit code is recorded and is NOT the proof.
    if [[ -z "$state" ]]; then
        inject_rc=0
        case_inject > "$dir/inject.out" 2> "$dir/inject.err" || inject_rc=$?
        printf '%s\n' "$inject_rc" > "$dir/inject.rc"

        # 4 ── prove. An observation the injector did not make.
        if ! case_prove > "$dir/prove.out" 2> "$dir/prove.err"; then
            state="$CHAOS_CANNOT"
            reason="the fault was not present after injection: $(tail -1 "$dir/prove.out" 2>/dev/null)$(tail -1 "$dir/prove.err" 2>/dev/null)"
            reason="${reason:-the independent proof said the fault is absent}"
        fi
    fi

    # 5 ── observe. A subject that could not be run is inconclusive, never a
    #      pass and never a failure — the same rule verify.rs applies to a
    #      verification that could not run.
    if [[ -z "$state" ]]; then
        CASE_OBSERVE_RC=0
        case_observe > "$dir/observe.out" 2> "$dir/observe.err" || CASE_OBSERVE_RC=$?
        printf '%s\n' "$CASE_OBSERVE_RC" > "$dir/observe.rc"
        if [[ "$CASE_OBSERVE_RC" == 127 ]]; then
            state="$CHAOS_CANNOT"
            reason="the subject could not be executed: $(tail -1 "$dir/observe.err" 2>/dev/null)"
        fi
        export CASE_OBSERVE_RC
    fi

    # 6 ── judge.
    if [[ -z "$state" ]]; then
        chaos_snapshot "$CASE_ROOT" "$dir/state.after"
        diff "$dir/state.before" "$dir/state.after" > "$dir/state.diff" 2>&1 || true
        CASE_BASELINE_OUT="$(cat "$dir/baseline.out" 2>/dev/null || true)"
        CASE_OBSERVED="$(cat "$dir/observe.out" "$dir/observe.err" 2>/dev/null || true)"
        export CASE_BASELINE_OUT CASE_OBSERVED
        case_judge || true
        if (( CHAOS_EXPECT_BAD > 0 )); then
            state="$CHAOS_FAILED"
            reason="$CHAOS_EXPECT_BAD of $((CHAOS_EXPECT_OK + CHAOS_EXPECT_BAD)) expectations failed"
        else
            state="$CHAOS_SURVIVED"
            reason=""
        fi
    else
        : > "$dir/state.after"
        : > "$dir/state.diff"
    fi

    # 7 ── cleanup, AFTER the snapshots and the judgement. A case that made the
    #      tree unreadable owns making it readable again, or the bundle it left
    #      behind is one nobody can open — and an unopenable bundle is the same
    #      as no diagnostics, which is the criterion this unit is built on.
    #      It runs whatever the verdict, including after a could-not-inject.
    if declare -F case_cleanup >/dev/null; then
        case_cleanup >> "$dir/setup.out" 2>> "$dir/setup.err" || true
    fi

    printf '%s\n' "${CHAOS_EXPECT_NOTES[@]:-}" > "$dir/expectations.txt"
    chaos_write_verdict "$dir" "$name" "$state" "$reason" "$case_seed" "$CASE_TITLE"

    case "$state" in
        "$CHAOS_SURVIVED") N_SURVIVED+=1 ;;
        "$CHAOS_FAILED")   N_FAILED+=1 ;;
        "$CHAOS_CANNOT")   N_CANNOT+=1 ;;
    esac
    SUMMARY+=("$(printf '%-18s %-28s %s' "$state" "$name" "$reason")")
    chaos_info "verdict: $state ${reason:+— $reason}"
done

# ── the report ──────────────────────────────────────────────────────────────
printf '\n═══ chaos summary (seed %s) ═══\n' "$SEED"
printf '%s\n' "${SUMMARY[@]}"
printf '\n%d survived, %d failed, %d could not inject\n' \
    "$N_SURVIVED" "$N_FAILED" "$N_CANNOT"
printf 'diagnostics: %s\n' "$OUT"
printf 'replay one:  %s --replay %s/<case>\n' "$0" "$OUT"

rc=0
(( N_FAILED > 0 )) && rc=1
# A could-not-inject in the DEFAULT set fails the run. In a run that asked for
# named cases it also fails, because asking for a case by name is asking for it
# to run. The only way a could-not-inject is not a failure is nobody asked.
(( N_CANNOT > 0 )) && rc=1
if (( rc != 0 )); then
    printf '\nA chaos run is green only when every requested case both INJECTED\n'
    printf 'its fault and the subject survived it. See the bundles above.\n'
fi
exit "$rc"
